{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5184",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "AllowedHosts": "*"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7123;http://localhost:5184",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "AllowedHosts": "*"
      }
    },
    "lan": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://0.0.0.0:7443",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "AllowedHosts": "*",
        "ASPNETCORE_Kestrel__Certificates__Default__Subject": "facturacion-lan",
        "ASPNETCORE_Kestrel__Certificates__Default__Store": "My",
        "ASPNETCORE_Kestrel__Certificates__Default__Location": "CurrentUser",
        "ASPNETCORE_Kestrel__Certificates__Default__AllowInvalid": "true"
      }
    }
  }
}
