<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Lo exige NPOI al compilar: es la promesa de no ejercer patentes de Microsoft sobre
         OOXML (Open Specification Promise), no una licencia de uso del paquete en sí. -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="NPOI" />
    <PackageReference Include="SkiaSharp" GeneratePathProperty="true" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <!-- NPOI usa SkiaSharp al abrir XLS; el paquete 3.119.2 declara lib/net8.0/_._
       como runtime genérico y .NET 10 no copia la DLL administrada. La referencia
       explícita la incluye en el servidor sin copiarla manualmente al desplegar. -->
  <ItemGroup>
    <Reference Include="SkiaSharp">
      <HintPath>$(PkgSkiaSharp)\lib\net8.0\SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Facturacion.Client\Facturacion.Client.csproj" />
    <ProjectReference Include="..\Facturacion.Shared\Facturacion.Shared.csproj" />
  </ItemGroup>

<!-- No publica la configuración de desarrollo ni archivos privados, porque pueden contener secretos. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Remove="cnf/**" />
    <None Remove="cnf/**" />
    <Content Remove="Infra/Instalacion/Recursos/**" />
    <EmbeddedResource Include="Infra/Instalacion/Recursos/*" />
    <Content Include="../CatalogosSAT/*.xls;../CatalogosSAT/*.xsd;../CatalogosSAT/*.xslt" Link="CatalogosSAT/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

<!--
    Bug del SDK sin corregir a la fecha (dotnet/runtime#121993, dotnet/aspnetcore#64199):
    al publicar el Server, el Client referenciado nunca ejecuta la fase de "publish" que
    resuelve los marcadores #[.{fingerprint}] de wwwroot/index.html —solo se ejecuta al
    publicar el Client directamente—, así que el index.html que llega al publicado del
    Server queda sin resolver y la aplicación no arranca. Se comprobó publicando de
    verdad, no leyendo el código: con este bug, "blazor.webassembly.js"
    del index.html publicado literalmente decía "blazor.webassembly#[.{fingerprint}].js".

    La fase de "publish" del Client sí resuelve los marcadores con las mismas huellas
    que terminan existiendo en _framework/. No sirve reutilizar el index de "build":
    el enlazado de WebAssembly cambia algunas huellas durante la publicación.
  -->
  <Target Name="CorregirMarcadoresDeIndexHtml" AfterTargets="Publish">
    <MSBuild Projects="..\Facturacion.Client\Facturacion.Client.csproj" Targets="Publish" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" RemoveProperties="PublishDir;PublishUrl" />
    <ItemGroup>
      <_IndexHtmlResuelto Include="..\Facturacion.Client\obj\$(Configuration)\$(TargetFramework)\staticwebassets\htmlassetplaceholders\publish\*.html" />
    </ItemGroup>
    <Error Condition="'@(_IndexHtmlResuelto)' == ''" Text="No se encontró el index.html publicado del Client con los marcadores resueltos (¿dotnet/runtime#121993 ya se corrigió? Si es así, esta corrección manual sobra y hay que quitarla)." />
    <Error Condition="'@(_IndexHtmlResuelto-&gt;Count())' &gt; 1" Text="Hay más de un index.html resuelto en obj/ del Client —probablemente restos de una publicación anterior—. Ejecuta 'dotnet clean' en Facturacion.Client antes de publicar." />
    <Copy SourceFiles="@(_IndexHtmlResuelto)" DestinationFiles="$(PublishDir)wwwroot\index.html" />
  </Target>

</Project>
