<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Lo exige NPOI al compilar: es la promesa de no ejercer patentes de Microsoft sobre
         OOXML (Open Specification Promise), no una licencia de uso del paquete en sí. -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="NPOI" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Facturacion.Client\Facturacion.Client.csproj" />
    <ProjectReference Include="..\Facturacion.Shared\Facturacion.Shared.csproj" />
  </ItemGroup>

  <!--
    appsettings.Development.json NO se publica. El SDK copia todos los appsettings.*.json al
    publicado por omisión, y este archivo lleva en claro la llave maestra de Data Protection
    —con la que se descifran los CSD—, la clave de firma de los JWT y la contraseña del
    sembrado. Que ASP.NET Core solo lo *lea* en Development no ayuda: el secreto igual viaja
    dentro del artefacto, y cualquiera que lo tenga se lleva las llaves privadas de todos los
    certificados cargados.

    Se detectó en el repaso de seguridad de la fase 9 publicando de verdad y abriendo el
    resultado, no leyendo el csproj (docs/REPASO-SEGURIDAD.md). En un despliegue la
    configuración va por variables de entorno; ver docs/DESPLIEGUE.md.
  -->
  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    Bug del SDK sin corregir a la fecha (dotnet/runtime#121993, dotnet/aspnetcore#64199):
    al publicar el Server, el Client referenciado nunca ejecuta la fase de "publish" que
    resuelve los marcadores #[.{fingerprint}] de wwwroot/index.html —solo se ejecuta al
    publicar el Client directamente—, así que el index.html que llega al publicado del
    Server queda sin resolver y la aplicación no arranca. Se comprobó publicando de
    verdad, no leyendo el código (ARQUITECTURA.md §9): con este bug, "blazor.webassembly.js"
    del index.html publicado literalmente decía "blazor.webassembly#[.{fingerprint}].js".

    La fase de "build" del Client sí resuelve los marcadores correctamente, y con el
    mismo nombre huellado que termina existiendo de verdad en _framework/ —se comprobó
    comparando los dos—, así que ese resultado se copia encima del index.html sin
    procesar que deja la publicación.
  -->
  <Target Name="CorregirMarcadoresDeIndexHtml" AfterTargets="Publish">
    <ItemGroup>
      <_IndexHtmlResuelto Include="..\Facturacion.Client\obj\$(Configuration)\$(TargetFramework)\staticwebassets\htmlassetplaceholders\publish\*.html" />
      <_IndexHtmlResuelto Include="..\Facturacion.Client\obj\$(Configuration)\$(TargetFramework)\staticwebassets\htmlassetplaceholders\build\*.html" Condition="'@(_IndexHtmlResuelto)' == ''" />
    </ItemGroup>
    <Error
      Condition="'@(_IndexHtmlResuelto)' == ''"
      Text="No se encontró el index.html con los marcadores resueltos del Client (¿dotnet/runtime#121993 ya se corrigió? Si es así, esta corrección manual sobra y hay que quitarla)." />
    <Error
      Condition="'@(_IndexHtmlResuelto->Count())' &gt; 1"
      Text="Hay más de un index.html resuelto en obj/ del Client —probablemente restos de una publicación anterior—. Ejecuta 'dotnet clean' en Facturacion.Client antes de publicar." />
    <Copy SourceFiles="@(_IndexHtmlResuelto)" DestinationFiles="$(PublishDir)wwwroot\index.html" />
  </Target>

</Project>
