{
  "//": "Copia este archivo como appsettings.Development.json y ajusta los valores.",
  "//_": "appsettings.Development.json está en .gitignore: no lo subas, aquí va la configuración local.",

  "ConnectionStrings": {
    "BaseDeDatos": "Server=.;Database=FacturacionDev;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False"
  },

  "//Jwt": "ClaveDeFirma: mínimo 32 caracteres. Genera una propia y no la compartas entre equipos. En producción va en una variable de entorno, nunca en un archivo.",
  "Jwt": {
    "Emisor": "facturacion-local",
    "Audiencia": "facturacion-client",
    "ClaveDeFirma": "cambia-esta-clave-por-una-tuya-de-al-menos-32-caracteres"
  },

  "//Almacen": "Archivos de empresa (logo, CSD) cifrados y fuera de wwwroot. LlaveMaestraPfx protege el llavero de Data Protection y con él los certificados: genérala con 'dotnet run -- --generar-llave-maestra' y RESPÁLDALA — si se pierde, los CSD ya cargados quedan ilegibles. En producción va en una variable de entorno.",
  "Almacen": {
    "Raiz": "almacenamiento",
    "RutaLlavero": "almacenamiento/llavero",
    "LlaveMaestraPfx": "genera-la-tuya-con-dotnet-run----generar-llave-maestra"
  },

  "//Sembrado": "Solo se usa en Development. Si quitas estas dos claves, el sembrado no corre. Crea una cuenta con dos empresas y un usuario con los seis permisos.",
  "Sembrado": {
    "Correo": "contador@ejemplo.mx",
    "Contrasena": "PonUnaContrasena123"
  },

  "//Pac": "Proveedor de timbrado (SW sapien). En Development puede quedar sin credenciales. En Staging usa Modo Deshabilitado para revisar sin simular CFDI. Production siempre exige Modo Real y credenciales. Sandbox y producción usan cuentas distintas.",
  "Pac": {
    "Modo": "Real",
    "UrlBase": "https://services.test.sw.com.mx",
    "Usuario": "",
    "Contrasena": "",
    "TiempoDeEsperaSegundos": 60
  },

  "//Correo": "Opcional en Development: sin 'Servidor', las invitaciones se escriben en el log de la consola en vez de enviarse de verdad. Fuera de Development es obligatorio.",
  "Correo": {
    "Servidor": "",
    "Puerto": 587,
    "Usuario": "",
    "Contrasena": "",
    "RemitenteCorreo": "no-responder@tudominio.mx",
    "RemitenteNombre": "Sistema de facturación",
    "UsarTls": true
  }
}
