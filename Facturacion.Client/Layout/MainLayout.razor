@inherits LayoutComponentBase
@implements IDisposable
@inject ServicioDeSesion Sesion
@inject EstadoDeEncabezado Encabezado
@inject IIndicadorDeTimbres IndicadorTimbres
@inject NavigationManager Navegacion

@*
    El único MainLayout del sistema (ARQUITECTURA.md §8). Las páginas aportan solo el contenido
    del área principal: nunca su propio encabezado, su propia barra ni su propio esqueleto.
*@

<MudPopoverProvider />
@* Comportamiento uniforme de todos los diálogos: cerrar con Escape y con clic fuera del
   recuadro, sin depender de que cada llamada pase sus DialogOptions. *@
<MudDialogProvider CloseOnEscapeKey="true" BackdropClick="true" />
<MudSnackbarProvider />

<div class="cascaron">
    <header class="barra-superior">
        <button type="button" class="boton-colapso" @onclick="AlternarMenu"
                aria-expanded="@(!_menuColapsado)" aria-controls="menu-lateral"
                title="@(_menuColapsado ? "Fijar el menú abierto" : "Encoger el menú a iconos")">
            <MudIcon Icon="@Icons.Material.Filled.Menu" Size="Size.Small" />
        </button>

        <span class="barra-superior-marca">Sistema de facturación</span>

        <SelectorDeEmpresa />

        <span class="separador-flexible"></span>

        <span class="indicador-timbres cifra-tabular" title="Timbres disponibles">
            <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Size="Size.Small" />
            @(_timbresDisponibles?.ToString() ?? "—")
        </span>

        <SelectorDeTema />
        <MenuDeUsuario />
    </header>

    <div class="cuerpo @(_menuColapsado ? "menu-colapsado" : null)">
        <nav id="menu-lateral" class="menu-lateral" aria-label="Secciones del sistema">
            @* A nombre de quién se está facturando ahora mismo. El selector de empresa NO
               vive aquí —está en la barra superior y en ningún otro lugar (ARQUITECTURA.md §8)—:
               esto solo lo recuerda, que en multiempresa es la diferencia entre timbrar
               con la llantera o con la cementera sin darse cuenta. *@
            @if (EmpresaActiva is { } empresa)
            {
                <div class="menu-marca" title="@empresa.NombreFiscal">
                    <span class="menu-marca-iniciales">@Iniciales(empresa.NombreFiscal)</span>
                    <div class="menu-marca-texto">
                        <div class="menu-marca-nombre">@empresa.NombreFiscal</div>
                        <div class="menu-marca-rfc cifra-tabular">@empresa.Rfc</div>
                    </div>
                </div>
            }

            @* Se agrupa por encabezado conservando el orden declarado en MenuPrincipal: el
               grupo sin título es el trabajo diario y va primero. Un grupo cuyas entradas
               esconde el permiso no pinta su encabezado, para no dejar títulos huérfanos. *@
            <div class="menu-navegacion">
                @foreach (var grupo in MenuPrincipal.Elementos.Where(EsVisible).GroupBy(e => e.Grupo))
                {
                    @if (grupo.Key is { } titulo)
                    {
                        <h2 class="menu-grupo">@titulo</h2>
                    }

                    <ul>
                        @foreach (var elemento in grupo)
                        {
                            <li>
                                <NavLink href="@elemento.Ruta" Match="NavLinkMatch.All" title="@elemento.Etiqueta">
                                    <MudIcon Icon="@elemento.Icono" Size="Size.Small" />
                                    <span>@elemento.Etiqueta</span>
                                </NavLink>
                            </li>
                        }
                    </ul>
                }
            </div>
        </nav>

        @* El @key es la fuga de datos entre empresas resuelta: al cambiar de empresa, Blazor
           descarta el árbol completo de la página y lo reconstruye desde cero. Ninguna lista
           cargada con datos de la empresa anterior puede sobrevivir un instante de más. *@
        <main class="area-principal" @key="Sesion.Sesion?.EmpresaActivaId">
            @if (!string.IsNullOrWhiteSpace(Encabezado.Titulo))
            {
                <h1>@Encabezado.Titulo</h1>
            }
            @if (Sesion.Sesion is { Empresas.Count: 0 } && !EnAltaDeEmpresa)
            {
                @* Antes esto era un callejón sin salida: quien se registra llega aquí con cero
                   empresas y no tiene administrador a quien pedirle nada, porque el
                   administrador es él. *@
                <p>Todavía no tienes ninguna empresa emisora. Da de alta la primera para empezar a facturar.</p>

                <div class="acciones-formulario">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => Navegacion.NavigateTo("/empresa/nueva"))">
                        Dar de alta mi empresa
                    </MudButton>
                </div>
            }
            else
            {
                @Body
            }
        </main>
    </div>
</div>

@code {
    private int? _timbresDisponibles;

    /// <summary>
    /// Menú encogido a riel de iconos. El botón fija el estado; acercar el cursor al riel lo
    /// despliega mientras esté encima, y de eso se encarga el CSS.
    /// <para>
    /// Vive en memoria y vuelve a expandirse al recargar: las preferencias de este sistema
    /// viven en el perfil del servidor, no en el navegador (ver el tema), y guardarla ahí pide
    /// un campo y su migración. Se decide aparte.
    /// </para>
    /// </summary>
    private bool _menuColapsado;

    private EmpresaDisponibleDto? EmpresaActiva
        => Sesion.Sesion is { EmpresaActivaId: { } id } sesion
            ? sesion.Empresas.FirstOrDefault(e => e.Id == id)
            : null;

    private void AlternarMenu() => _menuColapsado = !_menuColapsado;

    /// <summary>
    /// La única pantalla que se puede ver sin tener ninguna empresa. Sin esta excepción el
    /// aviso de "no tienes empresa" taparía justo la página que sirve para dejar de no
    /// tenerla, y el botón no llevaría a ningún lado.
    /// </summary>
    private bool EnAltaDeEmpresa =>
        Navegacion.ToBaseRelativePath(Navegacion.Uri).TrimEnd('/')
            .StartsWith("empresa/nueva", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Hasta dos iniciales del nombre fiscal, para el cuadro de la marca. Se salta las
    /// palabras cortas —«de», «y», «la»— porque «GRUPO ALFA DE OCCIDENTE» debe dar «GA» y
    /// no «GD».
    /// </summary>
    private static string Iniciales(string nombreFiscal)
    {
        var palabras = nombreFiscal
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(p => p.Length > 2)
            .Take(2)
            .ToArray();

        return palabras.Length == 0
            ? nombreFiscal.Length > 0 ? nombreFiscal[..1].ToUpperInvariant() : "?"
            : string.Concat(palabras.Select(p => char.ToUpperInvariant(p[0])));
    }

    protected override async Task OnInitializedAsync()
    {
        Sesion.Cambio += Redibujar;
        Encabezado.Cambio += Redibujar;

        // Un usuario con varias empresas y ninguna elegida todavía no debería estar aquí:
        // /seleccionar-empresa vive fuera de este layout porque no hay nada que poner en la
        // barra superior hasta que elija. Si llegó de todos modos —un marcador viejo, por
        // ejemplo— se le manda para allá en vez de mostrar la barra a medias.
        if (Sesion.Sesion is { EmpresaActivaId: null, Empresas.Count: > 1 })
        {
            Navegacion.NavigateTo("/seleccionar-empresa");
            return;
        }

        // Sin sesión no hay token que adjuntar: pedirlo igual solo produce un 401 que
        // revienta el layout entero, no solo la tarjeta de saldo (se veía al recargar una
        // página sin [Authorize], donde este layout monta antes de que haya nadie autenticado).
        if (Sesion.HaySesion)
            _timbresDisponibles = await IndicadorTimbres.ObtenerDisponiblesAsync();
    }

    public void Dispose()
    {
        Sesion.Cambio -= Redibujar;
        Encabezado.Cambio -= Redibujar;
    }

    private bool EsVisible(ElementoDeMenu elemento)
        => elemento.Permiso is null || Sesion.TienePermiso(elemento.Permiso);

    private void Redibujar() => InvokeAsync(StateHasChanged);
}
