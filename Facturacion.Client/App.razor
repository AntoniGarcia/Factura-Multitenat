@using Facturacion.Client.Componentes.Comunes
@inject NavigationManager Navegacion

<GuardaDeVersion />

<CascadingAuthenticationState>
    <PuertaDeArranque>
        <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Paginas.NoEncontrada)">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized Context="estado">
                        @* Con sesión pero sin permiso: aviso. El panel del operador conserva su propio acceso. *@
                        @if (estado.User.Identity?.IsAuthenticated == true && !EsPanelDeOperador)
                        {
                            <AvisoSinPermiso />
                        }
                        else
                        {
                            <RedirigirAInicioSesion />
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
        </Router>
    </PuertaDeArranque>
</CascadingAuthenticationState>

@code {
    private bool EsPanelDeOperador => Navegacion.ToBaseRelativePath(Navegacion.Uri)
        .StartsWith("operador", StringComparison.OrdinalIgnoreCase);
}
