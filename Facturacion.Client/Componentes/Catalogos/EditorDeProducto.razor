@using Facturacion.Shared.Contratos
@inject ServicioDeProductos Productos
@inject ServicioDeEmpresa Empresas
@inject ServicioDeCatalogos Catalogos
@inject IBusquedaDeCatalogo Busqueda

@*
    El formulario del producto, sin marco: la página que lo contiene pone sus botones y los
    liga al formulario con IdDelFormulario, igual que EditorDeCliente.
*@

<PanelErrores Problema="_error" />

@if (_cargando)
{
    <p>Cargando…</p>
}
else
{
            <EditForm Model="this" OnValidSubmit="GuardarAsync" id="@IdDelFormulario">
                <div class="formulario-catalogo-secciones">
                <section class="formulario-catalogo-seccion formulario-catalogo-seccion-principal">
                <h2 class="seccion-titulo">Identificación</h2>

                <div class="catalogo-rejilla">
                    <div class="catalogo-campo-amplio">
                    <MudTextField @bind-Value="_descripcion" Label="Nombre del producto" MaxLength="1000"
                                  HelperText="Así aparece en la factura." />
                    </div>
                    <div class="catalogo-campo-corto">
                    <MudTextField @bind-Value="_idInterno" Label="ID interno de la empresa" MaxLength="100"
                                  HelperText="Tu código o SKU. Opcional." />
                    </div>
                    <div class="catalogo-campo-amplio">
                    <MudTextField @bind-Value="_detalle" Label="Descripción" MaxLength="1000" Lines="2"
                                  HelperText="Opcional. Se agrega al concepto al facturar." />
                    </div>
                    <div class="catalogo-campo-corto">
                    <MudTextField @bind-Value="_unidadTexto" Label="Unidad de medida" MaxLength="@UnidadDeConcepto.LongitudMaxima"
                                  HelperText="Texto para el PDF, por ejemplo: Litro." />
                    </div>
                </div>
                </section>

                <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha">
                <h2 class="seccion-titulo">Claves del SAT</h2>
                <p class="seccion-ayuda">
                    Busca por clave o descripción y selecciona una opción del catálogo.
                </p>

                <div class="catalogo-rejilla catalogo-rejilla-dos">
                    <div>
                        <BuscadorCatalogo Catalogo="c_ClaveProdServ"
                                          Label="Clave de producto o servicio"
                                          Valor="@_claveProdServSel"
                                          ValorCambiado="AlElegirClaveProdServ"
                                          Requerido="true" />
                        @if (_claveProdServSel is not null)
                        {
                            <p class="clave-resuelta">
                                <span class="cifra-tabular">@_claveProdServSel.Clave</span> — @_claveProdServSel.Descripcion
                            </p>
                        }
                    </div>

                    <div>
                        <BuscadorCatalogo Catalogo="c_ClaveUnidad"
                                          Label="Clave de unidad"
                                          Valor="@_claveUnidadSel"
                                          ValorCambiado="AlElegirClaveUnidad"
                                          Requerido="true" />
                        @if (_claveUnidadSel is not null)
                        {
                            <p class="clave-resuelta">
                                <span class="cifra-tabular">@_claveUnidadSel.Clave</span> — @_claveUnidadSel.Descripcion
                            </p>
                        }
                    </div>
                </div>
                </section>

                <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha">
                <h2 class="seccion-titulo">Precio y peso</h2>

                <div class="catalogo-rejilla catalogo-rejilla-dos">
                    <MudNumericField @bind-Value="_valorUnitario" Label="Precio de venta" Min="0M" Format="N2"
                                     Class="cifra-tabular" />
                    <MudNumericField @bind-Value="_pesoKg" Label="Peso en kilogramos" Min="0M" Format="N3"
                                     Class="cifra-tabular" HelperText="Opcional." />
                </div>
                </section>

                <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha">
                <h2 class="seccion-titulo">Impuestos</h2>

                <div class="rejilla-campos">
<BuscadorCatalogo Catalogo="c_ObjetoImp" Opciones="@Catalogos.Obtener("c_ObjetoImp")" @bind-Clave="_objetoImp" @bind-Clave:after="AlCambiarObjeto" Label="Objeto de impuesto" PuedeLimpiar="false" />
                </div>

                @if (!LlevaDesglose)
                {
                    <div class="aviso-reservado" role="note">
                        <p>Este objeto de impuesto no lleva desglose.</p>
                    </div>
                }
                else
                {
                    <p class="seccion-ayuda">
                        Usa un atajo y revisa el desglose fiscal.
                    </p>

                    <div class="atajos-iva">
                        @foreach (var atajo in Atajos.Where(_ => ReglasDeObjetoImpuesto.PermiteImpuesto(_objetoImp, "002", false)))
                        {
                            <MudButton Variant="@(EsAtajoActivo(atajo) ? Variant.Filled : Variant.Outlined)"
                                       Size="Size.Small"
                                       OnClick="@(() => AplicarAtajo(atajo))">
                                @atajo.Etiqueta
                            </MudButton>
                        }
                        @if (_impuestos.Count == 0 && HayTasasPredeterminadas)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       OnClick="AplicarTasasDeLaEmpresa">
                                Usar tasas de la empresa
                            </MudButton>
                        }
                    </div>

                    @if (_impuestos.Count == 0 && HayTasasPredeterminadas)
                    {
                        <p class="seccion-ayuda">
                            Se agregarán las tasas mayores que cero. Para IVA 0 % o exento, usa su atajo.
                        </p>
                    }

                    <MudSimpleTable Dense="true" Class="tabla-impuestos">
                        <thead>
                            <tr>
                                <th>Impuesto</th>
                                <th>Tipo de factor</th>
                                <th class="cifra-tabular">Tasa o cuota</th>
                                <th>Sentido</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var impuesto in _impuestos)
                            {
                                <tr>
                                    <td class="cifra-tabular">@impuesto.Impuesto — @NombreImpuesto(impuesto.Impuesto)</td>
                                    <td>@impuesto.TipoFactor</td>
                                    <td class="cifra-tabular">
                                        @(impuesto.TasaOCuota is { } t ? t.ToString("0.######") : "—")
                                    </td>
                                    <td>@(impuesto.EsRetencion ? "Retención" : "Traslado")</td>
                                    <td>
                                        <MudButton Size="Size.Small" OnClick="@(() => _impuestos.Remove(impuesto))">Quitar</MudButton>
                                    </td>
                                </tr>
                            }
                            @if (_impuestos.Count == 0)
                            {
                                <tr><td colspan="5" class="tabla-datos-estado">Sin impuestos configurados.</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    <h3 class="seccion-subtitulo">Agregar otro impuesto</h3>
                    <div class="rejilla-campos">
<BuscadorCatalogo Catalogo="c_Impuesto" Opciones="@(Catalogos.Obtener("c_Impuesto").Where(i => ReglasDeObjetoImpuesto.PermiteImpuesto(_objetoImp, i.Clave, _nuevoEsRetencion)).ToArray())" @bind-Clave="_nuevoImpuesto" Label="Impuesto" PuedeLimpiar="false" />

<BuscadorCatalogo Catalogo="c_TipoFactor" Opciones="@Catalogos.Obtener("c_TipoFactor")" @bind-Clave="_nuevoFactor" Label="Tipo de factor" PuedeLimpiar="false" />

                        <MudNumericField @bind-Value="_nuevaTasa" Label="Tasa o cuota" Format="0.######"
                                         Class="cifra-tabular" HelperText="0.16 es 16 %. Vacío si es exento." />

                        <MudSelect T="bool" @bind-Value="_nuevoEsRetencion" Label="Sentido">
                            @if (_objetoImp is not ("06" or "08"))
                            {
                                <MudSelectItem T="bool" Value="false">Traslado</MudSelectItem>
                            }
                            <MudSelectItem T="bool" Value="true">Retención</MudSelectItem>
                        </MudSelect>

                        <MudButton Variant="Variant.Outlined" OnClick="AgregarImpuesto"
                                   Disabled="@(!ReglasDeObjetoImpuesto.PermiteImpuesto(_objetoImp, _nuevoImpuesto, _nuevoEsRetencion))">Agregar</MudButton>
                    </div>
                }
                </section>
                </div>
            </EditForm>
}

<ActualizadorDeCatalogos AlCambiar="@(() => { })" />

@code {
    /// <summary>Null para crear; con valor, precarga ese producto para editarlo.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>Identificador del formulario, para que los botones del contenedor lo envíen.</summary>
    [Parameter, EditorRequired]
    public string IdDelFormulario { get; set; } = string.Empty;

    [Parameter]
    public EventCallback AlGuardar { get; set; }

    /// <summary>Mientras carga o guarda: el contenedor deshabilita su botón de guardar.</summary>
    [Parameter]
    public EventCallback<bool> OcupadoCambiado { get; set; }

    /// <summary>El código interno del producto que se edita, para el título del contenedor.</summary>
    [Parameter]
    public EventCallback<int> CodigoCargado { get; set; }

    private bool EsNuevo => Id is null;

    private bool LlevaDesglose => ReglasDeObjetoImpuesto.PermiteDesglose(_objetoImp);

    private DetalleProblema? _error;
    private bool _cargando = true;
    private ConfiguracionEmpresaDto? _configuracionEmpresa;

    private string _descripcion = string.Empty;
    private string? _idInterno;
    private string? _detalle;
    private string _unidadTexto = string.Empty;
    private decimal _valorUnitario;
    private decimal? _pesoKg;
    private string _objetoImp = "02";
    private bool _activo = true;

    private ClaveSatDto? _claveProdServSel;
    private ClaveSatDto? _claveUnidadSel;

    private readonly List<ImpuestoDeProductoDto> _impuestos = [];

    private bool HayTasasPredeterminadas => _configuracionEmpresa is { } configuracion
        && (configuracion.TasaIvaPorDefecto > 0
            || configuracion.TasaIepsPorDefecto > 0
            || configuracion.TasaRetencionIvaPorDefecto > 0
            || configuracion.TasaRetencionIsrPorDefecto > 0
            || configuracion.TasaRetencionIepsPorDefecto > 0);

    private string _nuevoImpuesto = "002";
    private string _nuevoFactor = "Tasa";
    private decimal? _nuevaTasa;
    private bool _nuevoEsRetencion;

    /// <summary>Atajos de IVA que completan impuesto, factor y tasa sin sustituir la configuración detallada.</summary>
    private static readonly (string Etiqueta, string Factor, decimal? Tasa)[] Atajos =
    [
        ("IVA 16 %", "Tasa", 0.16m),
        ("IVA 8 % frontera", "Tasa", 0.08m),
        ("IVA 0 %", "Tasa", 0m),
        ("Exento de IVA", "Exento", null)
    ];

    // Se carga una sola vez: avisar al contenedor lo vuelve a dibujar (ver EditorDeCliente).
    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        await OcupadoCambiado.InvokeAsync(true);
        _configuracionEmpresa = await Empresas.ObtenerConfiguracionAsync();

        if (Id is { } id)
        {
            var producto = await Productos.ObtenerAsync(id);

            if (producto is not null)
            {
                _descripcion = producto.Descripcion;
                _idInterno = producto.IdInterno;
                _detalle = producto.Detalle;
                _unidadTexto = producto.UnidadTexto;
                _valorUnitario = producto.ValorUnitario;
                _pesoKg = producto.PesoKg;
                _objetoImp = producto.ObjetoImp;
                _activo = producto.Activo;

                _impuestos.Clear();
                _impuestos.AddRange(producto.Impuestos);
                PrepararNuevoImpuesto();

                // Se resuelven contra el catálogo para poder mostrar la descripción, que es
                // lo que le dice al capturista si eligió la clave correcta.
                _claveProdServSel = await ResolverAsync("c_ClaveProdServ", producto.ClaveProdServ);
                _claveUnidadSel = await ResolverAsync("c_ClaveUnidad", producto.ClaveUnidad);

                await CodigoCargado.InvokeAsync(producto.CodigoInterno);
            }
        }

        _cargando = false;
        await OcupadoCambiado.InvokeAsync(false);
    }

    private async Task<ClaveSatDto?> ResolverAsync(string catalogo, string clave)
    {
        var encontrados = await Busqueda.BuscarAsync(catalogo, clave, CancellationToken.None);
        return encontrados.FirstOrDefault(c => c.Clave == clave);
    }

    private void AlElegirClaveProdServ(ClaveSatDto? clave) => _claveProdServSel = clave;

    private void AlElegirClaveUnidad(ClaveSatDto? clave)
    {
        _claveUnidadSel = clave;

        // La unidad en texto se precarga con la del catálogo, pero se puede cambiar: es lo
        // que ve el cliente y a veces conviene que diga «Caja con 12» y no «Pieza». Un nombre
        // del catálogo que no cabe en los 20 caracteres del SAT no se precarga ni se recorta:
        // «Gramo por centímetro» ya significa otra cosa.
        if (clave is not null && string.IsNullOrWhiteSpace(_unidadTexto) &&
            UnidadDeConcepto.EsValida(clave.Descripcion))
            _unidadTexto = clave.Descripcion;
    }

    private void AlCambiarObjeto()
    {
        _impuestos.RemoveAll(i => !ReglasDeObjetoImpuesto.PermiteImpuesto(_objetoImp, i.Impuesto, i.EsRetencion));
        PrepararNuevoImpuesto();
    }

    private void PrepararNuevoImpuesto()
    {
        if (_objetoImp is "06" or "08")
        {
            _nuevoImpuesto = "001";
            _nuevoEsRetencion = true;
        }
        else if (_objetoImp == "07")
        {
            _nuevoImpuesto = "003";
            _nuevoEsRetencion = false;
        }
    }

    private string NombreImpuesto(string clave)
        => Catalogos.Obtener("c_Impuesto").FirstOrDefault(i => i.Clave == clave)?.Descripcion ?? clave;

    private bool EsAtajoActivo((string Etiqueta, string Factor, decimal? Tasa) atajo)
        => _impuestos.Count == 1
           && _impuestos[0] is { Impuesto: "002", EsRetencion: false } unico
           && unico.TipoFactor == atajo.Factor
           && unico.TasaOCuota == atajo.Tasa;

    private void AplicarAtajo((string Etiqueta, string Factor, decimal? Tasa) atajo)
    {
        if (!ReglasDeObjetoImpuesto.PermiteImpuesto(_objetoImp, "002", false)) return;
        // Solo reemplaza el traslado de IVA; si el producto tiene retenciones o IEPS
        // configurados a mano, se respetan.
        _impuestos.RemoveAll(i => i is { Impuesto: "002", EsRetencion: false });
        _impuestos.Insert(0, new ImpuestoDeProductoDto("002", atajo.Factor, atajo.Tasa, EsRetencion: false));
    }

    private void AplicarTasasDeLaEmpresa()
    {
        if (!LlevaDesglose || _impuestos.Count > 0 || _configuracionEmpresa is not { } configuracion)
            return;

        if (configuracion.TasaIvaPorDefecto > 0)
            _impuestos.Add(new ImpuestoDeProductoDto(
                "002", "Tasa", configuracion.TasaIvaPorDefecto, EsRetencion: false));

        if (configuracion.TasaIepsPorDefecto > 0)
            _impuestos.Add(new ImpuestoDeProductoDto(
                "003", "Tasa", configuracion.TasaIepsPorDefecto, EsRetencion: false));

        if (configuracion.TasaRetencionIvaPorDefecto > 0)
            _impuestos.Add(new ImpuestoDeProductoDto(
                "002", "Tasa", configuracion.TasaRetencionIvaPorDefecto, EsRetencion: true));

        if (configuracion.TasaRetencionIsrPorDefecto > 0)
            _impuestos.Add(new ImpuestoDeProductoDto(
                "001", "Tasa", configuracion.TasaRetencionIsrPorDefecto, EsRetencion: true));

        if (configuracion.TasaRetencionIepsPorDefecto > 0)
            _impuestos.Add(new ImpuestoDeProductoDto(
                "003", "Tasa", configuracion.TasaRetencionIepsPorDefecto, EsRetencion: true));

        _impuestos.RemoveAll(i => !ReglasDeObjetoImpuesto.PermiteImpuesto(_objetoImp, i.Impuesto, i.EsRetencion));
    }

    private void AgregarImpuesto()
    {
        if (!ReglasDeObjetoImpuesto.PermiteImpuesto(_objetoImp, _nuevoImpuesto, _nuevoEsRetencion)) return;
        _impuestos.RemoveAll(i => i.Impuesto == _nuevoImpuesto && i.EsRetencion == _nuevoEsRetencion);

        _impuestos.Add(new ImpuestoDeProductoDto(
            _nuevoImpuesto, _nuevoFactor,
            _nuevoFactor == "Exento" ? null : _nuevaTasa,
            _nuevoEsRetencion));
    }

    private async Task GuardarAsync()
    {
        await OcupadoCambiado.InvokeAsync(true);
        _error = null;

        var peticion = new PeticionGuardarProducto(
            _claveProdServSel?.Clave ?? string.Empty,
            _claveUnidadSel?.Clave ?? string.Empty,
            _unidadTexto, _descripcion, _valorUnitario, _pesoKg, _objetoImp,
            _impuestos, _activo, _idInterno, _detalle);

        var (exito, error) = EsNuevo
            ? await Productos.CrearAsync(peticion)
            : await Productos.ActualizarAsync(Id!.Value, peticion);

        await OcupadoCambiado.InvokeAsync(false);
        _error = error;

        if (error is null && exito is not null) await AlGuardar.InvokeAsync();
    }
}
