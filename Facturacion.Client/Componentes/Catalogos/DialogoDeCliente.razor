@*
    El editor de cliente como MudDialog: Catalogos.razor lo abre con IDialogService y le pasa
    Id solo para editar. El formulario es EditorDeCliente, el mismo de /clientes/nuevo.
*@

<MudDialog>
    <TitleContent>
        @(Id is null ? "Nuevo cliente" : $"Cliente {_claveInterna}")
    </TitleContent>
    <DialogContent>
        <div class="dialogo-formulario-scroll">
            <EditorDeCliente Id="Id"
                             IdDelFormulario="formulario-dialogo-cliente"
                             AlGuardar="@(() => MudDialog.Close(DialogResult.Ok(true)))"
                             OcupadoCambiado="o => _ocupado = o"
                             ClaveCargada="c => _claveInterna = c" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="formulario-dialogo-cliente"
                   Variant="Variant.Filled" Color="Color.Primary" Disabled="@_ocupado">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Null para crear; con valor, precarga ese cliente para editarlo.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    private bool _ocupado = true;
    private int _claveInterna;
}
