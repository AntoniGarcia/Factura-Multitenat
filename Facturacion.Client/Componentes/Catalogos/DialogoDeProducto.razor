@*
    El editor de producto como MudDialog: Catalogos.razor lo abre con IDialogService y le pasa
    Id solo para editar. El formulario es EditorDeProducto, el mismo de /productos/nuevo.
*@

<MudDialog>
    <TitleContent>
        @(Id is null ? "Nuevo producto" : $"Producto {_codigoInterno}")
    </TitleContent>
    <DialogContent>
        <div class="dialogo-formulario-scroll">
            <EditorDeProducto Id="Id"
                              IdDelFormulario="formulario-dialogo-producto"
                              AlGuardar="@(() => MudDialog.Close(DialogResult.Ok(true)))"
                              OcupadoCambiado="o => _ocupado = o"
                              CodigoCargado="c => _codigoInterno = c" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="formulario-dialogo-producto"
                   Variant="Variant.Filled" Color="Color.Primary" Disabled="@_ocupado">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Null para crear; con valor, precarga ese producto para editarlo.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    private bool _ocupado = true;
    private int _codigoInterno;
}
