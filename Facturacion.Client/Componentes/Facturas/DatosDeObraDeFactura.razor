@using Facturacion.Client.Servicios.Documentos
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Obras
@inject ServicioDeObras Obras

<PanelErrores Problema="_error" />

<div class="obra-formulario">
<section class="emision-seccion">
    <h2 class="seccion-titulo">Estimación de obra</h2>
    @if (_conciliacion is { } conciliacion)
    {
        <div class="aviso-documentos" role="status">
            <strong>Conciliación del cálculo guardado:</strong> @conciliacion.Mensaje
        </div>
    }

    <div class="obra-rejilla">
        <MudTextField T="string" Value="@(ImporteTrabajos > 0 ? ImporteTrabajos.ToString("#,##0.00####") : "Guarda los conceptos")"
                      Label="Importe de los trabajos" ReadOnly="true" Class="cifra-tabular" />
        <MudTextField T="string" Value="@(ImporteTrabajos > 0 ? IvaConceptos.ToString("#,##0.00####") : "Guarda los conceptos")"
                      Label="IVA de los conceptos" ReadOnly="true" Class="cifra-tabular"
                      HelperText="Suma del IVA de cada concepto, como sale en el CFDI." />
    </div>
</section>

<section class="emision-seccion">
    <h2 class="seccion-titulo">Amortización del anticipo, retenciones y devoluciones</h2>
    <div class="obra-rejilla">
        <MudNumericField T="decimal" @bind-Value="_porcentajeAmortizacion" Immediate="true" Label="Amortización del anticipo (%)"
                         Min="0" Max="100" Format="0.00##" Class="cifra-tabular" />
        <MudNumericField T="decimal" @bind-Value="_porcentajeRetenciones" Immediate="true" Label="Retenciones (%)"
                         Min="0" Max="100" Format="0.00##" Class="cifra-tabular" />
        <MudNumericField T="decimal" @bind-Value="_porcentajeDevoluciones" Immediate="true" Label="Devoluciones (%)"
                         Min="0" Max="100" Format="0.00##" Class="cifra-tabular" />
    </div>
    <p class="seccion-ayuda">
        Subtotal = trabajos − amortización − retenciones + devoluciones.
        @(AnticipoRelacionado ? "Con anticipo 07 relacionado se valida su saldo." : "Anticipo tipo 07 opcional en CFDI relacionados.")
    </p>
</section>

@if (_datosAnterioresSinTasa)
{
    <div class="aviso-documentos" role="status">
        Este borrador tiene retenciones o devoluciones capturadas como importes.
        Al volver a guardarlo, se recalcularán con los porcentajes que indiques aquí.
    </div>
    <MudCheckBox T="bool" @bind-Value="_aceptaRecalculo" Label="Acepto recalcular los importes anteriores" />
}

<section class="emision-seccion">
    <h2 class="seccion-titulo">Deducciones del pago</h2>
    <p class="seccion-ayuda">Se calculan sobre el importe de los trabajos y se restan del total.</p>
    @foreach (var deduccion in _deducciones)
    {
        <div class="obra-deduccion-bloque">
            <MudCheckBox T="bool" Value="deduccion.Aplica" ValueChanged="@(aplica => Marcar(deduccion, aplica))"
                         Label="@deduccion.Etiqueta" />
            @if (deduccion.Aplica)
            {
                <div class="obra-deduccion">
                    <MudTextField @bind-Value="deduccion.Nombre" Label="Concepto" MaxLength="60" Required="true" />
                    <MudNumericField T="decimal" @bind-Value="deduccion.Porcentaje" Immediate="true" Label="Porcentaje (%)"
                                     Min="0" Max="100" Step="0.1m" Format="0.00##" Class="cifra-tabular" />
                </div>
            }
        </div>
    }
</section>

@if (VistaActual is { } vista)
{
    <section class="obra-resultado" aria-label="Resultado de la estimación">
        <h2 class="seccion-titulo">Cálculo preliminar</h2>
        <p class="seccion-ayuda">Estimación sobre conceptos guardados; no sustituye el total fiscal del CFDI.</p>
        <dl class="obra-desglose">
            <div><dt>Importe de los trabajos</dt><dd class="cifra-tabular">@vista.ImporteTrabajos.ToString("#,##0.00####")</dd></div>
            <div><dt>Amortización del anticipo</dt><dd class="cifra-tabular">@(vista.Amortizacion != 0 ? "−" : "")@vista.Amortizacion.ToString("#,##0.00####")</dd></div>
            <div><dt>Retenciones</dt><dd class="cifra-tabular">@(vista.Retenciones != 0 ? "−" : "")@vista.Retenciones.ToString("#,##0.00####")</dd></div>
            <div><dt>Devoluciones</dt><dd class="cifra-tabular">@(vista.Devoluciones != 0 ? "+" : "")@vista.Devoluciones.ToString("#,##0.00####")</dd></div>
            <div><dt>Subtotal</dt><dd class="cifra-tabular">@vista.SubtotalEstimacion.ToString("#,##0.00####")</dd></div>
            <div><dt>IVA</dt><dd class="cifra-tabular">@vista.IvaEstimado.ToString("#,##0.00####")</dd></div>
            <div><dt>Total</dt><dd class="cifra-tabular">@vista.TotalEstimacion.ToString("#,##0.00####")</dd></div>
            @foreach (var deduccion in vista.Deducciones.Where(x => x.Porcentaje != 0))
            {
                <div><dt>@deduccion.Nombre</dt><dd class="cifra-tabular">−@deduccion.Importe.ToString("#,##0.00####")</dd></div>
            }
            @if (vista.Deducciones.Any(x => x.Porcentaje != 0))
            {
                <div><dt>Total deducciones</dt><dd class="cifra-tabular">−@vista.Deducciones.Sum(x => x.Importe).ToString("#,##0.00####")</dd></div>
            }
            <div class="obra-liquido"><dt>Importe líquido</dt><dd class="cifra-tabular">@vista.ImporteLiquido.ToString("#,##0.00####")</dd></div>
        </dl>
    </section>
}

<div class="tarjeta-formulario-acciones">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync" Disabled="@(_guardando || (_datosAnterioresSinTasa && !_aceptaRecalculo))">
        @(_guardando ? "Guardando…" : "Guardar cálculo de obra")
    </MudButton>
</div>
</div>

@code {
    [Parameter, EditorRequired] public Guid ComprobanteId { get; set; }
    [Parameter] public decimal ImporteTrabajos { get; set; }
    // El servidor lo vuelve a sumar al guardar.
    [Parameter] public decimal IvaConceptos { get; set; }
    // Solo se amortiza si la factura relaciona exactamente un CFDI con tipo 07.
    [Parameter] public bool AnticipoRelacionado { get; set; }
    [Parameter, EditorRequired] public Func<Task<bool>> GuardarFactura { get; set; } = null!;
    [Parameter] public EventCallback AlGuardar { get; set; }

    private decimal _porcentajeAmortizacion;
    private decimal AmortizacionAEnviar => _porcentajeAmortizacion;
    private ServicioParcialConstruccionDto? _servicioParcial;
    private decimal _porcentajeRetenciones;
    private decimal _porcentajeDevoluciones;
    // La tasa que se precarga al marcar cada deducción: 2 al millar de la CMIC en ICIC.
    private readonly List<DeduccionCaptura> _deducciones =
    [
        new("5 al millar", 0.5m),
        new("1% OBS", 1m),
        new("ICIC", 0.2m),
        new("ÚNETE", 0.5m)
    ];
    private DatosObraDto? _resultado;
    private ConciliacionFiscalObraDto? _conciliacion;
    private DetalleProblema? _error;
    private bool _guardando;
    private Guid? _idCargado;
    private bool _datosAnterioresSinTasa;
    private bool _aceptaRecalculo;

    private DatosObraDto? VistaActual
    {
        get
        {
            var importe = ImporteTrabajos > 0 ? ImporteTrabajos : _resultado?.ImporteTrabajos ?? 0;
            if (importe <= 0) return null;
            if (_datosAnterioresSinTasa && !_aceptaRecalculo && _resultado is not null) return _resultado;
            if (CoincideConGuardado(importe)) return _resultado;
            var porcentaje = AmortizacionAEnviar;
            var amortizacion = Porcentaje(importe, porcentaje);
            var retenciones = Porcentaje(importe, _porcentajeRetenciones);
            var devoluciones = Porcentaje(importe, _porcentajeDevoluciones);
            var subtotal = importe - amortizacion - retenciones + devoluciones;
            // Tasa efectiva de IVA deducida de los conceptos guardados, aplicada sobre el subtotal a 6 decimales.
            var aplicada = _resultado?.PorcentajeAmortizacion ?? 0;
            var baseActualIva = importe * (1m - aplicada / 100m);
            var tasaIva = baseActualIva > 0 ? IvaConceptos / baseActualIva : 0m;
            var iva = subtotal > 0 ? Math.Round(subtotal * tasaIva, 6, MidpointRounding.ToEven) : 0m;
            var total = subtotal + iva;
            var deducciones = _deducciones.Select(x => new DeduccionDeObraDto(
                x.NombreAEnviar, x.PorcentajeAEnviar, Porcentaje(importe, x.PorcentajeAEnviar))).ToArray();
            return new DatosObraDto(importe, porcentaje, amortizacion,
                _porcentajeRetenciones, retenciones, _porcentajeDevoluciones, devoluciones,
                subtotal, iva, total, deducciones,
                total - deducciones.Sum(x => x.Importe), null);
        }
    }

    private static decimal Porcentaje(decimal importe, decimal tasa)
        => Math.Round(importe * tasa / 100m, 6, MidpointRounding.ToEven);

    private bool CoincideConGuardado(decimal importe)
        => _resultado is { } datos && datos.ImporteTrabajos == importe &&
           datos.ServicioParcial == _servicioParcial &&
           datos.PorcentajeAmortizacion == AmortizacionAEnviar &&
           datos.PorcentajeRetenciones == _porcentajeRetenciones &&
           datos.PorcentajeDevoluciones == _porcentajeDevoluciones &&
           datos.IvaEstimado == IvaConceptos &&
           datos.Deducciones.Count == _deducciones.Count &&
           datos.Deducciones.Select((deduccion, indice) =>
               deduccion.Nombre == _deducciones[indice].NombreAEnviar &&
               deduccion.Porcentaje == _deducciones[indice].PorcentajeAEnviar).All(x => x);

    protected override async Task OnParametersSetAsync()
    {
        if (_idCargado == ComprobanteId) return;
        _idCargado = ComprobanteId;
        _resultado = null;
        _conciliacion = null;
        _servicioParcial = null;
        _porcentajeAmortizacion = 0;
        _porcentajeRetenciones = 0;
        _porcentajeDevoluciones = 0;
        foreach (var deduccion in _deducciones) deduccion.Restablecer();
        _datosAnterioresSinTasa = false;
        _aceptaRecalculo = false;
        var (datos, error) = await Obras.ObtenerAsync(ComprobanteId);
        _error = error;
        if (datos is null) return;
        _resultado = datos;
        _servicioParcial = datos.ServicioParcial;
        _porcentajeAmortizacion = datos.PorcentajeAmortizacion;
        _porcentajeRetenciones = datos.PorcentajeRetenciones ?? 0;
        _porcentajeDevoluciones = datos.PorcentajeDevoluciones ?? 0;
        _datosAnterioresSinTasa =
            (datos.PorcentajeRetenciones is null && datos.Retenciones != 0) ||
            (datos.PorcentajeDevoluciones is null && datos.Devoluciones != 0);
        for (var i = 0; i < _deducciones.Count; i++)
        {
            _deducciones[i].Nombre = datos.Deducciones[i].Nombre;
            _deducciones[i].Porcentaje = datos.Deducciones[i].Porcentaje;
            _deducciones[i].Aplica = datos.Deducciones[i].Porcentaje != 0;
        }
        await CargarConciliacionAsync();
    }

    private static void Marcar(DeduccionCaptura deduccion, bool aplica)
    {
        deduccion.Aplica = aplica;
        if (aplica && deduccion.Porcentaje == 0) deduccion.Porcentaje = deduccion.Sugerido;
    }

    private async Task GuardarAsync()
        => await GuardarDatosAsync();

    private async Task<bool> GuardarDatosAsync()
    {
        if (_guardando) return false;
        if (_deducciones.FirstOrDefault(x => x.Aplica && x.Porcentaje == 0) is { } sinPorcentaje)
        {
            _error = new DetalleProblema("urn:facturacion:error:obra-deduccion-sin-porcentaje",
                "Falta el porcentaje de una deducción", 400,
                $"Indica el porcentaje de {sinPorcentaje.Etiqueta} o desmárcala si el contrato no la aplica.",
                null, string.Empty, null);
            return false;
        }
        _guardando = true;
        _error = null;
        _conciliacion = null;
        try
        {
            if (!await GuardarFactura()) return false;
            var peticion = new PeticionGuardarDatosObra(AmortizacionAEnviar, _porcentajeRetenciones,
                _porcentajeDevoluciones,
                [.. _deducciones.Select(x => new PeticionDeduccionDeObra(x.NombreAEnviar, x.PorcentajeAEnviar))], null) { ServicioParcial = _servicioParcial };
            var (datos, error) = await Obras.GuardarAsync(ComprobanteId, peticion);
            _resultado = datos;
            if (datos is not null) _datosAnterioresSinTasa = false;
            _error = error;
            if (datos is not null)
            {
                await CargarConciliacionAsync();
                await AlGuardar.InvokeAsync();
            }
            return datos is not null;
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task CargarConciliacionAsync()
    {
        var (conciliacion, error) = await Obras.ObtenerConciliacionFiscalAsync(ComprobanteId);
        _conciliacion = conciliacion;
        if (error is not null) _error = error;
    }

    /// Siempre hay cuatro deducciones; una sin usar se guarda con 0 %, que la deja fuera del cálculo
    /// y del PDF. Desmarcar no borra lo capturado, para recuperarlo al volver a marcar mientras no
    /// se guarde.
    private sealed class DeduccionCaptura(string predeterminado, decimal sugerido)
    {
        public string Nombre { get; set; } = string.Empty;
        public decimal Porcentaje { get; set; }
        public bool Aplica { get; set; }
        public decimal Sugerido => sugerido;

        public string Etiqueta => string.IsNullOrWhiteSpace(Nombre) ? predeterminado : Nombre.Trim();
        public string NombreAEnviar => Aplica ? Nombre : Etiqueta;
        public decimal PorcentajeAEnviar => Aplica ? Porcentaje : 0m;

        public void Restablecer()
        {
            Nombre = predeterminado;
            Porcentaje = 0;
            Aplica = false;
        }
    }
}
