@using Facturacion.Shared.Documentos
@inject NavigationManager Navegacion
@inject ServicioDeEmpresa Empresa
@inject ServicioDeSesion Sesion

@*
    Primer paso de «Nuevo comprobante»: elegir qué se va a capturar antes de abrir el formulario.
    Cada tipo aparece solo si el usuario tiene su permiso de Emitir, y las facturas con
    complemento además solo si la empresa tiene contratado el módulo; el servidor revisa las dos
    cosas otra vez al crear el borrador. E (egreso) y N (nómina) no aparecen
    porque no existen en el sistema.

    La variante elegida viaja en la URL solo hasta crear el borrador; desde ahí queda guardada en
    el comprobante y es la que decide las pestañas del formulario.

    Navega por su cuenta en vez de devolver la ruta: quien lo abra no tiene que repetir el
    cierre y la navegación.
*@

<MudDialog>
    <DialogContent>
        @if (_opciones is null)
        {
            <p role="status">Cargando…</p>
        }
        else
        {
            <nav class="tablero-accesos selector-de-comprobante" aria-label="Tipo de comprobante">
                @foreach (var opcion in _opciones)
                {
                    <a class="tablero-acceso" href="@opcion.Ruta"
                       @onclick="() => Ir(opcion.Ruta)" @onclick:preventDefault="true">
                        <MudIcon Icon="@opcion.Icono" Size="Size.Small" />
                        <span><strong>@opcion.Titulo</strong><small>@opcion.Descripcion</small></span>
                    </a>
                }
            </nav>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => Dialogo.Cancel())">Cancelar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = default!;

    private sealed record Opcion(string Ruta, string Icono, string Titulo, string Descripcion);

    private IReadOnlyList<Opcion>? _opciones;

    protected override async Task OnInitializedAsync()
    {
        var licencias = (await Empresa.ObtenerAsync())?.Licencias;

        List<Opcion> opciones = [];

        if (Sesion.TienePermiso(Permisos.EmitirFactura))
            opciones.Add(new(RutaDeFactura(VariantesDeFactura.Basica), Icons.Material.Filled.ReceiptLong,
                "Factura básica", "Ingreso por venta de productos o servicios estándar"));

        if (licencias?.Notarios == true && Sesion.TienePermiso(Permisos.EmitirNotaria))
            opciones.Add(new(RutaDeFactura(VariantesDeFactura.Notaria), Icons.Material.Filled.Gavel,
                "Factura con complemento Notaría", "Ingreso por operaciones de fe pública e inmuebles"));

        if (licencias?.Comercio == true && Sesion.TienePermiso(Permisos.EmitirComercioExterior))
            opciones.Add(new(RutaDeFactura(VariantesDeFactura.ComercioExterior), Icons.Material.Filled.Public,
                "Factura con complemento Comercio Exterior", "Ingreso de exportación con datos aduanales"));

        if (licencias?.Obras == true && Sesion.TienePermiso(Permisos.EmitirObra))
            opciones.Add(new(RutaDeFactura(VariantesDeFactura.Obra), Icons.Material.Filled.Construction,
                "Factura de obra", "Ingreso con amortización, retenciones e impuestos locales de obra"));

        if (Sesion.TienePermiso(Permisos.EmitirPago))
            opciones.Add(new("/pagos/nuevo", Icons.Material.Filled.Payments,
                "Complemento de pago", "Cobro de facturas en parcialidades o diferidas"));

        if (Sesion.TienePermiso(Permisos.EmitirCartaPorte))
            opciones.Add(new("/traslados-carta-porte/nuevo", Icons.Material.Filled.LocalShipping,
                "Carta Porte", "Movimiento de mercancía propia, sin importe"));

        _opciones = opciones;
    }

    private static string RutaDeFactura(string variante) => $"/facturas/nueva?variante={variante}";

    private void Ir(string ruta)
    {
        // El proveedor de diálogos vive en MainLayout y sobrevive a la navegación: sin cerrar
        // antes, el diálogo quedaría abierto encima del formulario.
        Dialogo.Close();
        Navegacion.NavigateTo(ruta);
    }
}
