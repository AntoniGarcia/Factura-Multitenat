@inject IServicioDeConfirmacion Confirmacion

<NavigationLock ConfirmExternalNavigation="@HayCambios()" OnBeforeInternalNavigation="RevisarSalidaAsync" />

@code {
    [Parameter, EditorRequired]
    public Func<bool> HayCambios { get; set; } = default!;

    private async Task RevisarSalidaAsync(LocationChangingContext contexto)
    {
        // Se consulta al salir: el guardado puede terminar y navegar antes de que
        // Blazor vuelva a renderizar el formulario y sus parámetros.
        if (!HayCambios()) return;

        var salir = await Confirmacion.ConfirmarAsync("Cambios sin guardar",
            "Los cambios no se han guardado. ¿Quieres salir y descartarlos?", "Salir sin guardar");

        if (!salir) contexto.PreventNavigation();
    }
}
