@using Facturacion.Client.Servicios.Plataforma
@inject EstadoDeEncabezado Estado
@implements IDisposable

@*
    No pinta nada. Una página lo declara al principio de su marcado —<TituloDePagina
    Texto="Clientes" />— y es MainLayout quien de verdad dibuja el <h1>, en el mismo lugar
    para todas las páginas (ARQUITECTURA.md §8: "las páginas NO aportan encabezado propio").
*@

@code {
    [Parameter, EditorRequired]
    public string Texto { get; set; } = default!;

    protected override void OnParametersSet() => Estado.Establecer(Texto);

    // Si la página se desmonta —el usuario navegó a otro lado— el título no debe
    // quedarse pegado en la cabecera de la página siguiente durante el instante en que
    // esta todavía no declaró el suyo.
    public void Dispose() => Estado.Establecer(null);
}
