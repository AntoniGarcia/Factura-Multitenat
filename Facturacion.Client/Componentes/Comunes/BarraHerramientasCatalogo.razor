@*
    Dos renglones: arriba lo que crea o mueve registros, abajo lo que filtra. En uno solo los
    seis controles se amontonaban y los filtros quedaban partidos entre los botones.
*@

<div class="barra-herramientas-catalogo">
    @if (OnNuevo.HasDelegate || OnExportar.HasDelegate || OnSecundario.HasDelegate)
    {
        <div class="barra-herramientas-acciones">
            @if (OnNuevo.HasDelegate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OnNuevo">
                    @TextoNuevo
                </MudButton>
            }

            @if (OnExportar.HasDelegate)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="OnExportar">
                    Exportar CSV
                </MudButton>
            }

            @if (OnSecundario.HasDelegate)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@IconoSecundario" OnClick="OnSecundario">
                    @TextoSecundario
                </MudButton>
            }
        </div>
    }

    <div class="barra-herramientas-filtros">
        @* Con etiqueta, como los selectores: sin ella el buscador quedaba más arriba que ellos. *@
        <MudTextField T="string"
                       Label="Buscar"
                       ShrinkLabel="true"
                       Placeholder="@Placeholder"
                       Value="@Texto"
                       ValueChanged="AlBuscar"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.Search"
                       Immediate="true"
                       DebounceInterval="300"
                       Class="barra-herramientas-buscador" />

        @if (Empresas is { Count: > 1 })
        {
            <MudSelect T="Guid?"
                       Label="Dado de alta en"
                       Value="@Empresa"
                       ValueChanged="@(v => EmpresaCambiada.InvokeAsync(v))"
                       Class="barra-herramientas-empresa">
                <MudSelectItem T="Guid?" Value="@(null)">Todas las empresas</MudSelectItem>
                @foreach (var empresa in Empresas)
                {
                    <MudSelectItem T="Guid?" Value="@empresa.Id">@empresa.NombreFiscal</MudSelectItem>
                }
            </MudSelect>
        }

        @if (MuestraEstatus)
        {
            <MudSelect T="bool?"
                       Label="Estatus"
                       Value="@Activos"
                       ValueChanged="@(v => ActivosCambiado.InvokeAsync(v))"
                       Class="barra-herramientas-estatus">
                <MudSelectItem T="bool?" Value="@(null)">Todos</MudSelectItem>
                <MudSelectItem T="bool?" Value="@(true)">Activos</MudSelectItem>
                <MudSelectItem T="bool?" Value="@(false)">Inactivos</MudSelectItem>
            </MudSelect>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Texto { get; set; } = string.Empty;

    [Parameter]
    public string Placeholder { get; set; } = "Buscar…";

    /// <summary>Se dispara con debounce de 300 ms, el mismo de BuscadorCatalogo.</summary>
    [Parameter]
    public EventCallback<string> TextoCambiado { get; set; }

    /// <summary>
    /// Si el catálogo distingue activos de inactivos. En falso el filtro no se pinta, que es
    /// lo que necesitan los catálogos donde nada se da de baja.
    /// </summary>
    [Parameter]
    public bool MuestraEstatus { get; set; }

    /// <summary>
    /// Estatus filtrado: <c>null</c> todos, <c>true</c> solo activos, <c>false</c> solo dados
    /// de baja. Antes era un interruptor de dos estados y no había forma de ver únicamente
    /// los inactivos, que es como se encuentra al que alguien desactivó sin querer.
    /// </summary>
    [Parameter]
    public bool? Activos { get; set; } = true;

    [Parameter]
    public EventCallback<bool?> ActivosCambiado { get; set; }

    /// <summary>
    /// Empresas para el filtro por la que dio de alta el registro, en los catálogos que son de
    /// la cuenta. Es informativo: no cambia qué puede usar cada empresa. Con una sola no se pinta.
    /// </summary>
    [Parameter]
    public IReadOnlyList<EmpresaDisponibleDto>? Empresas { get; set; }

    /// <summary>Empresa filtrada; <c>null</c> son todas.</summary>
    [Parameter]
    public Guid? Empresa { get; set; }

    [Parameter]
    public EventCallback<Guid?> EmpresaCambiada { get; set; }

    [Parameter]
    public string TextoNuevo { get; set; } = "Nuevo";

    [Parameter]
    public EventCallback OnNuevo { get; set; }

    [Parameter]
    public EventCallback OnExportar { get; set; }

    [Parameter]
    public string TextoSecundario { get; set; } = string.Empty;

    [Parameter]
    public string IconoSecundario { get; set; } = Icons.Material.Filled.MoreHoriz;

    [Parameter]
    public EventCallback OnSecundario { get; set; }

    private Task AlBuscar(string texto)
    {
        Texto = texto;
        return TextoCambiado.InvokeAsync(texto);
    }
}
