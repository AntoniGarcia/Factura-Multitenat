@using Facturacion.Shared.Plataforma
@using Facturacion.Client.Servicios.Plataforma
@inject ServicioDeProductos Productos

@*
    El "Código" de producto del renglón de conceptos (§12.3), resuelto por búsqueda
    (ARQUITECTURA.md §7 / §31). El renglón se autocompleta entero desde aquí: unidad, descripción,
    precio e impuestos vienen del producto, no se capturan a mano (regla de negocio de §12.3).
*@

<MudAutocomplete T="ProductoEnListaDto"
                  Label="Código de producto"
                  Value="@Valor"
                  ValueChanged="@(v => ValorCambiado.InvokeAsync(v))"
                  SearchFunc="Buscar"
                  ToStringFunc="@Formatear"
                  MinCharacters="3"
                  DebounceInterval="300"
                  ResetValueOnEmptyText="true"
                  CoerceText="false"
                  Clearable="true"
                  Placeholder="Escribe código o descripción…">
    <ItemTemplate Context="producto">
        <span class="cifra-tabular buscador-catalogo-clave">@producto.CodigoInterno</span>
        <span class="buscador-catalogo-descripcion">@producto.Descripcion</span>
    </ItemTemplate>
</MudAutocomplete>

@code {
    [Parameter]
    public ProductoEnListaDto? Valor { get; set; }

    [Parameter]
    public EventCallback<ProductoEnListaDto?> ValorCambiado { get; set; }

    private async Task<IEnumerable<ProductoEnListaDto>> Buscar(string texto, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(texto) || texto.Length < 3) return [];

        var pagina = await Productos.ListarAsync(texto, activos: true, 0, 25, null, false, ct);
        return pagina.Elementos;
    }

    private static string Formatear(ProductoEnListaDto? producto)
        => producto is null ? string.Empty : $"{producto.CodigoInterno} — {producto.Descripcion}";
}
