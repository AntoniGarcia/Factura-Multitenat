@* Muestra dos decimales sin reducir la precisión del valor enviado al servidor. *@

<MudNumericField T="decimal"
                  Label="@Label"
                  Value="@Valor"
                  ValueChanged="@(v => ValorCambiado.InvokeAsync(v))"
                  Format="N2"
                  Culture="@CulturaEsMx"
                  Class="cifra-tabular campo-moneda"
                  Immediate="true"
                  Min="@Minimo"
                  Max="@Maximo"
                  Adornment="Adornment.Start"
                  AdornmentText="$"
                  Required="@Requerido"
                  Disabled="@Deshabilitado" />

@code {
    private static readonly System.Globalization.CultureInfo CulturaEsMx = new("es-MX");

    [Parameter]
    public string Label { get; set; } = "Importe";

    [Parameter]
    public decimal Valor { get; set; }

    [Parameter]
    public EventCallback<decimal> ValorCambiado { get; set; }

    [Parameter]
    public decimal Minimo { get; set; } = 0m;

    [Parameter]
    public decimal Maximo { get; set; } = decimal.MaxValue;

    [Parameter]
    public bool Requerido { get; set; }

    [Parameter]
    public bool Deshabilitado { get; set; }
}
