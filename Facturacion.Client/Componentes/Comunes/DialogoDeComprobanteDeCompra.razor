@implements IAsyncDisposable
@inject ServicioDeDescargas Descargas
@inject IJSRuntime JS

<MudDialog Class="dialogo-comprobante-compra">
    <DialogContent>
        @if (_paginas > 1)
        {
            <div class="vista-previa-paginacion" aria-label="Páginas del PDF">
                <MudButton Disabled="@(_cargando || _pagina == 1)" OnClick="@(() => CambiarPagina(-1))">Anterior</MudButton>
                <span role="status">Página @_pagina de @_paginas</span>
                <MudButton Disabled="@(_cargando || _pagina == _paginas)" OnClick="@(() => CambiarPagina(1))">Siguiente</MudButton>
            </div>
        }
        <div class="vista-previa-comprobante" aria-busy="@_cargando">
            <canvas @ref="_canvas" role="img" aria-label="@TituloVistaPrevia" hidden="@(_cargando || _error is not null)"></canvas>
            @if (_cargando)
            {
                <div class="vista-previa-cargando">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <span>Preparando vista previa…</span>
                </div>
            }
            else if (_error is not null)
            {
                <div class="vista-previa-cargando" role="alert">
                    <span>@_error</span>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ReintentarAsync">Volver a intentar</MudButton>
                </div>
            }
        </div>

        @if (EsBorrador)
        {
            <p class="seccion-ayuda comprobante-aviso-fiscal">Borrador sin timbrar. No tiene validez fiscal.</p>
        }
        else if (!string.IsNullOrWhiteSpace(AvisoFiscal))
        {
            <p class="seccion-ayuda comprobante-aviso-fiscal">@AvisoFiscal</p>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cerrar">Cerrar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Descargar">
            Descargar PDF
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter, EditorRequired]
    public ArchivoParaDescarga Archivo { get; set; } = default!;

    [Parameter]
    public string TituloVistaPrevia { get; set; } = "Vista previa del comprobante de compra";

    [Parameter]
    public bool EsBorrador { get; set; }

    [Parameter]
    public string AvisoFiscal { get; set; } =
        "Documento interno sin validez fiscal.";

    private ElementReference _canvas;
    private IJSObjectReference? _visor;
    private DotNetObjectReference<DialogoDeComprobanteDeCompra>? _notificaciones;
    private bool _cargando = true;
    private bool _cerrado;
    private string? _error;
    private int _pagina = 1;
    private int _paginas;

    protected override async Task OnAfterRenderAsync(bool primeraRenderizacion)
    {
        if (!primeraRenderizacion) return;
        await CargarVistaAsync();
    }

    private Task ReintentarAsync() => _cargando || _cerrado ? Task.CompletedTask : CargarVistaAsync();

    private async Task CargarVistaAsync()
    {
        _cargando = true;
        _error = null;
        _pagina = 1;
        _paginas = 0;

        try
        {
            _visor ??= await JS.InvokeAsync<IJSObjectReference>("import", "./visor-pdf.js");
            if (_cerrado) return;
            await _visor.InvokeVoidAsync("liberar", _canvas);
            using var flujo = new MemoryStream(Archivo.Contenido, writable: false);
            using var referencia = new DotNetStreamReference(flujo);
            _notificaciones ??= DotNetObjectReference.Create(this);
            _paginas = await _visor.InvokeAsync<int>("cargar", _canvas, referencia, _notificaciones);
        }
        catch (JSException) { _error = "No se pudo mostrar la vista previa. Puedes descargar el PDF para consultarlo."; }
        finally { _cargando = false; if (!_cerrado) StateHasChanged(); }
    }

    private async Task CambiarPagina(int cambio)
    {
        if (_visor is null || _cargando) return;
        _error = null;
        _cargando = true;
        try
        {
            var siguiente = _pagina + cambio;
            await _visor.InvokeVoidAsync("mostrarPagina", _canvas, siguiente);
            _pagina = siguiente;
        }
        catch (JSException) { _error = "No se pudo mostrar esta página. Puedes descargar el PDF para consultarlo."; }
        finally { _cargando = false; }
    }

    private async Task Descargar() => await Descargas.GuardarAsync(Archivo);

    [JSInvokable]
    public Task AlFallarRedibujadoAsync()
    {
        if (_cerrado) return Task.CompletedTask;
        _error = "No se pudo actualizar la vista previa. Vuelve a intentarlo o descarga el PDF para consultarlo.";
        return InvokeAsync(StateHasChanged);
    }

    private void Cerrar() => Dialogo.Close();

    public async ValueTask DisposeAsync()
    {
        _cerrado = true;
        if (_visor is not null)
        {
            await _visor.InvokeVoidAsync("liberar", _canvas);
            await _visor.DisposeAsync();
        }
        _notificaciones?.Dispose();
    }
}
