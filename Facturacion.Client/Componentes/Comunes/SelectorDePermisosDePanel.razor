@using Facturacion.Shared.Operador
@using Facturacion.Client.Servicios.Operador
@inject ServicioDeSesionDeOperador Sesion

<div class="selector-permisos-panel">
    <div class="permisos-modulos" role="group" aria-label="Módulos del panel">
        @foreach (var seccion in PermisosDePanel.Secciones)
        {
            var activa = SeccionActiva.Ver.Clave == seccion.Ver.Clave;
            var verMarcado = Value.Contains(seccion.Ver.Clave);

            <div class="permiso-modulo @(activa ? "activo" : null)" @key="seccion.Ver.Clave">
                <input type="checkbox" class="permiso-modulo-casilla"
                       aria-label="@($"Permiso: {seccion.Ver.Etiqueta}")"
                       checked="@verMarcado"
                       disabled="@(Deshabilitado || !PuedeDelegar(seccion.Ver.Clave))"
                       @onchange="@(e => CambiarCasilla(seccion.Ver.Clave, e.Value is true))" />
                <button type="button"
                        class="permiso-modulo-mostrar permiso-modulo-navegacion"
                        aria-pressed="@activa"
                        @onclick="@(() => SeleccionarSeccion(seccion))">
                    <span>@seccion.Ver.Etiqueta</span>
                    <span class="permiso-modulo-cantidad">
                        @AccionesHabilitadas(seccion)
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />

                </button>
            </div>
        }
    </div>

    @{ var seccionActiva = SeccionActiva; }
    <section class="permisos-detalle" aria-labelledby="permisos-detalle-titulo" @key="seccionActiva.Ver.Clave">
        <div class="permisos-detalle-encabezado">
            <h3 id="permisos-detalle-titulo">@seccionActiva.Titulo</h3>
            <span>@AccionesHabilitadas(seccionActiva) de @seccionActiva.Acciones.Count</span>
        </div>
        @{ var claves = ClavesDeSeccion(seccionActiva).Where(PuedeDelegar).ToList(); }
        <MudButton Size="Size.Small" ButtonType="ButtonType.Button" Variant="Variant.Outlined" Color="Color.Primary"
                   Disabled="@(Deshabilitado || claves.All(Value.Contains))"
                   OnClick="@(() => CambiarClaves(claves, marcar: true))">
            Seleccionar todo
        </MudButton>
        @if (seccionActiva.Acciones.Count > 0)
        {
            <p class="permisos-detalle-ayuda">Para usar las acciones del módulo, habilita también su casilla de acceso.</p>
        }
        <div class="permisos-acciones" role="group" aria-label="@($"Acciones de {seccionActiva.Titulo}")">
            @foreach (var accion in seccionActiva.Acciones)
            {
                <div class="permiso-casilla" @key="accion.Clave">
                <MudCheckBox T="bool"
                             Value="@Value.Contains(accion.Clave)"
                             ValueChanged="@(marcado => CambiarCasilla(accion.Clave, marcado))"
                             Label="@accion.Etiqueta"
                             Disabled="@(Deshabilitado || !PuedeDelegar(accion.Clave))" />
                </div>
            }
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired]
    public List<string> Value { get; set; } = [];

    [Parameter]
    public EventCallback<List<string>> ValueChanged { get; set; }

    [Parameter]
    public bool Deshabilitado { get; set; }

    private string _seccionActivaClave = PermisosDePanel.Secciones[0].Ver.Clave;

    private int AccionesHabilitadas(SeccionDePermisosDePanel seccion)
        => seccion.Acciones.Count(accion => Value.Contains(accion.Clave));

    private SeccionDePermisosDePanel SeccionActiva =>
        PermisosDePanel.Secciones.FirstOrDefault(s => s.Ver.Clave == _seccionActivaClave)
        ?? PermisosDePanel.Secciones[0];

    private void SeleccionarSeccion(SeccionDePermisosDePanel seccion) =>
        _seccionActivaClave = seccion.Ver.Clave;

    private bool PuedeDelegar(string clave) => Sesion.Sesion is { } sesion
        && (sesion.EsPrincipal || sesion.Permisos.Contains(clave));

    private static IEnumerable<string> ClavesDeSeccion(SeccionDePermisosDePanel seccion)
        => seccion.Acciones.Select(a => a.Clave).Prepend(seccion.Ver.Clave);

    private Task CambiarClaves(IEnumerable<string> claves, bool marcar)
        => ValueChanged.InvokeAsync(marcar ? [.. Value.Union(claves)] : [.. Value.Except(claves)]);

    private Task CambiarCasilla(string clave, bool marcado) => CambiarClaves([clave], marcado);
}
