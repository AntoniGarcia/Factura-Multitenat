@using Facturacion.Client.Servicios.Operador
@using Facturacion.Client.Servicios.Plataforma
@inject ServicioDeSesion Sesion
@inject ServicioDeSesionDeOperador SesionOperador
@inject ServicioDeTema Tema
@inject ServicioDeCatalogos Catalogos
@inject NavigationManager Navegacion

@*
    Antes de renderizar nada, intenta recuperar la sesión con la cookie de refresh y aplica
    el tema que trajo. Sin esta puerta, cada F5 muestra la interfaz de invitado en el tema
    claro por un instante y luego salta a la de usuario autenticado en su tema real
    (ARQUITECTURA.md §4 y §8).
*@

@if (_listo)
{
    @ChildContent
}
else
{
    <div class="puerta-arranque" role="status" aria-live="polite">
        <p>Restaurando tu sesión…</p>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    private bool _listo;

    protected override async Task OnInitializedAsync()
    {
        // Se prueba primero la identidad que corresponde a la ruta de arranque. Intentar
        // siempre la del inquilino haría que abrir /operador con la sesión del panel viva
        // gastara una llamada de más y, si además hubiera cookie de inquilino, restauraría la
        // sesión equivocada.
        if (EnRutaDeOperador)
        {
            await SesionOperador.RefrescarAsync();

            // El panel no usa los catálogos del SAT ni el tema guardado en el perfil del
            // inquilino: pedirlos aquí solo daría 401.
            await Tema.InicializarAsync(null);

            _listo = true;
            return;
        }

        // Que falle es lo normal cuando no hay cookie: significa que no hay sesión que
        // restaurar, no que algo esté mal.
        var haySesion = await Sesion.RefrescarAsync();

        await Tema.InicializarAsync(Sesion.Sesion?.Tema);

        // Sin sesión los catálogos precargables igual responderían 401: no vale la pena
        // pedirlos antes de que haya alguien autenticado.
        if (haySesion)
            await Catalogos.InicializarAsync();

        _listo = true;
    }

    private bool EnRutaDeOperador =>
        Navegacion.ToBaseRelativePath(Navegacion.Uri)
            .StartsWith("operador", StringComparison.OrdinalIgnoreCase);
}
