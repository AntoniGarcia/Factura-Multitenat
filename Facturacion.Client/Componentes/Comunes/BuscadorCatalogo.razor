@using Facturacion.Shared.Contratos
@inject IBusquedaDeCatalogo Busqueda
@inject IServicioModalCatalogo ModalCatalogo

@*
    Autocompletado contra el servidor: mínimo 3 caracteres, debounce 300 ms, "clave —
    descripción", navegable con flechas, Enter confirma, Esc limpia. Todo
    eso ya lo hace MudAutocomplete de fábrica, incluido cancelar la búsqueda anterior al
    escribir de nuevo.
*@

<MudTooltip Text="@Contexto" Disabled="@string.IsNullOrWhiteSpace(Contexto)">
<div class="buscador-catalogo-compuesto">
    <MudAutocomplete T="ClaveSatDto"
                      Label="@Label"
                      Value="@ValorActual"
                      ValueChanged="AlElegirAsync"
                      TextChanged="AlCambiarTextoAsync"
                      SearchFunc="Buscar"
                      ToStringFunc="@Formatear"
                      MinCharacters="@(Opciones is not null || MostrarOpciones ? 0 : 3)"
                      MaxItems="@(Opciones is not null ? (int?)null : 50)"
                      DebounceInterval="300"
                      OpenOnFocus="@(Opciones is not null || MostrarOpciones)"
                      ResetValueOnEmptyText="true"
                      CoerceText="false"
                      Strict="@(Opciones is null && !MostrarOpciones)"
                      Clearable="@PuedeLimpiar"
                      Required="@Requerido"
                      Disabled="@Deshabilitado"
                      Placeholder="@(Opciones is not null || MostrarOpciones ? "Escribe clave o descripción…" : "Escribe al menos 3 caracteres…")">
        <ItemTemplate Context="clave">
            <span class="cifra-tabular buscador-catalogo-clave">@clave.Clave</span>
            <span class="buscador-catalogo-descripcion">@clave.Descripcion</span>
        </ItemTemplate>
    </MudAutocomplete>

    @if (MuestraSelectorEnLista && Opciones is null)
    {
        <MudIconButton Icon="@Icons.Material.Filled.TableRows"
                       Disabled="@Deshabilitado"
                       OnClick="AbrirModalAsync"
                       title="Buscar en la lista" aria-label="@($"Buscar {Label} en la lista")" />
    }
</div>
</MudTooltip>

@code {
    [Parameter] public IReadOnlyList<ClaveSatDto>? Opciones { get; set; }
    [Parameter] public string? Clave { get; set; }
    [Parameter] public EventCallback<string> ClaveChanged { get; set; }
    [Parameter] public bool PuedeLimpiar { get; set; } = true;
    private IReadOnlyList<ClaveSatDto>? _opcionesCargadas;
    private string? _catalogoCargado;

    protected override async Task OnParametersSetAsync()
    {
        if (Opciones is not null || !MostrarOpciones || !ClaveChanged.HasDelegate || _catalogoCargado == Catalogo) return;
        var catalogo = Catalogo;
        var opciones = await Busqueda.OpcionesAsync(catalogo, CancellationToken.None);
        if (Catalogo != catalogo) return;
        _opcionesCargadas = opciones;
        _catalogoCargado = catalogo;
    }

    private ClaveSatDto? ValorActual => ClaveChanged.HasDelegate
        ? (Opciones ?? _opcionesCargadas)?.FirstOrDefault(x => x.Clave == Clave) ??
          (string.IsNullOrEmpty(Clave) ? null : new ClaveSatDto(Catalogo, Clave, "Clave guardada", false))
        : Valor;

    private async Task AlElegirAsync(ClaveSatDto? valor)
    {
        if (ClaveChanged.HasDelegate) await ClaveChanged.InvokeAsync(valor?.Clave ?? "");
        if (ValorCambiado.HasDelegate) await ValorCambiado.InvokeAsync(valor);
    }

    /// <summary>Nombre del catálogo, por ejemplo <c>c_RegimenFiscal</c>.</summary>
    [Parameter, EditorRequired]
    public string Catalogo { get; set; } = default!;

    [Parameter]
    public string Label { get; set; } = "Buscar clave";

    [Parameter]
    public ClaveSatDto? Valor { get; set; }

    [Parameter]
    public EventCallback<ClaveSatDto?> ValorCambiado { get; set; }

    [Parameter]
    public bool Requerido { get; set; }

    [Parameter]
    public bool Deshabilitado { get; set; }

    /// <summary>Solo para catálogos pequeños; los masivos conservan búsqueda remota.</summary>
    [Parameter]
    public bool MostrarOpciones { get; set; }

    [Parameter]
    public bool MuestraSelectorEnLista { get; set; } = true;

    /// <summary>Texto contextual mostrado al enfocar o pasar el puntero por el campo.</summary>
    [Parameter]
    public string? Contexto { get; set; }

    /// <summary>Notifica cada cambio de texto cuando el contenedor necesita reaccionar antes de seleccionar.</summary>
    [Parameter]
    public EventCallback<string> TextoCambiado { get; set; }

    /// <summary>Útil para CP: en el control se muestra solo la clave, no la descripción territorial.</summary>
    [Parameter]
    public bool MostrarSoloClave { get; set; }

    /// <summary>Fuente contextual, por ejemplo códigos postales de un municipio ya elegido.</summary>
    [Parameter]
    public Func<string, CancellationToken, Task<IReadOnlyList<ClaveSatDto>>>? BusquedaPersonalizada { get; set; }

    private async Task<IEnumerable<ClaveSatDto>> Buscar(string texto, CancellationToken ct)
    {
        if (Opciones is not null)
            return Opciones.Where(x => string.IsNullOrWhiteSpace(texto) ||
                Coincide(x.Clave, texto) || Coincide(x.Descripcion, texto));

        if (BusquedaPersonalizada is not null)
            return await BusquedaPersonalizada(texto, ct);

        if (MostrarOpciones)
        {
            var opciones = await Busqueda.OpcionesAsync(Catalogo, ct);
            return opciones.Where(x => string.IsNullOrWhiteSpace(texto) ||
                Coincide(x.Clave, texto) || Coincide(x.Descripcion, texto));
        }

        if (string.IsNullOrWhiteSpace(texto)) return [];

        if (!MostrarOpciones && texto.Length < 3) return [];

        return await Busqueda.BuscarAsync(Catalogo, texto, ct);
    }

    private static bool Coincide(string valor, string texto)
        => System.Globalization.CultureInfo.GetCultureInfo("es-MX").CompareInfo.IndexOf(valor, texto.Trim(),
            System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0;

    private string Formatear(ClaveSatDto? clave)
        => clave is null ? string.Empty : MostrarSoloClave ? clave.Clave : $"{clave.Clave} — {clave.Descripcion}";

    private Task AlCambiarTextoAsync(string texto)
        => TextoCambiado.HasDelegate ? TextoCambiado.InvokeAsync(texto) : Task.CompletedTask;

    private async Task AbrirModalAsync()
    {
        var clave = await ModalCatalogo.ElegirAsync(Catalogo, Label);
        if (clave is not null) await AlElegirAsync(clave);
    }
}
