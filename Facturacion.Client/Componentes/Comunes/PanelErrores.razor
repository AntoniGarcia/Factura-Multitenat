@using Facturacion.Shared.Comun
@inject IJSRuntime Js

@*
    Pinta un Problem Details. El traceId se muestra siempre, con botón de copiar: es lo que
    el usuario le dicta —o le pega— a soporte para que soporte encuentre el error en el log
    (ARQUITECTURA.md §4).
*@

@if (Problema is not null)
{
    <div class="panel-errores" role="alert">
        <p class="panel-errores-titulo">@Problema.Titulo</p>

        @if (!string.IsNullOrWhiteSpace(Problema.Detalle))
        {
            <p class="panel-errores-detalle">@Problema.Detalle</p>
        }

        @if (Problema.Errores is { Count: > 0 })
        {
            <ul class="panel-errores-campos">
                @foreach (var campo in Problema.Errores)
                {
                    @foreach (var mensaje in campo.Value)
                    {
                        <li>@mensaje</li>
                    }
                }
            </ul>
        }

        @if (!string.IsNullOrWhiteSpace(Problema.TraceId))
        {
            <p class="panel-errores-traza">
                Referencia para soporte: <code class="cifra-tabular">@Problema.TraceId</code>
                <button type="button" class="panel-errores-copiar" @onclick="Copiar" title="Copiar">
                    @(_copiado ? "Copiado" : "Copiar")
                </button>
            </p>
        }
    </div>
}

@code {
    [Parameter]
    public DetalleProblema? Problema { get; set; }

    private bool _copiado;

    private async Task Copiar()
    {
        if (Problema?.TraceId is not { Length: > 0 } traceId) return;

        await Js.InvokeVoidAsync("copiarAlPortapapeles", traceId);

        _copiado = true;
        StateHasChanged();

        await Task.Delay(1500);
        _copiado = false;
        StateHasChanged();
    }
}
