@using Facturacion.Shared.Comun
@using Facturacion.Shared.Plataforma

<div class="selector-permisos-cabecera">
    <div class="selector-permisos-resumen">
        <span class="permisos-resumen-conteo cifra-tabular">@TotalActivos de @Permisos.Asignables.Count</span>
        <span class="permisos-resumen-etiqueta">permisos activos</span>
    </div>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" ButtonType="ButtonType.Button"
               StartIcon="@(TodosMarcados ? Icons.Material.Filled.RemoveDone : Icons.Material.Filled.DoneAll)"
               Disabled="@Deshabilitado" OnClick="CambiarSeleccionCompleta">
        @(TodosMarcados ? "Quitar todos" : "Activar todos")
    </MudButton>
</div>

<MudTabs @bind-ActivePanelIndex="_pestana" Class="selector-permisos-pestanas" Elevation="0" KeepPanelsAlive="true">
    @foreach (var seccion in Permisos.Secciones)
    {
        var elementos = seccion.Elementos;

        <MudTabPanel @key="seccion.Titulo" Text="@TituloDePestana(seccion, elementos)">
            @if (elementos.Count == 1)
            {
                <section class="permisos-detalle permisos-detalle-unico" aria-label="@($"Permisos de {seccion.Titulo}")">
                    <div class="permisos-detalle-encabezado">
                        <h3>@elementos[0].Etiqueta</h3>
                        <div class="permisos-detalle-controles">
                            <span class="permiso-modulo-cantidad @(Efectivos(elementos[0]) > 0 ? "con-activos" : null)">
                                @Efectivos(elementos[0])/@elementos[0].Subpermisos.Count
                            </span>
                            @BotonModulo(elementos[0])
                        </div>
                    </div>
                    @Casillas(elementos[0])
                </section>
            }
            else
            {
                var activo = Activo(seccion, elementos);

                <div class="selector-permisos-panel">
                    <div class="permisos-modulos" role="group" aria-label="@seccion.Titulo">
                        @foreach (var elemento in elementos)
                        {
                            var marcados = Efectivos(elemento);
                            var seleccionado = elemento.Nombre == activo.Nombre;

                            <div class="permiso-modulo @(seleccionado ? "activo" : null)" @key="elemento.Nombre">
                                <button type="button"
                                        class="permiso-modulo-mostrar permiso-modulo-navegacion"
                                        aria-pressed="@seleccionado"
                                        @onclick="@(() => _activos[seccion.Titulo] = elemento.Nombre)">
                                    <span class="permiso-modulo-nombre">@elemento.Etiqueta</span>
                                    <span class="permiso-modulo-cantidad @(marcados > 0 ? "con-activos" : null)">@marcados/@elemento.Subpermisos.Count</span>
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                </button>
                            </div>
                        }
                    </div>

                    <section class="permisos-detalle" aria-labelledby="@($"permisos-{activo.Nombre}")" @key="activo.Nombre">
                        <div class="permisos-detalle-encabezado">
                            <h3 id="@($"permisos-{activo.Nombre}")">@activo.Etiqueta</h3>
                            <div class="permisos-detalle-controles">
                                <span class="permiso-modulo-cantidad @(Efectivos(activo) > 0 ? "con-activos" : null)">
                                    @Efectivos(activo)/@activo.Subpermisos.Count
                                </span>
                                @BotonModulo(activo)
                            </div>
                        </div>
                        @Casillas(activo)
                    </section>
                </div>
            }
        </MudTabPanel>
    }

    @if (Empresas is { Count: > 1 })
    {
        <MudTabPanel Text="@($"Empresas ({EmpresasElegidas.Count})")">
            <section class="permisos-detalle permisos-detalle-unico" aria-label="Empresas con acceso">
                <div class="permisos-detalle-encabezado">
                    <h3>Empresas habilitadas</h3>
                    <span class="permiso-modulo-cantidad @(EmpresasElegidas.Count > 0 ? "con-activos" : null)">
                        @EmpresasElegidas.Count/@Empresas.Count
                    </span>
                </div>
                <div class="permisos-acciones" role="group" aria-label="Empresas de la cuenta">
                    @foreach (var empresa in Empresas)
                    {
                        var elegida = EmpresasElegidas.Contains(empresa.Id);
                        <div class="permiso-casilla @(elegida ? "marcada" : null)" @key="empresa.Id">
                            <MudCheckBox T="bool"
                                         Value="@elegida"
                                         ValueChanged="@(marcada => CambiarEmpresa(empresa.Id, marcada))"
                                         Label="@empresa.NombreFiscal"
                                         Color="Color.Primary"
                                         Dense="true"
                                         Disabled="@Deshabilitado" />
                            <span class="permiso-concedido cifra-tabular">@empresa.Rfc</span>
                        </div>
                    }
                </div>
            </section>
        </MudTabPanel>
    }
</MudTabs>

@code {
    [Parameter, EditorRequired]
    public List<string> Value { get; set; } = [];

    [Parameter]
    public EventCallback<List<string>> ValueChanged { get; set; }

    [Parameter]
    public bool Deshabilitado { get; set; }

    [Parameter]
    public IReadOnlyList<EmpresaParaAccesoDto>? Empresas { get; set; }

    [Parameter]
    public List<Guid> EmpresasElegidas { get; set; } = [];

    [Parameter]
    public EventCallback<List<Guid>> EmpresasElegidasChanged { get; set; }

    private int _pestana;
    private readonly Dictionary<string, string> _activos = [];
    private bool TodosMarcados => Permisos.Asignables.All(Value.Contains);
    private int TotalActivos => Permisos.Asignables.Count(c => Value.Contains(c) || Permisos.ConcedidoPor(c, Value) is not null);

    private Task CambiarEmpresa(Guid empresaId, bool marcada)
    {
        List<Guid> nuevas = marcada
            ? [.. EmpresasElegidas.Append(empresaId).Distinct()]
            : [.. EmpresasElegidas.Where(id => id != empresaId)];

        return EmpresasElegidasChanged.InvokeAsync(nuevas);
    }

    private RenderFragment BotonModulo(ElementoDePermisos elemento) => __builder =>
    {
        var claves = elemento.Subpermisos.Select(p => p.Clave).ToList();
        if (claves.Count <= 1) return;
        var marcadas = claves.All(Value.Contains);
        <MudButton Size="Size.Small" ButtonType="ButtonType.Button" Variant="Variant.Text" Color="Color.Primary"
                   Disabled="@Deshabilitado"
                   OnClick="@(() => CambiarClaves(claves, marcar: !marcadas))">
            @(marcadas ? "Quitar todo" : "Activar todo")
        </MudButton>
    };

    private RenderFragment Casillas(ElementoDePermisos elemento) => __builder =>
    {
        <div class="permisos-acciones" role="group" aria-label="@($"Permisos de {elemento.Etiqueta}")">
            @foreach (var subpermiso in elemento.Subpermisos)
            {
                var concedido = Permisos.ConcedidoPor(subpermiso.Clave, Value);
                var activo = concedido is not null || Value.Contains(subpermiso.Clave);

                <div class="permiso-casilla @(activo ? "marcada" : null) @(concedido is not null ? "implicita" : null)" @key="subpermiso.Clave">
                    <MudCheckBox T="bool"
                                 Value="@activo"
                                 ValueChanged="@(marcado => Cambiar(subpermiso.Clave, marcado))"
                                 Label="@subpermiso.Etiqueta"
                                 Color="Color.Primary"
                                 Dense="true"
                                 Disabled="@(Deshabilitado || concedido is not null)" />
                    @if (concedido is not null)
                    {
                        <span class="permiso-concedido">@concedido</span>
                    }
                </div>
            }
        </div>
    };

    private ElementoDePermisos Activo(SeccionDePermisos seccion, IReadOnlyList<ElementoDePermisos> elementos)
        => _activos.TryGetValue(seccion.Titulo, out var nombre) && elementos.FirstOrDefault(e => e.Nombre == nombre) is { } elegido
            ? elegido
            : elementos[0];

    private int Efectivos(ElementoDePermisos elemento)
        => elemento.Subpermisos.Count(p => Value.Contains(p.Clave) || Permisos.ConcedidoPor(p.Clave, Value) is not null);

    private string TituloDePestana(SeccionDePermisos seccion, IReadOnlyList<ElementoDePermisos> elementos)
        => elementos.Sum(Efectivos) is > 0 and var marcados ? $"{seccion.Titulo} ({marcados})" : seccion.Titulo;

    // Descarga requiere listado: marcarla activa ambos y quitar listado quita descarga.
    private Task Cambiar(string clave, bool marcado)
    {
        var nuevo = new List<string>(Value);

        if (marcado)
        {
            if (!nuevo.Contains(clave)) nuevo.Add(clave);
            if (clave == Permisos.DocumentosDescarga && !nuevo.Contains(Permisos.DocumentosListado))
                nuevo.Add(Permisos.DocumentosListado);
        }
        else
        {
            nuevo.Remove(clave);
            if (clave == Permisos.DocumentosListado) nuevo.Remove(Permisos.DocumentosDescarga);
        }

        return ValueChanged.InvokeAsync(nuevo);
    }

    private Task CambiarSeleccionCompleta() => CambiarClaves(Permisos.Asignables, marcar: !TodosMarcados);

    private Task CambiarClaves(IEnumerable<string> claves, bool marcar)
    {
        var nuevo = marcar ? Value.Union(claves).ToList() : Value.Except(claves).ToList();
        if (nuevo.Contains(Permisos.DocumentosDescarga) && !nuevo.Contains(Permisos.DocumentosListado))
            nuevo.Add(Permisos.DocumentosListado);
        return ValueChanged.InvokeAsync(nuevo);
    }
}
