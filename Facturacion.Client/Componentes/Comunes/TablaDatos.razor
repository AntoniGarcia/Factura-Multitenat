@typeparam T
@using MudBlazor

@*
    Columnas configurables, orden y paginación en servidor, filas de 40px (fijado en
    mudblazor-tema.css), estado vacío, estado de carga, y en móvil se transforma en tarjetas
    apiladas —eso último con el Breakpoint de MudTable, no con CSS propio: es exactamente
    lo que ese parámetro hace—. Documentado aquí porque también lo va a usar la mitad B
    (REPARTO-EQUIPO.md §4).

    CargarPagina es el único punto de contacto con el servidor: quien use el componente
    decide qué endpoint llamar, TablaDatos solo pide "dame la página N ordenada así".
*@

<MudTable T="T"
          ServerData="CargarAsync"
          @ref="_tabla"
          Breakpoint="Breakpoint.Sm"
          Dense="true"
          Hover="true"
          Loading="_cargando"
          RowsPerPage="@TamanoPagina">
    <HeaderContent>
        @foreach (var columna in Columnas)
        {
            @if (columna.ClaveOrden is { } clave)
            {
                <MudTh>
                    <MudTableSortLabel T="T" SortLabel="@clave">@columna.Encabezado</MudTableSortLabel>
                </MudTh>
            }
            else
            {
                <MudTh>@columna.Encabezado</MudTh>
            }
        }
    </HeaderContent>
    <RowTemplate>
        @foreach (var columna in Columnas)
        {
            <MudTd DataLabel="@columna.Encabezado" Class="@(columna.Tabular ? "cifra-tabular" : null)">
                @columna.Contenido(context)
            </MudTd>
        }
    </RowTemplate>
    <NoRecordsContent>
        <p class="tabla-datos-estado">@TextoSinDatos</p>
    </NoRecordsContent>
    <LoadingContent>
        <p class="tabla-datos-estado">Cargando…</p>
    </LoadingContent>
    <PagerContent>
        <div class="tabla-paginacion">
            <span class="tabla-paginacion-info">
                Mostrando @_enPagina de @_total @TextoEntidad
            </span>

            <div class="tabla-paginacion-controles">
                <MudSelect T="int" Value="_tamano" ValueChanged="CambiarTamanoAsync" Dense="true"
                           Class="tabla-paginacion-tamano" Label="Por página">
                    @foreach (var opcion in TamanosDisponibles)
                    {
                        <MudSelectItem T="int" Value="@opcion">@opcion</MudSelectItem>
                    }
                </MudSelect>

                <MudPagination Count="@_totalPaginas" Selected="@(_pagina + 1)"
                               SelectedChanged="IrAPaginaAsync"
                               ShowFirstButton="false" ShowLastButton="false"
                               BoundaryCount="1" MiddleCount="3" />
            </div>
        </div>
    </PagerContent>
</MudTable>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ColumnaDeTabla<T>> Columnas { get; set; } = [];

    [Parameter, EditorRequired]
    public Func<PeticionDePagina, CancellationToken, Task<ResultadoDePagina<T>>> CargarPagina { get; set; } = default!;

    [Parameter]
    public int TamanoPagina { get; set; } = 25;

    [Parameter]
    public string TextoSinDatos { get; set; } = "No hay registros que mostrar.";

    /// <summary>
    /// Nombre en plural de lo que lista la tabla ("clientes", "productos", "documentos"), para
    /// el texto "Mostrando X de N …". El componente es agnóstico al dominio, así que lo aporta
    /// la página dueña.
    /// </summary>
    [Parameter]
    public string TextoEntidad { get; set; } = "registros";

    /// <summary>Opciones del selector de tamaño de página.</summary>
    private static readonly int[] TamanosDisponibles = [12, 25, 50];

    private MudTable<T>? _tabla;
    private bool _cargando;

    // Estado que alimenta la paginación propia (texto y botones numerados). Se refresca en
    // cada carga del servidor, que es cuando cambian la página, el tamaño o el total.
    private int _pagina;
    private int _tamano = 25;
    private int _total;
    private int _enPagina;
    private int _totalPaginas = 1;

    /// <summary>
    /// Vuelve a pedir la página actual. Lo llama la página dueña cuando cambia el texto de
    /// búsqueda de <see cref="BarraHerramientasCatalogo"/>, ya que el filtro de texto viaja
    /// en la petición al servidor que arma esa página, no en <see cref="PeticionDePagina"/>.
    /// </summary>
    public Task RecargarAsync() => _tabla?.ReloadServerData() ?? Task.CompletedTask;

    protected override void OnInitialized() => _tamano = TamanoPagina;

    private async Task<TableData<T>> CargarAsync(TableState estado, CancellationToken ct)
    {
        _cargando = true;
        try
        {
            var peticion = new PeticionDePagina(
                Pagina: estado.Page,
                TamanoPagina: estado.PageSize,
                ClaveOrden: estado.SortLabel,
                Descendente: estado.SortDirection == SortDirection.Descending);

            var resultado = await CargarPagina(peticion, ct);

            // Se guarda el estado para pintar "Mostrando X de N" y los botones numerados. El
            // total lo entrega el servidor; la página y el tamaño vienen del estado de la tabla.
            _pagina = estado.Page;
            _tamano = estado.PageSize;
            _total = resultado.Total;
            _enPagina = resultado.Elementos.Count;
            _totalPaginas = Math.Max(1, (int)Math.Ceiling(_total / (double)_tamano));

            return new TableData<T> { Items = resultado.Elementos, TotalItems = resultado.Total };
        }
        finally
        {
            _cargando = false;
            // El pie de paginación es contenido de este componente, no de MudTable: hay que
            // pedir el redibujo para que tome los valores recién calculados.
            StateHasChanged();
        }
    }

    /// <summary>Salta a la página elegida en el paginador. MudPagination cuenta desde 1; MudTable desde 0.</summary>
    private Task IrAPaginaAsync(int pagina)
    {
        _tabla?.NavigateTo(pagina - 1);
        return Task.CompletedTask;
    }

    /// <summary>Cambia cuántas filas se ven por página; MudTable recarga la página desde el servidor.</summary>
    private Task CambiarTamanoAsync(int tamano)
    {
        _tabla?.SetRowsPerPage(tamano);
        return Task.CompletedTask;
    }
}
