@using Facturacion.Shared.Plataforma

@* El marco de FormularioDeUsuario; devuelve la respuesta para que la lista recargue. *@

<MudDialog>
    <DialogContent>
        <div class="dialogo-formulario-scroll">
            <FormularioDeUsuario AlCrear="r => MudDialog.Close(DialogResult.Ok(r))"
                                 AlCancelar="() => MudDialog.Cancel()" />
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
}
