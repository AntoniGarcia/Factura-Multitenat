@page "/empresa/transporte"
@attribute [Authorize(Policy = Permisos.Politicas.LeerTransporte)]
@using Facturacion.Shared.Contratos
@using Facturacion.Shared.Transporte
@inject ServicioDeTransporte Transporte
@inject IBusquedaDeCatalogo Busqueda
@inject ServicioDeSesion Sesion

<PageTitle>Transporte</PageTitle>
<TituloDePagina Texto="Transporte" />
<PanelErrores Problema="_error" />

@* La consulta la abre quien hace Carta Porte o administra el catálogo; alta, edición y baja,
   solo administrar_vehiculos y administrar_figuras. Ocultarlas es comodidad: el servidor las
   rechaza igual. *@
<TarjetaFormulario Ancha="true" RutaVolver="/" Class="tarjeta-formulario-catalogo transporte-catalogo">
    <MudTabs>
        <MudTabPanel Text="Vehículos">
            <p class="seccion-ayuda">Vehículos disponibles para los traslados con Carta Porte.</p>
            <div class="transporte-herramientas">
            @if (_administraVehiculos)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NuevoVehiculo">Nuevo vehículo</MudButton>
            }
            <div class="transporte-filtro">
            <MudSelect T="bool?" Value="_filtroVehiculos" ValueChanged="FiltrarVehiculos" Label="Estatus">
                <MudSelectItem T="bool?" Value="@((bool?)true)">Activos</MudSelectItem><MudSelectItem T="bool?" Value="@((bool?)false)">Inactivos</MudSelectItem><MudSelectItem T="bool?" Value="@((bool?)null)">Todos</MudSelectItem>
            </MudSelect>
            </div>
            </div>
            @if (_editandoVehiculo)
            {
                <EditForm Model="this" OnValidSubmit="GuardarVehiculo">
                    <h2 class="seccion-titulo transporte-titulo">@(_vehiculoId is null ? "Nuevo vehículo" : "Editar vehículo")</h2>
                    <div class="formulario-catalogo-secciones">
                    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="vehiculo-identificacion">
                        <h3 id="vehiculo-identificacion" class="seccion-titulo">Identificación del vehículo</h3>
                        <div class="catalogo-rejilla catalogo-rejilla-tres">
                            <MudTextField @bind-Value="_vClave" Label="Clave interna" Required="true" Class="cifra-tabular" />
                            <MudTextField @bind-Value="_vDescripcion" Label="Descripción" Required="true" />
                            <MudTextField @bind-Value="_vPlaca" Label="Placa" Required="true" />
                            <MudNumericField T="int" @bind-Value="_vAnio" Label="Año modelo" Min="1900" Max="2100" />
                            <MudNumericField T="decimal" @bind-Value="_vPeso" Label="Peso bruto vehicular (t)" Min="0.01m" Format="N2" />
                            <BuscadorCatalogo Catalogo="c_ConfigAutotransporte" Label="Configuración SAT" Valor="@_configuracion" ValorCambiado="x => _configuracion = x" MostrarOpciones="true" MuestraSelectorEnLista="false" Requerido="true" />
                        </div>
                    </section>
                    <section class="formulario-catalogo-seccion" aria-labelledby="vehiculo-permiso">
                        <h3 id="vehiculo-permiso" class="seccion-titulo">Permiso de transporte</h3>
                        <div class="transporte-campos">
                            <BuscadorCatalogo Catalogo="c_TipoPermiso" Label="Tipo de permiso SAT" Valor="@_permiso" ValorCambiado="x => _permiso = x" MostrarOpciones="true" MuestraSelectorEnLista="false" Requerido="true" />
                            <MudTextField @bind-Value="_vNumeroPermiso" Label="Número de permiso" Required="true" />
                        </div>
                    </section>
                    <section class="formulario-catalogo-seccion" aria-labelledby="vehiculo-seguro">
                        <h3 id="vehiculo-seguro" class="seccion-titulo">Seguro</h3>
                        <div class="transporte-campos">
                            <MudTextField @bind-Value="_vAseguradora" Label="Aseguradora" Required="true" />
                            <MudTextField @bind-Value="_vPoliza" Label="Póliza" Required="true" />
                        </div>
                    </section>
                    </div>
                    <div class="tarjeta-formulario-acciones"><MudButton OnClick="CancelarVehiculo">Cancelar</MudButton><MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled">Guardar vehículo</MudButton></div>
                </EditForm>
            }
            <MudTable Items="_vehiculos" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                <HeaderContent><MudTh>Clave</MudTh><MudTh>Vehículo</MudTh><MudTh>Placa</MudTh><MudTh>Permiso</MudTh><MudTh>Acciones</MudTh></HeaderContent>
                <RowTemplate><MudTd DataLabel="Clave">@context.Clave</MudTd><MudTd DataLabel="Vehículo">@context.Descripcion</MudTd><MudTd DataLabel="Placa">@context.Placa</MudTd><MudTd DataLabel="Permiso">@context.TipoPermiso</MudTd><MudTd DataLabel="Acciones">@if (_administraVehiculos) { <MudButton Size="Size.Small" OnClick="@(() => EditarVehiculo(context))">Editar</MudButton><MudButton Size="Size.Small" OnClick="@(() => CambiarVehiculo(context))">@(context.Activo ? "Desactivar" : "Reactivar")</MudButton> }</MudTd></RowTemplate>
                <NoRecordsContent><p class="tabla-datos-estado">No hay vehículos con este estatus.</p></NoRecordsContent>
            </MudTable>
        </MudTabPanel>
        <MudTabPanel Text="Figuras de transporte">
            <p class="seccion-ayuda">Operadores y demás figuras que se asociarán a cada traslado.</p>
            <div class="transporte-herramientas">
            @if (_administraFiguras)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NuevoFigura">Nueva figura</MudButton>
            }
            <div class="transporte-filtro">
            <MudSelect T="bool?" Value="_filtroFiguras" ValueChanged="FiltrarFiguras" Label="Estatus">
                <MudSelectItem T="bool?" Value="@((bool?)true)">Activos</MudSelectItem><MudSelectItem T="bool?" Value="@((bool?)false)">Inactivos</MudSelectItem><MudSelectItem T="bool?" Value="@((bool?)null)">Todos</MudSelectItem>
            </MudSelect>
            </div>
            </div>
            @if (_editandoFigura)
            {
                <EditForm Model="this" OnValidSubmit="GuardarFigura">
                    <h2 class="seccion-titulo transporte-titulo">@(_figuraId is null ? "Nueva figura" : "Editar figura")</h2>
                    <div class="formulario-catalogo-secciones">
                    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="figura-identificacion">
                        <h3 id="figura-identificacion" class="seccion-titulo">Datos de la figura</h3>
                        <div class="catalogo-rejilla catalogo-rejilla-tres">
                            <MudTextField @bind-Value="_fClave" Label="Clave interna" Required="true" Class="cifra-tabular" />
                            <BuscadorCatalogo Catalogo="c_FiguraTransporte" Label="Tipo de figura SAT" Valor="@_tipoFigura" ValorCambiado="x => _tipoFigura = x" MostrarOpciones="true" MuestraSelectorEnLista="false" Requerido="true" />
                            <CampoRfc Valor="@_fRfc" ValorCambiado="x => _fRfc = x" Requerido="true" />
                        </div>
                        <div class="catalogo-rejilla">
                            <MudTextField @bind-Value="_fNombre" Label="Nombre" Required="true" Class="catalogo-campo-amplio" />
                            <MudTextField @bind-Value="_fLicencia" Label="Número de licencia" Class="catalogo-campo-corto" />
                        </div>
                    </section>
                    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="figura-domicilio">
                        <h3 id="figura-domicilio" class="seccion-titulo">Domicilio</h3>
                        <p class="seccion-ayuda">El código postal permite identificar el estado y municipio.</p>
                        <div class="catalogo-rejilla catalogo-rejilla-tres">
                            <MudTextField @bind-Value="_fCalle" Label="Calle" Required="true" />
                            <MudTextField @bind-Value="_fExterior" Label="Número exterior" Required="true" />
                            <MudTextField @bind-Value="_fInterior" Label="Número interior" />
                        </div>
                        <div class="catalogo-rejilla catalogo-rejilla-tres">
                            <BuscadorCatalogo @key="_estado?.Clave" Catalogo="c_Estado" Label="Estado" Valor="@_estado" ValorCambiado="x => AlCambiarEstadoAsync(x)" MostrarOpciones="true" MuestraSelectorEnLista="false" Contexto="@ResumenDomicilio" Requerido="true" />
                            <BuscadorCatalogo @key="_municipio?.Clave" Catalogo="c_Municipio" Label="Municipio" Valor="@_municipio" ValorCambiado="AlCambiarMunicipioAsync" BusquedaPersonalizada="BuscarMunicipiosAsync" MostrarOpciones="true" MuestraSelectorEnLista="false" Contexto="@ResumenDomicilio" Deshabilitado="@(_estado is null)" Requerido="true" />
                            <BuscadorCatalogo @key="_codigoPostal?.Clave" Catalogo="c_CodigoPostal" Label="Código postal" Valor="@_codigoPostal" ValorCambiado="AlCambiarCodigoPostalAsync" TextoCambiado="AlEscribirCodigoPostalAsync" BusquedaPersonalizada="BuscarCodigosPostalesAsync" MostrarSoloClave="true" MuestraSelectorEnLista="false" Contexto="@ResumenDomicilio" Requerido="true" />
                        </div>
                    </section>
                    </div>
                    <div class="tarjeta-formulario-acciones"><MudButton OnClick="CancelarFigura">Cancelar</MudButton><MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled">Guardar figura</MudButton></div>
                </EditForm>
            }
            <MudTable Items="_figuras" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                <HeaderContent><MudTh>Clave</MudTh><MudTh>Nombre</MudTh><MudTh>Tipo</MudTh><MudTh>RFC</MudTh><MudTh>Acciones</MudTh></HeaderContent>
                <RowTemplate><MudTd DataLabel="Clave">@context.Clave</MudTd><MudTd DataLabel="Nombre">@context.Nombre</MudTd><MudTd DataLabel="Tipo">@context.TipoFigura</MudTd><MudTd DataLabel="RFC" Class="cifra-tabular">@context.Rfc</MudTd><MudTd DataLabel="Acciones">@if (_administraFiguras) { <MudButton Size="Size.Small" OnClick="@(() => EditarFigura(context))">Editar</MudButton><MudButton Size="Size.Small" OnClick="@(() => CambiarFigura(context))">@(context.Activo ? "Desactivar" : "Reactivar")</MudButton> }</MudTd></RowTemplate>
                <NoRecordsContent><p class="tabla-datos-estado">No hay figuras con este estatus.</p></NoRecordsContent>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</TarjetaFormulario>

@code {
    private bool _administraVehiculos => Sesion.TienePermiso(Permisos.AdministrarVehiculos);
    private bool _administraFiguras => Sesion.TienePermiso(Permisos.AdministrarFiguras);

    private DetalleProblema? _error; private List<VehiculoDto> _vehiculos = []; private List<FiguraTransporteDto> _figuras = []; private List<ClaveSatDto> _municipiosDisponibles = []; private bool? _filtroVehiculos = true, _filtroFiguras = true;
    private bool _editandoVehiculo, _editandoFigura; private Guid? _vehiculoId, _figuraId; private ClaveSatDto? _configuracion, _permiso, _tipoFigura, _estado, _municipio, _codigoPostal;
    private string _vClave="", _vDescripcion="", _vPlaca="", _vAseguradora="", _vPoliza="", _vNumeroPermiso=""; private int _vAnio=DateTime.Today.Year; private decimal _vPeso;
    private string _fClave="", _fRfc="", _fNombre="", _fLicencia="", _fCalle="", _fExterior="", _fInterior="";
    protected override async Task OnInitializedAsync() { await RecargarVehiculos(); await RecargarFiguras(); }
    private void NuevoVehiculo() { _vehiculoId=null; _vClave=_vDescripcion=_vPlaca=_vAseguradora=_vPoliza=_vNumeroPermiso=""; _configuracion=_permiso=null; _vAnio=DateTime.Today.Year; _vPeso=0; _editandoVehiculo=true; }
    private void EditarVehiculo(VehiculoDto x) { _vehiculoId=x.Id; _vClave=x.Clave; _vDescripcion=x.Descripcion; _vPlaca=x.Placa; _vAseguradora=x.Aseguradora; _vPoliza=x.Poliza; _vNumeroPermiso=x.NumeroPermiso; _vAnio=x.AnioModelo; _vPeso=x.PesoBrutoVehicular; _configuracion=new("c_ConfigAutotransporte",x.ConfiguracionAutotransporte,x.ConfiguracionAutotransporte,true); _permiso=new("c_TipoPermiso",x.TipoPermiso,x.TipoPermiso,true); _editandoVehiculo=true; }
    private async Task GuardarVehiculo() { var (ok,error)=await Transporte.GuardarAsync(_vehiculoId,new PeticionGuardarVehiculo(_vClave,_vDescripcion,_configuracion?.Clave??"",_vPlaca,_vAnio,_vAseguradora,_vPoliza,_permiso?.Clave??"",_vNumeroPermiso,_vPeso,true)); _error=error; if(ok is not null){_editandoVehiculo=false;_vehiculos=await Transporte.VehiculosAsync(null)??[];} }
    private void CancelarVehiculo()=>_editandoVehiculo=false;
    private void NuevoFigura() { _figuraId=null; _fClave=_fRfc=_fNombre=_fLicencia=_fCalle=_fExterior=_fInterior=""; _tipoFigura=_estado=_municipio=_codigoPostal=null; _editandoFigura=true; }
    private void EditarFigura(FiguraTransporteDto x) { _figuraId=x.Id; _fClave=x.Clave;_fRfc=x.Rfc;_fNombre=x.Nombre;_fLicencia=x.NumeroLicencia??"";_fCalle=x.Calle;_fExterior=x.NumeroExterior;_fInterior=x.NumeroInterior??"";_estado=new("c_Estado",x.Estado,x.Estado,true);_municipio=new("c_Municipio",x.Municipio,x.Municipio,true);_codigoPostal=new("c_CodigoPostal",x.CodigoPostal,x.CodigoPostal,true);_tipoFigura=new("c_FiguraTransporte",x.TipoFigura,x.TipoFigura,true);_editandoFigura=true; }
    private async Task GuardarFigura() { var(ok,error)=await Transporte.GuardarAsync(_figuraId,new PeticionGuardarFiguraTransporte(_fClave,_tipoFigura?.Clave??"",_fRfc,_fNombre,_fLicencia,_fCalle,_fExterior,_fInterior,_estado?.Clave??"",_municipio?.Clave??"",_codigoPostal?.Clave??"",true));_error=error;if(ok is not null){_editandoFigura=false;_figuras=await Transporte.FigurasAsync(null)??[];} }
    private void CancelarFigura()=>_editandoFigura=false;
    private async Task FiltrarVehiculos(bool? activo) { _filtroVehiculos=activo; await RecargarVehiculos(); }
    private async Task FiltrarFiguras(bool? activo) { _filtroFiguras=activo; await RecargarFiguras(); }
    private async Task RecargarVehiculos()=>_vehiculos=await Transporte.VehiculosAsync(_filtroVehiculos)??[];
    private async Task RecargarFiguras()=>_figuras=await Transporte.FigurasAsync(_filtroFiguras)??[];
    private async Task CambiarVehiculo(VehiculoDto x) { var (_,error)=await Transporte.CambiarActivoVehiculoAsync(x.Id,!x.Activo);_error=error;if(error is null)await RecargarVehiculos(); }
    private async Task CambiarFigura(FiguraTransporteDto x) { var (_,error)=await Transporte.CambiarActivoFiguraAsync(x.Id,!x.Activo);_error=error;if(error is null)await RecargarFiguras(); }
    private async Task AlCambiarEstadoAsync(ClaveSatDto? estado)
    {
        _estado = estado;
        _municipio = null;
        _codigoPostal = null;
        _municipiosDisponibles = estado is null ? [] : await Transporte.MunicipiosAsync(estado.Clave) ?? [];
    }

    private Task AlCambiarMunicipioAsync(ClaveSatDto? municipio) { _municipio = municipio; _codigoPostal = null; return Task.CompletedTask; }

    private Task<IReadOnlyList<ClaveSatDto>> BuscarMunicipiosAsync(string texto, CancellationToken ct)
    {
        var filtro = texto.Trim();
        IReadOnlyList<ClaveSatDto> resultado = string.IsNullOrWhiteSpace(filtro)
            ? _municipiosDisponibles
            : _municipiosDisponibles.Where(x => x.Clave.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                                                x.Descripcion.Contains(filtro, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult(resultado);
    }

    private async Task<IReadOnlyList<ClaveSatDto>> BuscarCodigosPostalesAsync(string texto, CancellationToken ct)
    {
        if (_estado is null || _municipio is null)
            return texto.Length < 3 ? [] : await Busqueda.BuscarAsync("c_CodigoPostal", texto, ct);
        return await Transporte.CodigosPostalesAsync(_estado.Clave, _municipio.Clave, texto, ct) ?? [];
    }

    private async Task AlCambiarCodigoPostalAsync(ClaveSatDto? codigoPostal)
    {
        _codigoPostal = codigoPostal;
        _estado = null;
        _municipio = null;
        if (codigoPostal is null) return;

        await AplicarDomicilioPorCodigoPostalAsync(codigoPostal.Clave);
    }

    private async Task AlEscribirCodigoPostalAsync(string texto)
    {
        var codigoPostal = texto.Trim();
        if (codigoPostal == _codigoPostal?.Clave) return;

        _codigoPostal = null;
        _estado = null;
        _municipio = null;

        if (codigoPostal.Length != 5 || !codigoPostal.All(char.IsDigit)) return;

        _codigoPostal = new ClaveSatDto("c_CodigoPostal", codigoPostal, codigoPostal, true);
        await AplicarDomicilioPorCodigoPostalAsync(codigoPostal);
    }

    private async Task AplicarDomicilioPorCodigoPostalAsync(string codigoPostal)
    {
        var domicilio = await Transporte.ResolverDomicilioPorCodigoPostalAsync(codigoPostal);
        if (domicilio is null) return;

        _estado = new ClaveSatDto("c_Estado", domicilio.Estado, domicilio.NombreEstado, true);
        _municipio = domicilio.Municipio is null ? null :
            new ClaveSatDto("c_Municipio", domicilio.Municipio, domicilio.NombreMunicipio ?? domicilio.Municipio, true);

        await InvokeAsync(StateHasChanged);
    }

    private string? ResumenDomicilio
    {
        get
        {
            var partes = new[] { _estado?.Descripcion, _municipio?.Descripcion, _codigoPostal?.Clave }
                .Where(x => !string.IsNullOrWhiteSpace(x));
            var resumen = string.Join(" · ", partes);
            return string.IsNullOrWhiteSpace(resumen) ? null : $"Domicilio seleccionado: {resumen}";
        }
    }
}
