@page "/empresa/series"
@attribute [Authorize(Policy = Permisos.Politicas.Series)]
@inject ServicioDeEmpresa Empresas
@inject ServicioDeCatalogos Catalogos
@inject ServicioDeSesion Sesion
@inject IServicioDeConfirmacion Confirmacion

<PageTitle>Series de folios</PageTitle>
<TituloDePagina Texto="Series de folios" />

<PanelErrores Problema="_error" />

@* El formulario sirve para crear y, con Modificar, para editar: sin ninguna de las dos no se muestra. *@
@if (_puedeCrear || _editando is not null)
{
<TarjetaFormulario Class="tarjeta-formulario-catalogo series-formulario">

<section class="formulario-catalogo-seccion" aria-labelledby="serie-datos">
<h2 id="serie-datos" class="seccion-titulo">@(_editando is null ? "Nueva serie" : $"Editar serie {_editando.Prefijo}")</h2>
<p class="seccion-ayuda">Define la numeración para cada tipo de comprobante.</p>

<div class="series-rejilla">
    <MudTextField @bind-Value="_prefijo" Label="Prefijo" MaxLength="25" Class="cifra-tabular"
                  Disabled="_guardando" HelperText="Solo letras y números." />

    <MudNumericField @bind-Value="_folioInicial" Label="Folio inicial" Min="1" Class="cifra-tabular"
                     Disabled="@(_guardando || (_editando is not null && _editando.FolioActual >= _editando.FolioInicial))"
                     HelperText="@(_editando is not null && _editando.FolioActual >= _editando.FolioInicial
                                   ? "La serie ya entregó folios; no se puede cambiar."
                                   : "Número con el que comenzará la serie.")" />

    <MudSelect T="string" @bind-Value="_tipoComprobante" Label="Tipo de comprobante" Disabled="_guardando">
        @foreach (var tipo in Catalogos.Obtener("c_TipoDeComprobante"))
        {
            <MudSelectItem T="string" Value="@tipo.Clave">@tipo.Clave — @tipo.Descripcion</MudSelectItem>
        }
    </MudSelect>

    <MudCheckBox @bind-Value="_activa" Label="Serie activa" Disabled="@(_guardando || !_puedeDesactivar)" />
</div>
</section>

<div class="tarjeta-formulario-acciones">
    <span class="catalogo-acciones-ayuda">Los folios se reservan al timbrar y no se reutilizan.</span>
    @if (_editando is not null)
    {
        <MudButton Variant="Variant.Text" OnClick="Limpiar" Disabled="_guardando">Cancelar edición</MudButton>
    }
    <MudButton Variant="Variant.Filled" OnClick="Guardar" Disabled="_guardando">
        @(_guardando ? "Guardando…" : _editando is null ? "Crear serie" : "Guardar cambios")
    </MudButton>
</div>
</TarjetaFormulario>
}

<section class="series-listado" aria-labelledby="series-registradas">
<h2 id="series-registradas" class="seccion-titulo">Series registradas</h2>
<p class="seccion-ayuda">Las series inactivas conservan su historial.</p>

@if (_series.Count == 0)
{
    <p class="tabla-datos-estado">Todavía no hay ninguna serie.</p>
}
else
{
    <MudTable T="SerieDto" Items="_series" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Prefijo</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Folio inicial</MudTh>
            <MudTh>Último entregado</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate Context="serie">
                    <MudTd DataLabel="Prefijo" Class="cifra-tabular">@serie.Prefijo</MudTd>
                    <MudTd DataLabel="Tipo">@serie.TipoComprobante — @DescripcionTipo(serie.TipoComprobante)</MudTd>
                    <MudTd DataLabel="Folio inicial" Class="cifra-tabular">@serie.FolioInicial</MudTd>
                    <MudTd DataLabel="Último entregado" Class="cifra-tabular">
                        @(serie.FolioActual < serie.FolioInicial ? "—" : serie.FolioActual.ToString())
                    </MudTd>
                    <MudTd DataLabel="Estado">
                        <span class="indicador-estado indicador-estado-@(serie.Activa ? "timbrada" : "borrador")">
                            @(serie.Activa ? "Activa" : "Inactiva")
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Acciones">
                        @if (_puedeModificar)
                        {
                            <MudButton Size="Size.Small" OnClick="() => Editar(serie)" Disabled="_guardando"
                                       aria-label="@($"Editar serie {serie.Prefijo}")">Editar</MudButton>
                        }
                        @if (_puedeDesactivar)
                        {
                            <MudButton Size="Size.Small" OnClick="() => CambiarActiva(serie)" Disabled="_guardando">
                                @(serie.Activa ? "Desactivar" : "Reactivar")
                            </MudButton>
                        }
                        @* Una serie que ya entregó folios no se puede borrar; ni se ofrece. *@
                        @if (_puedeEliminar && serie.FolioActual < serie.FolioInicial)
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => Eliminar(serie)" Disabled="_guardando"
                                       aria-label="@($"Eliminar serie {serie.Prefijo}")">Eliminar</MudButton>
                        }
                    </MudTd>
        </RowTemplate>
    </MudTable>
}
</section>

@code {
    private IReadOnlyList<SerieDto> _series = [];
    private DetalleProblema? _error;
    private SerieDto? _editando;
    private bool _guardando;

    private string _prefijo = string.Empty;
    private int _folioInicial = 1;
    private string _tipoComprobante = "I";
    private bool _activa = true;

    // Comodidad visual: lo que el servidor rechazaría ni se ofrece.
    private bool _puedeCrear, _puedeModificar, _puedeDesactivar, _puedeEliminar;

    private string DescripcionTipo(string clave)
        => Catalogos.Obtener("c_TipoDeComprobante").FirstOrDefault(tipo => tipo.Clave == clave)?.Descripcion ?? clave;

    protected override async Task OnInitializedAsync()
    {
        _puedeCrear = Sesion.TienePermiso(Permisos.SeriesCrear);
        _puedeModificar = Sesion.TienePermiso(Permisos.SeriesModificar);
        _puedeDesactivar = Sesion.TienePermiso(Permisos.SeriesDesactivar);
        _puedeEliminar = Sesion.TienePermiso(Permisos.SeriesEliminar);

        await RecargarAsync();
    }

    private async Task RecargarAsync() => _series = await Empresas.ListarSeriesAsync();

    private void Editar(SerieDto serie)
    {
        _editando = serie;
        _prefijo = serie.Prefijo;
        _folioInicial = serie.FolioInicial;
        _tipoComprobante = serie.TipoComprobante;
        _activa = serie.Activa;
        _error = null;
    }

    private void Limpiar()
    {
        _editando = null;
        _prefijo = string.Empty;
        _folioInicial = 1;
        _tipoComprobante = "I";
        _activa = true;
        _error = null;
    }

    private async Task CambiarActiva(SerieDto serie)
    {
        var (_, error) = await Empresas.CambiarSerieActivaAsync(serie.Id, !serie.Activa);

        _error = error;

        if (error is null) await RecargarAsync();
    }

    /// <summary>Solo prospera si la serie no dio folios ni la usa un borrador; si no, el servidor pide desactivarla.</summary>
    private async Task Eliminar(SerieDto serie)
    {
        var confirmado = await Confirmacion.ConfirmarAsync(
            "Eliminar serie",
            $"La serie {serie.Prefijo} se borrará de forma definitiva. Solo es posible si ningún comprobante la usa.",
            "Eliminar");

        if (!confirmado) return;

        _error = await Empresas.EliminarSerieAsync(serie.Id);

        if (_error is null)
        {
            if (_editando?.Id == serie.Id) Limpiar();
            await RecargarAsync();
        }
    }

    private async Task Guardar()
    {
        _guardando = true;
        _error = null;

        var peticion = new PeticionGuardarSerie(_prefijo, _folioInicial, _tipoComprobante, _activa);

        var (exito, error) = _editando is null
            ? await Empresas.CrearSerieAsync(peticion)
            : await Empresas.ActualizarSerieAsync(_editando.Id, peticion);

        _guardando = false;

        if (error is not null)
        {
            _error = error;
            return;
        }

        if (exito is not null)
        {
            Limpiar();
            await RecargarAsync();
        }
    }
}
