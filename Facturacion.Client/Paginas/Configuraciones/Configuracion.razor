@page "/configuracion"
@attribute [Authorize(Policy = Permisos.Politicas.Configuracion)]
@inject ServicioDeEmpresa Empresas
@inject IServicioDeConfirmacion Confirmacion
@inject ServicioDeSesion Sesion
@using Facturacion.Client.Componentes.Empresas

@* El logo se guarda al seleccionarlo; los demás cambios se envían con Guardar. *@

<PageTitle>Configuración</PageTitle>
<TituloDePagina Texto="Configuración" />

<TarjetaFormulario Class="tarjeta-formulario-catalogo cliente-configuracion">
<PanelErrores Problema="_error" />

@if (_cargando)
{
    <p>Cargando…</p>
}
else
{
    <MudTabs @bind-ActivePanelIndex="_pestana">

        <MudTabPanel Text="General" Icon="@Icons.Material.Filled.Tune" Visible="_general">
            <div class="formulario-catalogo-secciones">
            <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="cliente-config-logo">
            <h2 id="cliente-config-logo" class="seccion-titulo">Logo de la empresa</h2>
            <p class="seccion-ayuda">
                PNG o JPG, hasta 2 MB. Se muestra en el PDF.
            </p>
            <p class="cliente-config-guardado-inmediato" role="note">El logo se guarda al seleccionarlo, sin pulsar Guardar.</p>
            <div class="logo-empresa">
                @if (_logo is not null)
                {
                    <img src="@_logo" alt="Logo de la empresa" class="logo-empresa-vista" />
                }
                else
                {
                    <div class="logo-empresa-vacio">Sin logo</div>
                }

                <div class="logo-empresa-acciones">
                    <MudFileUpload T="IBrowserFile" FilesChanged="SubirLogoAsync" Accept=".png,.jpg,.jpeg">
                        <CustomContent Context="carga">
                            <MudButton Variant="Variant.Outlined" Disabled="_trabajandoLogo"
                                       StartIcon="@Icons.Material.Filled.Upload"
                                       OnClick="@(() => carga.OpenFilePickerAsync())">
                                @(_logo is null ? "Agregar logo" : "Cambiar logo")
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>
                    <MudButton Variant="Variant.Text" Disabled="@(_logo is null || _trabajandoLogo)"
                               StartIcon="@Icons.Material.Filled.Delete" OnClick="QuitarLogoAsync">
                        Quitar logo
                    </MudButton>
                </div>
            </div>
            @if (_errorLogo is not null)
            {
                <p class="texto-error" role="alert">@_errorLogo</p>
            }
            </section>

            <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="cliente-config-avisos">
            <h2 id="cliente-config-avisos" class="seccion-titulo">Notificaciones</h2>
            <div class="rejilla-campos">
                <MudNumericField @bind-Value="_diasAviso" Label="Avisar caducidad del certificado"
                                 Min="1" Max="365" HelperText="Días antes de que caduque."
                                 Error="@(ErrorDiasAviso is not null)" ErrorText="@ErrorDiasAviso"
                                 Class="cifra-tabular" />
            </div>
            </section>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Correo" Icon="@Icons.Material.Filled.Email" Visible="_verCorreo">
            <section class="formulario-catalogo-seccion" aria-labelledby="cliente-config-correo"
                     @oninput="LimpiarPruebaSmtp" @onchange="LimpiarPruebaSmtp">
            <h2 id="cliente-config-correo" class="seccion-titulo">Envío de comprobantes</h2>
            <p class="seccion-ayuda">
                Solo aplica al envío de comprobantes.
            </p>

            <MudSwitch @bind-Value="_habilitado" Label="Usar mi propio servidor de correo" Color="Color.Primary" />

            @if (_habilitado)
            {
                <h3 class="cliente-config-subtitulo">Conexión SMTP</h3>
                <div class="catalogo-rejilla catalogo-rejilla-dos">
                    <MudTextField @bind-Value="_servidor" Label="Servidor SMTP" Placeholder="smtp.miempresa.com"
                                  MaxLength="253" Immediate="true"
                                  Error="@(ErrorServidor is not null)" ErrorText="@ErrorServidor" />
                    <MudNumericField @bind-Value="_puerto" Label="Puerto"
                                     HideSpinButtons="true" Immediate="true" Class="cifra-tabular"
                                     HelperText="465 o 587."
                                     Error="@(ErrorPuerto is not null)" ErrorText="@ErrorPuerto" />
                    <MudTextField @bind-Value="_usuario" Label="Usuario" Placeholder="facturas@miempresa.com"
                                  MaxLength="254" Immediate="true"
                                  Error="@(ErrorUsuario is not null)" ErrorText="@ErrorUsuario" />
                    <MudTextField @bind-Value="_contrasena" Label="Contraseña"
                                  InputType="@(_verContrasena ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_verContrasena ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  AdornmentAriaLabel="@(_verContrasena ? "Ocultar contraseña" : "Mostrar contraseña")"
                                  OnAdornmentClick="@(() => _verContrasena = !_verContrasena)"
                                  MaxLength="512" Immediate="true"
                                  HelperText="@(_tieneContrasena ? "Guardada; déjala vacía para conservarla." : "Sin contraseña guardada.")"
                                  Error="@(ErrorContrasena is not null)" ErrorText="@ErrorContrasena" />
                </div>

                <div class="rejilla-campos">
                    <MudSwitch T="bool" Value="true" Disabled="true" Color="Color.Primary"
                               Label="Requiere autenticación SSL/TLS" />
                </div>
                <p class="seccion-ayuda">
                    Conexión cifrada. En Gmail, usa una contraseña de aplicación.
                </p>

                <h3 class="cliente-config-subtitulo">Remitente (De)</h3>
                <div class="catalogo-rejilla catalogo-rejilla-dos">
                    <MudTextField @bind-Value="_remitenteNombre" Label="Nombre del remitente" Placeholder="Facturación Mi Empresa"
                                  MaxLength="128" Immediate="true" />
                    <MudTextField @bind-Value="_remitenteCorreo" Label="Correo del remitente" Placeholder="facturas@miempresa.com"
                                  InputType="InputType.Email" MaxLength="254" Immediate="true"
                                  HelperText="Normalmente, la misma cuenta del usuario."
                                  Error="@(ErrorRemitente is not null)" ErrorText="@ErrorRemitente" />
                </div>
            }
            else
            {
                <h3 class="cliente-config-subtitulo">Remitente del sistema</h3>
                <div class="catalogo-rejilla catalogo-rejilla-dos">
                    <MudTextField @bind-Value="_nombreRemitenteSistema" Label="Nombre del remitente"
                                  Placeholder="Facturación Mi Empresa" MaxLength="128" Immediate="true"
                                  HelperText="Vacío: el nombre del sistema."
                                  Error="@(ErrorNombreRemitenteSistema is not null)" ErrorText="@ErrorNombreRemitenteSistema" />
                    <MudTextField @bind-Value="_responderA" Label="Responder a" Placeholder="contacto@miempresa.com"
                                  InputType="InputType.Email" MaxLength="254" Immediate="true"
                                  HelperText="Vacío: el correo de contacto de Mi empresa."
                                  Error="@(ErrorResponderA is not null)" ErrorText="@ErrorResponderA" />
                </div>
            }
            @if (_habilitado)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ProbarSmtp" Disabled="@(_probandoSmtp || _guardando)">
                    @(_probandoSmtp ? "Comprobando…" : "Probar conexión")
                </MudButton>
                @if (_avisoSmtp is not null)
                {
                    <p class="mensaje-exito" role="status">@_avisoSmtp</p>
                }
            }
            </section>
        </MudTabPanel>

        <MudTabPanel Text="Impuestos" Icon="@Icons.Material.Filled.Percent" Visible="_impuestos">
            <p class="seccion-ayuda">
                Tasas sugeridas para productos. Cada factura usa los impuestos guardados en sus conceptos.
            </p>

            <div class="formulario-catalogo-secciones">
            <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="cliente-config-traslados">
            <h2 id="cliente-config-traslados" class="seccion-titulo">Impuestos trasladados</h2>
            <div class="catalogo-rejilla catalogo-rejilla-dos">
                <MudNumericField @bind-Value="_ivaPct" Label="IVA %" Min="0M" Max="100M" Step="1M" Format="N2"
                                 Class="cifra-tabular" />
                <MudNumericField @bind-Value="_iepsPct" Label="IEPS %" Min="0M" Max="100M" Format="N2"
                                 Class="cifra-tabular" />
            </div>
            </section>

            <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="cliente-config-retenciones">
            <h2 id="cliente-config-retenciones" class="seccion-titulo">Impuestos retenidos</h2>
            <p class="seccion-ayuda">Usa cero si no aplica.</p>
            <div class="catalogo-rejilla catalogo-rejilla-tres">
                <MudNumericField @bind-Value="_retIvaPct" Label="IVA %" Min="0M" Max="100M" Format="N2"
                                 Class="cifra-tabular" />
                <MudNumericField @bind-Value="_retIsrPct" Label="ISR %" Min="0M" Max="100M" Format="N2"
                                 Class="cifra-tabular" />
                <MudNumericField @bind-Value="_retIepsPct" Label="IEPS %" Min="0M" Max="100M" Format="N2"
                                 Class="cifra-tabular" />
            </div>
            </section>

            <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="cliente-config-locales">
            <h2 id="cliente-config-locales" class="seccion-titulo">Impuestos locales</h2>
            <p class="seccion-ayuda">
                Su aplicación depende del documento.
            </p>
            <div class="rejilla-campos">
                <MudNumericField @bind-Value="_ishPct" Label="ISH %" Min="0M" Max="100M" Format="N2"
                                 Class="cifra-tabular" HelperText="Impuesto sobre hospedaje." />
            </div>
            </section>
            </div>
        </MudTabPanel>

        @* Solo el titular da de alta empresas; el servidor lo exige igual y respeta el límite
           de la cuenta. Tiene su propio botón: no es parte de «Guardar configuración». *@
        <MudTabPanel Text="Nueva empresa" Icon="@Icons.Material.Filled.DomainAdd" Visible="_titular">
            <FormularioDeNuevaEmpresa />
        </MudTabPanel>
    </MudTabs>

    @if (_pestana != PestanaNuevaEmpresa)
    {
    <div class="tarjeta-formulario-acciones">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync"
                   Disabled="@(_guardando || _probandoSmtp || !HayCambios)">
            @(_guardando ? "Guardando…" : "Guardar configuración")
        </MudButton>
        <MudButton Variant="Variant.Text" OnClick="Cancelar" Disabled="@(_guardando || _probandoSmtp || !HayCambios)">
            Cancelar
        </MudButton>

        @if (_guardado)
        {
            <span class="mensaje-exito" role="status">Configuración guardada.</span>
        }
    </div>
    }
}
</TarjetaFormulario>

@code {
    private const long TopeLogo = 2 * 1024 * 1024;

    private bool _cargando = true, _guardando, _guardado, _trabajandoLogo, _verContrasena;
    private int _pestana;
    private DetalleProblema? _error;
    private string? _errorLogo;
    private bool _probandoSmtp;
    private string? _avisoSmtp;
    private int _versionSmtp;

    private string? _logo;

    // Lo último que confirmó el servidor: contra esto se calcula qué cambió y a qué vuelve «Cancelar».
    private ConfiguracionEmpresaDto _configuracion = null!;
    private CorreoDeEmpresaDto _correo = null!;

    // Las tasas se capturan en por ciento, como en el sistema anterior; viajan como fracción.
    private decimal _ivaPct, _iepsPct, _retIvaPct, _retIsrPct, _retIepsPct, _ishPct;
    private int _diasAviso;

    private bool _habilitado, _tieneContrasena;
    private string? _servidor, _usuario, _contrasena, _remitenteNombre, _remitenteCorreo;
    private string? _nombreRemitenteSistema, _responderA;
    private int _puerto;

    // Cada pestaña es una casilla de Configuración: solo se muestran, y solo se cargan, las que
    // el usuario tiene. El servidor rechaza igual tocar la parte que no tiene.
    private bool _general, _verCorreo, _impuestos, _titular;

    private const int PestanaNuevaEmpresa = 3;

    private void LimpiarPruebaSmtp()
    {
        _avisoSmtp = null;
        _versionSmtp++;
    }

    private async Task ProbarSmtp()
    {
        if (_probandoSmtp || _guardando || !_habilitado) return;
        _probandoSmtp = true;
        _avisoSmtp = null;
        _error = null;
        var version = _versionSmtp;
        try
        {
            _error = await Empresas.ProbarCorreoAsync(CorreoCapturado);
            if (_error is null && version == _versionSmtp)
                _avisoSmtp = "Conexión y autenticación correctas. No se guardaron cambios ni se envió correo.";
        }
        finally { _probandoSmtp = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        _general = Sesion.TienePermiso(Permisos.ConfiguracionGeneral);
        _verCorreo = Sesion.TienePermiso(Permisos.ConfiguracionCorreo);
        _impuestos = Sesion.TienePermiso(Permisos.ConfiguracionImpuestos);
        _titular = Sesion.TienePermiso(Permisos.Titular);
        _pestana = _general ? 0 : _verCorreo ? 1 : 2;

        try
        {
            var configuracion = Empresas.ObtenerConfiguracionAsync();
            var correo = _verCorreo ? Empresas.ObtenerCorreoAsync() : Task.FromResult<CorreoDeEmpresaDto?>(null);
            var logo = _general ? CargarLogoAsync() : Task.CompletedTask;

            await Task.WhenAll(configuracion, correo, logo);

            AplicarConfiguracion((await configuracion)!);

            if (await correo is { } guardado) AplicarCorreo(guardado);
        }
        finally
        {
            _cargando = false;
        }
    }

    // ── Logo ────────────────────────────────────────────────────────────────────────

    private async Task CargarLogoAsync()
    {
        try
        {
            var logo = await Empresas.ObtenerLogoAsync();
            _logo = logo is { } l ? $"data:{l.TipoMime};base64,{Convert.ToBase64String(l.Contenido)}" : null;
        }
        catch (HttpRequestException)
        {
            _errorLogo = "No se pudo cargar el logo.";
        }
    }

    private async Task SubirLogoAsync(IBrowserFile? archivo)
    {
        if (archivo is null) return;

        _errorLogo = null;
        _error = null;
        _trabajandoLogo = true;

        try
        {
            await using var flujo = archivo.OpenReadStream(TopeLogo);
            var error = await Empresas.SubirLogoAsync(flujo, archivo.Name);

            if (error is not null)
            {
                _error = error;
                return;
            }

            await CargarLogoAsync();
        }
        catch (IOException)
        {
            _errorLogo = "El logo pesa más de 2 MB.";
        }
        finally
        {
            _trabajandoLogo = false;
        }
    }

    private async Task QuitarLogoAsync()
    {
        if (!await Confirmacion.ConfirmarAsync(
                "Quitar logo", "Los PDF nuevos saldrán sin logo. ¿Quitarlo?", "Quitar", esPeligrosa: true))
            return;

        _trabajandoLogo = true;

        try
        {
            await Empresas.QuitarLogoAsync();
            _logo = null;
        }
        finally
        {
            _trabajandoLogo = false;
        }
    }

    // ── Validación inmediata (la que cuenta es la del servidor) ─────────────────────

    private string? ErrorDiasAviso => _diasAviso is < 1 or > 365 ? "Entre 1 y 365 días." : null;

    private string? ErrorServidor => _habilitado && string.IsNullOrWhiteSpace(_servidor)
        ? "Escribe el servidor SMTP." : null;

    private string? ErrorPuerto => _habilitado && _puerto is not (PuertosSmtp.SslDirecto or PuertosSmtp.StartTls)
        ? "Usa 465 (SSL directo) o 587 (STARTTLS)." : null;

    private string? ErrorUsuario => _habilitado && string.IsNullOrWhiteSpace(_usuario)
        ? "Escribe el usuario." : null;

    private string? ErrorContrasena => _habilitado && !_tieneContrasena && string.IsNullOrEmpty(_contrasena)
        ? "Escribe la contraseña." : null;

    private string? ErrorRemitente => !_habilitado ? null
        : string.IsNullOrWhiteSpace(_remitenteCorreo) ? "Escribe el correo del remitente."
        : !PareceCorreo(_remitenteCorreo.Trim()) ? "Escribe solo la dirección, como facturas@miempresa.com."
        : null;

    private string? ErrorNombreRemitenteSistema => !_habilitado && _nombreRemitenteSistema?.Contains('@') == true
        ? "Sin «@»: el nombre no debe parecer otra dirección." : null;

    private string? ErrorResponderA => !_habilitado && !string.IsNullOrWhiteSpace(_responderA) && !PareceCorreo(_responderA.Trim())
        ? "Escribe solo la dirección, como contacto@miempresa.com." : null;

    private bool CorreoTieneErrores
        => ErrorServidor is not null || ErrorPuerto is not null || ErrorUsuario is not null ||
           ErrorContrasena is not null || ErrorRemitente is not null ||
           ErrorNombreRemitenteSistema is not null || ErrorResponderA is not null;

    private static bool PareceCorreo(string texto)
    {
        var arroba = texto.IndexOf('@');
        return arroba > 0 && arroba == texto.LastIndexOf('@') && !texto.Any(char.IsWhiteSpace) &&
               texto.IndexOf('.', arroba) > arroba + 1 && !texto.EndsWith('.');
    }

    // ── Guardar y cancelar ──────────────────────────────────────────────────────────

    private ConfiguracionEmpresaDto ConfiguracionCapturada => new(
        TasaIvaPorDefecto: AFraccion(_ivaPct),
        TasaIepsPorDefecto: AFraccion(_iepsPct),
        TasaRetencionIvaPorDefecto: AFraccion(_retIvaPct),
        TasaRetencionIsrPorDefecto: AFraccion(_retIsrPct),
        TasaRetencionIepsPorDefecto: AFraccion(_retIepsPct),
        TasaIshPorDefecto: AFraccion(_ishPct),
        DiasAvisoCaducidadCertificado: _diasAviso);

    private PeticionGuardarCorreoDeEmpresa CorreoCapturado => new(
        _habilitado, _servidor, _puerto, _usuario,
        string.IsNullOrEmpty(_contrasena) ? null : _contrasena, _remitenteNombre, _remitenteCorreo,
        _nombreRemitenteSistema, _responderA);

    private bool ConfiguracionCambio => ConfiguracionCapturada != _configuracion;

    private bool CorreoCambio
        => _verCorreo && _correo is not null &&
           (_habilitado != _correo.Habilitado || _puerto != _correo.Puerto || !string.IsNullOrEmpty(_contrasena) ||
            Distinto(_servidor, _correo.Servidor) || Distinto(_usuario, _correo.Usuario) ||
            Distinto(_remitenteNombre, _correo.RemitenteNombre) || Distinto(_remitenteCorreo, _correo.RemitenteCorreo) ||
            Distinto(_nombreRemitenteSistema, _correo.NombreRemitenteSistema) || Distinto(_responderA, _correo.ResponderA));

    private bool HayCambios => ConfiguracionCambio || CorreoCambio;

    private static bool Distinto(string? a, string? b)
        => !string.Equals(string.IsNullOrWhiteSpace(a) ? null : a.Trim(), b, StringComparison.Ordinal);

    private async Task GuardarAsync()
    {
        _error = null;
        _guardado = false;

        if (ErrorDiasAviso is not null)
        {
            _pestana = 0;
            return;
        }

        if (CorreoCambio && CorreoTieneErrores)
        {
            _pestana = 1;
            return;
        }

        _guardando = true;

        try
        {
            // El correo primero: es el que puede fallar por el DNS, y así un error no deja las
            // tasas guardadas a medias con un aviso que hable de otra pestaña.
            if (CorreoCambio)
            {
                var (correo, errorCorreo) = await Empresas.GuardarCorreoAsync(CorreoCapturado);

                if (errorCorreo is not null)
                {
                    _error = errorCorreo;
                    _pestana = 1;
                    return;
                }

                AplicarCorreo(correo!);
            }

            if (ConfiguracionCambio)
            {
                var (configuracion, errorConfiguracion) = await Empresas.GuardarConfiguracionAsync(ConfiguracionCapturada);

                if (errorConfiguracion is not null)
                {
                    _error = errorConfiguracion;
                    return;
                }

                AplicarConfiguracion(configuracion!);
            }

            _guardado = true;
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Cancelar()
    {
        _error = null;
        _guardado = false;
        AplicarConfiguracion(_configuracion);
        if (_correo is not null) AplicarCorreo(_correo);
    }

    private void AplicarConfiguracion(ConfiguracionEmpresaDto c)
    {
        _configuracion = c;
        _ivaPct = APorciento(c.TasaIvaPorDefecto);
        _iepsPct = APorciento(c.TasaIepsPorDefecto);
        _retIvaPct = APorciento(c.TasaRetencionIvaPorDefecto);
        _retIsrPct = APorciento(c.TasaRetencionIsrPorDefecto);
        _retIepsPct = APorciento(c.TasaRetencionIepsPorDefecto);
        _ishPct = APorciento(c.TasaIshPorDefecto);
        _diasAviso = c.DiasAvisoCaducidadCertificado;
    }

    private void AplicarCorreo(CorreoDeEmpresaDto c)
    {
        _correo = c;
        _habilitado = c.Habilitado;
        _servidor = c.Servidor;
        _puerto = c.Puerto;
        _usuario = c.Usuario;
        _tieneContrasena = c.TieneContrasena;
        _contrasena = null;
        _remitenteNombre = c.RemitenteNombre;
        _remitenteCorreo = c.RemitenteCorreo;
        _nombreRemitenteSistema = c.NombreRemitenteSistema;
        _responderA = c.ResponderA;
    }

    private static decimal APorciento(decimal fraccion) => fraccion * 100m;

    // Seis decimales, como la columna: 10.6667 % se guarda como 0.106667.
    private static decimal AFraccion(decimal porciento) => Math.Round(porciento / 100m, 6);
}
