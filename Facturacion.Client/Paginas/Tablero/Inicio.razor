@page "/"
@attribute [Authorize]
@inject ServicioDeTablero Tablero

@*
    Tablero de la mitad A. El conteo de comprobantes por estatus no está aquí a propósito:
    se lee por IResumenDocumentos, que es de la mitad B y todavía no tiene implementación.
    Antes que enseñar un recuadro en ceros —que se lee como «hoy no facturaste», no como
    «esto aún no existe»— se omite. El enganche está en ServicioDeTablero, del servidor.
*@

<PageTitle>Inicio</PageTitle>
<TituloDePagina Texto="Inicio" />

@if (_datos is null)
{
    <p>Cargando…</p>
}
else
{
    @* Primero lo que impide facturar, después las cifras. Un contador que abre la
       aplicación necesita ver el estorbo antes que el saldo. *@

    @if (_datos.Certificado is { HayActivo: false })
    {
        <div class="aviso-caducidad aviso-critico">
            <p>
                Aun no cuenta con ningún certificado de sello digital. Sin él no se puede timbrar.
                <a href="empresa/certificados">Cargar certificado</a>
            </p>
        </div>
    }
    else if (_datos.Certificado is { PorCaducar: true } certificado)
    {
        <div class="aviso-caducidad @(certificado.DiasParaCaducar < 0 ? "aviso-critico" : "")">
            <p>
                @(certificado.DiasParaCaducar < 0
                    ? $"El certificado de sello digital caducó hace {-certificado.DiasParaCaducar} días y ya no permite timbrar."
                    : $"El certificado de sello digital caduca en {certificado.DiasParaCaducar} días.")
                <a href="empresa/certificados">Ver certificados</a>
            </p>
        </div>
    }

    @if (_datos.MembresiaEnAviso && _datos.Membresia is { } membresia)
    {
        <div class="aviso-caducidad @(membresia.DiasParaVencer < 0 ? "aviso-critico" : "")">
            <p>
                @(membresia.DiasParaVencer < 0
                    ? $"La membresía venció hace {-membresia.DiasParaVencer} días."
                    : $"La membresía vence en {membresia.DiasParaVencer} días.")
            </p>
        </div>
    }

    @if (_datos.Timbres.Disponibles < _datos.UmbralAvisoTimbres)
    {
        <div class="aviso-caducidad @(_datos.Timbres.Disponibles == 0 ? "aviso-critico" : "")">
            <p>
                @(_datos.Timbres.Disponibles == 0
                    ? "No quedan timbres disponibles."
                    : $"Quedan {_datos.Timbres.Disponibles} timbres.")
                <SiTienePermiso Permiso="@Permisos.ComprarTimbres">
                    <a href="timbres">Comprar timbres</a>
                </SiTienePermiso>
            </p>
        </div>
    }

    <h2 class="seccion-titulo">Timbres</h2>

    <div class="tarjetas-saldo">
        <div class="tarjeta-saldo">
            <span class="tarjeta-saldo-cifra cifra-tabular">@_datos.Timbres.Disponibles</span>
            <span class="tarjeta-saldo-etiqueta">Disponibles</span>
        </div>
        <div class="tarjeta-saldo">
            <span class="tarjeta-saldo-cifra cifra-tabular">@_datos.Timbres.Reservados</span>
            <span class="tarjeta-saldo-etiqueta">Reservados</span>
        </div>
        @if (_datos.Membresia is { } vigente)
        {
            <div class="tarjeta-saldo">
                <span class="tarjeta-saldo-cifra cifra-tabular">@vigente.DiasParaVencer</span>
                <span class="tarjeta-saldo-etiqueta">Días de membresía</span>
            </div>
        }
    </div>

    @if (_datos.Documentos is { } documentos)
    {
        <div class="rejilla-panel">
            <div class="tramo-8">
                <section class="panel">
                    <header class="panel-encabezado">
                        <h2 class="panel-titulo">Facturado por mes</h2>
                        <span class="panel-nota">Últimos seis meses</span>
                    </header>
                    <div class="panel-cuerpo">
                        @if (_hayHistorial)
                        {
                            <MudChart T="double" ChartType="ChartType.Bar"
                                      ChartSeries="@_serieImporte"
                                      ChartLabels="@_etiquetasMes"
                                      Width="100%" Height="260px" />
                        }
                        else
                        {
                            <p class="tabla-datos-estado">Todavía no hay comprobantes timbrados que graficar.</p>
                        }
                    </div>
                </section>
            </div>

            <div class="tramo-4">
                <section class="panel">
                    <header class="panel-encabezado">
                        <h2 class="panel-titulo">Comprobantes de @Mes(documentos.Desde)</h2>
                    </header>
                    <div class="panel-cuerpo">
                        @if (_hayComprobantesDelMes)
                        {
                            <MudChart T="double" ChartType="ChartType.Donut"
                                      ChartSeries="@_seriePorEstatus"
                                      ChartLabels="@_etiquetasEstatus"
                                      Width="100%" Height="220px" />
                        }
                        else
                        {
                            <p class="tabla-datos-estado">Sin comprobantes este mes.</p>
                        }
                    </div>
                </section>
            </div>

            <div class="tramo-6">
                <section class="panel">
                    <header class="panel-encabezado">
                        <h2 class="panel-titulo">Comprobantes timbrados por mes</h2>
                    </header>
                    <div class="panel-cuerpo">
                        @if (_hayHistorial)
                        {
                            <MudChart T="double" ChartType="ChartType.Line"
                                      ChartSeries="@_serieTimbrados"
                                      ChartLabels="@_etiquetasMes"
                                      Width="100%" Height="220px" />
                        }
                        else
                        {
                            <p class="tabla-datos-estado">Sin datos.</p>
                        }
                    </div>
                </section>
            </div>

            <div class="tramo-6">
                <section class="panel">
                    <header class="panel-encabezado">
                        <h2 class="panel-titulo">Resumen de @Mes(documentos.Desde)</h2>
                    </header>
                    <div class="panel-cuerpo panel-cuerpo-tabla">
                        <MudSimpleTable Dense="true" Hover="true">
                            <thead>
                                <tr><th>Estatus</th><th class="cifra-tabular">Comprobantes</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var renglon in documentos.ConteoPorEstatus)
                                {
                                    <tr>
                                        <td>@renglon.Etiqueta</td>
                                        <td class="cifra-tabular">@renglon.Cuenta</td>
                                    </tr>
                                }
                                <tr>
                                    <td><strong>Importe timbrado</strong></td>
                                    <td class="cifra-tabular"><strong>@documentos.ImporteTimbrado.ToString("C2")</strong></td>
                                </tr>
                                <tr>
                                    <td>Importe cancelado</td>
                                    <td class="cifra-tabular">@documentos.ImporteCancelado.ToString("C2")</td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>
                    </div>
                </section>
            </div>
        </div>
    }

    <h2 class="seccion-titulo">Accesos rápidos</h2>

    <div class="accesos-rapidos">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Groups"
                   Href="clientes">Clientes</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Inventory"
                   Href="productos">Productos</MudButton>
        <SiTienePermiso Permiso="@Permisos.ComprarTimbres">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ConfirmationNumber"
                       Href="timbres">Timbres</MudButton>
        </SiTienePermiso>
        <SiTienePermiso Permiso="@Permisos.ConfigurarEmpresa">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Business"
                       Href="empresa">Empresa</MudButton>
        </SiTienePermiso>
    </div>
}

@code {
    private TableroDto? _datos;

    private bool _hayHistorial;
    private bool _hayComprobantesDelMes;

    private List<ChartSeries<double>> _serieImporte = [];
    private List<ChartSeries<double>> _serieTimbrados = [];
    private List<ChartSeries<double>> _seriePorEstatus = [];
    private string[] _etiquetasMes = [];
    private string[] _etiquetasEstatus = [];

    protected override async Task OnInitializedAsync()
    {
        _datos = await Tablero.ObtenerAsync();

        if (_datos is null) return;

        _etiquetasMes = _datos.SerieMensual.Select(p => p.Etiqueta).ToArray();
        _hayHistorial = _datos.SerieMensual.Any(p => p.Timbrados > 0);

        _serieImporte =
        [
            new ChartSeries<double>
            {
                Name = "Importe",
                Data = _datos.SerieMensual.Select(p => (double)p.Importe).ToArray()
            }
        ];

        _serieTimbrados =
        [
            new ChartSeries<double>
            {
                Name = "Timbrados",
                Data = _datos.SerieMensual.Select(p => (double)p.Timbrados).ToArray()
            }
        ];

        // La dona solo lleva los estatus con comprobantes: un sector de tamaño cero no se ve
        // pero sí ocupa sitio en la leyenda.
        var conEstatus = _datos.Documentos?.ConteoPorEstatus
            .Where(r => r.Cuenta > 0)
            .ToList() ?? [];

        _hayComprobantesDelMes = conEstatus.Count > 0;
        _etiquetasEstatus = conEstatus.Select(r => r.Etiqueta).ToArray();

        _seriePorEstatus =
        [
            new ChartSeries<double>
            {
                Name = "Comprobantes",
                Data = conEstatus.Select(r => (double)r.Cuenta).ToArray()
            }
        ];
    }

    // El periodo lo decide el servidor, en el huso de la empresa; aquí solo se nombra.
    private static string Mes(DateOnly desde)
        => desde.ToString("MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-MX"));
}
