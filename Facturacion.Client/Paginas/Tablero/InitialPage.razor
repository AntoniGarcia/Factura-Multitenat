@page "/inicio"
@attribute [Authorize(Policy = Permisos.Timbrar)]
@using Facturacion.Client.Servicios.Documentos
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Documentos
@inject ServicioDeListado Listado
@inject ServicioDeEmision Emision
@inject ServicioDeCancelacion Cancelacion
@inject ServicioDeDescargas Descargas
@inject NavigationManager Navegacion
@inject IDialogService Dialogos

<PageTitle>Inicio</PageTitle>
<TituloDePagina Texto="Inicio" />
<PanelErrores Problema="_error" />

@if (_aviso is not null)
{
    <div class="aviso-documentos" role="status">@_aviso</div>
}

@* ── Pestañas ────────────────────────────────────────────────────────────────────────
   Las pestañas de estatus no llevan contenido propio: solo cambian el filtro de estatus y
   comparten UNA tabla y UNA vista previa (abajo). Así no hay cinco tablas duplicadas ni
   cinco cargas iniciales. Solo «Buscar» trae contenido: los filtros. *@
<MudTabs ActivePanelIndex="_panel" ActivePanelIndexChanged="AlCambiarPanel">
    <MudTabPanel Text="Timbrados"
                 BadgeDot="@(Conteo(EstatusComprobante.Timbrado) > 0)"
                 BadgeColor="Color.Success" />

    <MudTabPanel Text="Borradores"
                 BadgeData="@(Conteo(EstatusComprobante.Borrador) > 0 ? Conteo(EstatusComprobante.Borrador) : null)"
                 BadgeColor="Color.Info" />

    <MudTabPanel Text="Timbrando"
                 BadgeData="@(Conteo(EstatusComprobante.Timbrando) > 0 ? "!" : null)"
                 BadgeColor="Color.Warning" />

    <MudTabPanel Text="Cancelando"
                 BadgeData="@(Conteo(EstatusComprobante.EnCancelacion) > 0 ? "!" : null)"
                 BadgeColor="Color.Warning" />

    <MudTabPanel Text="Cancelados"
                 BadgeDot="@(Conteo(EstatusComprobante.Cancelado) > 0)"
                 BadgeColor="Color.Error" />

    <MudTabPanel Icon="@Icons.Material.Filled.Search" Text="Buscar">
        <section class="documentos-filtros" aria-label="Filtros de documentos">
            <div class="filtros-documentos">
                <MudTextField T="string"
                              Label="Buscar"
                              Value="_texto"
                              ValueChanged="AlBuscar"
                              DebounceInterval="300"
                              Immediate="true"
                              Clearable="true"
                              Placeholder="RFC, nombre o folio…" />

                <MudSelect T="string"
                           Label="Tipo"
                           Value="_tipoComprobante"
                           ValueChanged="AlFiltrarTipo"
                           Clearable="true">
                    <MudSelectItem T="string" Value="@(null)">Todos</MudSelectItem>
                    <MudSelectItem T="string" Value="@("I")">Facturas</MudSelectItem>
                    <MudSelectItem T="string" Value="@("P")">Pagos</MudSelectItem>
                    <MudSelectItem T="string" Value="@("T")">Traslados</MudSelectItem>
                </MudSelect>

                <CampoFecha Label="Desde" ValorUtc="_desdeUtc" ValorUtcCambiado="AlCambiarDesde" />
                <CampoFecha Label="Hasta" ValorUtc="_hastaUtc" ValorUtcCambiado="AlCambiarHasta" />
            </div>
        </section>
    </MudTabPanel>
</MudTabs>

@* ── Área de trabajo: listado + vista previa ───────────────────────────────────────────
   Dos columnas fijas siempre, no solo cuando hay algo seleccionado: la vista previa
   (columna derecha) queda pegada arriba con position: sticky (ver CSS de
   .vista-documento) y muestra un estado vacío mientras no se elige ningún renglón. La
   tabla recibe una altura fija (Height) para que, con muchos documentos, el scroll pase
   por dentro del listado y los botones de paginación no se pierdan más abajo. *@
<div class="documentos-area documentos-area-con-vista">
    <section class="documentos-listado" aria-label="Resultados">
        <TablaDatos T="ComprobanteEnListaDto"
                    @ref="_tabla"
                    Columnas="_columnas"
                    CargarPagina="CargarAsync"
                    AlHacerClic="Previsualizar"
                    EsSeleccionado="EsSeleccionado"
                    TextoEntidad="documentos"
                    TextoSinDatos="No hay documentos que coincidan."
                    TamanoPagina="15"
                    Height="calc(100vh - var(--alto-barra) - (var(--margen-pagina) * 2))" />
    </section>

    <aside class="vista-documento" aria-label="Vista previa del documento">
        @if (_seleccionado is { } seleccionado)
        {
            <header class="vista-documento-cabecera">
                <div>
                    <span class="vista-documento-sobretitulo">Vista previa</span>
                    <h2>@Folio(seleccionado)</h2>
                    <span>@seleccionado.ReceptorNombre</span>
                </div>
                <button type="button" class="vista-documento-cerrar" @onclick="CerrarVistaPrevia"
                        aria-label="Cerrar vista previa" title="Cerrar">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </header>

            <div class="vista-documento-estado">
                <IndicadorEstado Estatus="seleccionado.Estatus" />
                <span class="cifra-tabular">@seleccionado.FechaEmisionUtc.ToLocalTime().ToString("dd/MM/yyyy")</span>
            </div>

            @if (_cargandoVista)
            {
                <div class="vista-documento-cargando" role="status">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    <span>Cargando documento…</span>
                </div>
            }
            else if (_detalleSeleccionado is { } detalle)
            {
                <div class="vista-documento-cuerpo">
                    <section>
                        <h3>Receptor</h3>
                        <strong>@detalle.ReceptorNombre</strong>
                        <span class="cifra-tabular">@detalle.ReceptorRfc</span>
                        @if (!string.IsNullOrWhiteSpace(detalle.ReceptorDomicilioFiscal))
                        {
                            <span>CP @detalle.ReceptorDomicilioFiscal · Régimen @detalle.ReceptorRegimenFiscal</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(detalle.ReceptorUsoCfdi))
                        {
                            <span>Uso CFDI: @detalle.ReceptorUsoCfdi</span>
                        }
                    </section>

                    <section>
                        <h3>Conceptos</h3>
                        @if (detalle.Conceptos.Count > 0)
                        {
                            <div class="vista-documento-conceptos">
                                @foreach (var concepto in detalle.Conceptos)
                                {
                                    <div class="vista-documento-concepto">
                                        <div>
                                            <strong>@concepto.Descripcion</strong>
                                            <span class="cifra-tabular">@concepto.Cantidad.ToString("N2") × @concepto.ValorUnitario.ToString("N2")</span>
                                        </div>
                                        <strong class="cifra-tabular">@concepto.Importe.ToString("N2")</strong>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <span>Consulta el documento completo para ver su información de pago.</span>
                        }
                    </section>

                    <dl class="vista-documento-totales">
                        <div><dt>Subtotal</dt><dd>@detalle.SubTotal.ToString("N2")</dd></div>
                        @if (detalle.Descuento > 0)
                        {
                            <div><dt>Descuento</dt><dd>−@detalle.Descuento.ToString("N2")</dd></div>
                        }
                        <div><dt>Impuestos trasladados</dt><dd>@detalle.TotalImpuestosTrasladados.ToString("N2")</dd></div>
                        @if (detalle.TotalImpuestosRetenidos > 0)
                        {
                            <div><dt>Impuestos retenidos</dt><dd>−@detalle.TotalImpuestosRetenidos.ToString("N2")</dd></div>
                        }
                        <div class="vista-documento-total"><dt>Total @detalle.Moneda</dt><dd>@detalle.Total.ToString("N2")</dd></div>
                    </dl>

                    @if (detalle.Uuid is { } uuid)
                    {
                        <section class="vista-documento-fiscal">
                            <h3>Folio fiscal</h3>
                            <span class="cifra-tabular">@uuid</span>
                        </section>
                    }
                </div>
            }

            <footer class="vista-documento-acciones">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.OpenInNew"
                           Disabled="@(_detalleSeleccionado is null)"
                           OnClick="AbrirSeleccionado">
                    Abrir
                </MudButton>

                @* Antes solo aparecía cuando el documento tenía PDF fiscal; ahora se ve siempre
                   y solo se deshabilita, para que los botones no salten de lugar según el
                   documento elegido. *@
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           Disabled="@(_preparandoPdf || _detalleSeleccionado is null || !TienePdfFiscal(_detalleSeleccionado))"
                           OnClick="VerPdfFiscalAsync">
                    @(_preparandoPdf ? "Preparando PDF…" : "Ver PDF")
                </MudButton>

                @if (_detalleSeleccionado is { } detalleConXml && EsCfdiFiscal(detalleConXml))
                {
                    <MudButton Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.Code"
                               Disabled="@_descargandoXml"
                               OnClick="DescargarXmlFiscalAsync">
                        @(_descargandoXml ? "Descargando XML…" : "Descargar XML")
                    </MudButton>
                }

                @* «Enviar» (timbrados) y «Timbrar» (borradores): ninguno de los dos tiene
                   todavía un servicio detrás, así que quedan deshabilitados hasta que se
                   defina y conecte esa lógica. *@
                @if (seleccionado.Estatus == EstatusComprobante.Timbrado)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Send"
                               Disabled="true" title="Próximamente">
                        Enviar
                    </MudButton>
                }
                else if (seleccionado.Estatus == EstatusComprobante.Borrador)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Bolt"
                               Disabled="true" title="Próximamente">
                        Timbrar
                    </MudButton>
                }

                <SiTienePermiso Permiso="@Permisos.Cancelar">
                    @if (seleccionado.Estatus == EstatusComprobante.Timbrado)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                   Disabled="@_dialogoAbierto" OnClick="@(() => Cancelar(seleccionado))">
                            Cancelar
                        </MudButton>
                    }

                    @if (seleccionado.Uuid is not null)
                    {
                        <MudButton Variant="Variant.Text" OnClick="@(() => VerificarAnteSat(seleccionado))">
                            Verificar SAT
                        </MudButton>
                    }
                </SiTienePermiso>
            </footer>
        }
        else
        {
            <div class="estado-vacio-ficha">
                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" />
                <strong>Selecciona un documento</strong>
                <span>Elige un renglón de la tabla para ver aquí su vista previa.</span>
            </div>
        }
    </aside>
</div>

@* ── Acciones frecuentes ────────────────────────────────────────────────────────────
   Reemplaza el listado anterior (Nueva factura, Nuevo pago, Nueva Carta Porte, Clientes,
   Productos, Timbres, Empresa) por estos cuatro. "Catálogo" ahora cubre Clientes y
   Productos en una sola pantalla con pestañas (/catalogos). Administración y Tienda
   apuntan a las rutas que ya existían para Empresa y Timbres, respectivamente — si esos
   nombres van a otra pantalla, dime la ruta y la cambio. *@
<section class="panel tablero-accesos-panel" aria-labelledby="titulo-accesos-cliente">
    <header class="panel-encabezado">
        <h2 id="titulo-accesos-cliente" class="panel-titulo">Acciones frecuentes</h2>
        <span class="panel-nota">Atajos de la empresa activa</span>
    </header>
    <div class="tablero-accesos">
        <SiTienePermiso Permiso="@Permisos.Timbrar">
            <a class="tablero-acceso tablero-acceso-principal" href="/facturas/nueva">
                <MudIcon Icon="@Icons.Material.Filled.AddCircle" Size="Size.Small" />
                <span><strong>Nueva factura</strong><small>Capturar un comprobante</small></span>
            </a>
        </SiTienePermiso>
        <a class="tablero-acceso" href="/catalogos">
            <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" />
            <span><strong>Catálogo</strong><small>Clientes y productos</small></span>
        </a>
        <SiTienePermiso Permiso="@Permisos.ConfigurarEmpresa">
            <a class="tablero-acceso" href="/empresa">
                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                <span><strong>Administración</strong><small>Datos fiscales y configuración</small></span>
            </a>
        </SiTienePermiso>
        <SiTienePermiso Permiso="@Permisos.ComprarTimbres">
            <a class="tablero-acceso" href="/timbres">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" />
                <span><strong>Tienda</strong><small>Paquetes de timbres</small></span>
            </a>
        </SiTienePermiso>
    </div>
</section>

@code {
    /// <summary>Orden = índice de pestaña en el MudTabs de arriba.</summary>
    private enum Panel { Timbrados, Borradores, Timbrando, EnCancelacion, Cancelados, Buscar }

    /// <summary>Las pestañas que filtran por un estatus fijo (todas menos Buscar).</summary>
    private static readonly EstatusComprobante[] EstatusDePestanas =
    [
        EstatusComprobante.Timbrado,
        EstatusComprobante.Borrador,
        EstatusComprobante.Timbrando,
        EstatusComprobante.EnCancelacion,
        EstatusComprobante.Cancelado
    ];

    private TablaDatos<ComprobanteEnListaDto>? _tabla;
    private DetalleProblema? _error;
    private string? _aviso;
    private ComprobanteEnListaDto? _seleccionado;
    private ComprobanteDto? _detalleSeleccionado;
    private bool _cargandoVista;
    private bool _preparandoPdf;
    private bool _descargandoXml;
    private int _versionDeVista;

    // Evita apilar diálogos de cancelación al doble clic.
    private bool _dialogoAbierto;

    // Pestaña activa (índice de Panel) y conteos para las insignias.
    private int _panel = (int)Panel.Timbrados;
    private Dictionary<EstatusComprobante, int> _conteos = [];
    private int _versionDeConteos;

    private string _texto = string.Empty;
    private string? _tipoComprobante;

    // El rango que pide §1.1 del documento funcional: del inicio del año en curso a hoy.
    private DateTime? _desdeUtc = InicioDelAnio();
    private DateTime? _hastaUtc = DateTime.UtcNow;

    private IReadOnlyList<ColumnaDeTabla<ComprobanteEnListaDto>> _columnas = [];

    private bool EnPestanaBuscar => _panel == (int)Panel.Buscar;

    /// <summary>
    /// El estatus que realmente se consulta: el fijo de la pestaña, o ninguno cuando se está
    /// en «Buscar» — ese selector se quitó, así que ahí ya no se filtra por estatus.
    /// </summary>
    private EstatusComprobante? EstatusEfectivo => (Panel)_panel switch
    {
        Panel.Timbrados => EstatusComprobante.Timbrado,
        Panel.Borradores => EstatusComprobante.Borrador,
        Panel.Timbrando => EstatusComprobante.Timbrando,
        Panel.EnCancelacion => EstatusComprobante.EnCancelacion,
        Panel.Cancelados => EstatusComprobante.Cancelado,
        _ => null
    };

    private int Conteo(EstatusComprobante estatus)
        => _conteos.TryGetValue(estatus, out var cuenta) ? cuenta : 0;

    protected override void OnInitialized() => _columnas =
    [
        new("Folio", d => @<span class="cifra-tabular">@Folio(d)</span>, ClaveOrden: "folio", Tabular: true),
        new("Nombre", d => @<text>@d.ReceptorNombre</text>, ClaveOrden: "receptor"),
        new("RFC", d => @<span class="cifra-tabular">@d.ReceptorRfc</span>, Tabular: true),
        new("Total", d => @<span class="cifra-tabular">@d.Total.ToString("N2")</span>, ClaveOrden: "total", Tabular: true),
        new("Fecha", d => @<span class="cifra-tabular">@d.FechaEmisionUtc.ToLocalTime().ToString("dd/MM/yyyy")</span>,
            ClaveOrden: "fecha", Tabular: true)
    ];

    protected override async Task OnInitializedAsync() => await CargarConteosAsync();

    // ── Pestañas y conteos ──────────────────────────────────────────────────────────────

    private async Task AlCambiarPanel(int indice)
    {
        if (indice == _panel) return;

        _panel = indice;
        CerrarVistaPrevia();
        await RecargarAsync();
    }

    /// <summary>
    /// Un conteo por pestaña de estatus, con los mismos filtros de la búsqueda. Se pide una
    /// página de un solo renglón: solo interesa el Total. El número de la insignia coincide
    /// así con lo que la tabla mostrará al abrir la pestaña.
    /// </summary>
    private async Task CargarConteosAsync()
    {
        var version = ++_versionDeConteos;

        var consultas = EstatusDePestanas.Select(async estatus =>
        {
            var (pagina, _) = await Listado.ListarAsync(
                _texto, estatus, null, _tipoComprobante, _desdeUtc, FinDelRango(),
                1, 1, null, false, CancellationToken.None);

            return (estatus, total: pagina?.Total ?? 0);
        });

        var resultados = await Task.WhenAll(consultas);

        // Si los filtros cambiaron mientras llegaban, esta respuesta ya es vieja.
        if (version != _versionDeConteos) return;

        _conteos = resultados.ToDictionary(r => r.estatus, r => r.total);
        StateHasChanged();
    }

    // ── Vista previa ────────────────────────────────────────────────────────────────────

    private bool EsSeleccionado(ComprobanteEnListaDto documento)
        => documento.Id == _seleccionado?.Id;

    private async Task Previsualizar(ComprobanteEnListaDto documento)
    {
        _seleccionado = documento;
        _detalleSeleccionado = null;
        _cargandoVista = true;
        _error = null;
        var version = ++_versionDeVista;

        var (detalle, error) = await Emision.ObtenerParaVistaPreviaAsync(documento.Id);

        // Si el usuario eligió otro renglón mientras llegaba la respuesta, la anterior ya
        // no tiene derecho a reemplazar el panel nuevo.
        if (version != _versionDeVista) return;

        _detalleSeleccionado = detalle;
        _error = error;
        _cargandoVista = false;
    }

    private void CerrarVistaPrevia()
    {
        _versionDeVista++;
        _seleccionado = null;
        _detalleSeleccionado = null;
        _cargandoVista = false;
    }

    private void AbrirSeleccionado()
    {
        if (_seleccionado is not { } documento || _detalleSeleccionado is not { } detalle) return;

        var ruta = detalle.TipoDeComprobante switch
        {
            "P" => "pagos",
            "T" => "traslados-carta-porte",
            _ => "facturas"
        };
        Navegacion.NavigateTo($"/{ruta}/{documento.Id}");
    }

    private static bool EsCfdiFiscal(ComprobanteDto comprobante)
        => comprobante.Estatus is "timbrado" or "cancelado" && comprobante.Uuid is not null;

    private static bool TienePdfFiscal(ComprobanteDto comprobante)
        => EsCfdiFiscal(comprobante) && comprobante.TipoDeComprobante is "I" or "T";

    private async Task VerPdfFiscalAsync()
    {
        if (_detalleSeleccionado is null || _preparandoPdf) return;

        _preparandoPdf = true;
        _error = null;

        try
        {
            var (archivo, error) = await Emision.ObtenerPdfFiscalAsync(_detalleSeleccionado.Id);
            _error = error;

            if (archivo is null) return;

            var parametros = new DialogParameters<DialogoDeComprobanteDeCompra>
            {
                { x => x.Archivo, archivo },
                { x => x.TituloVistaPrevia, "Representación impresa del CFDI" },
                { x => x.AvisoFiscal,
                    "Representación impresa del CFDI. Incluye los datos fiscales del comprobante timbrado." }
            };

            await Dialogos.ShowAsync<DialogoDeComprobanteDeCompra>(
                "PDF del CFDI",
                parametros,
                new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
        }
        finally
        {
            _preparandoPdf = false;
        }
    }

    private async Task DescargarXmlFiscalAsync()
    {
        if (_detalleSeleccionado is null || _descargandoXml) return;

        _descargandoXml = true;
        _error = null;

        try
        {
            var (archivo, error) = await Emision.ObtenerXmlFiscalAsync(_detalleSeleccionado.Id);
            _error = error;

            if (archivo is not null)
                await Descargas.GuardarAsync(archivo);
        }
        finally
        {
            _descargandoXml = false;
        }
    }

    /// <summary>
    /// Un borrador todavía no tiene folio y no debe aparentar tenerlo (ARQUITECTURA.md §5): el folio
    /// se asigna al timbrar.
    /// </summary>
    private static string Folio(ComprobanteEnListaDto documento)
        => documento.Folio is { } folio
            ? string.IsNullOrEmpty(documento.Serie) ? folio.ToString() : $"{documento.Serie}-{folio}"
            : "—";

    private static DateTime InicioDelAnio()
    {
        var hoy = DateTime.Now;
        return new DateTime(hoy.Year, 1, 1, 0, 0, 0, DateTimeKind.Local).ToUniversalTime();
    }

    // ── Carga de la tabla ───────────────────────────────────────────────────────────────

    private async Task<ResultadoDePagina<ComprobanteEnListaDto>> CargarAsync(
        PeticionDePagina peticion, CancellationToken ct)
    {
        var (pagina, error) = await Listado.ListarAsync(
            _texto, EstatusEfectivo, null, _tipoComprobante, _desdeUtc, FinDelRango(),
            peticion.Pagina, peticion.TamanoPagina, peticion.ClaveOrden, peticion.Descendente, ct);

        _error = error;

        if (pagina is null || (_seleccionado is not null && pagina.Elementos.All(d => d.Id != _seleccionado.Id)))
            CerrarVistaPrevia();

        return pagina is null
            ? ResultadoDePagina<ComprobanteEnListaDto>.Vacio
            : new ResultadoDePagina<ComprobanteEnListaDto>(pagina.Elementos, pagina.Total);
    }

    /// <summary>
    /// El servidor corta con «menor que», así que el día elegido entra completo sumándole uno.
    /// Sin esto, filtrar «hasta hoy» dejaría fuera todo lo emitido hoy.
    /// </summary>
    private DateTime? FinDelRango()
        => _hastaUtc is { } hasta ? hasta.ToLocalTime().Date.AddDays(1).ToUniversalTime() : null;

    // ── Filtros (pestaña «Buscar») ──────────────────────────────────────────────────────
    // Cambiar un filtro recarga la tabla Y los conteos de las insignias.

    private async Task AlBuscar(string texto)
    {
        _texto = texto ?? string.Empty;
        await RecargarTodoAsync();
    }

    private async Task AlFiltrarTipo(string? tipo)
    {
        _tipoComprobante = string.IsNullOrWhiteSpace(tipo) ? null : tipo;
        await RecargarTodoAsync();
    }

    private async Task AlCambiarDesde(DateTime? valorUtc)
    {
        _desdeUtc = valorUtc;
        await RecargarTodoAsync();
    }

    private async Task AlCambiarHasta(DateTime? valorUtc)
    {
        _hastaUtc = valorUtc;
        await RecargarTodoAsync();
    }

    private Task RecargarAsync() => _tabla?.RecargarAsync() ?? Task.CompletedTask;

    private async Task RecargarTodoAsync()
    {
        await Task.WhenAll(RecargarAsync(), CargarConteosAsync());
    }

    // ── Cancelación (B8) ────────────────────────────────────────────────────────────────

    private async Task Cancelar(ComprobanteEnListaDto documento)
    {
        // Guard contra doble clic: no apilar dos diálogos de cancelación del mismo renglón.
        if (_dialogoAbierto) return;
        _dialogoAbierto = true;
        try
        {
            var parametros = new DialogParameters<DialogoDeCancelacion>
            {
                { x => x.Folio, Folio(documento) }
            };

            var referencia = await Dialogos.ShowAsync<DialogoDeCancelacion>(
                "Cancelar comprobante", parametros, new DialogOptions { CloseOnEscapeKey = true });

            var resultado = await referencia.Result;

            if (resultado is not { Canceled: false, Data: PeticionDeCancelacion peticion }) return;

            _error = null;

            // Clave nueva por cada intento real del usuario: protege del doble clic sin impedir
            // que vuelva a intentarlo a propósito si la primera vez falló.
            var (exito, error) = await Cancelacion.CancelarAsync(
                documento.Id, peticion, Guid.NewGuid().ToString("N"));

            _error = error;

            if (exito is not null)
            {
                _aviso = MensajeDe(exito);
                CerrarVistaPrevia();
            }

            // Un documento pudo pasar de Timbrados a Cancelando/Cancelados: hay que recontar.
            await RecargarTodoAsync();
        }
        finally
        {
            _dialogoAbierto = false;
        }
    }

    private async Task VerificarAnteSat(ComprobanteEnListaDto documento)
    {
        _error = null;

        var (estatus, error) = await Cancelacion.ConsultarEstatusAsync(documento.Id);

        _error = error;

        if (estatus is not null)
        {
            _aviso = $"El SAT reporta: {estatus.EstadoCfdi ?? "sin dato"}. " +
                      $"{estatus.EsCancelable ?? "Sin información de cancelabilidad"}.";
            CerrarVistaPrevia();
        }

        await RecargarTodoAsync();
    }

    /// <summary>
    /// Una cancelación con aceptación del receptor no termina al pulsar el botón, y decir
    /// «cancelada» ahí sería mentir: el comprobante sigue siendo válido hasta que el otro
    /// conteste.
    /// </summary>
    private static string MensajeDe(ResultadoDeCancelacionDto resultado)
        => resultado.EstadoSolicitud switch
        {
            "cancelada" => "El SAT canceló el comprobante.",
            "en_espera_del_receptor" =>
                "El SAT registró la solicitud. El comprobante sigue vigente hasta que el receptor " +
                "la acepte o se venza el plazo de tres días hábiles.",
            _ => "La solicitud quedó registrada. Usa «Verificar SAT» para conocer su desenlace."
        };
}
