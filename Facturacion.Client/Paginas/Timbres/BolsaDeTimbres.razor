@page "/timbres"
@attribute [Authorize(Policy = Permisos.ComprarTimbres)]
@inject ServicioDeTimbres Timbres
@inject IServicioDeConfirmacion Confirmacion
@inject NavigationManager Navegacion
@inject IDialogService Dialogos
@inject ServicioDeArchivosDeFacturaCompra ArchivosFactura

<PageTitle>Timbres</PageTitle>
<TituloDePagina Texto="Timbres y membresía" />

<p class="seccion-ayuda">Consulta el saldo de tu cuenta y elige el paquete que necesitas para seguir facturando.</p>

<PanelErrores Problema="_error" />

@if (_membresia is not null && EstaPorVencer)
{
    <div class="aviso-caducidad" role="status">
        <p>
            @if (_membresia.DiasParaVencer < 0)
            {
                <text>Tu membresía venció el @_membresia.FinUtc.ToLocalTime().ToString("d 'de' MMMM 'de' yyyy").</text>
            }
            else
            {
                <text>
                    Tu membresía vence en @_membresia.DiasParaVencer
                    @(_membresia.DiasParaVencer == 1 ? "día" : "días"),
                    el @_membresia.FinUtc.ToLocalTime().ToString("d 'de' MMMM 'de' yyyy").
                </text>
            }
            Renuévala para no interrumpir la facturación.
        </p>
    </div>
}

<section class="timbres-resumen" aria-label="Saldo y membresía" aria-busy="@_cargando">
    <div class="tarjeta-saldo tarjeta-saldo-disponible">
        <span class="tarjeta-saldo-etiqueta">Timbres disponibles</span>
        <span class="tarjeta-saldo-cifra cifra-tabular">@(_cargando ? "—" : _saldo.Disponibles.ToString("N0"))</span>
        <span class="tarjeta-saldo-detalle">Compartidos entre las empresas de tu cuenta</span>
    </div>

    <div class="tarjeta-saldo">
        <span class="tarjeta-saldo-etiqueta">Timbres apartados</span>
        <span class="tarjeta-saldo-cifra cifra-tabular">@(_cargando ? "—" : _saldo.Reservados.ToString("N0"))</span>
        <span class="tarjeta-saldo-detalle">En comprobantes que se están emitiendo</span>
    </div>

    @if (_membresia is not null)
    {
        <div class="tarjeta-saldo tarjeta-membresia">
            <span class="tarjeta-saldo-etiqueta">Membresía de la cuenta</span>
            <span class="indicador-estado indicador-estado-@EstiloDeMembresia">@TextoDeMembresia</span>
            <dl class="membresia-fechas">
                <div><dt>Desde</dt><dd>@_membresia.InicioUtc.ToLocalTime().ToString("dd/MM/yyyy")</dd></div>
                <div><dt>Hasta</dt><dd>@_membresia.FinUtc.ToLocalTime().ToString("dd/MM/yyyy")</dd></div>
            </dl>
        </div>
    }
</section>

<p class="seccion-ayuda">Si un timbrado no se completa, su timbre vuelve al saldo disponible.</p>

<h2 class="seccion-titulo">Comprar timbres</h2>

<p class="seccion-ayuda">
    La compra queda registrada y los timbres entran en cuanto se confirma el pago.
</p>

@if (_cargando)
{
    <p class="seccion-ayuda" role="status">Cargando paquetes…</p>
}
else if (_paquetes.Count == 0)
{
    <p class="seccion-ayuda" role="status">No hay paquetes disponibles por el momento.</p>
}

<div class="rejilla-paquetes" aria-label="Paquetes de timbres">
    @foreach (var paquete in _paquetes)
    {
        <article @key="paquete.Id" class="tarjeta-paquete @(paquete.Id == _mejorPrecioId ? "tarjeta-paquete-destacado" : null)"
                 aria-labelledby="@($"paquete-{paquete.Id}")">
            <header class="paquete-encabezado">
                <h3 id="@($"paquete-{paquete.Id}")">@paquete.Nombre</h3>
                @if (paquete.EsPersonalizado)
                {
                    <span class="indicador-estado indicador-estado-advertencia">Exclusivo para tu cuenta</span>
                }
                @if (paquete.Id == _mejorPrecioId)
                {
                    <span class="paquete-distintivo">Menor precio por timbre</span>
                }
            </header>

            <p class="paquete-cantidad"><strong class="cifra-tabular">@paquete.CantidadTimbres.ToString("N0")</strong> timbres</p>

            <div class="paquete-precio">
                <p class="paquete-total cifra-tabular">@paquete.PrecioTotal.ToString("C2") <span>MXN</span></p>
                <span class="paquete-impuestos">Precio total · IVA incluido</span>
            </div>

            <dl class="paquete-detalles">
                <div><dt>Por timbre</dt><dd class="cifra-tabular">@paquete.PrecioPorTimbre.ToString("C2")</dd></div>
                <div><dt>Vigencia</dt><dd>@paquete.VigenciaMeses @(paquete.VigenciaMeses == 1 ? "mes" : "meses")</dd></div>
            </dl>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="@(_comprando is not null)"
                       aria-label="@($"Comprar {paquete.Nombre}, {paquete.CantidadTimbres:N0} timbres por {paquete.PrecioTotal:C2} MXN")"
                       OnClick="@(() => Comprar(paquete))">
                @(_comprando == paquete.Id ? "Registrando compra…" : "Comprar paquete")
            </MudButton>
        </article>
    }
</div>

<h2 class="seccion-titulo">Compras</h2>

@if (_compras.Count == 0)
{
    <p class="seccion-ayuda">Todavía no has comprado ningún paquete.</p>
}
else
{
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr>
                <th class="cifra-tabular">Fecha</th>
                <th>Paquete</th>
                <th>Empresa</th>
                <th class="cifra-tabular">Timbres</th>
                <th class="cifra-tabular">Total</th>
                <th>Estado</th>
                <th>Factura</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var compra in _compras)
            {
                <tr class="@(compra.Estado == "pagada" ? "fila-previsualizable" : null)"
                    @onclick="@(() => compra.EstadoFactura == "timbrado" ? PrevisualizarFactura(compra) : PrevisualizarComprobante(compra))">
                    <td class="cifra-tabular">@compra.CreadaUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@compra.NombrePaquete</td>
                    <td>@compra.Empresa</td>
                    <td class="cifra-tabular">@compra.CantidadTimbres</td>
                    <td class="cifra-tabular">@compra.PrecioTotal.ToString("C2")</td>
                    <td>
                        <span class="indicador-estado indicador-estado-@EstiloDeCompra(compra.Estado)">
                            @TextoDeCompra(compra.Estado)
                        </span>
                    </td>
                    <td>@EstadoDeFactura(compra.EstadoFactura)</td>
                    <td>
                        @if (compra.Estado == "pagada")
                        {
                            <span @onclick:stopPropagation="true">
                                @if (compra.EstadoFactura == "timbrado")
                                {
                                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Text"
                                               Disabled="@(_previsualizando is not null)" OnClick="@(() => PrevisualizarFactura(compra))">Ver factura</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(_descargando is not null)"
                                               OnClick="@(() => DescargarFactura(compra, false))">PDF</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(_descargando is not null)"
                                               OnClick="@(() => DescargarFactura(compra, true))">XML</MudButton>
                                    <MudMenu Label="Compra" Size="Size.Small" Disabled="@(_previsualizando is not null || _descargando is not null)">
                                        <MudMenuItem OnClick="@(() => PrevisualizarComprobante(compra))">Ver comprobante de compra</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => DescargarComprobante(compra))">Descargar comprobante</MudMenuItem>
                                    </MudMenu>
                                }
                                else
                                {
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           Disabled="@(_previsualizando is not null)"
                                           OnClick="@(() => PrevisualizarComprobante(compra))">
                                    @(_previsualizando == compra.Id ? "Abriendo…" : "Comprobante")
                                </MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           Disabled="@(_descargando is not null)"
                                           OnClick="@(() => DescargarComprobante(compra))">
                                    @(_descargando == compra.Id ? "Descargando…" : "Descargar PDF")
                                </MudButton>
                                }
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

<div class="acciones-formulario">
    <MudButton Variant="Variant.Text"
               OnClick="@(() => Navegacion.NavigateTo("/timbres/movimientos"))">
        Ver el historial de movimientos
    </MudButton>
</div>

@code {
    private SaldoTimbresDto _saldo = new(0, 0);
    private IReadOnlyList<PaqueteDto> _paquetes = [];
    private IReadOnlyList<CompraDto> _compras = [];
    private MembresiaDto? _membresia;
    private DetalleProblema? _error;
    private Guid? _comprando;
    private Guid? _descargando;
    private Guid? _previsualizando;
    private Guid? _mejorPrecioId;
    private bool _cargando = true;

    /// <summary>Mismo margen que aplica el servidor para decidir si conviene avisar.</summary>
    private const int DiasDeAviso = 30;

    private bool EstaPorVencer =>
        _membresia is not null
        && _membresia.Estado != "cancelada"
        && _membresia.DiasParaVencer <= DiasDeAviso;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        try
        {
            _saldo = await Timbres.SaldoAsync();
            _paquetes = await Timbres.PaquetesAsync();
            _compras = await Timbres.ComprasAsync();
            _membresia = await Timbres.MembresiaAsync();
            // El distintivo compara los precios recibidos, sin recalcular lo que se cobra.
            _mejorPrecioId = _paquetes.Select(p => p.PrecioPorTimbre).Distinct().Count() > 1
                ? _paquetes.OrderBy(p => p.PrecioPorTimbre).ThenBy(p => p.PrecioTotal).First().Id
                : null;
        }
        finally { _cargando = false; }
    }

    private async Task Comprar(PaqueteDto paquete)
    {
        var confirmado = await Confirmacion.ConfirmarAsync(
            "Confirmar compra",
            $"Se registrará la compra de «{paquete.Nombre}» por {paquete.PrecioTotal:C2}, IVA incluido. " +
            "Los timbres entran cuando se confirme el pago.",
            "Comprar");

        if (!confirmado) return;

        _comprando = paquete.Id;
        _error = null;

        // La clave se genera una sola vez por intención de compra. Si la red falla y el
        // usuario vuelve a darle, el servidor reconoce la clave y devuelve la compra que ya
        // registró en vez de crear otra.
        var clave = Guid.NewGuid().ToString();

        try
        {
            var (exito, error) = await Timbres.ComprarAsync(paquete.Id, clave);

            _error = error;

            if (exito is not null) await CargarAsync();
        }
        finally
        {
            _comprando = null;
        }
    }

    private async Task DescargarComprobante(CompraDto compra)
    {
        if (_descargando is not null) return;

        _descargando = compra.Id;
        _error = null;

        try
        {
            _error = await Timbres.DescargarComprobanteAsync(compra.Id);
        }
        finally
        {
            _descargando = null;
        }
    }

    private static string EstadoDeFactura(string? estado) => estado switch
    {
        "timbrado" => "Emitida", "timbrando" => "En proceso", "borrador" => "En preparación",
        "error" => "En revisión", _ => "—"
    };

    private async Task DescargarFactura(CompraDto compra, bool xml)
    {
        if (_descargando is not null) return;
        _descargando = compra.Id; _error = null;
        try { _error = await ArchivosFactura.DescargarAsync(compra.Id, xml); }
        finally { _descargando = null; }
    }

    private async Task PrevisualizarFactura(CompraDto compra)
    {
        if (_previsualizando is not null) return;
        _previsualizando = compra.Id; _error = null;
        try
        {
            var (archivo, error) = await ArchivosFactura.ObtenerAsync(compra.Id);
            _error = error;
            if (archivo is null) return;
            await Dialogos.ShowAsync<DialogoDeComprobanteDeCompra>("Factura de la compra",
                new DialogParameters<DialogoDeComprobanteDeCompra>
                { { x => x.Archivo, archivo }, { x => x.TituloVistaPrevia, "Vista previa de la factura" }, { x => x.AvisoFiscal, "" } },
                new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
        }
        finally { _previsualizando = null; }
    }

    private async Task PrevisualizarComprobante(CompraDto compra)
    {
        if (compra.Estado != "pagada" || _previsualizando is not null) return;

        _previsualizando = compra.Id;
        _error = null;

        try
        {
            var (archivo, error) = await Timbres.ObtenerComprobanteAsync(compra.Id);
            _error = error;

            if (archivo is null) return;

            var parametros = new DialogParameters<DialogoDeComprobanteDeCompra>
            {
                { x => x.Archivo, archivo }
            };

            await Dialogos.ShowAsync<DialogoDeComprobanteDeCompra>(
                "Comprobante de compra",
                parametros,
                new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
        }
        finally
        {
            _previsualizando = null;
        }
    }

    private string EstiloDeMembresia => _membresia!.Estado switch
    {
        "activa" when _membresia.DiasParaVencer <= DiasDeAviso => "advertencia",
        "activa" => "timbrada",
        "vencida" => "cancelada",
        _ => "borrador"
    };

    private string TextoDeMembresia => _membresia!.Estado switch
    {
        "activa" => "Activa",
        "vencida" => "Vencida",
        "cancelada" => "Cancelada",
        _ => _membresia.Estado
    };

    private static string EstiloDeCompra(string estado) => estado switch
    {
        "pagada" => "timbrada",
        "cancelada" => "cancelada",
        _ => "advertencia"
    };

    private static string TextoDeCompra(string estado) => estado switch
    {
        "pendiente_de_pago" => "Pendiente de pago",
        "pagada" => "Pagada",
        "cancelada" => "Cancelada",
        _ => estado
    };
}
