@page "/empresa/usuarios"
@attribute [Authorize(Policy = Permisos.Titular)]
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Componentes.Usuarios
@using Facturacion.Client.Paginas.Operador.Operadores
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Plataforma
@inject ServicioDeUsuarios Usuarios
@inject IDialogService Dialogos
@inject IServicioDeConfirmacion Confirmacion

<PageTitle>Usuarios</PageTitle>
<TituloDePagina Texto="Usuarios" />

<PanelErrores Problema="_error" />

@if (_aviso is not null)
{
    <p class="mensaje-exito" role="status">@_aviso</p>
}

@if (_datos is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="resumen-importacion">
        <span class="indicador-estado indicador-estado-@(_enElLimite ? "cancelada" : "timbrada")">
            @_datos.UsuariosEnLaCuenta de @_datos.LimiteDeUsuarios usuarios en tu cuenta
        </span>
    </div>

    <div class="acciones-formulario">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="AbrirNuevoUsuarioAsync" Disabled="@(_enElLimite || _dialogoAbierto)">
            Nuevo usuario
        </MudButton>
    </div>
    @if (_enElLimite)
    {
        <p class="seccion-ayuda">
            Tu cuenta ya llegó al máximo de @_datos.LimiteDeUsuarios usuarios. Para agregar más, contacta a soporte.
        </p>
    }

    <h2 class="seccion-titulo">Usuarios de tu cuenta</h2>

    <MudTable T="UsuarioDeLaCuentaDto" Items="_datos.Usuarios" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="12" Class="usuarios-tabla">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Correo</MudTh>
            <MudTh>Permisos</MudTh>
            @if (_datos.Empresas.Count > 1)
            {
                <MudTh>Empresas</MudTh>
            }
            <MudTh>Estado</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate Context="usuario">
            <MudTd DataLabel="Nombre" Class="usuario-nombre">@usuario.Nombre @(usuario.EsUsuarioActual ? "(tú)" : "")</MudTd>
            <MudTd DataLabel="Correo" Class="usuario-correo">
                @usuario.Correo
                @if (usuario.EsTitular)
                {
                    <span class="indicador-estado indicador-estado-timbrada">Titular</span>
                }
                else if (usuario.CreadoPorAdministrador)
                {
                    <span class="indicador-estado indicador-estado-borrador">Alta interna</span>
                }
            </MudTd>
            <MudTd DataLabel="Permisos" Class="usuario-permisos">@(usuario.EsTitular ? "Todos" : Etiquetas(usuario.Permisos))</MudTd>
            @if (_datos.Empresas.Count > 1)
            {
                <MudTd DataLabel="Empresas" Class="usuario-empresas">@(usuario.EsTitular ? "Todas" : NombresDeEmpresas(usuario.Empresas))</MudTd>
            }
            <MudTd DataLabel="Estado" Class="usuario-estado">
                <span class="indicador-estado indicador-estado-@(usuario.Activo ? "timbrada" : "borrador")">
                    @(usuario.Activo ? "Activo" : "Inactivo")
                </span>
            </MudTd>
            <MudTd DataLabel="Acciones" Class="usuario-acciones">
                @* El servidor también rechaza cualquier modificación al titular. *@
                @if (!usuario.EsTitular)
                {
                    <div class="acciones-renglon">
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Disabled="@_dialogoAbierto"
                                   StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => EditarUsuario(usuario))">Editar</MudButton>
                        @if (!usuario.EsUsuarioActual)
                        {
                            <MudMenu Label="Más acciones" Size="Size.Small" Disabled="@_dialogoAbierto"
                                     title="@($"Más acciones de {usuario.Nombre}")">
                                <MudMenuItem OnClick="@(() => CambiarActivo(usuario))">
                                    @(usuario.Activo ? "Desactivar" : "Reactivar")
                                </MudMenuItem>
                                @if (usuario.CreadoPorAdministrador)
                                {
                                    <MudMenuItem OnClick="@(() => EliminarAsync(usuario))">Eliminar</MudMenuItem>
                                }
                            </MudMenu>
                        }
                    </div>
                }
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="@([12, 24, 48])" RowsPerPageString="Usuarios por página"
                           InfoFormat="{first_item}–{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>

}

@code {
    private UsuariosDeLaCuentaDto? _datos;
    private DetalleProblema? _error;
    private string? _aviso;

    // Evita apilar diálogos al doble clic: mientras uno esté abierto, los botones de la fila
    // quedan deshabilitados y los handlers salen temprano.
    private bool _dialogoAbierto;

    private bool _enElLimite =>
        _datos is not null && _datos.UsuariosEnLaCuenta >= _datos.LimiteDeUsuarios;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync() => _datos = await Usuarios.ListarAsync();

    private async Task AbrirNuevoUsuarioAsync()
    {
        if (_dialogoAbierto) return;
        _dialogoAbierto = true;
        _aviso = null;
        try
        {
            // Sin cerrar con clic fuera: un clic distraído borraría la contraseña y los
            // permisos ya capturados. Escape y Cancelar siguen cerrando.
            var opciones = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
            var referencia = await Dialogos.ShowAsync<DialogoDeUsuario>("Nuevo usuario", opciones);
            var resultado = await referencia.Result;

            if (resultado is { Canceled: false, Data: RespuestaCrearUsuario respuesta })
            {
                _aviso = respuesta.Mensaje;
                await CargarAsync();
            }
        }
        finally
        {
            _dialogoAbierto = false;
        }
    }

    // Con decenas de casillas la lista completa no cabe en un renglón: se resume por sección
    // («Emitir 12 · Catálogos 4»). El detalle está en Editar usuario.
    private static string Etiquetas(IReadOnlyList<string> permisos)
    {
        var partes = Permisos.Secciones
            .Select(s => (s.Titulo, Cuenta: s.Elementos.SelectMany(e => e.Subpermisos).Count(p => permisos.Contains(p.Clave))))
            .Where(x => x.Cuenta > 0)
            .Select(x => $"{x.Titulo} {x.Cuenta}")
            .ToList();

        return partes.Count == 0 ? "—" : string.Join(" · ", partes);
    }

    private string NombresDeEmpresas(IReadOnlyList<Guid> empresas)
    {
        var nombres = _datos!.Empresas.Where(e => empresas.Contains(e.Id)).Select(e => e.NombreFiscal).ToList();
        return nombres.Count == 0 ? "—" : string.Join(" · ", nombres);
    }

    private async Task EditarUsuario(UsuarioDeLaCuentaDto usuario)
    {
        if (_dialogoAbierto || _datos is null) return;
        _dialogoAbierto = true;
        _aviso = null;
        try
        {
            var parametros = new DialogParameters<EditarUsuarioDialogo>
            {
                { x => x.Usuario, usuario },
                { x => x.Empresas, _datos.Empresas }
            };
            var opciones = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
            var referencia = await Dialogos.ShowAsync<EditarUsuarioDialogo>("Editar usuario", parametros, opciones);
            if (await referencia.Result is { Canceled: false })
            {
                _aviso = "Usuario actualizado.";
                await CargarAsync();
            }
        }
        finally { _dialogoAbierto = false; }
    }

    private async Task CambiarActivo(UsuarioDeLaCuentaDto usuario)
    {
        if (_dialogoAbierto) return;
        if (usuario.Activo)
        {
            var confirmado = await Confirmacion.ConfirmarAsync(
                "Desactivar usuario",
                $"«{usuario.Nombre}» ya no podrá iniciar sesión en ninguna empresa de la cuenta. " +
                "Su acceso se corta en un máximo de 15 minutos, cuando expire el token actual.",
                "Desactivar", esPeligrosa: true);

            if (!confirmado) return;
        }

        var (_, error) = await Usuarios.CambiarActivoAsync(usuario.UsuarioId, !usuario.Activo);
        _error = error;

        if (error is null) await CargarAsync();
    }

    private async Task EliminarAsync(UsuarioDeLaCuentaDto usuario)
    {
        if (_dialogoAbierto) return;
        _dialogoAbierto = true;
        _error = null;
        _aviso = null;
        try
        {
            var parametros = new DialogParameters<DialogoConfirmarContrasenaOperador>
            {
                { x => x.Mensaje, $"Eliminar a «{usuario.Nombre}». Escribe tu contraseña. Se quita de todas las empresas de la cuenta. Solo se permite si no tiene actividad registrada." },
                { x => x.TextoConfirmar, "Eliminar" },
                { x => x.ColorConfirmar, Color.Error }
            };
            var referencia = await Dialogos.ShowAsync<DialogoConfirmarContrasenaOperador>("Eliminar usuario", parametros,
                new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true });
            if (await referencia.Result is not { Canceled: false, Data: string contrasena }) return;
            _error = await Usuarios.EliminarAsync(usuario.UsuarioId, contrasena);
            if (_error is null)
            {
                _aviso = "Usuario eliminado.";
                await CargarAsync();
            }
        }
        catch (HttpRequestException)
        {
            _error = new("about:blank", "No se pudo confirmar la eliminación", 0,
                "Actualiza la lista antes de intentarlo de nuevo.", null, string.Empty, null);
        }
        finally { _dialogoAbierto = false; }
    }

}
