@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@inject ServicioDeUsuarios Usuarios

<MudDialog>
    <DialogContent>
        @* El correo es también el nombre de inicio de sesión: cambiarlo le cambia la forma
           de entrar, y nadie se lo avisa por correo. Se dice aquí porque es el único momento
           en que alguien puede acordarse de avisarle. *@
        <p class="seccion-ayuda">
            Con este correo entra @NombreUsuario al sistema. Si lo cambias, avísale: la próxima
            vez tendrá que iniciar sesión con el nuevo.
        </p>

        <PanelErrores Problema="_error" />

        <MudTextField @bind-Value="_correo" Label="Correo" Immediate="true"
                      InputType="InputType.Email" MaxLength="254" Disabled="@_guardando" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar"
                   Disabled="@(_guardando || string.IsNullOrWhiteSpace(_correo))">
            @(_guardando ? "Guardando…" : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid UsuarioId { get; set; }

    [Parameter, EditorRequired]
    public string NombreUsuario { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string CorreoActual { get; set; } = string.Empty;

    private string _correo = string.Empty;
    private DetalleProblema? _error;
    private bool _guardando;

    protected override void OnInitialized() => _correo = CorreoActual;

    private async Task Guardar()
    {
        _guardando = true;
        _error = await Usuarios.CambiarCorreoAsync(UsuarioId, _correo);
        _guardando = false;

        if (_error is null) Dialogo.Close(DialogResult.Ok(true));
    }

    private void Cancelar() => Dialogo.Cancel();
}
