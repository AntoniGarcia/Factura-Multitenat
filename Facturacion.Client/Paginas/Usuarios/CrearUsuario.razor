@page "/usuarios/nuevo"
@attribute [Authorize(Policy = Permisos.AdministrarUsuarios)]
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Componentes.Usuarios
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Plataforma
@inject NavigationManager Navegacion

<PageTitle>Nuevo usuario</PageTitle>
<TituloDePagina Texto="Nuevo usuario" />

<TarjetaFormulario RutaVolver="/">
@if (_resultado is null)
{
    @* El @key nuevo en «Crear otro» hace que Blazor arme el formulario desde cero, vacío. *@
    <FormularioDeUsuario @key="_versionDelFormulario"
                         AlCrear="r => _resultado = r"
                         AlCancelar="@(() => Navegacion.NavigateTo("/empresa/usuarios"))" />
}
else
{
    <p class="mensaje-exito" role="status">@_resultado.Mensaje</p>

    <div class="tarjeta-formulario-acciones">
        <MudButton Variant="Variant.Text" OnClick="Limpiar">Crear otro</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navegacion.NavigateTo("/empresa/usuarios"))">Ver usuarios</MudButton>
    </div>
}
</TarjetaFormulario>

@code {
    private RespuestaCrearUsuario? _resultado;
    private int _versionDelFormulario;

    private void Limpiar()
    {
        _resultado = null;
        _versionDelFormulario++;
    }
}
