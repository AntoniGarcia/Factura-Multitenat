@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Plataforma
@inject ServicioDeUsuarios Usuarios
@implements IDisposable

<MudDialog Class="dialogo-edicion-operador dialogo-edicion-usuario">
    <DialogContent>
        <PanelErrores Problema="_error" />
        <MudTabs Elevation="0" KeepPanelsAlive="true">
            <MudTabPanel Text="Datos del usuario" Icon="@Icons.Material.Filled.PersonOutline">
                <div class="formulario-catalogo-secciones operador-edicion-secciones">
                    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="usuario-edicion-datos">
                        <h2 id="usuario-edicion-datos" class="seccion-titulo">Datos de acceso</h2>
                        <div class="operador-edicion-campos">
                            <MudTextField @bind-Value="_nombre" Label="Nombre" Immediate="true" MaxLength="254"
                                          Required="true" Disabled="@_guardando" />
                            <MudTextField @bind-Value="_correo" Label="Correo" Immediate="true" InputType="InputType.Email"
                                          MaxLength="254" Required="true" Disabled="@_guardando" />
                        </div>
                    </section>

                    @if (PuedeCambiarContrasena)
                    {
                        <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="usuario-edicion-contrasena">
                            <h2 id="usuario-edicion-contrasena" class="seccion-titulo">Contraseña</h2>
                            <div class="operador-edicion-campos">
                                <MudTextField @bind-Value="_contrasena" Label="Contraseña nueva (opcional)" Immediate="true"
                                              InputType="@(_verContrasena ? InputType.Text : InputType.Password)"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@(_verContrasena ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                              OnAdornmentClick="@(() => _verContrasena = !_verContrasena)"
                                              MaxLength="128" Disabled="@_guardando" />
                                <MudTextField @bind-Value="_confirmacion" Label="Confirmar contraseña nueva" Immediate="true"
                                              InputType="InputType.Password" MaxLength="128" Disabled="@_guardando"
                                              Error="@(_confirmacion.Length > 0 && _contrasena != _confirmacion)"
                                              ErrorText="Las contraseñas no coinciden." />
                            </div>
                            <p class="seccion-ayuda">Déjala vacía para conservar la actual; al cambiarla se cierran sus sesiones.</p>
                        </section>
                    }
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Permisos y empresas" Icon="@Icons.Material.Filled.VerifiedUser">
                <div class="formulario-catalogo-secciones operador-edicion-secciones">
                    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="usuario-edicion-permisos">
                        <SelectorDePermisos @bind-Value="_permisos" Empresas="Empresas" @bind-EmpresasElegidas="_empresas"
                                            Deshabilitado="@_guardando" />
                    </section>
                </div>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancelar" Disabled="@_guardando">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar"
                   Disabled="@(_guardando || string.IsNullOrWhiteSpace(_nombre) || string.IsNullOrWhiteSpace(_correo) || _contrasena != _confirmacion)">
            @(_guardando ? "Guardando…" : "Guardar cambios")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter, EditorRequired]
    public UsuarioDeLaCuentaDto Usuario { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<EmpresaParaAccesoDto> Empresas { get; set; } = [];

    private string _nombre = string.Empty;
    private string _correo = string.Empty;
    private string _contrasena = string.Empty;
    private string _confirmacion = string.Empty;
    private bool _verContrasena;
    private bool PuedeCambiarContrasena => Usuario.CreadoPorAdministrador && !Usuario.EsUsuarioActual;
    private List<string> _permisos = [];
    private List<Guid> _empresas = [];
    private DetalleProblema? _error;
    private bool _guardando;

    protected override void OnInitialized()
    {
        _nombre = Usuario.Nombre;
        _correo = Usuario.Correo;
        _permisos = [.. Usuario.Permisos];
        _empresas = Empresas.Count == 1 ? [Empresas[0].Id] : [.. Usuario.Empresas];
    }

    private async Task Guardar()
    {
        if (_guardando || _contrasena != _confirmacion) return;
        _guardando = true;
        try
        {
            _error = await Usuarios.ActualizarAsync(Usuario.UsuarioId,
                new(_nombre, _correo, PuedeCambiarContrasena && _contrasena.Length > 0 ? _contrasena : null, _permisos, _empresas));
            if (_error is null) Dialogo.Close(DialogResult.Ok(true));
        }
        catch (HttpRequestException)
        {
            _error = new("about:blank", "No se pudo confirmar el guardado", 503,
                "Actualiza la lista para comprobar los datos antes de volver a intentarlo.", null, string.Empty, null);
        }
        finally { _guardando = false; }
    }

    private void Cancelar() => Dialogo.Cancel();

    public void Dispose() { _contrasena = string.Empty; _confirmacion = string.Empty; }
}
