@page "/facturas/nueva"
@page "/facturas/{Id:guid}"
@attribute [Authorize(Policy = Permisos.Timbrar)]
@using Facturacion.Client.Servicios.Documentos
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Client.Componentes.Facturas
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Documentos
@using Facturacion.Shared.Notaria
@using Facturacion.Shared.Plataforma
@inject ServicioDeEmision Emision
@inject ServicioDeObras Obras
@inject ServicioDeComercioExterior ComercioExterior
@inject ServicioDeClientes Clientes
@inject ServicioDeProductos Productos
@inject ServicioDeEmpresa Empresa
@inject ServicioDeCatalogos Catalogos
@inject NavigationManager Navegacion
@inject IDialogService Dialogos
@inject IServicioDeConfirmacion Confirmacion

<PageTitle>@(EsNuevo ? "Nueva factura" : "Factura")</PageTitle>
<TituloDePagina Texto="@TituloDeLaPantalla" />

<TarjetaFormulario Ancha="true" RutaVolver="/documentos">
<PanelErrores Problema="_error" />

@if (_cargando)
{
    <p>Cargando…</p>
}
else if (_comprobante is null)
{
    <p>No se encontró ese comprobante.</p>
}
else if (!EsEditable)
{
    <div class="aviso-normalizacion" role="status">
        <p><strong>Comprobante @EtiquetaDeEstatus.</strong></p>
        @if (_comprobante.Uuid is { } uuid)
        {
            <p>
                Folio <span class="cifra-tabular">@_comprobante.Serie-@_comprobante.Folio</span> —
                UUID <span class="cifra-tabular">@uuid</span>
            </p>
        }
    </div>
    <div class="acciones-formulario">
        <MudButton Variant="Variant.Filled" OnClick="@(() => Navegacion.NavigateTo("/facturas/nueva"))">
            Nueva factura
        </MudButton>
        <MudButton Variant="Variant.Text" OnClick="@(() => Navegacion.NavigateTo("/"))">Ir al inicio</MudButton>
    </div>
}
else
{
    @if (_integracionFiscal is { TimbradoDisponible: false })
    {
        <div class="aviso-documentos" role="status">
            El timbrado está pendiente de integración con el PAC. Puedes capturar y guardar
            borradores; no se generarán folios fiscales ni se consumirán timbres.
        </div>
    }

    <div class="emision-layout">
    <div class="emision-captura">
    @if (_tieneLicenciaObras)
    {
        <MudCheckBox T="bool" @bind-Value="_esFacturaDeObra" Disabled="@(_obraGuardada || _esFacturaComercio)"
                     Label="Esta factura corresponde a una estimación de obra" />
    }
    @if (_tieneLicenciaComercio)
    {
        <MudCheckBox T="bool" @bind-Value="_esFacturaComercio" Disabled="@(_comercioGuardado || _esFacturaDeObra)"
                     Label="Esta factura corresponde a Comercio Exterior" />
    }
    <MudTabs Class="emision-pestanas">
        <MudTabPanel Text="Detalle y conceptos">
            <section class="emision-seccion">
            <h2 class="seccion-titulo">General</h2>
            <div class="rejilla-campos">
                <MudTextField T="string" Value="@("Factura")" Label="Tipo de documento" ReadOnly="true" />
                <MudTextField T="string" Value="@FolioMostrado" Label="Folio" ReadOnly="true" Class="cifra-tabular" />

                <MudSelect T="string" @bind-Value="_moneda" Label="Moneda">
                    @foreach (var m in Catalogos.Obtener("c_Moneda"))
                    {
                        <MudSelectItem T="string" Value="@m.Clave">@m.Clave — @m.Descripcion</MudSelectItem>
                    }
                </MudSelect>

                <CampoMoneda Valor="@(_tipoCambio ?? 0)" ValorCambiado="v => _tipoCambio = v"
                              Label="Tipo de cambio" Deshabilitado="@(_moneda == "MXN")"
                              Requerido="@(_moneda != "MXN")" />

                <MudSelect T="Guid?" Value="@(_serie?.Id)" ValueChanged="AlCambiarSerie" Label="Serie">
                    @foreach (var s in _seriesActivas)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)s.Id)">@s.Prefijo</MudSelectItem>
                    }
                </MudSelect>
            </div>
            </section>

            <section class="emision-seccion">
            <h2 class="seccion-titulo">Datos del cliente</h2>
            <div class="rejilla-campos">
                <BuscadorDeCliente Valor="@_cliente" ValorCambiado="AlElegirClienteAsync" Requerido="true" />
                <MudTextField T="string" Value="@(_cliente?.Rfc)" Label="R.F.C." ReadOnly="true" Class="cifra-tabular" />
                <MudTextField T="string" Value="@(_cliente?.Nombre)" Label="Nombre" ReadOnly="true" />
                <MudTextField T="string" Value="@(_cliente?.DomicilioFiscalCp)" Label="Domicilio fiscal (CP)" ReadOnly="true" Class="cifra-tabular" />

                <MudSelect T="string" @bind-Value="_metodoPago" Label="Método de pago" Clearable="true">
                    @foreach (var m in Catalogos.Obtener("c_MetodoPago"))
                    {
                        <MudSelectItem T="string" Value="@m.Clave">@m.Clave — @m.Descripcion</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" @bind-Value="_formaPago" Label="Forma de pago" Clearable="true">
                    @foreach (var f in Catalogos.Obtener("c_FormaPago"))
                    {
                        <MudSelectItem T="string" Value="@f.Clave">@f.Clave — @f.Descripcion</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string" @bind-Value="_usoCfdi" Label="Uso de CFDI">
                    @foreach (var u in Catalogos.Obtener("c_UsoCFDI"))
                    {
                        <MudSelectItem T="string" Value="@u.Clave">@u.Clave — @u.Descripcion</MudSelectItem>
                    }
                </MudSelect>
            </div>
            </section>

            <section class="emision-seccion">
            <h2 class="seccion-titulo">Conceptos</h2>
            <p class="seccion-ayuda">
                Cada renglón se resuelve desde el catálogo de productos: código, unidad, descripción, precio e
                impuestos vienen de ahí. Solo la cantidad y el descuento se capturan aquí.
            </p>

            <div class="lista-conceptos">
                @for (var i = 0; i < _renglones.Count; i++)
                {
                    var indice = i;
                    var renglon = _renglones[indice];

                    <div class="concepto-editor">
                        @if (string.IsNullOrEmpty(renglon.ClaveProdServ))
                        {
                            <div class="concepto-editor-buscador">
                                <span class="concepto-editor-numero">@(indice + 1)</span>
                                <BuscadorDeProducto Valor="null" ValorCambiado="p => AlElegirProductoAsync(indice, p)" />
                            </div>
                        }
                        else
                        {
                            <div class="concepto-editor-identidad">
                                <span class="concepto-editor-numero">@(indice + 1)</span>
                                <div>
                                    <strong>@renglon.Descripcion</strong>
                                    <span><span class="cifra-tabular">@renglon.ClaveProdServ</span> · @renglon.UnidadTexto</span>
                                </div>
                            </div>

                            <MudNumericField T="decimal" Value="@renglon.Cantidad" ValueChanged="v => renglon.Cantidad = v"
                                             Label="Cantidad" Format="N2" Min="0.000001m"
                                             Class="concepto-editor-cantidad cifra-tabular" />

                            @if (_esFacturaComercio)
                            {
                                <MudTextField @bind-Value="renglon.NoIdentificacion"
                                              Label="Identificador de mercancía" MaxLength="100"
                                              HelperText="Debe coincidir con el NoIdentificacion del CFDI." />
                            }

                            <div class="concepto-editor-dato concepto-editor-precio">
                                <span>Precio unitario</span>
                                <strong class="cifra-tabular">@renglon.ValorUnitario.ToString("N2")</strong>
                            </div>

                            <MudNumericField T="decimal" Value="@renglon.Descuento" ValueChanged="v => renglon.Descuento = v"
                                             Label="Descuento" Format="N2" Min="0"
                                             Class="concepto-editor-descuento cifra-tabular" />

                            <div class="concepto-editor-dato concepto-editor-importe">
                                <span>Importe</span>
                                <strong class="cifra-tabular">@renglon.Importe.ToString("N2")</strong>
                            </div>

                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Class="concepto-editor-quitar"
                                           title="Quitar concepto" aria-label="Quitar concepto"
                                           OnClick="@(() => _renglones.RemoveAt(indice))" />
                        }
                    </div>
                }
            </div>

            @if (_renglones.Count == 0)
            {
                <div class="conceptos-vacio">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                    <span>Agrega el primer producto o servicio de la factura.</span>
                </div>
            }

            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => _renglones.Add(new RenglonConcepto()))">
                Agregar concepto
            </MudButton>
            </section>

            <section class="emision-seccion emision-seccion-notas">
                <h2 class="seccion-titulo">Información adicional</h2>
                <div class="rejilla-campos">
                    <MudTextField @bind-Value="_condicionesDePago" Label="Condiciones de pago" MaxLength="1000" />
                </div>
                <MudTextField @bind-Value="_observaciones" Label="Observaciones" Lines="3" MaxLength="2000" />
            </section>
        </MudTabPanel>

        <MudTabPanel Text="CFDI relacionados">
            <p class="seccion-ayuda">Opcional: solo si esta factura corrige, sustituye o se relaciona con otra ya timbrada.</p>

            <div class="rejilla-campos">
                <MudSelect T="string" @bind-Value="_tipoRelacion" Label="Tipo de relación" Clearable="true">
                    @foreach (var t in Catalogos.Obtener("c_TipoRelacion"))
                    {
                        <MudSelectItem T="string" Value="@t.Clave">@t.Clave — @t.Descripcion</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_serieRelacionado" Label="Serie" MaxLength="25" />
                <MudNumericField T="int?" @bind-Value="_folioRelacionado" Label="Folio" />
            </div>

            <MudButton Variant="Variant.Text" OnClick="AgregarRelacionadoAsync" Disabled="@(!PuedeAgregarRelacionado)">
                Agregar
            </MudButton>

            @if (_relacionados.Count > 0)
            {
                <MudSimpleTable Dense="true" Class="tabla-impuestos">
                    <thead>
                        <tr><th>Serie</th><th>Folio</th><th>UUID</th><th></th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _relacionados.Count; i++)
                        {
                            var indice = i;
                            var r = _relacionados[indice];
                            <tr>
                                <td>@r.Serie</td>
                                <td class="cifra-tabular">@r.Folio</td>
                                <td class="cifra-tabular">@r.UuidRelacionado</td>
                                <td>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   OnClick="@(() => _relacionados.RemoveAt(indice))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudTabPanel>

        <MudTabPanel Text="Información global" Disabled="@(!EsPublicoEnGeneral)">
            @if (!EsPublicoEnGeneral)
            {
                <p class="seccion-ayuda">Solo aplica cuando el cliente es «Público en general» (RFC XAXX010101000).</p>
            }
            else
            {
                <div class="rejilla-campos">
                    <MudSelect T="string" @bind-Value="_globalPeriodicidad" Label="Periodicidad" Required="true">
                        @foreach (var p in Catalogos.Obtener("c_Periodicidad"))
                        {
                            <MudSelectItem T="string" Value="@p.Clave">@p.Clave — @p.Descripcion</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="_globalMeses" Label="Mes" Required="true">
                        @foreach (var m in Catalogos.Obtener("c_Meses"))
                        {
                            <MudSelectItem T="string" Value="@m.Clave">@m.Clave — @m.Descripcion</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="int?" @bind-Value="_globalAnio" Label="Año" Required="true" />
                </div>
            }
        </MudTabPanel>
        @if (_tieneLicenciaNotaria)
        {
            <MudTabPanel Text="Notaría">
                <DatosNotarialesDeFactura ComprobanteId="@_comprobante.Id" Editable="@EsEditable" />
            </MudTabPanel>
        }
        @if (_tieneLicenciaObras && _esFacturaDeObra)
        {
            <MudTabPanel Text="Constructoras">
                <DatosDeObraDeFactura ComprobanteId="@_comprobante.Id" ImporteTrabajos="@_comprobante.SubTotal" GuardarFactura="GuardarAsync"
                                      AlGuardar="@(() => _obraGuardada = true)" />
            </MudTabPanel>
        }
        @if (_tieneLicenciaComercio && _esFacturaComercio)
        {
            <MudTabPanel Text="Comercio exterior">
                <DatosDeComercioExteriorDeFactura ComprobanteId="@_comprobante.Id" GuardarFactura="GuardarAsync"
                                                   VistaPreviaPdf="AbrirVistaPreviaAsync"
                                                   ObtenerConceptos="@(() => _comprobante.Conceptos)"
                                                   ResidenciaFiscalSugerida="@_clienteDetalle?.ResidenciaFiscal"
                                                   NumeroRegistroTributarioSugerido="@_clienteDetalle?.NumRegIdTrib"
                                                   AlGuardar="@(() => _comercioGuardado = true)" />
            </MudTabPanel>
        }
    </MudTabs>
    </div>

    <aside class="emision-resumen" aria-label="Resumen de la factura">
        <header class="emision-resumen-cabecera">
            <div>
                <span>Resumen de factura</span>
                <h2>@FolioMostrado</h2>
            </div>
            <IndicadorEstado Estatus="@EstatusVisual" />
        </header>

        <div class="emision-resumen-cliente">
            <span>Receptor</span>
            <strong>@(_cliente?.Nombre ?? "Sin seleccionar")</strong>
            @if (_cliente is not null)
            {
                <span class="cifra-tabular">@_cliente.Rfc</span>
            }
        </div>

        <dl class="emision-resumen-datos">
            <div><dt>Moneda</dt><dd class="cifra-tabular">@_moneda</dd></div>
            <div><dt>Serie</dt><dd class="cifra-tabular">@(_serie?.Prefijo ?? "—")</dd></div>
            <div><dt>Conceptos</dt><dd class="cifra-tabular">@_renglones.Count</dd></div>
        </dl>

        <dl class="emision-resumen-totales">
            <div><dt>Subtotal</dt><dd>@_comprobante.SubTotal.ToString("N2")</dd></div>
            <div><dt>Descuento</dt><dd>−@_comprobante.Descuento.ToString("N2")</dd></div>
            <div><dt>Impuestos trasladados</dt><dd>@_comprobante.TotalImpuestosTrasladados.ToString("N2")</dd></div>
            <div><dt>Impuestos retenidos</dt><dd>−@_comprobante.TotalImpuestosRetenidos.ToString("N2")</dd></div>
            <div class="emision-resumen-total"><dt>Total @_comprobante.Moneda</dt><dd>@_comprobante.Total.ToString("N2")</dd></div>
        </dl>

        <p class="emision-resumen-nota">
            @(_esFacturaDeObra || _esFacturaComercio
                ? "Este borrador requiere completar el módulo especial antes de generar un CFDI."
                : "Importes calculados por el servidor al guardar el borrador.")
        </p>

        <footer class="emision-resumen-acciones">
            <MudButton Variant="Variant.Outlined" OnClick="GuardarAsync"
                       Disabled="@(_guardando || _generando || _preparandoVista)">
                @(_guardando ? "Guardando…" : _esFacturaDeObra || _esFacturaComercio ? "Guardar conceptos" : "Guardar borrador")
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       OnClick="VistaPreviaAsync"
                       Disabled="@(_guardando || _generando || _preparandoVista || _renglones.Count == 0 || _esFacturaDeObra || _esFacturaComercio)">
                @(_preparandoVista ? "Preparando…" : "Vista previa PDF")
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="TimbrarCfdiAsync"
                       Disabled="@(_guardando || _generando || _preparandoVista || _renglones.Count == 0 || !PuedeTimbrar || _esFacturaDeObra || _esFacturaComercio)">
                @(_generando ? "Timbrando…" : "Timbrar CFDI")
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => Navegacion.NavigateTo("/documentos"))">
                Volver a documentos
            </MudButton>
        </footer>
    </aside>
    </div>
}
</TarjetaFormulario>

@code {
    private const string RfcPublicoEnGeneral = "XAXX010101000";

    [Parameter]
    public Guid? Id { get; set; }

    private bool EsNuevo => Id is null;

    private ComprobanteDto? _comprobante;
    private bool _cargando = true;
    private bool _guardando;
    private bool _generando;
    private bool _preparandoVista;
    private DetalleProblema? _error;
    private EstadoDeIntegracionFiscalDto? _integracionFiscal;
    private bool _tieneLicenciaNotaria;
    private bool _tieneLicenciaObras;
    private bool _tieneLicenciaComercio;
    private bool _esFacturaDeObra;
    private bool _esFacturaComercio;
    private bool _obraGuardada;
    private bool _comercioGuardado;
    private ClienteDto? _clienteDetalle;

    // Cabecera
    private string _moneda = "MXN";
    private decimal? _tipoCambio;
    private SerieParaEmisionDto? _serie;
    private IReadOnlyList<SerieParaEmisionDto> _seriesActivas = [];

    // Cliente
    private ClienteEnListaDto? _cliente;
    private string? _usoCfdi, _metodoPago, _formaPago;

    // Conceptos
    private readonly List<RenglonConcepto> _renglones = [];

    // Pie
    private string? _observaciones, _condicionesDePago;

    // CFDI relacionados
    private string? _tipoRelacion;
    private string _serieRelacionado = string.Empty;
    private int? _folioRelacionado;
    private readonly List<ComprobanteRelacionadoDto> _relacionados = [];

    // Información global
    private string? _globalPeriodicidad, _globalMeses;
    private int? _globalAnio = DateTime.UtcNow.Year;

    private bool EsEditable => _comprobante is { Estatus: "borrador" or "error" };

    private EstatusComprobante EstatusVisual
        => EstatusComprobanteExtensiones.Desde(_comprobante?.Estatus ?? "borrador");

    private bool PuedeTimbrar => _integracionFiscal?.TimbradoDisponible == true;

    private bool EsPublicoEnGeneral => _cliente?.Rfc == RfcPublicoEnGeneral;

    private bool PuedeAgregarRelacionado =>
        !string.IsNullOrWhiteSpace(_tipoRelacion) &&
        !string.IsNullOrWhiteSpace(_serieRelacionado) &&
        _folioRelacionado is > 0;

    private string TituloDeLaPantalla => _comprobante switch
    {
        null => "Nueva factura",
        { Folio: { } folio, Serie: { } serie } => $"Factura {serie}-{folio}",
        _ => "Nueva factura"
    };

    private string FolioMostrado => _comprobante is { Folio: { } f, Serie: { } s } ? $"{s}-{f}" : "Se asigna al timbrar";

    private string EtiquetaDeEstatus => _comprobante?.Estatus switch
    {
        "timbrado" => "timbrado",
        "timbrando" => "en proceso de timbrado",
        "cancelado" => "cancelado",
        "en_cancelacion" => "en proceso de cancelación",
        _ => _comprobante?.Estatus ?? string.Empty
    };

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _error = null;
        _integracionFiscal = await Emision.ObtenerEstadoDeIntegracionAsync();
        var empresa = await Empresa.ObtenerAsync();
        _tieneLicenciaNotaria = empresa?.Licencias.Notarios == true;
        _tieneLicenciaObras = empresa?.Licencias.Obras == true;
        _tieneLicenciaComercio = empresa?.Licencias.Comercio == true;

        if (EsNuevo)
        {
            // Se crea aquí, no al dar clic en "Guardar": el comprobante ES el borrador desde
            // el primer momento (ver ServicioDeEmision), y la URL con el id real es lo que
            // permite recargar la página sin perderlo.
            var nuevo = await Emision.CrearBorradorAsync();
            Navegacion.NavigateTo($"/facturas/{nuevo.Id}", replace: true);
            return;
        }

        _seriesActivas = await Empresa.ListarSeriesActivasAsync("I");

        var comprobante = await Emision.ObtenerAsync(Id!.Value);
        _comprobante = comprobante;

        if (comprobante is not null)
        {
            if (_tieneLicenciaObras)
            {
                var (datosObra, _) = await Obras.ObtenerAsync(comprobante.Id);
                _obraGuardada = datosObra is not null;
                _esFacturaDeObra = _obraGuardada;
            }
            if (_tieneLicenciaComercio)
            {
                var (datosComercio, _) = await ComercioExterior.ObtenerAsync(comprobante.Id);
                _comercioGuardado = datosComercio is not null;
                _esFacturaComercio = _comercioGuardado;
            }
            _moneda = comprobante.Moneda;
            _tipoCambio = comprobante.TipoCambio;
            // La que el borrador traía, no la primera de la lista: con FAC y HON dadas de alta,
            // tomar la primera convertía un borrador de honorarios en factura al recargar, sin
            // decir nada. Si la serie guardada ya no está activa queda nulo y hay que elegir
            // otra a mano, que es preferible a timbrar con una que nadie escogió.
            _serie = _seriesActivas.FirstOrDefault(s => s.Id == comprobante.SerieId);
            _metodoPago = comprobante.MetodoPago;
            _formaPago = comprobante.FormaPago;
            _usoCfdi = comprobante.ReceptorUsoCfdi;
            _observaciones = comprobante.Observaciones;
            _condicionesDePago = comprobante.CondicionesDePago;
            _globalPeriodicidad = comprobante.GlobalPeriodicidad;
            _globalMeses = comprobante.GlobalMeses;
            _globalAnio = comprobante.GlobalAnio ?? DateTime.UtcNow.Year;

            if (comprobante.ClienteId is { } clienteId)
            {
                var cliente = await Clientes.ObtenerAsync(clienteId);

                if (cliente is not null)
                {
                    _clienteDetalle = cliente;
                    _cliente = new ClienteEnListaDto(
                        cliente.Id, cliente.ClaveInterna, cliente.Rfc, cliente.Nombre,
                        cliente.RegimenFiscal, cliente.DomicilioFiscalCp, cliente.CorreoPrincipal, cliente.Activo);
                }
            }

            _renglones.Clear();
            foreach (var concepto in comprobante.Conceptos)
            {
                _renglones.Add(new RenglonConcepto
                {
                    ProductoId = concepto.ProductoId,
                    ClaveProdServ = concepto.ClaveProdServ,
                    ClaveUnidad = concepto.ClaveUnidad,
                    UnidadTexto = concepto.UnidadTexto,
                    NoIdentificacion = concepto.NoIdentificacion,
                    Descripcion = concepto.Descripcion,
                    ObjetoImp = concepto.ObjetoImp,
                    ValorUnitario = concepto.ValorUnitario,
                    Cantidad = concepto.Cantidad,
                    Descuento = concepto.Descuento,
                    Impuestos = concepto.Impuestos
                });
            }

            _relacionados.Clear();
            _relacionados.AddRange(comprobante.Relacionados);
        }

        _cargando = false;
    }

    private void AlCambiarSerie(Guid? serieId)
        => _serie = _seriesActivas.FirstOrDefault(s => s.Id == serieId);

    private async Task AlElegirClienteAsync(ClienteEnListaDto? seleccion)
    {
        _cliente = seleccion;
        _clienteDetalle = null;

        if (seleccion is null) return;

        // La lupa solo trae lo que se ve en la lista; método y forma de pago preferidos no
        // vienen ahí, así que se resuelve el cliente completo para precargarlos (§12.2).
        var completo = await Clientes.ObtenerAsync(seleccion.Id);

        if (completo is null) return;

        _clienteDetalle = completo;

        _usoCfdi = completo.UsoCfdiPreferido;
        _metodoPago = completo.MetodoPagoPreferido;
        _formaPago = completo.FormaPagoPreferida;
    }

    private async Task AlElegirProductoAsync(int indice, ProductoEnListaDto? seleccion)
    {
        if (seleccion is null) return;

        var producto = await Productos.ObtenerAsync(seleccion.Id);
        if (producto is null) return;

        var renglon = _renglones[indice];

        renglon.ProductoId = producto.Id;
        renglon.ClaveProdServ = producto.ClaveProdServ;
        renglon.ClaveUnidad = producto.ClaveUnidad;
        renglon.UnidadTexto = producto.UnidadTexto;
        renglon.NoIdentificacion = producto.CodigoInterno.ToString(System.Globalization.CultureInfo.InvariantCulture);
        renglon.Descripcion = producto.Descripcion;
        renglon.ObjetoImp = producto.ObjetoImp;
        renglon.ValorUnitario = producto.ValorUnitario;
        renglon.Impuestos = [.. producto.Impuestos.Select(i =>
            new ImpuestoDeConceptoDto(i.Impuesto, i.TipoFactor, i.TasaOCuota, i.EsRetencion))];
    }

    private async Task AgregarRelacionadoAsync()
    {
        if (!PuedeAgregarRelacionado) return;

        var (resuelto, error) = await Emision.ResolverRelacionadoAsync(_serieRelacionado, _folioRelacionado!.Value);

        if (error is not null)
        {
            _error = error;
            return;
        }

        _error = null;
        _relacionados.Add(new ComprobanteRelacionadoDto(
            null, _tipoRelacion!, resuelto!.Uuid, resuelto.Serie, resuelto.Folio));

        _serieRelacionado = string.Empty;
        _folioRelacionado = null;
        _tipoRelacion = null;
    }

    private async Task<bool> GuardarAsync()
    {
        if (_comprobante is null) return false;

        // Antes se filtraban con .Where(r => r.ProductoId is not null) y desaparecían sin
        // mensaje. El servidor rechaza igual estos renglones —ResolverConceptosAsync—, así que
        // esto no es la validación que cuenta: es decirlo antes del viaje y señalando cuál.
        var sinProducto = _renglones.FindIndex(r => r.ProductoId is null);

        if (sinProducto >= 0)
        {
            _error = ProblemaLocal($"El renglón {sinProducto + 1} no tiene un producto elegido.");
            return false;
        }

        _guardando = true;
        _error = null;

        var peticion = new PeticionGuardarBorrador(
            "I",
            _serie?.Id,
            _moneda,
            _moneda == "MXN" ? null : _tipoCambio,
            _formaPago,
            _metodoPago,
            _esFacturaComercio ? "02" : "01",
            _condicionesDePago,
            _observaciones,
            _cliente?.Id,
            _usoCfdi,
            EsPublicoEnGeneral ? _globalPeriodicidad : null,
            EsPublicoEnGeneral ? _globalMeses : null,
            EsPublicoEnGeneral ? _globalAnio : null,
            [.. _renglones.Select((r, i) => new ConceptoDto(
                null, i + 1, r.ProductoId, r.ClaveProdServ!, r.ClaveUnidad!, r.UnidadTexto, r.NoIdentificacion,
                r.Descripcion!, r.Cantidad, r.ValorUnitario, r.Importe, r.Descuento, r.ObjetoImp!, r.Impuestos))],
            _relacionados);

        var (exito, error) = await Emision.GuardarAsync(_comprobante.Id, peticion);

        _guardando = false;

        if (error is not null)
        {
            _error = error;
            return false;
        }

        _comprobante = exito;
        return true;
    }

    private async Task VistaPreviaAsync()
    {
        if (_comprobante is null || _preparandoVista) return;

        if (!await GuardarAsync()) return;

        await AbrirVistaPreviaAsync();
    }

    private async Task AbrirVistaPreviaAsync()
    {
        if (_comprobante is null || _preparandoVista) return;

        _preparandoVista = true;
        _error = null;

        try
        {
            var (archivo, error) = await Emision.ObtenerVistaPreviaPdfAsync(_comprobante.Id);

            if (error is not null)
            {
                _error = error;
                return;
            }

            var parametros = new DialogParameters<DialogoDeComprobanteDeCompra>
            {
                { x => x.Archivo, archivo! },
                { x => x.TituloVistaPrevia, "Vista previa del borrador" },
                { x => x.AvisoFiscal,
                    "Borrador sin validez fiscal. No contiene UUID, sellos, código QR fiscal ni certificación del SAT." }
            };

            await Dialogos.ShowAsync<DialogoDeComprobanteDeCompra>(
                "Vista previa de factura",
                parametros,
                new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
        }
        finally
        {
            _preparandoVista = false;
        }
    }

    private async Task TimbrarCfdiAsync()
    {
        if (_comprobante is null || !PuedeTimbrar) return;

        if (!await GuardarAsync()) return;

        var confirmado = await Confirmacion.ConfirmarAsync(
            "Timbrar CFDI",
            $"Se consumirá un timbre para emitir el CFDI de {_cliente?.Nombre ?? "el receptor"} " +
            $"por {_comprobante.Total:N2} {_comprobante.Moneda}. Después ya no podrás editarlo.",
            "Timbrar CFDI");

        if (!confirmado) return;

        _generando = true;
        _error = null;

        // Clave nueva por cada clic real del usuario: si el navegador reintenta la misma
        // petición HTTP, es el filtro de idempotencia del servidor el que la detiene, no esto.
        var (exito, error) = await Emision.TimbrarAsync(_comprobante!.Id, Guid.NewGuid().ToString("N"));

        _generando = false;

        if (error is not null)
        {
            _error = error;
            return;
        }
        // Se vuelve a pedir el comprobante completo: la respuesta de timbrar solo trae el
        // resumen, y la pantalla de solo lectura necesita el resto (receptor, conceptos).
        _comprobante = await Emision.ObtenerAsync(exito!.ComprobanteId);
    }

    /// <summary>
    /// Un Problem Details armado en el navegador, para lo que se detecta antes de llamar al
    /// servidor. Va sin <c>traceId</c> a propósito: no hubo petición, así que no hay nada que
    /// buscar en el log, y <c>PanelErrores</c> oculta esa línea cuando viene vacía.
    /// </summary>
    private static DetalleProblema ProblemaLocal(string detalle) => new(
        "urn:facturacion:error:captura-incompleta",
        "Falta algo en la captura",
        400,
        detalle,
        null,
        string.Empty,
        null);

    private sealed class RenglonConcepto
    {
        public Guid? ProductoId { get; set; }
        public string? ClaveProdServ { get; set; }
        public string? ClaveUnidad { get; set; }
        public string? UnidadTexto { get; set; }
        public string? NoIdentificacion { get; set; }
        public string? Descripcion { get; set; }
        public string? ObjetoImp { get; set; }
        public decimal ValorUnitario { get; set; }
        public decimal Cantidad { get; set; } = 1;
        public decimal Descuento { get; set; }
        public IReadOnlyList<ImpuestoDeConceptoDto> Impuestos { get; set; } = [];

        /// <summary>
        /// <c>Importe = Cantidad × ValorUnitario</c>, sin restar el descuento: en CFDI 4.0 el
        /// descuento es un atributo aparte del concepto y tiene su propia columna. Restarlo aquí
        /// hacía que la pantalla mostrara una cifra y el XML llevara otra.
        ///
        /// <para>
        /// Seis decimales y redondeo bancario para que dé exactamente lo mismo que
        /// <c>MotorDeImpuestos</c>, que es quien manda: el servidor recalcula este importe al
        /// guardar y es el suyo el que acaba en el XML. Las dos constantes están duplicadas
        /// porque el motor vive en el Server y todavía no lo alcanza el Client.
        /// </para>
        /// </summary>
        public decimal Importe => Math.Round(Cantidad * ValorUnitario, 6, MidpointRounding.ToEven);
    }
}
