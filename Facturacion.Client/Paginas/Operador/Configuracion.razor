@page "/operador/configuracion"
@layout LayoutDeOperador
@attribute [Authorize(Policy = PoliticasDelPanel.PoliticaDeOperador)]
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Paginas.Operador.Operadores
@using Facturacion.Client.Servicios.Operador
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Operador
@inject ServicioDePerfilDeOperador Perfil
@inject ServicioDeSesionDeOperador Sesion
@inject ServicioDeConfiguracionDelSistema ConfiguracionDelSistema
@inject IDialogService Dialogos
@inject NavigationManager Navegacion

<PageTitle>Configuración</PageTitle>
<TituloDePagina Texto="Configuración" />

<TarjetaFormulario>
    <PanelErrores Problema="_error" />

    @if (_aviso is not null)
    {
        <p class="mensaje-exito" role="status">@_aviso</p>
    }

    <h2 class="seccion-titulo">Mis datos</h2>

    <div class="rejilla-campos">
        <MudTextField @bind-Value="_nombre" Label="Nombre" MaxLength="128" />
    </div>

    <div class="acciones-formulario">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_trabajando"
                   OnClick="GuardarNombre">
            Guardar nombre
        </MudButton>
    </div>

    <h2 class="seccion-titulo">Correo de acceso</h2>

    <div class="rejilla-campos">
        <MudTextField @bind-Value="_correo" Label="Correo" InputType="InputType.Email" MaxLength="254" />
        <MudTextField @bind-Value="_contrasenaParaCorreo" Label="Tu contraseña actual"
                      InputType="InputType.Password" />
    </div>

    <div class="acciones-formulario">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_trabajando || string.IsNullOrWhiteSpace(_contrasenaParaCorreo))"
                   OnClick="CambiarCorreo">
            Cambiar correo
        </MudButton>
    </div>

    <h2 class="seccion-titulo">Contraseña</h2>
    <p class="seccion-ayuda">Al cambiarla se cierran todas las sesiones y tendrás que entrar de nuevo.</p>

    <div class="rejilla-campos">
        <MudTextField @bind-Value="_contrasenaActual" Label="Contraseña actual"
                      InputType="InputType.Password" />
        <MudTextField @bind-Value="_contrasenaNueva" Label="Contraseña nueva"
                      InputType="@(_verContrasena ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_verContrasena ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _verContrasena = !_verContrasena)"
                      HelperText="Al menos 12 caracteres." MaxLength="128" />
        <MudTextField @bind-Value="_contrasenaRepetida" Label="Repite la nueva"
                      InputType="InputType.Password" MaxLength="128" />
    </div>

    @if (!string.IsNullOrEmpty(_contrasenaRepetida) && _contrasenaNueva != _contrasenaRepetida)
    {
        <p class="texto-error">Las dos contraseñas no coinciden.</p>
    }

    <div class="acciones-formulario">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!PuedeCambiarContrasena)"
                   OnClick="CambiarContrasena">
            Cambiar contraseña
        </MudButton>
    </div>

    <h2 class="seccion-titulo">Correo saliente</h2>
    <p class="seccion-ayuda">De aquí salen todas las notificaciones del sistema.</p>

    @if (_sistemaCargando)
    {
        <p class="tabla-datos-estado">Cargando…</p>
    }
    else
    {
        <div class="rejilla-campos">
            <MudTextField @bind-Value="_servidor" Label="Servidor SMTP" Placeholder="smtp.ejemplo.com" />
            <MudTextField @bind-Value="_puertoTexto" Label="Puerto" Class="cifra-tabular" />
            <MudTextField @bind-Value="_usuarioSmtp" Label="Usuario" />
            <MudTextField @bind-Value="_contrasenaSmtp" Label="Contraseña"
                          InputType="@(_verSmtp ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_verSmtp ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _verSmtp = !_verSmtp)" />
            <MudTextField @bind-Value="_remitenteCorreo" Label="Correo del remitente"
                          InputType="InputType.Email" />
            <MudTextField @bind-Value="_remitenteNombre" Label="Nombre del remitente" />
        </div>

        <div class="rejilla-campos">
            <MudSwitch @bind-Value="_usarTls" Label="Usar conexión segura" Color="Color.Primary" />
        </div>
    }

    <h2 class="seccion-titulo">Identidad del sistema</h2>

    <div class="rejilla-campos">
        <MudTextField @bind-Value="_nombreDelSistema" Label="Nombre del sistema"
                      HelperText="El nombre que aparece en los correos y documentos."
                      MaxLength="128" />
    </div>

    <h2 class="seccion-titulo">Mensajes del registro</h2>
    <p class="seccion-ayuda">Se mandan por correo al crear una cuenta. Las palabras en mayúsculas las escribe solo el sistema con el dato correspondiente: NOMBRE es el nombre de quien se registra, CODIGO el de verificación, MINUTOS el tiempo de validez, y CORREO y CLAVE son los datos de acceso.</p>

    <h3 class="seccion-subtitulo">Correo de verificación</h3>

    <div class="rejilla-campos">
        <MudTextField @bind-Value="_asuntoVerificacion" Label="Asunto" MaxLength="128" />
    </div>
    <MudTextField @bind-Value="_cuerpoVerificacion" Label="Mensaje" Lines="7" MaxLength="8000" />

    <h3 class="seccion-subtitulo">Correo de contraseña</h3>

    <div class="rejilla-campos">
        <MudTextField @bind-Value="_asuntoContrasena" Label="Asunto" MaxLength="128" />
    </div>
    <MudTextField @bind-Value="_cuerpoContrasena" Label="Mensaje" Lines="7" MaxLength="8000" />

    <div class="acciones-formulario">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_sistemaCargando || _trabajando)"
                   OnClick="GuardarConfiguracionDelSistema">
            Guardar configuración del sistema
        </MudButton>
    </div>

</TarjetaFormulario>

@code {
    private DetalleProblema? _error;
    private string? _aviso;
    private bool _trabajando;
    private bool _verContrasena;

    private string _nombre = string.Empty;
    private string _correo = string.Empty;
    private string _contrasenaParaCorreo = string.Empty;
    private string _contrasenaActual = string.Empty;
    private string _contrasenaNueva = string.Empty;
    private string _contrasenaRepetida = string.Empty;

    private bool _sistemaCargando = true;
    private bool _verSmtp;
    private string _servidor = string.Empty;
    private string _puertoTexto = string.Empty;
    private string _usuarioSmtp = string.Empty;
    private string _contrasenaSmtp = string.Empty;
    private string _remitenteCorreo = string.Empty;
    private string _remitenteNombre = string.Empty;
    private bool _usarTls = true;
    private string _nombreDelSistema = string.Empty;
    private string _asuntoVerificacion = string.Empty;
    private string _cuerpoVerificacion = string.Empty;
    private string _asuntoContrasena = string.Empty;
    private string _cuerpoContrasena = string.Empty;

    private bool PuedeCambiarContrasena =>
        !_trabajando &&
        !string.IsNullOrWhiteSpace(_contrasenaActual) &&
        _contrasenaNueva.Length >= 12 &&
        _contrasenaNueva == _contrasenaRepetida;

    protected override void OnInitialized()
    {
        if (Sesion.Sesion is not { } sesion) return;

        _nombre = sesion.Nombre;
        _correo = sesion.Correo;
    }

    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        if (!primeraVez) return;

        var configuracion = await ConfiguracionDelSistema.ObtenerAsync();

        if (configuracion is not null)
        {
            _servidor = configuracion.Servidor;
            _puertoTexto = configuracion.Puerto.ToString();
            _usuarioSmtp = configuracion.Usuario;
            _contrasenaSmtp = configuracion.Contrasena;
            _remitenteCorreo = configuracion.RemitenteCorreo;
            _remitenteNombre = configuracion.RemitenteNombre;
            _usarTls = configuracion.UsarTls;
            _nombreDelSistema = configuracion.NombreDelSistema;
            _asuntoVerificacion = configuracion.AsuntoVerificacion;
            _cuerpoVerificacion = configuracion.CuerpoVerificacion;
            _asuntoContrasena = configuracion.AsuntoContrasena;
            _cuerpoContrasena = configuracion.CuerpoContrasena;
        }

        _sistemaCargando = false;
        StateHasChanged();
    }

    private async Task GuardarNombre()
    {
        _trabajando = true;
        _error = null;
        _aviso = null;

        var (exito, error) = await Perfil.ActualizarNombreAsync(_nombre);

        _error = error;
        _trabajando = false;

        if (exito is not null)
        {
            Sesion.RefrescarDatos(exito);
            _aviso = "Nombre actualizado.";
        }
    }

    private async Task CambiarCorreo()
    {
        _trabajando = true;
        _error = null;
        _aviso = null;

        var (exito, error) = await Perfil.CambiarCorreoAsync(_correo, _contrasenaParaCorreo);

        _error = error;
        _trabajando = false;
        _contrasenaParaCorreo = string.Empty;

        if (exito is not null)
        {
            Sesion.RefrescarDatos(exito);
            _aviso = $"Ahora entras con {exito.Correo}.";
        }
    }

    private async Task CambiarContrasena()
    {
        _trabajando = true;
        _error = null;
        _aviso = null;

        _error = await Perfil.CambiarContrasenaAsync(_contrasenaActual, _contrasenaNueva);

        _trabajando = false;

        if (_error is not null) return;

        // El servidor cerró todas las sesiones, incluida la de esta pestaña: el token que
        // queda en memoria ya no sirve para nada.
        Sesion.Olvidar();
        Navegacion.NavigateTo("/operador/iniciar-sesion", replace: true);
    }

    private async Task GuardarConfiguracionDelSistema()
    {
        if (_trabajando || _sistemaCargando) return;

        if (!int.TryParse(_puertoTexto, out var puerto) || puerto is < 1 or > 65535)
        {
            _error = new DetalleProblema(
                Titulo: "Puerto no válido",
                Detalle: "El puerto debe ser un número entre 1 y 65535.",
                Estado: 400,
                Tipo: "https://facturacion.com/errors/puerto-invalido",
                Instancia: null,
                TraceId: Guid.NewGuid().ToString("N"),
                Errores: null);
            return;
        }

        var parametros = new DialogParameters<DialogoConfirmarContrasenaOperador>
        {
            { x => x.Mensaje, "Vas a cambiar la configuración del correo saliente, el nombre del sistema y los mensajes del registro. Esto afecta a todos los correos que envía el SaaS." },
            { x => x.TextoConfirmar, "Guardar cambios" }
        };

        var referencia = await Dialogos.ShowAsync<DialogoConfirmarContrasenaOperador>(
            "Configuración del sistema", parametros);
        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: string contrasena }) return;

        _trabajando = true;
        _error = null;
        _aviso = null;

        var peticion = new PeticionGuardarConfiguracionDelSistema(
            _servidor.Trim(),
            puerto,
            _usuarioSmtp.Trim(),
            _contrasenaSmtp,
            _remitenteCorreo.Trim(),
            _remitenteNombre.Trim(),
            _usarTls,
            _nombreDelSistema.Trim(),
            _asuntoVerificacion.Trim(),
            _cuerpoVerificacion.Trim(),
            _asuntoContrasena.Trim(),
            _cuerpoContrasena.Trim(),
            contrasena);

        _error = await ConfiguracionDelSistema.GuardarAsync(peticion);

        _trabajando = false;

        if (_error is null)
            _aviso = "Configuración del sistema guardada y aplicada.";
    }

}
