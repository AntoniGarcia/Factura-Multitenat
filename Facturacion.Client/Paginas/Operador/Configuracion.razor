@page "/operador/configuracion"
@layout LayoutDeOperador
@attribute [Authorize(Policy = PoliticasDelPanel.PoliticaDeOperador)]
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Paginas.Operador.Operadores
@using Facturacion.Client.Servicios.Operador
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Operador
@using Facturacion.Shared.Documentos
@inject ServicioDePerfilDeOperador Perfil
@inject ServicioDeSesionDeOperador Sesion
@inject ServicioDeConfiguracionDelSistema ConfiguracionDelSistema
@inject NavigationManager Navegacion
@inject ISnackbar Avisos

<PageTitle>Configuración</PageTitle>
<TituloDePagina Texto="Configuración" />

<TarjetaFormulario Class="tarjeta-formulario-catalogo operador-configuracion">
    <PanelErrores Problema="_error" />

    @if (_aviso is not null)
    {
        <p class="mensaje-exito" role="status">@_aviso</p>
    }

    <MudTabs Elevation="0" KeepPanelsAlive="true">
    <MudTabPanel Text="Mi cuenta">
    <div class="formulario-catalogo-secciones">
    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="operador-config-perfil">
    <h2 id="operador-config-perfil" class="seccion-titulo">Mis datos</h2>

    <div class="rejilla-campos">
        <MudTextField @bind-Value="_nombre" Label="Nombre" MaxLength="128" />
    </div>

    <div class="acciones-formulario">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_trabajando"
                   OnClick="GuardarNombre">
            Guardar nombre
        </MudButton>
    </div>

    </section>
    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="operador-config-correo">
    <h2 id="operador-config-correo" class="seccion-titulo">Correo de acceso</h2>

    <div class="catalogo-rejilla catalogo-rejilla-dos">
        <MudTextField @bind-Value="_correo" Label="Correo" InputType="InputType.Email" MaxLength="254" />
        <MudTextField @bind-Value="_contrasenaParaCorreo" Label="Tu contraseña actual"
                      InputType="InputType.Password" />
    </div>

    <div class="acciones-formulario">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_trabajando || string.IsNullOrWhiteSpace(_contrasenaParaCorreo))"
                   OnClick="CambiarCorreo">
            Cambiar correo
        </MudButton>
    </div>

    </section>
    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="operador-config-contrasena">
    <h2 id="operador-config-contrasena" class="seccion-titulo">Contraseña</h2>
    <p class="seccion-ayuda">El cambio cierra tus sesiones abiertas.</p>

    <div class="catalogo-rejilla catalogo-rejilla-tres">
        <MudTextField @bind-Value="_contrasenaActual" Label="Contraseña actual"
                      InputType="InputType.Password" />
        <MudTextField @bind-Value="_contrasenaNueva" Label="Contraseña nueva"
                      InputType="@(_verContrasena ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_verContrasena ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _verContrasena = !_verContrasena)"
                      HelperText="Al menos 12 caracteres." MaxLength="128" />
        <MudTextField @bind-Value="_contrasenaRepetida" Label="Repite la nueva"
                      InputType="InputType.Password" MaxLength="128" />
    </div>

    @if (!string.IsNullOrEmpty(_contrasenaRepetida) && _contrasenaNueva != _contrasenaRepetida)
    {
        <p class="texto-error">Las dos contraseñas no coinciden.</p>
    }

    <div class="acciones-formulario">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!PuedeCambiarContrasena)"
                   OnClick="CambiarContrasena">
            Cambiar contraseña
        </MudButton>
    </div>
    </section>
    </div>
    </MudTabPanel>

    @if (Sesion.TienePermiso(PoliticasDelPanel.VerConfiguracion))
    {
    <MudTabPanel Text="Sistema">
    <div class="formulario-catalogo-secciones">
    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="operador-config-pac">
    <h2 id="operador-config-pac" class="seccion-titulo">Integración fiscal</h2>
    <p role="status">@EstadoDelPac</p>
    </section>
    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="operador-config-smtp"
             @oninput="LimpiarAvisoSmtp" @onchange="LimpiarAvisoSmtp">
    <h2 id="operador-config-smtp" class="seccion-titulo">Correo saliente</h2>
    <p class="seccion-ayuda">Remitente de registro, acceso y avisos del sistema.</p>

    @if (_sistemaCargando)
    {
        <p class="tabla-datos-estado">Cargando…</p>
    }
    else
    {
        <div class="catalogo-rejilla catalogo-rejilla-dos">
            <MudTextField @bind-Value="_servidor" Label="Servidor SMTP" Placeholder="smtp.ejemplo.com" MaxLength="253" Disabled="@(!PuedeAdministrarSistema || _trabajando)" />
            <MudTextField @bind-Value="_puertoTexto" Label="Puerto" HelperText="587 (STARTTLS)." Class="cifra-tabular" Disabled="@(!PuedeAdministrarSistema || _trabajando)" />
            <MudTextField @bind-Value="_usuarioSmtp" Label="Usuario" MaxLength="254" Disabled="@(!PuedeAdministrarSistema || _trabajando)" />
            <MudTextField @bind-Value="_contrasenaSmtpNueva" Label="Contraseña"
                          InputType="InputType.Password" MaxLength="512" Disabled="@(!(PuedeAdministrarSistema || PuedeProbarCorreo) || _trabajando)"
                          HelperText="@(_contrasenaSmtpConfigurada ? "Configurada; déjala vacía para conservarla." : "Sin credencial configurada.")" />
            <MudTextField @bind-Value="_remitenteCorreo" Label="Correo del remitente"
                          InputType="InputType.Email" MaxLength="254" Disabled="@(!PuedeAdministrarSistema || _trabajando)" />
            <MudTextField @bind-Value="_remitenteNombre" Label="Nombre del remitente" MaxLength="128" Disabled="@(!PuedeAdministrarSistema || _trabajando)" />
        </div>

        <div class="rejilla-campos">
            <MudSwitch @bind-Value="_usarTls" Label="Usar conexión segura" Color="Color.Primary" Disabled="@(!PuedeAdministrarSistema || _trabajando)" />
        </div>
        @if (PuedeProbarCorreo)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ProbarConfiguracionDelSistema" Disabled="@(_trabajando || _sistemaCargando)">
                @(_trabajando ? "Procesando…" : "Probar conexión")
            </MudButton>
        }
    }
    </section>

    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="operador-config-identidad">
    <h2 id="operador-config-identidad" class="seccion-titulo">Identidad del sistema</h2>

    <div class="rejilla-campos">
        <MudTextField @bind-Value="_nombreDelSistema" Label="Nombre del sistema"
                      HelperText="Visible en correos y documentos."
                      MaxLength="128" Disabled="@(!PuedeAdministrarSistema)" />
    </div>
    </section>

    <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="operador-config-mensajes">
    <h2 id="operador-config-mensajes" class="seccion-titulo">Mensajes del registro</h2>
    <p class="seccion-ayuda">Variables disponibles: NOMBRE, CODIGO, MINUTOS y CORREO.</p>

    <details class="catalogo-opcional operador-config-plantilla">
    <summary>Correo de verificación</summary>
    <div class="catalogo-opcional-contenido">

    <div class="rejilla-campos">
        <MudTextField @bind-Value="_asuntoVerificacion" Label="Asunto" MaxLength="128" Disabled="@(!PuedeAdministrarSistema)" />
    </div>
    <MudTextField @bind-Value="_cuerpoVerificacion" Label="Mensaje" Lines="7" MaxLength="8000" Disabled="@(!PuedeAdministrarSistema)" />
    </div>
    </details>

    <details class="catalogo-opcional operador-config-plantilla">
    <summary>Correo de bienvenida</summary>
    <div class="catalogo-opcional-contenido">

    <div class="rejilla-campos">
        <MudTextField @bind-Value="_asuntoContrasena" Label="Asunto" MaxLength="128" Disabled="@(!PuedeAdministrarSistema)" />
    </div>
    <MudTextField @bind-Value="_cuerpoContrasena" Label="Mensaje" Lines="7" MaxLength="8000" Disabled="@(!PuedeAdministrarSistema)" />
    </div>
    </details>
    </section>
    </div>

    @if (PuedeAdministrarSistema)
    {
    <div class="tarjeta-formulario-acciones">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_sistemaCargando || _trabajando)"
                   OnClick="GuardarConfiguracionDelSistema">
            Guardar configuración del sistema
        </MudButton>
    </div>
    }
    </MudTabPanel>
    }
    @if (Sesion.TienePermiso(PoliticasDelPanel.VerConfiguracion))
    {
        <MudTabPanel Text="Facturación">
            <Facturacion.Client.Componentes.Operador.ConfiguracionFiscalDelProveedor />
        </MudTabPanel>
    }
    </MudTabs>

</TarjetaFormulario>

@code {
    private DetalleProblema? _error;
    private string? _aviso;
    private bool _trabajando;
    private bool _verContrasena;
    private bool PuedeProbarCorreo => Sesion.TienePermiso(PoliticasDelPanel.ProbarCorreoSistema);
    private bool PuedeAdministrarSistema => Sesion.TienePermiso(PoliticasDelPanel.EditarCorreoSistema);

    private string _nombre = string.Empty;
    private string _correo = string.Empty;
    private string _contrasenaParaCorreo = string.Empty;
    private string _contrasenaActual = string.Empty;
    private string _contrasenaNueva = string.Empty;
    private string _contrasenaRepetida = string.Empty;

    private bool _sistemaCargando = true;
    private EstadoDeIntegracionFiscalDto? _pac;
    private string EstadoDelPac => _pac switch
    {
        null => _sistemaCargando ? "Consultando PAC…" : "No se pudo consultar el PAC.",
        { TimbradoDisponible: false } => "PAC no configurado. Timbrado no disponible.",
        { Simulado: true } => "PAC simulado. Sin validez fiscal.",
        _ => "PAC disponible."
    };
    private string _servidor = string.Empty;
    private string _puertoTexto = string.Empty;
    private string _usuarioSmtp = string.Empty;
    private string _contrasenaSmtpNueva = string.Empty;
    private bool _contrasenaSmtpConfigurada;
    private string _remitenteCorreo = string.Empty;
    private string _remitenteNombre = string.Empty;
    private bool _usarTls = true;
    private string _nombreDelSistema = string.Empty;
    private string _asuntoVerificacion = string.Empty;
    private string _cuerpoVerificacion = string.Empty;
    private string _asuntoContrasena = string.Empty;
    private string _cuerpoContrasena = string.Empty;

    private bool PuedeCambiarContrasena =>
        !_trabajando &&
        !string.IsNullOrWhiteSpace(_contrasenaActual) &&
        _contrasenaNueva.Length >= 12 &&
        _contrasenaNueva == _contrasenaRepetida;

    protected override void OnInitialized()
    {
        if (Sesion.Sesion is not { } sesion) return;

        _nombre = sesion.Nombre;
        _correo = sesion.Correo;
    }

    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        if (!primeraVez || !Sesion.TienePermiso(PoliticasDelPanel.VerConfiguracion)) return;

        try
        {
            _pac = await ConfiguracionDelSistema.ObtenerEstadoFiscalAsync();
        }
        catch (HttpRequestException)
        {
            _pac = null;
        }

        var configuracion = await ConfiguracionDelSistema.ObtenerAsync();

        if (configuracion is not null)
        {
            _servidor = configuracion.Servidor;
            _puertoTexto = configuracion.Puerto.ToString();
            _usuarioSmtp = configuracion.Usuario;
            _contrasenaSmtpConfigurada = configuracion.ContrasenaSmtpConfigurada;
            _remitenteCorreo = configuracion.RemitenteCorreo;
            _remitenteNombre = configuracion.RemitenteNombre;
            _usarTls = configuracion.UsarTls;
            _nombreDelSistema = configuracion.NombreDelSistema;
            _asuntoVerificacion = configuracion.AsuntoVerificacion;
            _cuerpoVerificacion = configuracion.CuerpoVerificacion;
            _asuntoContrasena = configuracion.AsuntoContrasena;
            _cuerpoContrasena = configuracion.CuerpoContrasena;
        }

        _sistemaCargando = false;
        StateHasChanged();
    }

    private async Task GuardarNombre()
    {
        _trabajando = true;
        _error = null;
        _aviso = null;

        var (exito, error) = await Perfil.ActualizarNombreAsync(_nombre);

        _error = error;
        _trabajando = false;

        if (exito is not null)
        {
            Sesion.RefrescarDatos(exito);
            _aviso = "Nombre actualizado.";
        }
    }

    private async Task CambiarCorreo()
    {
        _trabajando = true;
        _error = null;
        _aviso = null;

        var (exito, error) = await Perfil.CambiarCorreoAsync(_correo, _contrasenaParaCorreo);

        _error = error;
        _trabajando = false;
        _contrasenaParaCorreo = string.Empty;

        if (exito is not null)
        {
            Sesion.RefrescarDatos(exito);
            _aviso = $"Ahora entras con {exito.Correo}.";
        }
    }

    private async Task CambiarContrasena()
    {
        _trabajando = true;
        _error = null;
        _aviso = null;

        _error = await Perfil.CambiarContrasenaAsync(_contrasenaActual, _contrasenaNueva);

        _trabajando = false;

        if (_error is not null) return;

        // El servidor cerró todas las sesiones, incluida la de esta pestaña: el token que
        // queda en memoria ya no sirve para nada.
        Sesion.Olvidar();
        Navegacion.NavigateTo("/operador/iniciar-sesion", replace: true);
    }

    private void LimpiarAvisoSmtp() => _aviso = null;

    private Task GuardarConfiguracionDelSistema() => ProcesarConfiguracionDelSistema(false);
    private Task ProbarConfiguracionDelSistema() => ProcesarConfiguracionDelSistema(true);

    private async Task ProcesarConfiguracionDelSistema(bool probar)
    {
        if (_trabajando || _sistemaCargando || !(probar ? PuedeProbarCorreo : PuedeAdministrarSistema)) return;

        if (!int.TryParse(_puertoTexto, out var puerto) || puerto is < 1 or > 65535)
        {
            _error = new DetalleProblema(
                Titulo: "Puerto no válido",
                Detalle: "El puerto debe ser un número entre 1 y 65535.",
                Estado: 400,
                Tipo: "https://facturacion.com/errors/puerto-invalido",
                Instancia: null,
                TraceId: Guid.NewGuid().ToString("N"),
                Errores: null);
            return;
        }


        _trabajando = true;
        _error = null;
        _aviso = null;

        var peticion = new PeticionGuardarConfiguracionDelSistema(
            _servidor.Trim(),
            puerto,
            _usuarioSmtp.Trim(),
            string.IsNullOrWhiteSpace(_contrasenaSmtpNueva) ? null : _contrasenaSmtpNueva,
            _remitenteCorreo.Trim(),
            _remitenteNombre.Trim(),
            _usarTls,
            _nombreDelSistema.Trim(),
            _asuntoVerificacion.Trim(),
            _cuerpoVerificacion.Trim(),
            _asuntoContrasena.Trim(),
            _cuerpoContrasena.Trim());

        try
        {
            _error = probar ? await ConfiguracionDelSistema.ProbarAsync(peticion) : await ConfiguracionDelSistema.GuardarAsync(peticion);
        }
        finally { _trabajando = false; }

        if (probar)
        {
            if (_error is null)
                Avisos.Add("Conexión correcta (no se guardaron cambios ni se envió correo).",
                    Severity.Success, o => { o.VisibleStateDuration = 4000; o.ShowCloseIcon = true; });
            return;
        }

        if (_error is null)
        {
            if (!string.IsNullOrWhiteSpace(_contrasenaSmtpNueva))
                _contrasenaSmtpConfigurada = true;

            _contrasenaSmtpNueva = string.Empty;
            _aviso = "Configuración del sistema guardada y aplicada.";
        }
    }

}
