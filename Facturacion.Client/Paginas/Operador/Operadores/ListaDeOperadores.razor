@page "/operador/operadores"
@layout LayoutDeOperador
@attribute [Authorize(Policy = PoliticasDelPanel.VerOperadores)]
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Servicios.Operador
@using Facturacion.Shared.Operador
@inject ServicioDeOperadores Operadores
@inject IDialogService Dialogos
@inject IServicioDeConfirmacion Confirmacion
@inject ServicioDeSesionDeOperador Sesion

<PageTitle>Operadores</PageTitle>
<TituloDePagina Texto="Operadores" />

<PanelErrores Problema="_error" />

@if (_aviso is not null)
{
    <div class="aviso-documentos" role="status">@_aviso</div>
}

<div class="filtros-documentos">
    <MudTextField T="string" Value="_texto" ValueChanged="AlBuscar" Label="Buscar"
                  Placeholder="Nombre o correo" Immediate="false" DebounceInterval="300"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    <MudSelect T="string"
               Value="_filtroEstado"
               ValueChanged="AlCambiarFiltroEstado"
               Label="Estado">
        <MudSelectItem T="string" Value="@("todos")">Todos</MudSelectItem>
        <MudSelectItem T="string" Value="@("activos")">Activos</MudSelectItem>
        <MudSelectItem T="string" Value="@("inactivos")">Inactivos</MudSelectItem>
        <MudSelectItem T="string" Value="@("eliminados")">Eliminados</MudSelectItem>
    </MudSelect>
    @if (Sesion.TienePermiso(PoliticasDelPanel.CrearOperadores))
    {
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="Nuevo" Class="ml-4">Nuevo operador</MudButton>
    }
</div>

<TablaDatos T="OperadorDto"
            @ref="_tabla"
            Columnas="_columnas"
            CargarPagina="CargarAsync"
            TextoEntidad="operadores"
            TextoSinDatos="No hay operadores que coincidan." />

@code {
    private TablaDatos<OperadorDto>? _tabla;
    private DetalleProblema? _error;
    private string? _aviso;
    private bool _trabajando;
    private string _texto = string.Empty;
    private string _filtroEstado = "todos";

    private IReadOnlyList<ColumnaDeTabla<OperadorDto>> _columnas = [];

    protected override void OnInitialized() => _columnas =
    [
        new("Operador", u => @<div>
                             <div>@u.Nombre</div>
                             <div class="texto-secundario">@u.Correo</div>
                         </div>),
        new("Permisos", u => @<div>
                               @if (u.EsPrincipal || u.Permisos.Count == 0)
                               {
                                   <span>@(u.EsPrincipal ? "Todos" : "Sin permisos")</span>
                               }
                               else
                               {
                                   <details class="resumen-permisos-operador">
                                       <summary>@u.Permisos.Count @(u.Permisos.Count == 1 ? "permiso" : "permisos")</summary>
                                       <ul>
                                           @foreach (var permiso in u.Permisos)
                                           {
                                               <li>@PermisosDePanel.EtiquetaCorta(permiso)</li>
                                           }
                                       </ul>
                                   </details>
                               }
                           </div>),
        new("Alta", u => @<span class="cifra-tabular">@u.FechaAltaUtc.ToLocalTime().ToString("dd/MM/yyyy")</span>),
        new("Estado", u => @<span>
                               <span class="indicador-estado indicador-estado-@(u.Activo ? "timbrada" : "borrador")">
                                   @(u.Eliminado ? "Eliminado" : u.Activo ? "Activo" : "Desactivado")
                               </span>
                               @if (u.EsPrincipal)
                               {
                                   <span class="indicador-estado indicador-estado-principal" title="Operador principal del SaaS">
                                       Principal
                                   </span>
                               }
                           </span>),
        new("", u => @<div class="acciones-renglon">
                           @if (Sesion.TienePermiso(PoliticasDelPanel.VerActividadOperadores))
                           {
                               <MudButton Size="Size.Small" OnClick="@(() => VerActividad(u))">Actividad</MudButton>
                           }
                           @if (PuedeGestionar(u))
                           {
                               @if (Sesion.TienePermiso(PoliticasDelPanel.EditarOperadores))
                               {
                               <MudButton Size="Size.Small" Disabled="@_trabajando"
                                          OnClick="@(() => Editar(u))">
                                   Editar
                               </MudButton>
                               }
                               @if (Sesion.TienePermiso(PoliticasDelPanel.EliminarOperadores))
                               {
                               <MudButton Size="Size.Small" Disabled="@_trabajando" Color="Color.Error"
                                          OnClick="@(() => EliminarAsync(u))">Eliminar</MudButton>
                               }
                               @if (Sesion.TienePermiso(u.Activo ? PoliticasDelPanel.DesactivarOperadores : PoliticasDelPanel.ReactivarOperadores))
                               {
                                <MudButton Size="Size.Small" Disabled="@_trabajando"
                                           OnClick="@(() => CambiarActivo(u))"
                                           Color="@(u.Activo ? Color.Error : Color.Success)">
                                    @(u.Activo ? "Desactivar" : "Activar")
                                </MudButton>
                               }
                           }
                       </div>)
    ];

    private async Task<ResultadoDePagina<OperadorDto>> CargarAsync(
        PeticionDePagina peticion, CancellationToken ct)
    {
        var pagina = await Operadores.ListarAsync(
            _texto, FiltroDeActivos(), _filtroEstado == "eliminados", peticion.Pagina, peticion.TamanoPagina, ct);

        return new ResultadoDePagina<OperadorDto>(pagina.Elementos, pagina.Total);
    }

    private async Task AlBuscar(string texto)
    {
        _texto = texto;
        await RecargarAsync();
    }

    private async Task AlCambiarFiltroEstado(string estado)
    {
        _filtroEstado = estado;
        await RecargarAsync();
    }

    private bool? FiltroDeActivos() => _filtroEstado switch
    {
        "activos" => true,
        "inactivos" => false,
        _ => null
    };

    private Task RecargarAsync() => _tabla?.RecargarAsync() ?? Task.CompletedTask;

    private bool PuedeGestionar(OperadorDto operador)
        => !operador.Eliminado && !operador.EsPrincipal && operador.Id != Sesion.Sesion?.OperadorId
           && (Sesion.Sesion?.EsPrincipal == true
               || operador.Permisos.All(p => Sesion.Sesion?.Permisos.Contains(p) == true));

    private Task VerActividad(OperadorDto operador)
        => Dialogos.ShowAsync<DialogoDeActividadDeOperador>("Actividad del operador",
            new DialogParameters<DialogoDeActividadDeOperador>
            {
                { x => x.Operador, operador },
                { x => x.PuedeLimpiar, Sesion.TienePermiso(PermisosDePanel.LimpiarActividadOperadores)
                    && (Sesion.Sesion?.EsPrincipal == true || !operador.EsPrincipal
                        && operador.Permisos.All(p => Sesion.Sesion?.Permisos.Contains(p) == true)) }
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

    private async Task Nuevo()
    {
        var parametros = new DialogParameters<FormularioDeOperador>
        {
            { x => x.Modo, ModoFormulario.Crear }
        };

        var referencia = await Dialogos.ShowAsync<FormularioDeOperador>("Nuevo operador", parametros, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var resultado = await referencia.Result;

        if (resultado is { Canceled: false, Data: true })
        {
            _aviso = "Operador creado correctamente.";
            await RecargarAsync();
        }
    }

    private async Task Editar(OperadorDto operador)
    {
        var parametros = new DialogParameters<FormularioDeOperador>
        {
            { x => x.Modo, ModoFormulario.Editar },
            { x => x.Operador, operador }
        };

        var referencia = await Dialogos.ShowAsync<FormularioDeOperador>("Editar operador", parametros, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var resultado = await referencia.Result;

        if (resultado is { Canceled: false, Data: true })
        {
            _aviso = "Operador actualizado correctamente.";
            await RecargarAsync();
        }
    }

    private async Task CambiarActivo(OperadorDto operador)
    {
        if (_trabajando) return;

        var accion = operador.Activo ? "Desactivar" : "Activar";
        var mensaje = operador.Activo
            ? $"«{operador.Nombre}» dejará de poder entrar al panel y se cerrarán sus sesiones."
            : $"«{operador.Nombre}» volverá a poder entrar al panel.";
        if (!await Confirmacion.ConfirmarAsync($"{accion} operador", mensaje, accion, esPeligrosa: operador.Activo)) return;

        _trabajando = true;
        _error = null;
        _aviso = null;

        var (exito, error) = await Operadores.CambiarActivoAsync(operador.Id, new PeticionCambiarActivoOperador(!operador.Activo));

        _error = error;
        _trabajando = false;

        if (_error is null)
            _aviso = operador.Activo ? "Operador desactivado." : "Operador activado.";

        await RecargarAsync();
    }

    private async Task EliminarAsync(OperadorDto operador)
    {
        if (_trabajando) return;
        _trabajando = true;
        _error = null;
        _aviso = null;
        try
        {
            if (!await Confirmacion.ConfirmarAsync("Eliminar operador",
                $"¿Eliminar a «{operador.Nombre}»? Su acceso se elimina definitivamente y se conserva su actividad.",
                "Eliminar", esPeligrosa: true)) return;
            _error = await Operadores.EliminarAsync(operador.Id);
            if (_error is null)
            {
                _aviso = "Operador eliminado.";
                await RecargarAsync();
            }
        }
        catch (HttpRequestException)
        {
            _error = new("about:blank", "No se pudo confirmar la eliminación", 0,
                "Actualiza la lista antes de intentarlo de nuevo.", null, string.Empty, null);
        }
        finally { _trabajando = false; }
    }
}
