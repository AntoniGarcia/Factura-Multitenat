@using MudBlazor

@*
    Cambio de contraseña de otro operador por parte del principal. Pide la contraseña nueva,
    su confirmación y la del propio operador que ejecuta (re-autenticación): es la operación
    más delicada del panel, equivale a entrar como otra persona.
*@

<MudDialog>
    <DialogContent>
        <p class="seccion-ayuda">
            Contraseña nueva de «@NombreOperador». Al guardarla se cierran todas sus sesiones.
        </p>

        <div class="rejilla-campos">
            <MudTextField @bind-Value="_contrasenaNueva" Label="Contraseña nueva"
                          InputType="@(_verNueva ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_verNueva ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _verNueva = !_verNueva)"
                          Immediate="true" MaxLength="128"
                          HelperText="Mínimo 12 caracteres."
                          Required="true" />
            <MudTextField @bind-Value="_confirma" Label="Repite la contraseña"
                          InputType="@(_verNueva ? InputType.Text : InputType.Password)"
                          Immediate="true" MaxLength="128"
                          Required="true" />
            <MudTextField @bind-Value="_contrasenaOperador" Label="Tu contraseña de operador"
                          InputType="@(_verPropia ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_verPropia ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _verPropia = !_verPropia)"
                          Immediate="true" MaxLength="128"
                          Required="true" />
        </div>

        @if (_coinciden == false)
        {
            <p class="texto-error">Las contraseñas no coinciden.</p>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!PuedeConfirmar)" OnClick="Confirmar">
            Cambiar contraseña
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter, EditorRequired]
    public string NombreOperador { get; set; } = string.Empty;

    private string _contrasenaNueva = string.Empty;
    private string _confirma = string.Empty;
    private string _contrasenaOperador = string.Empty;
    private bool _verNueva;
    private bool _verPropia;
    private bool? _coinciden;

    private bool PuedeConfirmar
        => _contrasenaNueva.Length >= 12
           && _confirma.Length >= 12
           && _contrasenaOperador.Length >= 12;

    private void Confirmar()
    {
        _coinciden = _contrasenaNueva == _confirma;

        if (_coinciden != true) return;

        Dialogo.Close(DialogResult.Ok(new ContrasenaACambiar(_contrasenaNueva, _contrasenaOperador)));
    }

    private void Cancelar() => Dialogo.Cancel();

    /// <summary>Lo que necesita el servicio: la contraseña nueva y la del principal que ejecuta.</summary>
    public sealed record ContrasenaACambiar(string ContrasenaNueva, string ContrasenaOperador);
}