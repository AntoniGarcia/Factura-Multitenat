@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Shared.Comun
@using Facturacion.Client.Servicios.Operador

<MudDialog>
    <DialogContent>
        <p class="seccion-ayuda">Permisos de @NombreOperador.</p>

        <PanelErrores Problema="_error" />

        <SelectorDePermisos @bind-Value="_permisos" Deshabilitado="@_guardando" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Guardar" Disabled="@_guardando">
            @(_guardando ? "Guardando…" : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter, EditorRequired]
    public string NombreOperador { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<string> PermisosActuales { get; set; } = [];

    private List<string> _permisos = [];
    private DetalleProblema? _error;
    private bool _guardando;

    protected override void OnInitialized() => _permisos = [.. PermisosActuales];

    private async Task Guardar()
    {
        _guardando = true;
        _error = null;

        // El servidor valida que la lista no venga vacía
        if (!_permisos.Any())
        {
            _error = new DetalleProblema(
                Tipo: "https://facturacion.com/errors/sin-permisos",
                Titulo: "Sin permisos",
                Estado: 400,
                Detalle: "El operador debe tener al menos un permiso.",
                Instancia: null,
                TraceId: Guid.NewGuid().ToString("N"),
                Errores: null);
            _guardando = false;
            return;
        }

        Dialogo.Close(DialogResult.Ok(_permisos));
    }

    private void Cancelar() => Dialogo.Cancel();
}