@using MudBlazor
@using System.ComponentModel.DataAnnotations

<MudDialog>
    <DialogContent>
        <p class="dialogo-cancelacion-aviso">@Mensaje</p>

        <div class="operador-dialogo-campos">
            <MudTextField @bind-Value="_correoNuevo" Label="Correo nuevo" InputType="InputType.Email"
                          Immediate="true" MaxLength="254" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialogo.Cancel())">Cancelar</MudButton>
        @if (PermiteCambiarContrasena)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Outlined"
                       OnClick="@(() => Dialogo.Close(DialogResult.Ok(true)))">Cambiar contraseña del titular</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!SePuedeConfirmar)"
                   OnClick="Confirmar">
            @TextoConfirmar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter]
    public string Mensaje { get; set; } = "Escribe el correo nuevo.";

    [Parameter]
    public string TextoConfirmar { get; set; } = "Guardar";

    [Parameter]
    public bool PermiteCambiarContrasena { get; set; }

    [Parameter]
    public string? CorreoActual { get; set; }

    private string _correoNuevo = string.Empty;

    protected override void OnInitialized() => _correoNuevo = CorreoActual ?? string.Empty;

    private bool SePuedeConfirmar =>
        new EmailAddressAttribute().IsValid(_correoNuevo);

    private void Confirmar() => Dialogo.Close(DialogResult.Ok(_correoNuevo.Trim().ToLowerInvariant()));
}
