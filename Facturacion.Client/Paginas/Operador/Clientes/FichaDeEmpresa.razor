@page "/operador/cuentas/{CuentaId:guid}/empresas/{EmpresaId:guid}"
@layout LayoutDeOperador
@attribute [Authorize(Policy = PoliticasDelPanel.PoliticaDeOperador)]
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Paginas.Operador.Operadores
@using Facturacion.Client.Servicios.Operador
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Operador
@inject ServicioDeClientesDePlataforma Clientes
@inject ServicioDeComprasDeOperador Compras
@inject ServicioDeUsuariosDePlataforma Usuarios
@inject IServicioDeConfirmacion Confirmacion
@inject IDialogService Dialogos

<PageTitle>@(_ficha?.NombreFiscal ?? "Ficha de empresa") · Panel del operador</PageTitle>
<TituloDePagina Texto="@(_ficha?.NombreFiscal ?? "Ficha de empresa")" />

@if (_cargando)
{
    <p class="tabla-datos-estado">Cargando…</p>
}
else if (_ficha is null)
{
    <div class="estado-vacio-ficha">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
        <strong>No se encontró esa empresa</strong>
        <span>La empresa no pertenece a esta cuenta o el enlace ya no es válido.</span>
        <MudButton Href="@($"/operador/cuentas/{CuentaId}")" Variant="Variant.Outlined">
            Volver a la cuenta
        </MudButton>
    </div>
}
else
{
    <a href="@($"/operador/cuentas/{CuentaId}")" class="ficha-operador-volver">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
        Volver a la cuenta
    </a>

    <section class="ficha-cuenta-resumen ficha-empresa-resumen" aria-label="Resumen de la empresa">
        <div class="ficha-empresa-identidad">
            <div>
                <div class="ficha-cuenta-meta">
                    <span class="indicador-estado indicador-estado-@(_ficha.Activa ? "timbrada" : "borrador")">
                        @(_ficha.Activa ? "Empresa activa" : "Empresa inactiva")
                    </span>
                    <span>Alta el @_ficha.FechaAltaUtc.ToLocalTime().ToString("dd MMM yyyy")</span>
                </div>
                <span class="ficha-cuenta-etiqueta">RFC</span>
                <strong class="ficha-empresa-rfc">@_ficha.Rfc</strong>
                <span class="ficha-empresa-regimen">Régimen fiscal @_ficha.RegimenFiscal</span>
            </div>

            <div class="ficha-empresa-acciones">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCard"
                           Disabled="@_trabajando"
                           OnClick="AsignarTimbres">
                    Asignar timbres
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="@(_ficha.Activa ? Color.Error : Color.Primary)"
                           StartIcon="@(_ficha.Activa
                               ? Icons.Material.Filled.Block
                               : Icons.Material.Filled.CheckCircle)"
                           Disabled="@_trabajando"
                           OnClick="CambiarActivoEmpresa">
                    @(_ficha.Activa ? "Desactivar" : "Reactivar empresa")
                </MudButton>
            </div>
        </div>

        <dl class="ficha-cuenta-metricas">
            <div>
                <dt>Timbres disponibles</dt>
                <dd class="cifra-tabular">@_ficha.TimbresDisponibles.ToString("N0")</dd>
            </div>
            <div>
                <dt>Timbres reservados</dt>
                <dd class="cifra-tabular">@_ficha.TimbresReservados.ToString("N0")</dd>
            </div>
            <div>
                <dt>Usuarios con acceso</dt>
                <dd class="cifra-tabular">@_ficha.Usuarios.Count.ToString("N0")</dd>
            </div>
            <div>
                <dt>Pagos pendientes</dt>
                <dd class="cifra-tabular @(_totalPendientes > 0 ? "metrica-advertencia" : null)">
                    @_totalPendientes.ToString("N0")
                </dd>
            </div>
        </dl>
    </section>

    <PanelErrores Problema="_error" />

    @if (_aviso is not null)
    {
        <div class="aviso-documentos" role="status">@_aviso</div>
    }

    @if (!_ficha.Activa)
    {
        <div class="aviso-empresa-inactiva" role="status">
            <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" />
            <div>
                <strong>Esta empresa está inactiva</strong>
                <span>No puede emitir nuevos comprobantes, pero su información permanece intacta.</span>
            </div>
        </div>
    }
    else if (_totalPendientes > 0)
    {
        <div class="aviso-operador-accion" role="status">
            <span class="aviso-operador-accion-icono" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Small" />
            </span>
            <div>
                <strong>
                    @_totalPendientes
                    @(_totalPendientes == 1 ? "pago espera acreditación" : "pagos esperan acreditación")
                </strong>
                <span>Confirma que el dinero haya llegado antes de entregar los timbres.</span>
            </div>
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       OnClick="@(() => _pestanaActiva = 1)">
                Revisar pagos
            </MudButton>
        </div>
    }

    <MudTabs @bind-ActivePanelIndex="_pestanaActiva"
             Elevation="0"
             ApplyEffectsToContainer="true"
             Class="pestanas-ficha-operador">
        <MudTabPanel Text="@($"Usuarios ({_ficha.Usuarios.Count})")">
            <div class="pestana-ficha-contenido">
                <div class="cabecera-seccion-ficha">
                    <div>
                        <h2>Usuarios con acceso</h2>
                        <p>Personas que pueden entrar y trabajar con esta empresa.</p>
                    </div>
                </div>

                <MudTable T="UsuarioDeCuentaDto"
                          Items="@_ficha.Usuarios"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          Breakpoint="Breakpoint.Sm"
                          Class="tabla-ficha-operador">
                    <HeaderContent>
                        <MudTh>Usuario</MudTh>
                        <MudTh>Fecha de alta</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Usuario">
                            <div class="usuario-ficha-identidad">
                                <strong>@context.Nombre</strong>
                                <a href="@($"mailto:{context.Correo}")">@context.Correo</a>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Fecha de alta" Class="cifra-tabular">
                            @context.FechaAltaUtc.ToLocalTime().ToString("dd/MM/yyyy")
                        </MudTd>
                        <MudTd DataLabel="Estado">
                            <span class="indicador-estado indicador-estado-@(context.Activo ? "timbrada" : "borrador")">
                                @(context.Activo ? "Activo" : "Inactivo")
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Acciones" Class="celda-menu-ficha">
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     Size="Size.Small"
                                     Disabled="@_trabajando"
                                     AnchorOrigin="Origin.BottomRight"
                                     AriaLabel="@($"Acciones para {context.Nombre}")">
                                <MudMenuItem OnClick="@(() => RestablecerContrasena(context))">
                                    <MudIcon Icon="@Icons.Material.Filled.Password" Size="Size.Small" />
                                    Restablecer contraseña
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => CambiarCorreo(context))">
                                    <MudIcon Icon="@Icons.Material.Filled.AlternateEmail" Size="Size.Small" />
                                    Modificar correo
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => CambiarActivo(context))">
                                    <MudIcon Icon="@(context.Activo
                                                      ? Icons.Material.Filled.PersonOff
                                                      : Icons.Material.Filled.PersonAdd)"
                                             Size="Size.Small" />
                                    @(context.Activo ? "Dar de baja" : "Reactivar")
                                </MudMenuItem>
                                <MudMenuItem Class="opcion-menu-peligrosa"
                                             OnClick="@(() => EliminarAcceso(context))">
                                    <MudIcon Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" />
                                    Eliminar acceso
                                </MudMenuItem>
                            </MudMenu>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="estado-vacio-tabla">
                            Ningún usuario tiene acceso a esta empresa.
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="@($"Compras ({_totalPendientes} pendientes)")">
            <div class="pestana-ficha-contenido">
                <div class="cabecera-seccion-ficha cabecera-compras-ficha">
                    <div>
                        <h2>Compras de timbres</h2>
                        <p>Solicitudes que requieren atención e historial acreditado.</p>
                    </div>
                    <MudTextField T="string"
                                  Value="_textoCompras"
                                  ValueChanged="AlBuscarCompras"
                                  Label="Buscar compras"
                                  Placeholder="Nombre del paquete"
                                  Immediate="false"
                                  DebounceInterval="300"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="buscador-compras-ficha" />
                </div>

                @if (_cargandoCompras)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="progreso-compras-ficha" />
                }

                <section class="seccion-compras-ficha" aria-labelledby="titulo-pendientes-empresa">
                    <div class="cabecera-subseccion-ficha">
                        <h3 id="titulo-pendientes-empresa">Por acreditar</h3>
                        @if (_ficha.ComprasPendientes.Count > 0)
                        {
                            <span class="indicador-estado indicador-estado-advertencia">
                                @_ficha.ComprasPendientes.Count
                            </span>
                        }
                    </div>

                    <MudTable T="CompraDeOperadorDto"
                              Items="@_ficha.ComprasPendientes"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              Breakpoint="Breakpoint.Sm"
                              Class="tabla-ficha-operador">
                        <HeaderContent>
                            <MudTh>Solicitada</MudTh>
                            <MudTh>Paquete</MudTh>
                            <MudTh class="cifra-tabular">Timbres</MudTh>
                            <MudTh class="cifra-tabular">Total</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Solicitada" Class="cifra-tabular">
                                @context.CreadaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </MudTd>
                            <MudTd DataLabel="Paquete">@context.NombrePaquete</MudTd>
                            <MudTd DataLabel="Timbres" Class="cifra-tabular">
                                @context.CantidadTimbres.ToString("N0")
                            </MudTd>
                            <MudTd DataLabel="Total" Class="cifra-tabular">
                                @context.PrecioTotal.ToString("C2")
                            </MudTd>
                            <MudTd DataLabel="Acciones" Class="celda-accion-ficha">
                                <div class="acciones-compra-ficha">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Disabled="@_trabajando"
                                               OnClick="@(() => Acreditar(context))">
                                        Acreditar
                                    </MudButton>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Error"
                                               Disabled="@_trabajando"
                                               OnClick="@(() => Rechazar(context))">
                                        Descartar
                                    </MudButton>
                                </div>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="estado-vacio-tabla">
                                @(_buscandoCompras
                                    ? "Ningún pago pendiente coincide con la búsqueda."
                                    : "No hay pagos pendientes por acreditar.")
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                </section>

                <section class="seccion-compras-ficha" aria-labelledby="titulo-historial-empresa">
                    <div class="cabecera-subseccion-ficha">
                        <h3 id="titulo-historial-empresa">Historial reciente</h3>
                        <span class="texto-secundario">
                            @(_buscandoCompras ? "Hasta 100 coincidencias" : "Últimas 10 compras")
                        </span>
                    </div>

                    <MudTable T="CompraDeOperadorDto"
                              Items="@_ficha.UltimasCompras"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              Breakpoint="Breakpoint.Sm"
                              Class="tabla-ficha-operador">
                        <HeaderContent>
                            <MudTh>Fecha</MudTh>
                            <MudTh>Paquete</MudTh>
                            <MudTh class="cifra-tabular">Timbres</MudTh>
                            <MudTh class="cifra-tabular">Total</MudTh>
                            <MudTh>Estado</MudTh>
                            <MudTh class="cifra-tabular">Vence</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Fecha" Class="cifra-tabular">
                                @context.CreadaUtc.ToLocalTime().ToString("dd/MM/yyyy")
                            </MudTd>
                            <MudTd DataLabel="Paquete">@context.NombrePaquete</MudTd>
                            <MudTd DataLabel="Timbres" Class="cifra-tabular">
                                @context.CantidadTimbres.ToString("N0")
                            </MudTd>
                            <MudTd DataLabel="Total" Class="cifra-tabular">
                                @context.PrecioTotal.ToString("C2")
                            </MudTd>
                            <MudTd DataLabel="Estado">
                                <span class="indicador-estado indicador-estado-timbrada">Acreditada</span>
                            </MudTd>
                            <MudTd DataLabel="Vence" Class="cifra-tabular">
                                @(context.VenceUtc?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="estado-vacio-tabla">
                                @(_buscandoCompras
                                    ? "Ninguna compra acreditada coincide con la búsqueda."
                                    : "Todavía no se ha acreditado ninguna compra.")
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                </section>
            </div>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public Guid CuentaId { get; set; }

    [Parameter]
    public Guid EmpresaId { get; set; }

    private FichaDeEmpresaDto? _ficha;
    private DetalleProblema? _error;
    private string? _aviso;
    private bool _cargando = true;
    private bool _cargandoCompras;
    private bool _trabajando;
    private int _pestanaActiva;
    private int _totalPendientes;
    private string _textoCompras = string.Empty;

    private bool _buscandoCompras => !string.IsNullOrWhiteSpace(_textoCompras);

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        await CargarAsync();
        _cargando = false;
    }

    private async Task CargarAsync()
    {
        _ficha = await Clientes.ObtenerEmpresaAsync(CuentaId, EmpresaId, _textoCompras);

        if (!_buscandoCompras && _ficha is not null)
            _totalPendientes = _ficha.ComprasPendientes.Count;
    }

    private async Task AlBuscarCompras(string texto)
    {
        _textoCompras = texto;
        _cargandoCompras = true;
        await CargarAsync();
        _cargandoCompras = false;
    }

    private async Task Acreditar(CompraDeOperadorDto compra)
    {
        if (_trabajando) return;

        var confirmado = await Confirmacion.ConfirmarAsync(
            "Acreditar el pago",
            $"Se van a abonar {compra.CantidadTimbres:N0} timbres a «{_ficha!.NombreFiscal}» " +
            $"({_ficha.Rfc}) por {compra.PrecioTotal:C2}. Hazlo solo si el pago ya llegó.",
            "Acreditar");

        if (!confirmado) return;

        _trabajando = true;
        _error = null;
        _aviso = null;

        _error = await Compras.AcreditarAsync(compra.Id);

        _trabajando = false;

        if (_error is null)
        {
            _aviso = $"Pago acreditado: {compra.CantidadTimbres:N0} timbres para {_ficha.NombreFiscal}.";
            if (_buscandoCompras) _totalPendientes = Math.Max(0, _totalPendientes - 1);
        }

        await CargarAsync();
    }

    private async Task Rechazar(CompraDeOperadorDto compra)
    {
        if (_trabajando) return;

        var parametros = new DialogParameters<DialogoDeMotivo>
        {
            { x => x.Titulo, "Descartar la compra" },
            { x => x.Mensaje, $"«{compra.NombrePaquete}» por {compra.PrecioTotal:C2}. " +
                              "No se entregará ningún timbre." }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDeMotivo>("Descartar la compra", parametros);
        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: string motivo }) return;

        _trabajando = true;
        _error = null;
        _aviso = null;

        _error = await Compras.RechazarAsync(compra.Id, motivo);

        _trabajando = false;

        if (_error is null)
        {
            _aviso = "Compra descartada.";
            if (_buscandoCompras) _totalPendientes = Math.Max(0, _totalPendientes - 1);
        }

        await CargarAsync();
    }

    private async Task CambiarActivoEmpresa()
    {
        if (_trabajando || _ficha is null) return;

        if (_ficha.Activa)
        {
            var parametros = new DialogParameters<DialogoDeBajaDeEmpresa>
            {
                { x => x.NombreEmpresa, _ficha.NombreFiscal }
            };

            var referencia = await Dialogos.ShowAsync<DialogoDeBajaDeEmpresa>("Desactivar empresa", parametros);
            var resultado = await referencia.Result;

            if (resultado is not { Canceled: false, Data: ValueTuple<string, string> baja }) return;

            _trabajando = true;
            _error = null;
            _aviso = null;

            _error = await Clientes.CambiarActivoEmpresaAsync(
                CuentaId, EmpresaId,
                new PeticionCambiarActivoDeEmpresa(false, baja.Item1, baja.Item2));

            _trabajando = false;

            if (_error is null) _aviso = "Empresa desactivada. Sus datos y comprobantes se conservan.";

            await CargarAsync();
            return;
        }

        var confirmar = new DialogParameters<DialogoConfirmarContrasenaOperador>
        {
            { x => x.Mensaje, $"Vas a reactivar «{_ficha.NombreFiscal}» ({_ficha.Rfc})." },
            { x => x.TextoConfirmar, "Reactivar" }
        };

        var refReactivar = await Dialogos.ShowAsync<DialogoConfirmarContrasenaOperador>("Reactivar la empresa", confirmar);
        var resReactivar = await refReactivar.Result;

        if (resReactivar is not { Canceled: false, Data: string contrasena }) return;

        _trabajando = true;
        _error = null;
        _aviso = null;

        _error = await Clientes.CambiarActivoEmpresaAsync(
            CuentaId, EmpresaId,
            new PeticionCambiarActivoDeEmpresa(true, null, contrasena));

        _trabajando = false;

        if (_error is null) _aviso = "Empresa reactivada.";

        await CargarAsync();
    }

    private async Task AsignarTimbres()
    {
        if (_trabajando || _ficha is null) return;

        var parametros = new DialogParameters<DialogoDeAsignacionDeTimbres>
        {
            { x => x.NombreEmpresa, _ficha.NombreFiscal }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDeAsignacionDeTimbres>("Asignar timbres", parametros);
        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: ValueTuple<int, int, string> asignacion }) return;

        _trabajando = true;
        _error = null;
        _aviso = null;

        var error = await Clientes.AsignarTimbresAsync(
            CuentaId, EmpresaId,
            new PeticionAsignarTimbres(asignacion.Item1, asignacion.Item2, asignacion.Item3));

        _trabajando = false;

        if (error is null)
            _aviso = $"Se asignaron {asignacion.Item1:N0} timbres a {_ficha.NombreFiscal}.";
        else
            _error = error;

        await CargarAsync();
    }

    private async Task RestablecerContrasena(UsuarioDeCuentaDto usuario)
    {
        if (_trabajando) return;

        var parametros = new DialogParameters<DialogoDeContrasenaDeUsuario>
        {
            { x => x.NombreUsuario, usuario.Nombre },
            { x => x.CorreoUsuario, usuario.Correo }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDeContrasenaDeUsuario>(
            "Restablecer contraseña", parametros);

        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: ValueTuple<string, string> datos }) return;

        _trabajando = true;
        _error = null;
        _aviso = null;

        _error = await Usuarios.RestablecerContrasenaAsync(usuario.Id, datos.Item1, datos.Item2);

        _trabajando = false;

        if (_error is null)
            _aviso = $"Contraseña restablecida. Comunícasela a {usuario.Nombre} por un medio seguro; " +
                     "sus sesiones abiertas ya se cerraron.";

        await CargarAsync();
    }

    private async Task CambiarCorreo(UsuarioDeCuentaDto usuario)
    {
        if (_trabajando) return;

        var parametros = new DialogParameters<DialogoDeCambioDeCorreo>
        {
            { x => x.Mensaje, $"Correo de «{usuario.Nombre}» ({usuario.Correo}). " +
                              "El usuario entra con este correo; comunícaselo si cambia." }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDeCambioDeCorreo>("Modificar correo", parametros);
        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: ValueTuple<string, string> datos }) return;

        _trabajando = true;
        _error = null;
        _aviso = null;

        _error = await Usuarios.CambiarCorreoAsync(usuario.Id, datos.Item1, datos.Item2);

        _trabajando = false;

        if (_error is null) _aviso = $"Correo de {usuario.Nombre} actualizado.";

        await CargarAsync();
    }

    private async Task CambiarActivo(UsuarioDeCuentaDto usuario)
    {
        if (_trabajando) return;

        string? motivo = null;

        if (usuario.Activo)
        {
            var parametros = new DialogParameters<DialogoDeMotivo>
            {
                { x => x.Titulo, "Dar de baja el acceso" },
                { x => x.Mensaje, $"«{usuario.Nombre}» ({usuario.Correo}) dejará de poder entrar a " +
                                  $"«{_ficha!.NombreFiscal}» y sus sesiones se cerrarán." },
                { x => x.EtiquetaCampo, "Motivo de la baja" },
                { x => x.TextoConfirmar, "Dar de baja" }
            };

            var referencia = await Dialogos.ShowAsync<DialogoDeMotivo>("Dar de baja el acceso", parametros);
            var resultado = await referencia.Result;

            if (resultado is not { Canceled: false, Data: string texto }) return;

            motivo = texto;
        }
        else
        {
            var confirmado = await Confirmacion.ConfirmarAsync(
                "Reactivar el acceso",
                $"«{usuario.Nombre}» volverá a poder entrar a «{_ficha!.NombreFiscal}».",
                "Reactivar");

            if (!confirmado) return;
        }

        _trabajando = true;
        _error = null;
        _aviso = null;

        _error = await Usuarios.CambiarActivoAsync(usuario.Id, !usuario.Activo, motivo);

        _trabajando = false;

        if (_error is null)
            _aviso = usuario.Activo ? "Acceso dado de baja." : "Acceso reactivado.";

        await CargarAsync();
    }

    private async Task EliminarAcceso(UsuarioDeCuentaDto usuario)
    {
        if (_trabajando) return;

        var parametros = new DialogParameters<DialogoDeMotivo>
        {
            { x => x.Titulo, "Eliminar el acceso" },
            { x => x.Mensaje, $"«{usuario.Nombre}» ({usuario.Correo}) dejará de poder entrar a " +
                              $"«{_ficha!.NombreFiscal}». Su cuenta queda intacta para las demás empresas." },
            { x => x.EtiquetaCampo, "Motivo" },
            { x => x.TextoConfirmar, "Eliminar acceso" }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDeMotivo>("Eliminar el acceso", parametros);
        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: string motivo }) return;

        _trabajando = true;
        _error = null;
        _aviso = null;

        _error = await Usuarios.EliminarAccesoAsync(usuario.Id, EmpresaId, motivo);

        _trabajando = false;

        if (_error is null)
            _aviso = $"Acceso de {usuario.Nombre} a «{_ficha.NombreFiscal}» eliminado.";

        await CargarAsync();
    }
}
