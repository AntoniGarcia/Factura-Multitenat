@using MudBlazor

<MudDialog Class="dialogo-cuenta-operador">
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(Mensaje))
        {
            <p class="seccion-ayuda">@Mensaje</p>
        }

        <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="cuenta-membresia-vigencia">
            <h2 id="cuenta-membresia-vigencia" class="seccion-titulo">Vigencia de la membresía</h2>
            <div class="membresia-atajos" role="group" aria-label="Duración rápida">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => AplicarMeses(6))">6 meses</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => AplicarMeses(12))">1 año</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => AplicarMeses(24))">2 años</MudButton>
            </div>
            <div class="operador-dialogo-campos operador-dialogo-campos-dos">
                <MudDatePicker @bind-Date="_inicio" Label="Vigente desde" />
                <MudDatePicker @bind-Date="_fin" Label="Vigente hasta" />
            </div>
        </section>

        @if (!EsRangoValido)
        {
            <p class="texto-error">La fecha de fin debe ser posterior a la de inicio.</p>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => Dialogo.Cancel())">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!EsRangoValido)"
                   OnClick="Confirmar">
            Registrar membresía
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter]
    public string Mensaje { get; set; } = string.Empty;

    private DateTime? _inicio = DateTime.Today;
    private DateTime? _fin = DateTime.Today.AddYears(1);

    private bool EsRangoValido => _inicio is { } desde && _fin is { } hasta && hasta > desde;

    private void AplicarMeses(int meses)
    {
        var baseFecha = _inicio ?? DateTime.Today;
        _inicio = baseFecha;
        _fin = baseFecha.AddMonths(meses);
    }

    private void Confirmar()
    {
        if (!EsRangoValido) return;

        // Las fechas se envían en UTC exacto a medianoche para evitar corrimientos de día.
        var desde = DateTime.SpecifyKind(_inicio!.Value, DateTimeKind.Utc);
        var hasta = DateTime.SpecifyKind(_fin!.Value, DateTimeKind.Utc);

        Dialogo.Close(DialogResult.Ok((desde, hasta)));
    }
}
