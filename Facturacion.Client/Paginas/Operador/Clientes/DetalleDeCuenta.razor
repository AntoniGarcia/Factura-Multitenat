@page "/operador/cuentas/{Id:guid}"
@layout LayoutDeOperador
@attribute [Authorize(Policy = PoliticasDelPanel.VerClientes)]
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Servicios.Operador
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Operador
@inject ServicioDeClientesDePlataforma Clientes
@inject ServicioDeTableroDeOperador Suscripciones
@inject IServicioDeConfirmacion Confirmacion
@inject IDialogService Dialogos
@inject ServicioDeSesionDeOperador Sesion
@inject NavigationManager Navegacion

<PageTitle>@(_detalle?.Cuenta.Nombre ?? "Ficha de cuenta") · Panel del operador</PageTitle>
<TituloDePagina Texto="@(_detalle?.Cuenta.Nombre ?? "Ficha de cuenta")" />

@if (_cargando)
{
    <p class="tabla-datos-estado">Cargando…</p>
}
else if (_detalle is null)
{
    <div class="estado-vacio-ficha">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
        <strong>No se encontró esa cuenta</strong>
        <span>Es posible que haya sido desactivada o que el enlace ya no sea válido.</span>
        <MudButton Href="/operador/cuentas" Variant="Variant.Outlined">Volver a clientes</MudButton>
    </div>
}
else
{
    <nav class="ficha-migas" aria-label="Navegación">
        <a href="/operador/cuentas" class="ficha-operador-volver">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            Cuentas
        </a>
        <span aria-hidden="true">/</span>
        <span>@_detalle.Cuenta.Nombre</span>
    </nav>

    <section class="ficha-cuenta-resumen" aria-label="Resumen de la cuenta">
        <div class="ficha-cuenta-identidad">
            <div class="ficha-cuenta-contacto">
                <div class="ficha-cuenta-meta">
                    <span class="indicador-estado indicador-estado-@(_detalle.Cuenta.Activa ? "timbrada" : "borrador")">
                        @(_detalle.Cuenta.Activa ? "Activa" : "Inactiva")
                    </span>
                    <span>Alta @_detalle.Cuenta.FechaAltaUtc.ToLocalTime().ToString("dd MMM yyyy")</span>
                    @if (!string.IsNullOrWhiteSpace(_detalle.NombreTitular))
                    {
                        <span class="ficha-titular-dato">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                            Titular: <strong>@_detalle.NombreTitular</strong>
                        </span>
                    }
                </div>
                <span class="ficha-cuenta-etiqueta">Correo de contacto</span>
                <a href="@($"mailto:{_detalle.Cuenta.CorreoContacto}")">@_detalle.Cuenta.CorreoContacto</a>
            </div>

            <div class="ficha-cuenta-acciones">
                @if (Sesion.TienePermiso(PoliticasDelPanel.GestionarLimites))
                {
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Tune"
                               Disabled="@_trabajando"
                               OnClick="EditarLimites">
                        Límites
                    </MudButton>
                }
                @if (Sesion.TienePermiso(PoliticasDelPanel.EditarContactoCuentas))
                {
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Edit"
                               Disabled="@_trabajando"
                               OnClick="EditarCorreoDeContacto">
                        Contacto
                    </MudButton>
                }
            </div>
        </div>

        <dl class="ficha-cuenta-metricas">
            <div class="ficha-metrica-tarjeta">
                <dt><MudIcon Icon="@Icons.Material.Filled.Apartment" Size="Size.Small" /> Empresas</dt>
                <dd class="cifra-tabular">
                    @_detalle.Limites.Empresas.ToString("N0") <span class="ficha-metrica-tope">/ @_detalle.Limites.LimiteDeEmpresas.ToString("N0")</span>
                </dd>
                <div class="ficha-metrica-barra" aria-hidden="true">
                    <span style="width: @PorcentajeUso(_detalle.Limites.Empresas, _detalle.Limites.LimiteDeEmpresas)%"></span>
                </div>
            </div>
            <div class="ficha-metrica-tarjeta">
                <dt><MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" /> Usuarios activos</dt>
                <dd class="cifra-tabular">
                    @_detalle.Limites.UsuariosActivos.ToString("N0") <span class="ficha-metrica-tope">/ @_detalle.Limites.LimiteDeUsuarios.ToString("N0")</span>
                </dd>
                <div class="ficha-metrica-barra" aria-hidden="true">
                    <span style="width: @PorcentajeUso(_detalle.Limites.UsuariosActivos, _detalle.Limites.LimiteDeUsuarios)%"></span>
                </div>
            </div>
            <div class="ficha-metrica-tarjeta">
                <dt><MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Size="Size.Small" /> Timbres disponibles</dt>
                <dd class="cifra-tabular">@_detalle.Cuenta.TimbresDisponibles.ToString("N0")</dd>
            </div>
            <div class="ficha-metrica-tarjeta">
                <dt><MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Small" /> Timbres reservados</dt>
                <dd class="cifra-tabular">@_detalle.TimbresReservados.ToString("N0")</dd>
            </div>
            <div class="ficha-metrica-tarjeta">
                <dt><MudIcon Icon="@Icons.Material.Filled.CardMembership" Size="Size.Small" /> Membresía</dt>
                <dd>
                    <span class="indicador-estado indicador-estado-@EstiloDeMembresia(_detalle.Cuenta)">
                        @TextoDeMembresia()
                    </span>
                </dd>
            </div>
        </dl>
    </section>

    <PanelErrores Problema="_error" />
    @if (_aviso is not null)
    {
        <div class="aviso-documentos" role="status">@_aviso</div>
    }

    @if (TotalDeComprasPendientes > 0)
    {
        <div class="aviso-operador-accion" role="status">
            <span class="aviso-operador-accion-icono" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Small" />
            </span>
            <div>
                <strong>
                    @TotalDeComprasPendientes
                    @(TotalDeComprasPendientes == 1 ? "pago pendiente" : "pagos pendientes")
                </strong>
                <span>
                    En @EmpresasConPendientes
                    @(EmpresasConPendientes == 1 ? "empresa de esta cuenta" : "empresas de esta cuenta")
                </span>
            </div>
            @if (Sesion.TienePermiso(PoliticasDelPanel.VerCompras))
            {
                <MudButton Href="/operador/compras" Variant="Variant.Text" Size="Size.Small">
                    Revisar pagos
                </MudButton>
            }
        </div>
    }

    <MudTabs Elevation="0"
             ApplyEffectsToContainer="true"
             KeepPanelsAlive="true"
             Class="pestanas-ficha-operador">
        <MudTabPanel Text="@($"Empresas ({_detalle.Empresas.Count})")" Icon="@Icons.Material.Filled.Apartment">
            <div class="pestana-ficha-contenido">
                <div class="cabecera-seccion-ficha">
                    <h2>Empresas emisoras</h2>
                </div>

                <MudTable T="EmpresaDeCuentaDto"
                          Items="@_detalle.Empresas"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          Breakpoint="Breakpoint.Sm"
                          OnRowClick="AlSeleccionarEmpresa"
                          Class="tabla-ficha-operador filas-previsualizables">
                    <HeaderContent>
                        <MudTh>RFC</MudTh>
                        <MudTh>Nombre fiscal</MudTh>
                        <MudTh>Régimen</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="RFC" Class="cifra-tabular">@context.Rfc</MudTd>
                        <MudTd DataLabel="Nombre fiscal">
                            <div class="empresa-con-pendientes">
                                <a href="@($"/operador/cuentas/{Id}/empresas/{context.Id}")">
                                    @context.NombreFiscal
                                </a>
                                @if (context.ComprasPendientes > 0)
                                {
                                    <span class="indicador-estado indicador-estado-advertencia">
                                        @context.ComprasPendientes pendientes
                                    </span>
                                }
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Régimen" Class="cifra-tabular">@context.RegimenFiscal</MudTd>
                        <MudTd DataLabel="Estado">
                            <span class="indicador-estado indicador-estado-@(context.Activa ? "timbrada" : "borrador")">
                                @(context.Activa ? "Activa" : "Inactiva")
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Acciones" Class="celda-accion-ficha">
                            <a href="@($"/operador/cuentas/{Id}/empresas/{context.Id}")"
                               class="accion-ir-ficha"
                               aria-label="@($"Abrir la empresa {context.NombreFiscal}")">
                                <span>Abrir</span>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                            </a>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="estado-vacio-tabla">
                            Esta cuenta todavía no tiene empresas emisoras.
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="@($"Paquetes exclusivos ({_detalle.PaquetesPersonalizados.Count})")" Icon="@Icons.Material.Filled.Inventory2">
            <div class="pestana-ficha-contenido">
                <div class="cabecera-seccion-ficha">
                    <div>
                        <h2>Paquetes exclusivos</h2>
                        <p>Visibles solo para las empresas de esta cuenta.</p>
                    </div>
                    @if (Sesion.TienePermiso(PoliticasDelPanel.CrearPaquetesExclusivos))
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AddCard"
                                   Disabled="@_trabajando"
                                   OnClick="CrearPaquetePersonalizado">
                            Crear paquete
                        </MudButton>
                    }
                </div>

                <MudTable T="PaquetePersonalizadoDto"
                          Items="@_detalle.PaquetesPersonalizados"
                          Dense="true" Hover="true" Elevation="0"
                          Breakpoint="Breakpoint.Sm" Class="tabla-ficha-operador">
                    <HeaderContent>
                        <MudTh>Paquete</MudTh>
                        <MudTh class="cifra-tabular">Timbres</MudTh>
                        <MudTh class="cifra-tabular">Por timbre</MudTh>
                        <MudTh class="cifra-tabular">Total con IVA</MudTh>
                        <MudTh>Vigencia</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Paquete">
                            <strong>@context.Nombre</strong>
                            @if (context.Compras > 0)
                            {
                                <div class="texto-secundario">@(context.Compras == 1 ? "1 compra" : $"{context.Compras} compras")</div>
                            }
                        </MudTd>
                        <MudTd DataLabel="Timbres" Class="cifra-tabular">@context.CantidadTimbres.ToString("N0")</MudTd>
                        <MudTd DataLabel="Por timbre" Class="cifra-tabular">
                            @((context.CantidadTimbres > 0 ? context.PrecioTotal / context.CantidadTimbres : 0m).ToString("C4"))
                        </MudTd>
                        <MudTd DataLabel="Total con IVA" Class="cifra-tabular">@context.PrecioTotal.ToString("C2")</MudTd>
                        <MudTd DataLabel="Vigencia">@context.VigenciaMeses meses</MudTd>
                        <MudTd DataLabel="Estado">
                            <span class="indicador-estado indicador-estado-@(context.Activo ? "timbrada" : "borrador")">
                                @(context.Activo ? "Disponible" : "Inactivo")
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Acciones" Class="celda-accion-ficha">
                            @if (Sesion.TienePermiso(PoliticasDelPanel.EditarPaquetesExclusivos))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@_trabajando"
                                           OnClick="@(() => EditarPaquetePersonalizado(context))">
                                    Editar
                                </MudButton>
                            }
                            @if (Sesion.TienePermiso(context.Activo ? PoliticasDelPanel.DesactivarPaquetesExclusivos : PoliticasDelPanel.ReactivarPaquetesExclusivos))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           Color="@(context.Activo ? Color.Error : Color.Primary)"
                                           Disabled="@_trabajando"
                                           OnClick="@(() => CambiarActivoPaquetePersonalizado(context))">
                                    @(context.Activo ? "Desactivar" : "Reactivar")
                                </MudButton>
                            }
                            @if (Sesion.TienePermiso(PermisosDePanel.EliminarPaquetesExclusivos))
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" Disabled="@_trabajando"
                                           OnClick="@(() => EliminarPaquetePersonalizado(context))">Eliminar</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="estado-vacio-tabla">Esta cuenta aún no tiene paquetes exclusivos.</div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="@($"Membresía ({_membresias.Count})")" Icon="@Icons.Material.Filled.CardMembership">
            <div class="pestana-ficha-contenido">
                <div class="cabecera-seccion-ficha">
                    <h2>Historial de membresía</h2>
                    @if (Sesion.TienePermiso(PoliticasDelPanel.GestionarMembresias))
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CardMembership"
                                   Disabled="@_trabajando"
                                   OnClick="RegistrarMembresia">
                            @(_membresias.Any(membresia => membresia.Estado == "activa")
                                ? "Renovar membresía"
                                : "Registrar membresía")
                        </MudButton>
                    }
                </div>

                <div class="suscripcion-actual">
                    <span class="suscripcion-actual-icono" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" />
                    </span>
                    <div>
                        <span>Estado actual</span>
                        <strong>@TextoDeMembresia()</strong>
                    </div>
                </div>

                <MudTable T="MembresiaDeOperadorDto"
                          Items="@_membresias"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          Breakpoint="Breakpoint.Sm"
                          Class="tabla-ficha-operador">
                    <HeaderContent>
                        <MudTh>Desde</MudTh>
                        <MudTh>Hasta</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Desde" Class="cifra-tabular">
                            @context.InicioUtc.ToLocalTime().ToString("dd/MM/yyyy")
                        </MudTd>
                        <MudTd DataLabel="Hasta" Class="cifra-tabular">
                            @context.FinUtc.ToLocalTime().ToString("dd/MM/yyyy")
                        </MudTd>
                        <MudTd DataLabel="Estado">
                            <span class="indicador-estado indicador-estado-@EstiloDeMembresia(context.Estado)">
                                @TextoDeEstado(context.Estado)
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Acciones" Class="celda-accion-ficha">
                            @if (context.Estado == "activa" && Sesion.TienePermiso(PoliticasDelPanel.GestionarMembresias))
                            {
                                <MudButton Size="Size.Small"
                                           Color="Color.Error"
                                           Variant="Variant.Text"
                                           Disabled="@_trabajando"
                                           OnClick="@(() => CancelarMembresia(context))">
                                    Dar de baja
                                </MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="estado-vacio-tabla">
                            Esta cuenta nunca ha tenido una membresía.
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private DetalleDeCuentaDto? _detalle;
    private IReadOnlyList<MembresiaDeOperadorDto> _membresias = [];
    private DetalleProblema? _error;
    private string? _aviso;
    private bool _cargando = true;
    private bool _trabajando;

    private int TotalDeComprasPendientes =>
        _detalle?.Empresas.Sum(empresa => empresa.ComprasPendientes) ?? 0;

    private int EmpresasConPendientes =>
        _detalle?.Empresas.Count(empresa => empresa.ComprasPendientes > 0) ?? 0;

    private void AlSeleccionarEmpresa(TableRowClickEventArgs<EmpresaDeCuentaDto> evento)
    {
        if (evento.Item is { } empresa)
            Navegacion.NavigateTo($"/operador/cuentas/{Id}/empresas/{empresa.Id}");
    }

    private static int PorcentajeUso(int actual, int limite)
        => limite <= 0 ? 0 : Math.Clamp((int)Math.Round(actual * 100.0 / limite), 0, 100);

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        await CargarAsync();
        _cargando = false;
    }

    private async Task CargarAsync()
    {
        _detalle = await Clientes.ObtenerAsync(Id);
        _membresias = await Suscripciones.MembresiasAsync(Id);
    }

    private async Task RegistrarMembresia()
    {
        if (_trabajando || _detalle is null) return;

        var parametros = new DialogParameters<DialogoDeMembresia>
        {
            { x => x.Mensaje, $"Membresía de «{_detalle.Cuenta.Nombre}» (reemplaza la activa si existe)." }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDeMembresia>("Registrar membresía", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: ValueTuple<DateTime, DateTime> rango }) return;

        _trabajando = true;
        _error = null;

        var (_, error) = await Suscripciones.RegistrarMembresiaAsync(
            new PeticionRegistrarMembresia(Id, rango.Item1, rango.Item2));

        _error = error;
        _trabajando = false;

        if (error is null) await CargarAsync();
    }

    private async Task CancelarMembresia(MembresiaDeOperadorDto membresia)
    {
        if (_trabajando) return;

        var confirmado = await Confirmacion.ConfirmarAsync(
            "Dar de baja la membresía",
            $"La membresía vigente hasta el {membresia.FinUtc.ToLocalTime():dd/MM/yyyy} quedará cancelada.",
            "Dar de baja", esPeligrosa: true);

        if (!confirmado) return;

        _trabajando = true;
        _error = null;

        _error = await Suscripciones.CancelarMembresiaAsync(membresia.Id);

        _trabajando = false;

        if (_error is null) await CargarAsync();
    }

    private async Task EditarLimites()
    {
        if (_trabajando || _detalle is null) return;

        var parametros = new DialogParameters<DialogoDeLimitesDeCuenta>
        {
            { x => x.NombreCuenta, _detalle.Cuenta.Nombre },
            { x => x.Limites, _detalle.Limites }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDeLimitesDeCuenta>("Editar límites", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: PeticionCambiarLimitesDeCuenta peticion }) return;

        _trabajando = true;
        _error = null;

        _error = await Clientes.CambiarLimitesAsync(Id, peticion);

        _trabajando = false;

        if (_error is null) await CargarAsync();
    }

    private async Task CrearPaquetePersonalizado()
    {
        if (_trabajando || _detalle is null) return;

        var parametros = new DialogParameters<DialogoDePaquetePersonalizado>
        {
            { x => x.NombreCuenta, _detalle.Cuenta.Nombre }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDePaquetePersonalizado>("Crear paquete exclusivo", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: PeticionGuardarPaquetePersonalizado peticion }) return;

        _trabajando = true;
        _error = await Clientes.CrearPaquetePersonalizadoAsync(Id, peticion);
        _trabajando = false;

        if (_error is null) await CargarAsync();
    }

    private async Task EditarPaquetePersonalizado(PaquetePersonalizadoDto paquete)
    {
        if (_trabajando || _detalle is null) return;

        var parametros = new DialogParameters<DialogoDePaquetePersonalizado>
        {
            { x => x.NombreCuenta, _detalle.Cuenta.Nombre },
            { x => x.Paquete, paquete }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDePaquetePersonalizado>("Editar paquete exclusivo", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: PeticionGuardarPaquetePersonalizado peticion }) return;

        _trabajando = true;
        _error = await Clientes.ActualizarPaquetePersonalizadoAsync(Id, paquete.Id, peticion);
        _trabajando = false;

        if (_error is null) await CargarAsync();
    }

    private async Task EliminarPaquetePersonalizado(PaquetePersonalizadoDto paquete)
    {
        if (_trabajando) return;
        _trabajando = true;
        _error = null;
        _aviso = null;
        try
        {
            if (!await Confirmacion.ConfirmarAsync("Eliminar paquete exclusivo",
                    $"«{paquete.Nombre}» desaparecerá del catálogo de esta cuenta. Las compras registradas se conservarán.",
                    "Eliminar", esPeligrosa: true)) return;
            _error = await Clientes.EliminarPaquetePersonalizadoAsync(Id, paquete.Id);
            if (_error is null)
            {
                _aviso = "Paquete eliminado.";
                await CargarAsync();
            }
        }
        finally { _trabajando = false; }
    }

    private async Task CambiarActivoPaquetePersonalizado(PaquetePersonalizadoDto paquete)
    {
        if (_trabajando) return;

        var nuevoEstado = !paquete.Activo;
        if (!nuevoEstado)
        {
            var confirmado = await Confirmacion.ConfirmarAsync(
                "Desactivar paquete",
                $"«{paquete.Nombre}» dejará de aparecer para esta cuenta. Las compras existentes no cambiarán.",
                "Desactivar");
            if (!confirmado) return;
        }

        _trabajando = true;
        _error = await Clientes.CambiarActivoPaquetePersonalizadoAsync(Id, paquete.Id, nuevoEstado);
        _trabajando = false;

        if (_error is null) await CargarAsync();
    }

    private bool PuedeCambiarContrasenaDelTitular => _detalle?.NombreTitular is not null
        && Sesion.TienePermiso(PoliticasDelPanel.RestablecerContrasenasUsuarios);

    private async Task CambiarContrasenaDelTitular()
    {
        if (_trabajando || !PuedeCambiarContrasenaDelTitular || _detalle?.NombreTitular is not { } nombre) return;
        var cuentaId = Id;
        var referencia = await Dialogos.ShowAsync<DialogoDeContrasenaDeUsuario>("Cambiar contraseña del titular",
            new DialogParameters<DialogoDeContrasenaDeUsuario> { { x => x.NombreUsuario, nombre } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await referencia.Result is not { Canceled: false, Data: string contrasena }) return;

        _trabajando = true;
        _error = null;
        _aviso = null;
        try
        {
            _error = await Clientes.CambiarContrasenaDelTitularAsync(cuentaId, contrasena);
            if (_error is null) _aviso = "Contraseña del titular actualizada.";
        }
        finally { _trabajando = false; }
    }

    private async Task EditarCorreoDeContacto()
    {
        if (_trabajando || _detalle is null) return;

        var parametros = new DialogParameters<DialogoDeCambioDeCorreo>
        {
            { x => x.Mensaje, $"Correo de contacto de «{_detalle.Cuenta.Nombre}»." },
            { x => x.TextoConfirmar, "Guardar correo" },
            { x => x.CorreoActual, _detalle.Cuenta.CorreoContacto },
            { x => x.PermiteCambiarContrasena, PuedeCambiarContrasenaDelTitular }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDeCambioDeCorreo>("Editar correo de contacto", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var resultado = await referencia.Result;

        if (resultado is { Canceled: false, Data: true })
        {
            await CambiarContrasenaDelTitular();
            return;
        }
        if (resultado is not { Canceled: false, Data: string valor }) return;

        _trabajando = true;
        _error = null;

        _error = await Clientes.CambiarCorreoDeContactoDeCuentaAsync(
            Id, new PeticionCambiarCorreoDeContactoDeCuenta(valor));

        _trabajando = false;

        if (_error is null) await CargarAsync();
    }

    private static string EstiloDeMembresia(CuentaEnListaDto cuenta) => cuenta.MembresiaEstado switch
    {
        "activa" when cuenta.MembresiaFinUtc is { } fin && fin < DateTime.UtcNow => "cancelada",
        "activa" => "timbrada",
        "vencida" => "cancelada",
        "cancelada" => "cancelada",
        _ => "borrador"
    };

    private static string EstiloDeMembresia(string estado) => estado switch
    {
        "activa" => "timbrada",
        "vencida" => "borrador",
        _ => "cancelada"
    };

    private static string TextoDeEstado(string estado) => estado switch
    {
        "activa" => "Activa",
        "vencida" => "Vencida",
        "cancelada" => "Cancelada",
        _ => estado
    };

    private string TextoDeMembresia() => _detalle?.Cuenta.MembresiaEstado switch
    {
        "activa" when _detalle.Cuenta.MembresiaFinUtc is { } fin => $"Activa hasta {fin.ToLocalTime():dd/MM/yyyy}",
        "activa" => "Activa",
        "vencida" => "Vencida",
        "cancelada" => "Cancelada",
        _ => "Sin membresía"
    };
}
