@page "/operador/cuentas/{Id:guid}"
@layout LayoutDeOperador
@attribute [Authorize(Policy = PoliticasDelPanel.PoliticaDeOperador)]
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Servicios.Operador
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Operador
@inject ServicioDeClientesDePlataforma Clientes
@inject ServicioDeTableroDeOperador Suscripciones
@inject IServicioDeConfirmacion Confirmacion
@inject IDialogService Dialogos

<PageTitle>@(_detalle?.Cuenta.Nombre ?? "Ficha de cuenta") · Panel del operador</PageTitle>
<TituloDePagina Texto="@(_detalle?.Cuenta.Nombre ?? "Ficha de cuenta")" />

@if (_cargando)
{
    <p class="tabla-datos-estado">Cargando…</p>
}
else if (_detalle is null)
{
    <div class="estado-vacio-ficha">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
        <strong>No se encontró esa cuenta</strong>
        <span>Es posible que haya sido desactivada o que el enlace ya no sea válido.</span>
        <MudButton Href="/operador/cuentas" Variant="Variant.Outlined">Volver a clientes</MudButton>
    </div>
}
else
{
    <a href="/operador/cuentas" class="ficha-operador-volver">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
        Volver a clientes
    </a>

    <section class="ficha-cuenta-resumen" aria-label="Resumen de la cuenta">
        <div class="ficha-cuenta-identidad">
            <div class="ficha-cuenta-contacto">
                <div class="ficha-cuenta-meta">
                    <span class="indicador-estado indicador-estado-@(_detalle.Cuenta.Activa ? "timbrada" : "borrador")">
                        @(_detalle.Cuenta.Activa ? "Cuenta activa" : "Cuenta inactiva")
                    </span>
                    <span>Cliente desde @_detalle.Cuenta.FechaAltaUtc.ToLocalTime().ToString("dd MMM yyyy")</span>
                </div>
                <span class="ficha-cuenta-etiqueta">Correo de contacto</span>
                <a href="@($"mailto:{_detalle.Cuenta.CorreoContacto}")">@_detalle.Cuenta.CorreoContacto</a>
            </div>

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Edit"
                       Disabled="@_trabajando"
                       OnClick="EditarCorreoDeContacto">
                Editar contacto
            </MudButton>
        </div>

        <dl class="ficha-cuenta-metricas">
            <div>
                <dt>Empresas</dt>
                <dd class="cifra-tabular">@_detalle.Cuenta.Empresas.ToString("N0")</dd>
            </div>
            <div>
                <dt>Usuarios</dt>
                <dd class="cifra-tabular">@_detalle.Cuenta.Usuarios.ToString("N0")</dd>
            </div>
            <div>
                <dt>Timbres disponibles</dt>
                <dd class="cifra-tabular">@_detalle.Cuenta.TimbresDisponibles.ToString("N0")</dd>
            </div>
            <div>
                <dt>Membresía</dt>
                <dd>
                    <span class="indicador-estado indicador-estado-@EstiloDeMembresia(_detalle.Cuenta)">
                        @TextoDeMembresia()
                    </span>
                </dd>
            </div>
        </dl>
    </section>

    <PanelErrores Problema="_error" />

    @if (TotalDeComprasPendientes > 0)
    {
        <div class="aviso-operador-accion" role="status">
            <span class="aviso-operador-accion-icono" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.PendingActions" Size="Size.Small" />
            </span>
            <div>
                <strong>
                    @TotalDeComprasPendientes
                    @(TotalDeComprasPendientes == 1 ? "pago pendiente" : "pagos pendientes")
                </strong>
                <span>
                    En @EmpresasConPendientes
                    @(EmpresasConPendientes == 1 ? "empresa de esta cuenta" : "empresas de esta cuenta")
                </span>
            </div>
            <MudButton Href="/operador/compras" Variant="Variant.Text" Size="Size.Small">
                Revisar pagos
            </MudButton>
        </div>
    }

    <MudTabs Elevation="0"
             ApplyEffectsToContainer="true"
             Class="pestanas-ficha-operador">
        <MudTabPanel Text="@($"Empresas ({_detalle.Empresas.Count})")">
            <div class="pestana-ficha-contenido">
                <div class="cabecera-seccion-ficha">
                    <div>
                        <h2>Empresas emisoras</h2>
                        <p>Identidad fiscal, saldo de timbres y estado de cada empresa.</p>
                    </div>
                </div>

                <MudTable T="EmpresaDeCuentaDto"
                          Items="@_detalle.Empresas"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          Breakpoint="Breakpoint.Sm"
                          Class="tabla-ficha-operador">
                    <HeaderContent>
                        <MudTh>RFC</MudTh>
                        <MudTh>Nombre fiscal</MudTh>
                        <MudTh>Régimen</MudTh>
                        <MudTh class="cifra-tabular">Disponibles</MudTh>
                        <MudTh class="cifra-tabular">Reservados</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="RFC" Class="cifra-tabular">@context.Rfc</MudTd>
                        <MudTd DataLabel="Nombre fiscal">
                            <div class="empresa-con-pendientes">
                                <a href="@($"/operador/cuentas/{Id}/empresas/{context.Id}")">
                                    @context.NombreFiscal
                                </a>
                                @if (context.ComprasPendientes > 0)
                                {
                                    <span class="indicador-estado indicador-estado-advertencia">
                                        @context.ComprasPendientes pendientes
                                    </span>
                                }
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Régimen" Class="cifra-tabular">@context.RegimenFiscal</MudTd>
                        <MudTd DataLabel="Disponibles" Class="cifra-tabular">
                            @context.TimbresDisponibles.ToString("N0")
                        </MudTd>
                        <MudTd DataLabel="Reservados" Class="cifra-tabular">
                            @context.TimbresReservados.ToString("N0")
                        </MudTd>
                        <MudTd DataLabel="Estado">
                            <span class="indicador-estado indicador-estado-@(context.Activa ? "timbrada" : "borrador")">
                                @(context.Activa ? "Activa" : "Inactiva")
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Acciones" Class="celda-accion-ficha">
                            <a href="@($"/operador/cuentas/{Id}/empresas/{context.Id}")"
                               class="accion-ir-ficha"
                               aria-label="@($"Abrir la empresa {context.NombreFiscal}")">
                                <span>Ver detalle</span>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                            </a>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="estado-vacio-tabla">
                            Esta cuenta todavía no tiene empresas emisoras.
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="@($"Membresía ({_membresias.Count})")">
            <div class="pestana-ficha-contenido">
                <div class="cabecera-seccion-ficha">
                    <div>
                        <h2>Historial de membresía</h2>
                        <p>Vigencia actual y periodos registrados para esta cuenta.</p>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.CardMembership"
                               Disabled="@_trabajando"
                               OnClick="RegistrarMembresia">
                        @(_membresias.Any(membresia => membresia.Estado == "activa")
                            ? "Renovar membresía"
                            : "Registrar membresía")
                    </MudButton>
                </div>

                <div class="suscripcion-actual">
                    <span class="suscripcion-actual-icono" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" />
                    </span>
                    <div>
                        <span>Estado actual</span>
                        <strong>@TextoDeMembresia()</strong>
                    </div>
                </div>

                <MudTable T="MembresiaDeOperadorDto"
                          Items="@_membresias"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          Breakpoint="Breakpoint.Sm"
                          Class="tabla-ficha-operador">
                    <HeaderContent>
                        <MudTh>Desde</MudTh>
                        <MudTh>Hasta</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Desde" Class="cifra-tabular">
                            @context.InicioUtc.ToLocalTime().ToString("dd/MM/yyyy")
                        </MudTd>
                        <MudTd DataLabel="Hasta" Class="cifra-tabular">
                            @context.FinUtc.ToLocalTime().ToString("dd/MM/yyyy")
                        </MudTd>
                        <MudTd DataLabel="Estado">
                            <span class="indicador-estado indicador-estado-@EstiloDeMembresia(context.Estado)">
                                @TextoDeEstado(context.Estado)
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Acciones" Class="celda-accion-ficha">
                            @if (context.Estado == "activa")
                            {
                                <MudButton Size="Size.Small"
                                           Color="Color.Error"
                                           Variant="Variant.Text"
                                           Disabled="@_trabajando"
                                           OnClick="@(() => CancelarMembresia(context))">
                                    Dar de baja
                                </MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="estado-vacio-tabla">
                            Esta cuenta nunca ha tenido una membresía.
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private DetalleDeCuentaDto? _detalle;
    private IReadOnlyList<MembresiaDeOperadorDto> _membresias = [];
    private DetalleProblema? _error;
    private bool _cargando = true;
    private bool _trabajando;

    private int TotalDeComprasPendientes =>
        _detalle?.Empresas.Sum(empresa => empresa.ComprasPendientes) ?? 0;

    private int EmpresasConPendientes =>
        _detalle?.Empresas.Count(empresa => empresa.ComprasPendientes > 0) ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        await CargarAsync();
        _cargando = false;
    }

    private async Task CargarAsync()
    {
        _detalle = await Clientes.ObtenerAsync(Id);
        _membresias = await Suscripciones.MembresiasAsync(Id);
    }

    private async Task RegistrarMembresia()
    {
        if (_trabajando || _detalle is null) return;

        var parametros = new DialogParameters<DialogoDeMembresia>
        {
            { x => x.Mensaje, $"Membresía de «{_detalle.Cuenta.Nombre}». " +
                              "Si ya tenía una activa, quedará sustituida por esta." }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDeMembresia>("Registrar membresía", parametros);
        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: ValueTuple<DateTime, DateTime> rango }) return;

        _trabajando = true;
        _error = null;

        var (_, error) = await Suscripciones.RegistrarMembresiaAsync(
            new PeticionRegistrarMembresia(Id, rango.Item1, rango.Item2));

        _error = error;
        _trabajando = false;

        if (error is null) await CargarAsync();
    }

    private async Task CancelarMembresia(MembresiaDeOperadorDto membresia)
    {
        if (_trabajando) return;

        var confirmado = await Confirmacion.ConfirmarAsync(
            "Dar de baja la membresía",
            $"La membresía vigente hasta el {membresia.FinUtc.ToLocalTime():dd/MM/yyyy} quedará cancelada.",
            "Dar de baja", esPeligrosa: true);

        if (!confirmado) return;

        _trabajando = true;
        _error = null;

        _error = await Suscripciones.CancelarMembresiaAsync(membresia.Id);

        _trabajando = false;

        if (_error is null) await CargarAsync();
    }

    private async Task EditarCorreoDeContacto()
    {
        if (_trabajando || _detalle is null) return;

        var parametros = new DialogParameters<DialogoDeCambioDeCorreo>
        {
            { x => x.Mensaje, $"Correo de contacto de «{_detalle.Cuenta.Nombre}». " +
                              "No cambia el acceso de ningún usuario." },
            { x => x.TextoConfirmar, "Guardar" }
        };

        var referencia = await Dialogos.ShowAsync<DialogoDeCambioDeCorreo>("Editar correo de contacto", parametros);
        var resultado = await referencia.Result;

        if (resultado is not { Canceled: false, Data: ValueTuple<string, string> datos }) return;

        _trabajando = true;
        _error = null;

        _error = await Clientes.CambiarCorreoDeContactoDeCuentaAsync(
            Id, new PeticionCambiarCorreoDeContactoDeCuenta(datos.Item1, datos.Item2));

        _trabajando = false;

        if (_error is null) await CargarAsync();
    }

    private static string EstiloDeMembresia(CuentaEnListaDto cuenta) => cuenta.MembresiaEstado switch
    {
        "activa" when cuenta.MembresiaFinUtc is { } fin && fin < DateTime.UtcNow => "cancelada",
        "activa" => "timbrada",
        "vencida" => "cancelada",
        "cancelada" => "cancelada",
        _ => "borrador"
    };

    private static string EstiloDeMembresia(string estado) => estado switch
    {
        "activa" => "timbrada",
        "vencida" => "borrador",
        _ => "cancelada"
    };

    private static string TextoDeEstado(string estado) => estado switch
    {
        "activa" => "Activa",
        "vencida" => "Vencida",
        "cancelada" => "Cancelada",
        _ => estado
    };

    private string TextoDeMembresia() => _detalle?.Cuenta.MembresiaEstado switch
    {
        "activa" when _detalle.Cuenta.MembresiaFinUtc is { } fin => $"Activa hasta {fin.ToLocalTime():dd/MM/yyyy}",
        "activa" => "Activa",
        "vencida" => "Vencida",
        "cancelada" => "Cancelada",
        _ => "Sin membresía"
    };
}
