@using MudBlazor

<MudDialog Class="dialogo-cuenta-operador">
    <DialogContent>
        <p class="seccion-ayuda">
            Al guardar se cerrarán las sesiones activas de <strong>@NombreUsuario</strong>.
        </p>

        <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha">
        <div class="operador-dialogo-campos operador-dialogo-campos-dos">
            <MudTextField @bind-Value="_nueva" Label="Contraseña nueva"
                          InputType="@(_ver ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_ver ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _ver = !_ver)"
                          Immediate="true" MaxLength="128"
                          HelperText="Mínimo 12 caracteres." />

            <MudTextField @bind-Value="_confirmacion" Label="Confirmar contraseña"
                          InputType="InputType.Password" Immediate="true" MaxLength="128"
                          Error="@(_confirmacion.Length > 0 && _nueva != _confirmacion)" ErrorText="Las contraseñas no coinciden." />
        </div>
        </section>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => Dialogo.Cancel())">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(!SePuedeConfirmar)"
                   OnClick="Confirmar">
            Restablecer
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialogo { get; set; } = default!;

    [Parameter]
    public string NombreUsuario { get; set; } = string.Empty;

    [Parameter]
    public string CorreoUsuario { get; set; } = string.Empty;

    private string _nueva = string.Empty;
    private string _confirmacion = string.Empty;
    private bool _ver;

    private bool SePuedeConfirmar =>
        _nueva.Length >= 12 && _nueva == _confirmacion;

    private void Confirmar() => Dialogo.Close(DialogResult.Ok(_nueva));
}
