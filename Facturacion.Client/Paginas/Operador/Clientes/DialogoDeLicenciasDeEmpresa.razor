@using Facturacion.Shared.Operador

<MudDialog Class="dialogo-cuenta-operador">
    <DialogContent>
        <p class="seccion-ayuda">
            Módulos activos para <strong>@NombreEmpresa</strong>.
        </p>

        <section class="formulario-catalogo-seccion formulario-catalogo-seccion-ancha" aria-labelledby="empresa-modulos-contratados">
        <h2 id="empresa-modulos-contratados" class="seccion-titulo">Módulos contratados</h2>
        <div class="permisos-acciones">
            <div class="permiso-casilla @(_notarios ? "marcada" : null)">
                <MudCheckBox @bind-Value="_notarios" Label="Notaría" Color="Color.Primary" Dense="true" />
            </div>
            <div class="permiso-casilla @(_obras ? "marcada" : null)">
                <MudCheckBox @bind-Value="_obras" Label="Constructoras" Color="Color.Primary" Dense="true" />
            </div>
            <div class="permiso-casilla @(_comercio ? "marcada" : null)">
                <MudCheckBox @bind-Value="_comercio" Label="Comercio exterior" Color="Color.Primary" Dense="true" />
            </div>
            <div class="permiso-casilla @(_ine ? "marcada" : null)">
                <MudCheckBox @bind-Value="_ine" Label="Complemento INE" Color="Color.Primary" Dense="true" />
            </div>
        </div>
        </section>

    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar">
            Guardar módulos
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;
    [Parameter] public string NombreEmpresa { get; set; } = string.Empty;
    [Parameter] public LicenciasDeEmpresaDto Licencias { get; set; } = new(false, false, false, false);

    private bool _notarios, _obras, _comercio, _ine;

    protected override void OnInitialized()
    {
        _notarios = Licencias.Notarios;
        _obras = Licencias.Obras;
        _comercio = Licencias.Comercio;
        _ine = Licencias.Ine;
    }

    private void Guardar() => Dialogo.Close(DialogResult.Ok(
        new PeticionActualizarLicenciasDeEmpresa(_notarios, _obras, _comercio, _ine)));

    private void Cancelar() => Dialogo.Cancel();
}
