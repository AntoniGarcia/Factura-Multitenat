@page "/operador/catalogos-sat"
@layout LayoutDeOperador
@attribute [Authorize(Policy = PoliticasDelPanel.VerCatalogosSat)]
@using Facturacion.Shared.Operador
@using Facturacion.Client.Servicios.Operador
@implements IDisposable
@inject ServicioDeCatalogosDeOperador Catalogos
@inject ServicioDeSesionDeOperador SesionOperador
@inject IServicioDeConfirmacion Confirmacion

<PageTitle>Catálogos del SAT</PageTitle>
<TituloDePagina Texto="Catálogos del SAT" />
<PanelErrores Problema="_error" />

@if (_cargando)
{
    <p role="status">Cargando catálogos…</p>
}
else if (_catalogos.Count > 0)
{
    <section class="catalogo-panel" aria-label="Consulta de catálogos del SAT">
        <p class="catalogo-descripcion">Claves, vigencia y versiones de los catálogos oficiales.</p>
        <div class="filtros-documentos">
            <MudAutocomplete T="string" Label="Catálogo del SAT" Value="_catalogo" ValueChanged="CambiarCatalogoAsync"
                             ToStringFunc="NombreCatalogo" SearchFunc="BuscarCatalogosAsync" MinCharacters="0"
                             DebounceInterval="300" OpenOnFocus="true" Strict="true" MaxItems="null"
                             Placeholder="Escribe nombre o clave…" />
            <MudTextField T="string" Label="Buscar clave o descripción" Value="_texto" ValueChanged="BuscarAsync"
                          DebounceInterval="300" Immediate="true" MaxLength="150"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            <MudSelect T="string" Label="Vigencia" Value="_vigencia" ValueChanged="CambiarVigenciaAsync">
                <MudSelectItem T="string" Value="@("todos")">Todas</MudSelectItem>
                <MudSelectItem T="string" Value="@("vigentes")">Vigentes</MudSelectItem>
                <MudSelectItem T="string" Value="@("no-vigentes")">No vigentes</MudSelectItem>
            </MudSelect>
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="ActualizarAsync">Recargar consulta</MudButton>
        </div>
        @if (Seleccionado?.UltimaCarga is { } carga)
        {
            <p class="seccion-ayuda">Versión @carga.VersionCatalogo · Revisión @carga.RevisionCatalogo · Última carga: @carga.FechaCargaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        }
        else
        {
            <p class="seccion-ayuda">Sin información de la última carga.</p>
        }
        @if (PuedeActualizar)
        {
            <details class="catalogo-opcional" open="@Actualizando">
                <summary>Cargar actualización</summary>
                <div class="catalogo-opcional-contenido">
                    <p class="seccion-ayuda">Archivo oficial Excel para @NombreCatalogo(_catalogo). Las claves retiradas se conservan como no vigentes.</p>
                    <div class="acciones-formulario catalogos-actualizacion">
                        <MudFileUpload T="IBrowserFile" FilesChanged="SeleccionarArchivo" Accept=".xls,.xlsx" Disabled="@(_subiendo || Actualizando)">
                            <CustomContent Context="carga">
                                <MudButton Variant="Variant.Outlined" Disabled="@(_subiendo || Actualizando)" OnClick="@(() => carga.OpenFilePickerAsync())" StartIcon="@Icons.Material.Filled.AttachFile">
                                    @(_archivo?.Name ?? "Elegir archivo SAT")
                                </MudButton>
                            </CustomContent>
                        </MudFileUpload>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AplicarActualizacionAsync"
                                   Disabled="@(_archivo is null || _subiendo || Actualizando)">Aplicar actualización</MudButton>
                    </div>
                </div>
            </details>
        }
        @if (_actualizacion is { } actualizacion)
        {
            <p role="status" class="@(_actualizacion.Estado == "error" ? "mensaje-error" : "seccion-ayuda")">@actualizacion.Catalogo: @actualizacion.Mensaje</p>
            @if (Actualizando) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
        }
        @if (FaltaBusqueda)
        {
            <p class="seccion-ayuda" role="status">Escribe al menos tres caracteres para consultar este catálogo.</p>
        }
        <div class="catalogo-tabla">
            <TablaDatos T="FilaCatalogoSatDto" @key="_revision" Columnas="_columnas"
                        CargarPagina="CargarAsync" TextoEntidad="claves" TextoSinDatos="No hay claves que coincidan." TamanoPagina="24" />
        </div>
    </section>
}
else
{
    <MudButton OnClick="ActualizarAsync">Volver a intentar</MudButton>
}

@code {
    private IReadOnlyList<CatalogoSatDeOperadorDto> _catalogos = [];
    private string _catalogo = "c_Moneda";
    private string _texto = "";
    private string _vigencia = "todos";
    private bool _cargando = true;
    private bool _descartado;
    private DetalleProblema? _error;
    private long _revision;
    private IBrowserFile? _archivo;
    private bool _subiendo;
    private ActualizacionCatalogosDto? _actualizacion;
    private readonly CancellationTokenSource _cancelacion = new();
    private Task? _seguimiento;
    private bool PuedeActualizar => SesionOperador.TienePermiso(PoliticasDelPanel.AdministrarConfiguracion);
    private bool Actualizando => _actualizacion?.Estado == "cargando";
    private CatalogoSatDeOperadorDto? Seleccionado => _catalogos.FirstOrDefault(x => x.Definicion.Clave == _catalogo);
    private bool FaltaBusqueda => Seleccionado?.Definicion.RequiereBusqueda == true && _texto.Trim().Length < 3;
    private readonly IReadOnlyList<ColumnaDeTabla<FilaCatalogoSatDto>> _columnas =
    [
        new("Clave", x => @<span class="cifra-tabular">@x.Clave</span>),
        new("Descripción", x => @<div class="catalogo-celda-principal"><strong>@x.Descripcion</strong><span>@x.Contexto</span></div>),
        new("Vigencia", x => @<span class="indicador-estado indicador-estado-@(x.Vigente ? "timbrada" : "borrador")">@(x.Vigente ? "Vigente" : "No vigente")</span>),
        new("Desde", x => @<span class="cifra-tabular">@(x.InicioVigencia == DateOnly.MinValue ? "—" : x.InicioVigencia.ToString("dd/MM/yyyy"))</span>),
        new("Hasta", x => @<span class="cifra-tabular">@(x.FinVigencia?.ToString("dd/MM/yyyy") ?? "—")</span>)
    ];

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogosAsync();
        try
        {
            var (actualizacion, error) = await Catalogos.ObtenerActualizacionAsync(_cancelacion.Token);
            _actualizacion = actualizacion;
            if (error is not null) _error = error;
            if (Actualizando) _seguimiento = SeguirActualizacionAsync();
        }
        catch (HttpRequestException) { _error = ErrorDeConexion(); }
        _cargando = false;
    }

    private async Task CargarCatalogosAsync()
    {
        try
        {
            var (datos, error) = await Catalogos.ListarAsync();
            if (_descartado) return;
            _error = error;
            if (datos is not null) _catalogos = datos;
        }
        catch (HttpRequestException) { _error = ErrorDeConexion(); }
    }

    private async Task<ResultadoDePagina<FilaCatalogoSatDto>> CargarAsync(PeticionDePagina peticion, CancellationToken ct)
    {
        var revision = _revision;
        if (FaltaBusqueda) return new([], 0);
        try
        {
            var (datos, error) = await Catalogos.ConsultarAsync(_catalogo, _texto, _vigencia switch
            { "vigentes" => true, "no-vigentes" => false, _ => null }, peticion.Pagina, peticion.TamanoPagina, ct);
            if (ct.IsCancellationRequested || revision != _revision || _descartado) throw new OperationCanceledException(ct);
            _error = error;
            return new(datos?.Elementos ?? [], datos?.Total ?? 0);
        }
        catch (HttpRequestException)
        {
            if (revision == _revision && !_descartado) _error = ErrorDeConexion();
            return new([], 0);
        }
        finally { if (!_descartado) await InvokeAsync(StateHasChanged); }
    }

    private Task CambiarCatalogoAsync(string clave)
    {
        if (!_catalogos.Any(x => x.Definicion.Clave == clave)) return Task.CompletedTask;
        _catalogo = clave;
        _archivo = null;
        _texto = "";
        _error = null;
        _revision++;
        return Task.CompletedTask;
    }

    private Task BuscarAsync(string texto) { _texto = texto; return RecargarAsync(); }
    private string NombreCatalogo(string clave)
        => _catalogos.FirstOrDefault(x => x.Definicion.Clave == clave) is { } item
            ? $"{item.Definicion.Nombre} · {item.Definicion.Clave}" : clave;

    private Task<IEnumerable<string>> BuscarCatalogosAsync(string texto, CancellationToken ct)
        => Task.FromResult(_catalogos.Where(x => string.IsNullOrWhiteSpace(texto) || texto == NombreCatalogo(_catalogo) ||
            System.Globalization.CultureInfo.GetCultureInfo("es-MX").CompareInfo.IndexOf(
                $"{x.Definicion.Nombre} {x.Definicion.Clave}", texto.Trim(),
                System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.IgnoreNonSpace) >= 0)
            .Select(x => x.Definicion.Clave));
    private Task CambiarVigenciaAsync(string vigencia) { _vigencia = vigencia; return RecargarAsync(); }
    private Task RecargarAsync()
    {
        _revision++;
        _error = null;
        return Task.CompletedTask;
    }

    private async Task ActualizarAsync() { await CargarCatalogosAsync(); await RecargarAsync(); }
    private static DetalleProblema ErrorDeConexion() => new("about:blank", "No se pudieron consultar los catálogos", 0,
        "Revisa tu conexión y vuelve a intentar.", null, "", null);
    private void SeleccionarArchivo(IBrowserFile? archivo) { _archivo = archivo; _error = null; }

    private async Task AplicarActualizacionAsync()
    {
        if (_archivo is null || Actualizando || _subiendo) return;
        if (_archivo.Size > 50L * 1024 * 1024 || Path.GetExtension(_archivo.Name).ToLowerInvariant() is not (".xls" or ".xlsx"))
        {
            _error = new("archivo-invalido", "Archivo no válido", 400, "Selecciona un Excel .xls o .xlsx de hasta 50 MB.", null, "", null);
            return;
        }
        var catalogo = _catalogo;
        var archivo = _archivo;
        if (!await Confirmacion.ConfirmarAsync("Actualizar catálogo", $"Se actualizará {NombreCatalogo(catalogo)} con {archivo.Name}.", "Actualizar")) return;
        _subiendo = true;
        try
        {
            await using var flujo = archivo.OpenReadStream(50L * 1024 * 1024, _cancelacion.Token);
            var (trabajo, error) = await Catalogos.ActualizarAsync(catalogo, flujo, archivo.Name, _cancelacion.Token);
            _error = error;
            if (trabajo is not null)
            {
                _actualizacion = trabajo;
                _archivo = null;
                _seguimiento = SeguirActualizacionAsync();
            }
        }
        catch (HttpRequestException) { _error = ErrorDeConexion(); }
        catch (OperationCanceledException) when (_descartado) { }
        finally { _subiendo = false; }
    }

    private async Task SeguirActualizacionAsync()
    {
        try
        {
            using var reloj = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (Actualizando && await reloj.WaitForNextTickAsync(_cancelacion.Token))
            {
                var (estado, error) = await Catalogos.ObtenerActualizacionAsync(_cancelacion.Token);
                if (_descartado) return;
                _error = error;
                _actualizacion = estado;
                if (estado is null && error is null)
                    _error = new("carga-interrumpida", "Actualización interrumpida", 409, "El servidor se reinició. Revisa la última carga antes de volver a intentarlo.", null, "", null);
                if (estado?.Estado == "listo") await ActualizarAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_descartado) { }
        catch (HttpRequestException)
        {
            if (!_descartado) { _error = ErrorDeConexion(); await InvokeAsync(StateHasChanged); }
        }
    }

    public void Dispose() { _descartado = true; _revision++; _cancelacion.Cancel(); _cancelacion.Dispose(); }
}
