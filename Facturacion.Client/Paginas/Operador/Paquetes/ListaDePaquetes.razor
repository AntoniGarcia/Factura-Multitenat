@page "/operador/paquetes"
@layout LayoutDeOperador
@attribute [Authorize(Policy = PoliticasDelPanel.PoliticaDeOperador)]
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Servicios.Operador
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Operador
@inject ServicioDePaquetesDeOperador Paquetes
@inject IServicioDeConfirmacion Confirmacion
@inject IDialogService Dialogos
@inject NavigationManager Navegacion

<PageTitle>Paquetes de timbres</PageTitle>
<TituloDePagina Texto="Paquetes de timbres" />

<PanelErrores Problema="_error" />

@if (_aviso is not null)
{
    <div class="aviso-documentos" role="status">@_aviso</div>
}

<div class="acciones-formulario">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="Nuevo">
        Nuevo paquete
    </MudButton>
</div>

@if (_paquetes is null)
{
    <p class="tabla-datos-estado">Cargando…</p>
}
else if (_paquetes.Count == 0)
{
    <p class="tabla-datos-estado">Todavía no hay ningún paquete.</p>
}
else
{
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr>
                <th>Orden</th>
                <th>Nombre</th>
                <th class="cifra-tabular">Timbres</th>
                <th class="cifra-tabular">Precio total</th>
                <th class="cifra-tabular">Por timbre</th>
                <th class="cifra-tabular">Vigencia</th>
                <th class="cifra-tabular">Compras</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var paquete in _paquetes)
            {
                <tr>
                    <td class="cifra-tabular">@paquete.Orden</td>
                    <td>@paquete.Nombre</td>
                    <td class="cifra-tabular">@paquete.CantidadTimbres.ToString("N0")</td>
                    <td class="cifra-tabular">@paquete.PrecioTotal.ToString("C2")</td>
                    <td class="cifra-tabular">@paquete.PrecioPorTimbre.ToString("C2")</td>
                    <td class="cifra-tabular">@paquete.VigenciaMeses meses</td>
                    <td class="cifra-tabular">@paquete.Compras</td>
                    <td>
                        <span class="indicador-estado indicador-estado-@(paquete.Activo ? "timbrada" : "borrador")">
                            @(paquete.Activo ? "A la venta" : "Retirado")
                        </span>
                    </td>
                    <td>
                        <div class="acciones-renglon">
                            <MudButton Size="Size.Small"
                                       OnClick="@(() => Navegacion.NavigateTo($"/operador/paquetes/{paquete.Id}"))">
                                Editar
                            </MudButton>
                            <MudButton Size="Size.Small" Disabled="@_trabajando"
                                       OnClick="@(() => CambiarActivo(paquete))">
                                @(paquete.Activo ? "Retirar" : "Reactivar")
                            </MudButton>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    private IReadOnlyList<PaqueteDeOperadorDto>? _paquetes;
    private DetalleProblema? _error;
    private string? _aviso;
    private bool _trabajando;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync() => _paquetes = await Paquetes.ListarAsync();

    private async Task Nuevo()
    {
        _error = null;
        _aviso = null;

        var referencia = await Dialogos.ShowAsync<DialogoDePaquete>(
            "Nuevo paquete",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var resultado = await referencia.Result;

        if (resultado is { Canceled: false, Data: true })
        {
            _aviso = "Paquete creado.";
            await CargarAsync();
        }
    }

    private async Task CambiarActivo(PaqueteDeOperadorDto paquete)
    {
        if (_trabajando) return;

        // Retirar es lo que merece confirmación: deja de venderse desde ese momento. El
        // aviso menciona las compras existentes porque no se pierden, que es la duda normal.
        if (paquete.Activo)
        {
            var confirmado = await Confirmacion.ConfirmarAsync(
                "Retirar de la venta",
                $"«{paquete.Nombre}» dejará de aparecer cuando un cliente compre timbres. " +
                "Las compras ya hechas con este paquete no se tocan.",
                "Retirar", esPeligrosa: true);

            if (!confirmado) return;
        }

        _trabajando = true;
        _error = null;

        var (_, error) = await Paquetes.CambiarActivoAsync(paquete.Id, !paquete.Activo);

        _error = error;
        _trabajando = false;

        if (error is null) await CargarAsync();
    }
}
