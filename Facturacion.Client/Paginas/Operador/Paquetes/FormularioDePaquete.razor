@page "/operador/paquetes/nuevo"
@page "/operador/paquetes/{Id:guid}"
@layout LayoutDeOperador
@attribute [Authorize(Policy = PoliticasDelPanel.PoliticaDeOperador)]
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Servicios.Operador
@using Facturacion.Shared.Operador
@inject NavigationManager Navegacion

<PageTitle>@(Id is null ? "Nuevo paquete" : "Editar paquete")</PageTitle>
<TituloDePagina Texto="@(Id is null ? "Nuevo paquete" : "Editar paquete")" />

<TarjetaFormulario RutaVolver="/operador/paquetes">
    <EditorDePaquete Id="Id"
                     Guardado="VolverALista"
                     Cancelado="VolverALista" />
</TarjetaFormulario>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private void VolverALista() => Navegacion.NavigateTo("/operador/paquetes");
}
