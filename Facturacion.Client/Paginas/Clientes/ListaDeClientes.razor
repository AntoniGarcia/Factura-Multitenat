@page "/clientes"
@attribute [Authorize]
@inject ServicioDeClientes Clientes
@inject NavigationManager Navegacion
@inject IServicioDeConfirmacion Confirmacion
@inject ServicioDeSesion Sesion

<PageTitle>Clientes</PageTitle>
<TituloDePagina Texto="Clientes" />

<PanelErrores Problema="_error" />

<section class="catalogo-panel" aria-label="Catálogo de clientes">
    <p class="catalogo-descripcion">
        Receptores disponibles para facturar en la empresa activa. Los inactivos conservan su historial.
    </p>

    <BarraHerramientasCatalogo Texto="@_texto"
                               TextoCambiado="AlBuscar"
                               Placeholder="Buscar por nombre, RFC o correo…"
                               MuestraEstatus="true"
                               Activos="_activos"
                               ActivosCambiado="AlFiltrarActivos"
                               TextoNuevo="Nuevo cliente"
                               OnNuevo="@(_puedeCrear ? EventCallback.Factory.Create(this, () => Navegacion.NavigateTo("/clientes/nuevo")) : default)"
                               OnExportar="Exportar" />

    <div class="catalogo-tabla">
        <TablaDatos T="ClienteEnListaDto"
                    @ref="_tabla"
                    Columnas="_columnas"
                    CargarPagina="CargarAsync"
                    TextoEntidad="clientes"
                    TextoSinDatos="No hay clientes que coincidan." />
    </div>
</section>

@code {
    private TablaDatos<ClienteEnListaDto>? _tabla;
    private DetalleProblema? _error;
    private string _texto = string.Empty;
    private bool? _activos;

    // Comodidad visual: lo que el servidor rechazaría ni se ofrece. La protección real es la
    // política de cada endpoint.
    private bool _puedeCrear, _puedeModificar, _puedeDesactivar, _puedeEliminar;

    private IReadOnlyList<ColumnaDeTabla<ClienteEnListaDto>> _columnas = [];

    protected override void OnInitialized()
    {
        _puedeCrear = Sesion.TienePermiso(Permisos.ClientesCrear);
        _puedeModificar = Sesion.TienePermiso(Permisos.ClientesModificar);
        _puedeDesactivar = Sesion.TienePermiso(Permisos.ClientesDesactivar);
        _puedeEliminar = Sesion.TienePermiso(Permisos.ClientesEliminar);
        _columnas = _puedeModificar || _puedeDesactivar || _puedeEliminar ? [.. Columnas, Acciones] : Columnas;
    }

    private IReadOnlyList<ColumnaDeTabla<ClienteEnListaDto>> Columnas =>
    [
        new("Clave", c => @<span class="cifra-tabular">@c.ClaveInterna</span>, ClaveOrden: "clave", Tabular: true),
        new("Cliente", c => @<div class="catalogo-celda-principal">
                                 <strong>@c.Nombre</strong>
                                 <span class="cifra-tabular">@c.Rfc</span>
                             </div>, ClaveOrden: "nombre"),
        new("Datos fiscales", c => @<div class="catalogo-celda-secundaria">
                                       <span>Régimen <span class="cifra-tabular">@c.RegimenFiscal</span></span>
                                       <span>C.P. <span class="cifra-tabular">@c.DomicilioFiscalCp</span></span>
                                   </div>),
        new("Correo", c => @<span class="catalogo-correo">@(c.CorreoPrincipal ?? "—")</span>),
        new("Estado", c => @<span class="indicador-estado indicador-estado-@(c.Activo ? "timbrada" : "borrador")">
                                @(c.Activo ? "Activo" : "Inactivo")
                            </span>),
    ];

    private ColumnaDeTabla<ClienteEnListaDto> Acciones => new("", c => @<div class="acciones-renglon">
                          @if (_puedeModificar)
                          {
                              <MudButton Size="Size.Small" OnClick="@(() => Navegacion.NavigateTo($"/clientes/{c.Id}"))">Editar</MudButton>
                          }
                          @if (_puedeDesactivar)
                          {
                              <MudButton Size="Size.Small" OnClick="@(() => CambiarActivo(c))">
                                  @(c.Activo ? "Desactivar" : "Reactivar")
                              </MudButton>
                          }
                          @if (_puedeEliminar)
                          {
                              <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => Eliminar(c))">Eliminar</MudButton>
                          }
                      </div>);

    private async Task<ResultadoDePagina<ClienteEnListaDto>> CargarAsync(PeticionDePagina peticion, CancellationToken ct)
    {
        var pagina = await Clientes.ListarAsync(
            _texto, _activos, peticion.Pagina, peticion.TamanoPagina,
            peticion.ClaveOrden, peticion.Descendente, ct);

        return new ResultadoDePagina<ClienteEnListaDto>(pagina.Elementos, pagina.Total);
    }

    private async Task AlBuscar(string texto)
    {
        _texto = texto;
        await RecargarAsync();
    }

    private async Task AlFiltrarActivos(bool? activos)
    {
        _activos = activos;
        await RecargarAsync();
    }

    private Task RecargarAsync() => _tabla?.RecargarAsync() ?? Task.CompletedTask;

    /// <summary>
    /// Dar de baja es reversible —solo apaga <c>Activo</c>— pero igual se confirma: en una
    /// rejilla densa el botón de al lado es «Editar», y desactivar al cliente equivocado en
    /// medio de una jornada de captura es una interrupción real.
    /// </summary>
    private async Task CambiarActivo(ClienteEnListaDto cliente)
    {
        if (cliente.Activo)
        {
            var confirmado = await Confirmacion.ConfirmarAsync(
                "Desactivar cliente",
                $"«{cliente.Nombre}» dejará de aparecer al facturar. Sus comprobantes ya emitidos no se tocan.",
                "Desactivar");

            if (!confirmado) return;
        }

        var (_, error) = await Clientes.CambiarActivoAsync(cliente.Id, !cliente.Activo);

        _error = error;

        if (error is null) await RecargarAsync();
    }

    /// <summary>Solo prospera si ningún comprobante usó al cliente; si no, el servidor pide desactivarlo.</summary>
    private async Task Eliminar(ClienteEnListaDto cliente)
    {
        var confirmado = await Confirmacion.ConfirmarAsync(
            "Eliminar cliente",
            $"«{cliente.Nombre}» se borrará de forma definitiva. Solo es posible si ningún comprobante lo usa.",
            "Eliminar");

        if (!confirmado) return;

        _error = await Clientes.EliminarAsync(cliente.Id);

        if (_error is null) await RecargarAsync();
    }

    private void Exportar()
        => Navegacion.NavigateTo(ServicioDeClientes.RutaDeExportacion(_activos), forceLoad: true);
}
