@page "/clientes/nuevo"
@page "/clientes/{Id:guid}"
@attribute [Authorize(Policy = Permisos.Politicas.EditarClientes)]
@using Facturacion.Client.Componentes.Catalogos
@inject NavigationManager Navegacion

<PageTitle>@(EsNuevo ? "Nuevo cliente" : "Editar cliente")</PageTitle>
<TituloDePagina Texto="@(EsNuevo ? "Nuevo cliente" : $"Cliente {_claveInterna}")" />

<TarjetaFormulario RutaVolver="/clientes" Class="tarjeta-formulario-catalogo">
    <EditorDeCliente Id="Id"
                     IdDelFormulario="formulario-cliente"
                     AlGuardar="@(() => Navegacion.NavigateTo("/clientes"))"
                     OcupadoCambiado="o => _ocupado = o"
                     ClaveCargada="c => _claveInterna = c" />

    <div class="tarjeta-formulario-acciones">
        <span class="catalogo-acciones-ayuda">Los datos fiscales se validan al guardar.</span>
        <MudButton Variant="Variant.Text" OnClick="@(() => Navegacion.NavigateTo("/clientes"))">Cancelar</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="formulario-cliente"
                   Variant="Variant.Filled" Color="Color.Primary" Disabled="_ocupado">
            Guardar cliente
        </MudButton>
    </div>
</TarjetaFormulario>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool EsNuevo => Id is null;
    private bool _ocupado = true;
    private int _claveInterna;
}
