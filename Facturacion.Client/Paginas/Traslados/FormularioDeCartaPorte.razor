@page "/traslados-carta-porte/nuevo"
@page "/traslados-carta-porte/{Id:guid}"
@attribute [Authorize(Policy = Permisos.Politicas.EditarCartaPorte)]
@using Facturacion.Client.Servicios.Documentos
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Contratos
@using Facturacion.Shared.Documentos
@using Facturacion.Shared.Plataforma
@using Facturacion.Shared.Transporte
@using System.Text.RegularExpressions
@inject ServicioDeTrasladosCartaPorte Traslados
@inject ServicioDeEmision Emision
@inject ServicioDeTransporte Transporte
@inject ServicioDeClientes Clientes
@inject ServicioDeProductos Productos
@inject ServicioDeEmpresa Empresa
@inject ServicioDeCatalogos Catalogos
@inject NavigationManager Navegacion
@inject IDialogService Dialogos
@inject ServicioDeDescargas Descargas
@inject IServicioDeConfirmacion Confirmacion

<PageTitle>@(EsNuevo ? "Nueva Carta Porte" : "Carta Porte")</PageTitle>
<TituloDePagina Texto="@(EsNuevo ? "Nueva Carta Porte" : "Carta Porte")" />

<TarjetaFormulario Ancha="true" RutaVolver="/documentos" Class="carta-porte-formulario">
    <PanelErrores Problema="_error" />

    @if (_cargando)
    {
        <p class="tabla-datos-estado">Cargando…</p>
    }
    else
    {
        <p class="seccion-ayuda">Traslado de mercancía propia con importe cero. Valida el XML antes de timbrar.</p>

        @if (!string.IsNullOrWhiteSpace(_mensajeXml))
        {
            <div class="aviso-documentos" role="status">@_mensajeXml</div>
        }

        @if (!EsEditable)
        {
            <div class="aviso-documentos" role="status">
                Esta Carta Porte está en estado <strong>@_estatus</strong>. Consulta sus archivos fiscales desde Documentos.
            </div>
        }

        @if (_vehiculos.Count == 0 || _figuras.Count == 0)
        {
            <div class="aviso-documentos" role="alert">
                Antes de guardar registra al menos un vehículo y un operador activos en Transporte.
                <MudButton Variant="Variant.Text" OnClick="@(() => Navegacion.NavigateTo("/empresa/transporte"))">Ir a transporte</MudButton>
            </div>
        }

        <MudTabs Elevation="0" ApplyEffectsToContainer="true">
            <MudTabPanel Text="Autotransporte">
                <section class="seccion-formulario">
                    <h2>Datos del traslado</h2>
                    <div class="rejilla-formulario">
                        <MudSelect T="Guid?" Label="Vehículo" Value="_vehiculoId" ValueChanged="v => _vehiculoId = v" Disabled="@(!EsEditable)" Required="true">
                            @foreach (var vehiculo in _vehiculos)
                            {
                                <MudSelectItem T="Guid?" Value="@vehiculo.Id">@vehiculo.Clave — @vehiculo.Descripcion · @vehiculo.Placa</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="Guid?" Label="Operador" Value="_figuraId" ValueChanged="v => _figuraId = v" Disabled="@(!EsEditable)" Required="true">
                            @foreach (var figura in _figuras)
                            {
                                <MudSelectItem T="Guid?" Value="@figura.Id">@figura.Nombre · @figura.Rfc</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="decimal" Label="Distancia recorrida (km)" @bind-Value="_distanciaKm" Immediate="true" Min="0.01m" Max="99999m" Format="N2" Disabled="@(!EsEditable)" Required="true" />
                    </div>

                    @* Solo consulta: se editan en Transporte. *@
                    @if (VehiculoElegido is { } vehiculo)
                    {
                        <h3>Vehículo</h3>
                        <div class="rejilla-formulario">
                            <MudTextField T="string" Label="Placa" Value="@vehiculo.Placa" ReadOnly="true" Class="cifra-tabular" />
                            <MudTextField T="string" Label="Año modelo" Value="@vehiculo.AnioModelo.ToString()" ReadOnly="true" Class="cifra-tabular" />
                            <MudTextField T="string" Label="Configuración SAT" Value="@vehiculo.ConfiguracionAutotransporte" ReadOnly="true" Class="cifra-tabular" />
                            <MudTextField T="string" Label="Peso bruto vehicular (t)" Value="@vehiculo.PesoBrutoVehicular.ToString("N2")" ReadOnly="true" Class="cifra-tabular" />
                            <MudTextField T="string" Label="Tipo de permiso SAT" Value="@vehiculo.TipoPermiso" ReadOnly="true" Class="cifra-tabular" />
                            <MudTextField T="string" Label="Número de permiso" Value="@vehiculo.NumeroPermiso" ReadOnly="true" />
                            <MudTextField T="string" Label="Aseguradora" Value="@vehiculo.Aseguradora" ReadOnly="true" />
                            <MudTextField T="string" Label="Póliza" Value="@vehiculo.Poliza" ReadOnly="true" />
                        </div>
                    }
                    @if (FiguraElegida is { } figura)
                    {
                        <h3>Operador</h3>
                        <div class="rejilla-formulario">
                            <MudTextField T="string" Label="Tipo de figura SAT" Value="@figura.TipoFigura" ReadOnly="true" Class="cifra-tabular" />
                            <MudTextField T="string" Label="RFC" Value="@figura.Rfc" ReadOnly="true" Class="cifra-tabular" />
                            <MudTextField T="string" Label="Número de licencia" Value="@(figura.NumeroLicencia ?? "—")" ReadOnly="true" Class="cifra-tabular" />
                            <MudTextField T="string" Label="Domicilio" Value="@DomicilioDeFigura(figura)" ReadOnly="true" />
                        </div>
                    }
                </section>

                <section class="seccion-formulario">
                    <h2>Salida y llegada</h2>
                    <div class="carta-porte-fechas">
                    <div class="carta-porte-fecha-grupo">
                        <h3>Salida</h3>
                        <div class="rejilla-formulario carta-porte-rejilla-dos">
                        <MudDatePicker Label="Fecha de salida" Date="_fechaSalida" DateChanged="v => _fechaSalida = v ?? DateTime.Today" Disabled="@(!EsEditable)" Required="true" />
                        <MudTimePicker Label="Hora de salida" Time="_horaSalida" TimeChanged="v => _horaSalida = v ?? TimeSpan.Zero" Disabled="@(!EsEditable)" Required="true" />
                        </div>
                    </div>
                    <div class="carta-porte-fecha-grupo">
                        <h3>Llegada</h3>
                        <div class="rejilla-formulario carta-porte-rejilla-dos">
                        <MudDatePicker Label="Fecha de llegada" Date="_fechaLlegada" DateChanged="v => _fechaLlegada = v ?? DateTime.Today" Disabled="@(!EsEditable)" Required="true" />
                        <MudTimePicker Label="Hora de llegada" Time="_horaLlegada" TimeChanged="v => _horaLlegada = v ?? TimeSpan.Zero" Disabled="@(!EsEditable)" Required="true" />
                        </div>
                    </div>
                    </div>
                </section>
                <section class="seccion-formulario">
                    <h2>Notas del traslado</h2>
                    <MudTextField T="string" @bind-Value="_observaciones" Label="Observaciones internas" Lines="3" Immediate="true"
                                  MaxLength="2000" Disabled="@(!EsEditable)" HelperText="Se muestran en el PDF, pero no forman parte del XML fiscal." />
                </section>
            </MudTabPanel>

            <MudTabPanel Text="Trayecto">
                <section class="seccion-formulario">
                    <h2>Origen</h2>
                    <p class="seccion-ayuda">Lugar donde inicia el traslado.</p>
                    @if (!string.IsNullOrWhiteSpace(_avisoOrigen))
                    {
                        <p class="seccion-ayuda" role="status">@_avisoOrigen</p>
                    }
                    <EditorDomicilioCartaPorte Valor="@ADomicilio(_origen)" ValorCambiado="ActualizarOrigen" Deshabilitado="@(!EsEditable)" />
                </section>
                <section class="seccion-formulario">
                    <h2>Destino</h2>
                    <p class="seccion-ayuda">El cliente elegido define el destino. Sin cliente, se usa la empresa emisora.</p>
                    <BuscadorDeCliente Etiqueta="Cliente destinatario (opcional)" Valor="_clienteDestino"
                                      ValorCambiado="SeleccionarClienteDestinoAsync" Deshabilitado="@(!EsEditable)" />
                    @if (_destino.NombreRemitenteDestinatario is not null)
                    {
                        <p class="seccion-ayuda">Destinatario guardado: @_destino.NombreRemitenteDestinatario · RFC @_destino.RfcRemitenteDestinatario</p>
                    }
                    <EditorDomicilioCartaPorte Valor="@ADomicilio(_destino)" ValorCambiado="ActualizarDestino" Deshabilitado="@(!EsEditable)" />
                </section>
            </MudTabPanel>

            <MudTabPanel Text="Productos">
                <section class="seccion-formulario">
                    <h2>Productos transportados</h2>
                    <p class="seccion-ayuda">Describe lo que se transporta con claves del catálogo de Carta Porte.</p>
                    @if (EsEditable)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarMercancia">Agregar producto</MudButton>
                    }

                    @foreach (var renglon in _mercancias)
                    {
                        <article class="carta-porte-mercancia" @key="renglon">
                            <div class="carta-porte-mercancia-cabecera">
                                <h3>Producto @(_mercancias.IndexOf(renglon) + 1)</h3>
                                @if (EsEditable && _mercancias.Count > 1)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => _mercancias.Remove(renglon))">Quitar producto</MudButton>
                                }
                            </div>
                            @* Del catálogo solo se toman ID interno y nombre para mostrarlos, y la
                               descripción y el peso si están vacíos. Las claves del SAT se eligen aparte. *@
                            <div class="rejilla-formulario">
                                @if (EsEditable)
                                {
                                    <BuscadorDeProducto Valor="null" ValorCambiado="p => ElegirProductoAsync(renglon, p)" />
                                }
                                <MudTextField T="string" Label="ID interno" Value="@(renglon.ProductoIdInterno ?? "—")" ReadOnly="true" Class="cifra-tabular" />
                                <MudTextField T="string" Label="Nombre del producto" Value="@(renglon.ProductoNombre ?? "—")" ReadOnly="true" />
                            </div>
                            @if (EsEditable && renglon.ProductoId is not null)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => DesvincularProducto(renglon))">
                                    Desvincular del catálogo
                                </MudButton>
                            }
                            <div class="rejilla-formulario carta-porte-rejilla-dos">
                                <BuscadorCatalogo Catalogo="c_ClaveProdServCP" Label="Bien transportado SAT" Valor="@renglon.Producto"
                                                  ValorCambiado="v => renglon.Producto = v" Deshabilitado="@(!EsEditable)" Requerido="true" />
                                <MudTextField T="string" Label="Descripción" @bind-Value="renglon.Descripcion" Immediate="true" Disabled="@(!EsEditable)" Required="true" />
                            </div>
                            <div class="rejilla-formulario">
                                <MudNumericField T="decimal" Label="Cantidad" Value="renglon.Cantidad" ValueChanged="valor => CambiarCantidad(renglon, valor)" Immediate="true" Min="0.000001m" Format="N6" Disabled="@(!EsEditable)" Required="true" />
                                <BuscadorCatalogo Catalogo="c_ClaveUnidad" Label="Unidad SAT" Valor="@renglon.Unidad"
                                                  ValorCambiado="v => renglon.Unidad = v" Deshabilitado="@(!EsEditable)" Requerido="true" />
                                <MudTextField T="string" Label="Unidad propia (opcional)" @bind-Value="renglon.UnidadPropia" Immediate="true" Disabled="@(!EsEditable)" MaxLength="20" />
                            </div>
                            @* El SAT pide «largo/alto/ancho» más la unidad, en enteros de hasta tres cifras:
                               30/40/30cm. Se captura por partes y se arma al guardar. *@
                            <div class="rejilla-formulario carta-porte-dimensiones" role="group" aria-label="Dimensiones del empaque, opcionales">
                                <MudNumericField T="int?" Label="Largo" @bind-Value="renglon.Largo" Immediate="true" Min="1" Max="999" Disabled="@(!EsEditable)"
                                                 Error="@renglon.DimensionesIncompletas" ErrorText="Captura largo, alto y ancho, o ninguno." />
                                <MudNumericField T="int?" Label="Alto" @bind-Value="renglon.Alto" Immediate="true" Min="1" Max="999" Disabled="@(!EsEditable)"
                                                 Error="@renglon.DimensionesIncompletas" />
                                <MudNumericField T="int?" Label="Ancho" @bind-Value="renglon.Ancho" Immediate="true" Min="1" Max="999" Disabled="@(!EsEditable)"
                                                 Error="@renglon.DimensionesIncompletas" />
                                <MudSelect T="string" Label="Unidad de las dimensiones" @bind-Value="renglon.UnidadDeDimension" Disabled="@(!EsEditable)">
                                    <MudSelectItem T="string" Value="@("cm")">Centímetros (cm)</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("plg")">Pulgadas (plg)</MudSelectItem>
                                </MudSelect>
                            </div>
                            <div class="rejilla-formulario">
                                <MudNumericField T="decimal?" Label="Peso unitario (kg, opcional)" Value="renglon.PesoUnitarioKg" ValueChanged="valor => CambiarPesoUnitario(renglon, valor)" Immediate="true" Min="0.000001m" Format="N6" Disabled="@(!EsEditable)" />
                                <MudNumericField T="decimal" Label="Peso total (kg)" Value="renglon.PesoEnKg" ValueChanged="valor => CambiarPesoTotal(renglon, valor)" Immediate="true" Min="0.001m" Format="N3" Disabled="@(!EsEditable)" Required="true" />
                            </div>
                        </article>
                    }
                    <dl class="carta-porte-resumen">
                        <div><dt>Peso bruto total</dt><dd class="cifra-tabular">@(_mercancias.Sum(x => x.PesoEnKg).ToString("N3")) kg</dd></div>
                        <div><dt>Productos</dt><dd class="cifra-tabular">@_mercancias.Count</dd></div>
                        <div><dt>Cantidad por unidad</dt><dd class="cifra-tabular">@CantidadPorUnidad</dd></div>
                    </dl>
                </section>
            </MudTabPanel>

            <MudTabPanel Text="CFDI relacionados">
                <section class="seccion-formulario">
                    <h2>Comprobantes relacionados</h2>
                    <p class="seccion-ayuda">Opcional. Busca un CFDI timbrado de esta empresa; su UUID se incluirá en el XML.</p>
                    @if (EsEditable)
                    {
                        <div class="rejilla-formulario">
<BuscadorCatalogo Catalogo="c_TipoRelacion" Opciones="@Catalogos.Obtener("c_TipoRelacion")" @bind-Clave="_tipoRelacion" Label="Tipo de relación" PuedeLimpiar="true" />
<BuscadorCatalogo Catalogo="serie" Opciones="@_seriesRelacionables" @bind-Clave="_serieRelacionado" Label="Serie" PuedeLimpiar="true" MuestraSelectorEnLista="false" />
                            <MudNumericField T="int?" @bind-Value="_folioRelacionado" Label="Folio" Immediate="true" Min="1" />
                        </div>
                        <MudButton Variant="Variant.Outlined" OnClick="AgregarRelacionadoAsync" Disabled="@(!PuedeAgregarRelacionado)">Agregar CFDI</MudButton>
                    }
                    @if (_relacionados.Count > 0)
                    {
                        <MudSimpleTable Dense="true" Class="tabla-impuestos">
                            <thead><tr><th>Tipo de relación</th><th>UUID</th><th></th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < _relacionados.Count; i++)
                                {
                                    var indice = i;
                                    var relacionado = _relacionados[indice];
                                    <tr>
                                        <td>@relacionado.TipoRelacion</td>
                                        <td class="cifra-tabular">@relacionado.UuidRelacionado</td>
                                        <td>
                                            @if (EsEditable)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Quitar CFDI relacionado"
                                                               OnClick="@(() => _relacionados.RemoveAt(indice))" />
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </section>
            </MudTabPanel>
        </MudTabs>

        <div class="tarjeta-formulario-acciones">
            <MudButton OnClick="@(() => Navegacion.NavigateTo("/documentos"))">Volver</MudButton>
            @if (EsEditable)
            {
                @if (!EsNuevo)
                {
                    <MudButton Variant="Variant.Outlined" Disabled="@(_validandoXml || _guardando)" OnClick="VistaPreviaAsync">Vista previa PDF</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="@(_validandoXml || _guardando)" OnClick="DescargarXmlAsync">Descargar XML</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="@(_validandoXml || _guardando)" OnClick="ValidarXmlAsync">
                        @(_validandoXml ? "Validando XML…" : "Validar XML guardado")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_validandoXml || _guardando || _timbrando || !PuedeTimbrar)" OnClick="TimbrarAsync">
                        @(_timbrando ? "Timbrando…" : "Timbrar Carta Porte")
                    </MudButton>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_guardando" OnClick="GuardarAsync">
                    @(_guardando ? "Guardando…" : "Guardar borrador")
                </MudButton>
            }
        </div>
    }
</TarjetaFormulario>

<ActualizadorDeCatalogos AlCambiar="@(() => { })" />

@code {
    [Parameter] public Guid? Id { get; set; }

    private readonly List<RenglonMercancia> _mercancias = [new()];
    private List<VehiculoDto> _vehiculos = [];
    private List<FiguraTransporteDto> _figuras = [];
    private DetalleProblema? _error;
    private bool _cargando = true, _guardando, _validandoXml, _timbrando;
    private string? _mensajeXml;
    private string _estatus = "borrador";
    private EstadoDeIntegracionFiscalDto? _integracionFiscal;
    private Guid? _vehiculoId, _figuraId;
    private Guid? _clienteDestinoId;
    private ClienteEnListaDto? _clienteDestino;
    private decimal _distanciaKm;
    private DateTime _fechaSalida = DateTime.Today, _fechaLlegada = DateTime.Today;
    private TimeSpan? _horaSalida = TimeSpan.FromHours(9), _horaLlegada = TimeSpan.FromHours(10);
    private UbicacionCartaPorteDto _origen = Vacio("Origen", 1);
    private UbicacionCartaPorteDto _destino = Vacio("Destino", 2);
    private readonly List<ComprobanteRelacionadoDto> _relacionados = [];
    private string? _tipoRelacion;
    private string? _serieRelacionado;
    private IReadOnlyList<ClaveSatDto> _seriesRelacionables = [];
    private int? _folioRelacionado;
    private string? _observaciones;
    private bool _precargaOrigenIntentada;
    private string? _avisoOrigen;

    private bool EsNuevo => Id is null;
    private bool EsEditable => _estatus is "borrador" or "error";
    private bool PuedeTimbrar => _integracionFiscal?.TimbradoDisponible == true;
    private bool PuedeAgregarRelacionado => EsEditable && !string.IsNullOrWhiteSpace(_tipoRelacion) &&
        !string.IsNullOrWhiteSpace(_serieRelacionado) && _folioRelacionado is > 0;
    private string CantidadPorUnidad => !_mercancias.Any(x => x.Unidad is not null) ? "—" : string.Join(" · ", _mercancias
        .Where(x => x.Unidad is not null)
        .GroupBy(x => x.Unidad!.Clave)
        .OrderBy(x => x.Key)
        .Select(x => $"{x.Sum(y => y.Cantidad):0.######} {x.Key}"));

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _error = null;
        _mensajeXml = null;
        _integracionFiscal = await Emision.ObtenerEstadoDeIntegracionAsync();
        var empresa = await Empresa.ObtenerAsync();
        if (Id is null && !_precargaOrigenIntentada)
        {
            _precargaOrigenIntentada = true;
            if (empresa is not null) PrecargarOrigen(empresa);
        }
        _vehiculos = await Transporte.VehiculosAsync(true) ?? [];
        _figuras = (await Transporte.FigurasAsync(true) ?? []).Where(x => x.TipoFigura == "01").ToList();
        _seriesRelacionables = await Emision.ListarSeriesRelacionablesAsync();

        if (Id is { } id)
        {
            var traslado = await Traslados.ObtenerAsync(id);
            if (traslado is null)
            {
                _error = ProblemaLocal("No se encontró el traslado Carta Porte.");
            }
            else
            {
                await RehidratarAsync(traslado);
            }
        }

        _cargando = false;
    }

    private async Task RehidratarAsync(TrasladoCartaPorteDto traslado)
    {
        _estatus = traslado.Estatus;
        _vehiculoId = traslado.VehiculoId;
        _figuraId = traslado.FiguraTransporteId;
        _distanciaKm = traslado.DistanciaRecorridaKm;
        var salida = traslado.FechaSalidaLocal;
        var llegada = traslado.FechaLlegadaLocal;
        _fechaSalida = salida.Date; _horaSalida = salida.TimeOfDay;
        _fechaLlegada = llegada.Date; _horaLlegada = llegada.TimeOfDay;
        _origen = traslado.Ubicaciones.SingleOrDefault(x => x.Tipo == "Origen") ?? Vacio("Origen", 1);
        _destino = traslado.Ubicaciones.SingleOrDefault(x => x.Tipo == "Destino") ?? Vacio("Destino", 2);
        _clienteDestinoId = traslado.ClienteDestinoId;
        _observaciones = traslado.Observaciones;
        _relacionados.Clear();
        _relacionados.AddRange(traslado.Relacionados ?? []);
        if (_clienteDestino?.Id != _clienteDestinoId)
        {
            _clienteDestino = null;
            if (_clienteDestinoId is { } clienteId && await Clientes.ObtenerAsync(clienteId) is { } cliente)
                _clienteDestino = new ClienteEnListaDto(cliente.Id, cliente.ClaveInterna, cliente.Rfc,
                    cliente.Nombre, cliente.RegimenFiscal, cliente.DomicilioFiscalCp, cliente.CorreoPrincipal, cliente.Activo);
        }
        _mercancias.Clear();
        _mercancias.AddRange(traslado.Mercancias.OrderBy(x => x.Orden).Select(x => new RenglonMercancia
        {
            Producto = new ClaveSatDto("c_ClaveProdServCP", x.ClaveProdServ, x.ClaveProdServ, true),
            Descripcion = x.Descripcion,
            Cantidad = x.Cantidad,
            Unidad = new ClaveSatDto("c_ClaveUnidad", x.ClaveUnidad, x.ClaveUnidad, true),
            PesoEnKg = x.PesoEnKg,
            PesoUnitarioKg = x.PesoUnitarioKg,
            UnidadPropia = x.Unidad ?? string.Empty,
            Dimensiones = x.Dimensiones ?? string.Empty,
            ProductoId = x.ProductoId,
            ProductoIdInterno = x.ProductoIdInterno,
            ProductoNombre = x.ProductoNombre
        }));
        if (_mercancias.Count == 0) _mercancias.Add(new());
    }

    private void AgregarMercancia() => _mercancias.Add(new RenglonMercancia());

    private async Task ElegirProductoAsync(RenglonMercancia renglon, ProductoEnListaDto? seleccion)
    {
        if (seleccion is null) return;
        var producto = await Productos.ObtenerAsync(seleccion.Id);
        if (producto is null) return;

        renglon.ProductoId = producto.Id;
        renglon.ProductoIdInterno = producto.IdInterno;
        renglon.ProductoNombre = producto.Descripcion;
        if (string.IsNullOrWhiteSpace(renglon.Descripcion)) renglon.Descripcion = producto.Descripcion;
        if (renglon.PesoUnitarioKg is null && producto.PesoKg is { } peso) CambiarPesoUnitario(renglon, peso);
    }

    private static void DesvincularProducto(RenglonMercancia renglon)
    {
        renglon.ProductoId = null;
        renglon.ProductoIdInterno = null;
        renglon.ProductoNombre = null;
    }

    private void ActualizarOrigen(DomicilioSatDto domicilio)
    {
        _origen = ConDomicilio(_origen, domicilio);
        _avisoOrigen = null;
    }

    private void ActualizarDestino(DomicilioSatDto domicilio)
        => _destino = ConDomicilio(_destino, domicilio);

    private static DomicilioSatDto ADomicilio(UbicacionCartaPorteDto ubicacion)
        => new(ubicacion.Calle, ubicacion.NumeroExterior, ubicacion.NumeroInterior,
            ubicacion.Estado, ubicacion.Municipio, ubicacion.CodigoPostal);

    private static UbicacionCartaPorteDto ConDomicilio(UbicacionCartaPorteDto ubicacion, DomicilioSatDto domicilio)
        => ubicacion with
        {
            Calle = domicilio.Calle,
            NumeroExterior = domicilio.NumeroExterior ?? string.Empty,
            NumeroInterior = domicilio.NumeroInterior,
            Estado = domicilio.Estado,
            Municipio = domicilio.Municipio,
            CodigoPostal = domicilio.CodigoPostal
        };

    private void PrecargarOrigen(EmpresaDto empresa)
    {
        if (empresa.OrigenCartaPorte is not { } domicilio) return;

        _origen = Vacio("Origen", 1) with
        {
            RfcRemitenteDestinatario = empresa.Rfc,
            NombreRemitenteDestinatario = empresa.NombreFiscal,
            Calle = domicilio.Calle,
            NumeroExterior = domicilio.NumeroExterior ?? string.Empty,
            NumeroInterior = domicilio.NumeroInterior,
            Estado = domicilio.Estado,
            Municipio = domicilio.Municipio,
            CodigoPostal = domicilio.CodigoPostal
        };
        _avisoOrigen = "Origen precargado desde la configuración de Carta Porte de la empresa. Confirma que corresponde al lugar real de salida.";
    }

    private async Task AgregarRelacionadoAsync()
    {
        if (!PuedeAgregarRelacionado) return;

        var (resuelto, error) = await Emision.ResolverRelacionadoAsync(_serieRelacionado!, _folioRelacionado!.Value);
        if (error is not null)
        {
            _error = error;
            return;
        }

        if (_relacionados.Any(x => x.UuidRelacionado == resuelto!.Uuid))
        {
            _error = ProblemaLocal("Ese CFDI ya está relacionado con el traslado.");
            return;
        }

        _relacionados.Add(new ComprobanteRelacionadoDto(null, _tipoRelacion!, resuelto!.Uuid, resuelto.Serie, resuelto.Folio));
        _tipoRelacion = null;
        _serieRelacionado = null;
        _folioRelacionado = null;
        _error = null;
    }

    private async Task SeleccionarClienteDestinoAsync(ClienteEnListaDto? seleccionado)
    {
        _error = null;
        if (seleccionado?.Rfc == "XEXX010101000")
        {
            _error = ProblemaLocal("Este traslado nacional requiere un destinatario con RFC mexicano.");
            return;
        }

        if (_clienteDestinoId != seleccionado?.Id)
        {
            _destino = Vacio("Destino", 2) with
            {
                RfcRemitenteDestinatario = seleccionado?.Rfc ?? _origen.RfcRemitenteDestinatario,
                NombreRemitenteDestinatario = seleccionado?.Nombre ?? _origen.NombreRemitenteDestinatario
            };
        }
        _clienteDestino = seleccionado;
        _clienteDestinoId = seleccionado?.Id;
        if (seleccionado is null) return;

        // Se precarga lo que el cliente tenga capturado y el resto se completa aquí. Un domicilio
        // anterior al cambio a claves del SAT trae el estado escrito a mano: ese no se precarga.
        var cliente = await Clientes.ObtenerAsync(seleccionado.Id);
        if (cliente is null || cliente.Pais is not (null or "MEX")) return;

        var estadoValido = cliente.Estado is { Length: 3 } estado && estado.All(char.IsAsciiLetterUpper);
        _destino = _destino with
        {
            Calle = cliente.Calle ?? string.Empty,
            NumeroExterior = cliente.NumeroExterior ?? string.Empty,
            NumeroInterior = cliente.NumeroInterior,
            Estado = estadoValido ? cliente.Estado! : string.Empty,
            Municipio = estadoValido ? cliente.Municipio ?? string.Empty : string.Empty,
            CodigoPostal = cliente.CodigoPostal is { Length: 5 } cp && cp.All(char.IsAsciiDigit) ? cp : string.Empty
        };
    }

    private async Task GuardarAsync()
    {
        if (_vehiculoId is null || _figuraId is null)
        {
            _error = ProblemaLocal("Elige un vehículo y un operador activos.");
            return;
        }

        _guardando = true;
        _error = null;
        try
        {
            var peticion = new PeticionGuardarTrasladoCartaPorte(
                _vehiculoId.Value, _figuraId.Value, Combinar(_fechaSalida, _horaSalida), Combinar(_fechaLlegada, _horaLlegada),
                _distanciaKm, [_origen, _destino],
                [.. _mercancias.Select((x, indice) => new MercanciaCartaPorteDto(indice + 1, x.Producto?.Clave ?? string.Empty,
                    x.Descripcion, x.Cantidad, x.Unidad?.Clave ?? string.Empty, x.PesoEnKg, x.UnidadPropia, x.Dimensiones,
                    x.PesoUnitarioKg, x.ProductoId))], _clienteDestinoId, _relacionados, _observaciones);

            var resultado = EsNuevo
                ? await Traslados.CrearAsync(peticion)
                : await Traslados.ActualizarAsync(Id!.Value, peticion);
            _error = resultado.Error;
            if (resultado.Exito is not { } guardado) return;

            await RehidratarAsync(guardado);
            if (EsNuevo) Navegacion.NavigateTo($"/traslados-carta-porte/{guardado.ComprobanteId}", replace: true);
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task ValidarXmlAsync()
    {
        if (Id is not { } id || _validandoXml) return;

        _validandoXml = true;
        _error = null;
        _mensajeXml = null;
        try
        {
            var resultado = await Traslados.ValidarXmlAsync(id);
            _error = resultado.Error;
            _mensajeXml = resultado.Exito?.Mensaje;
        }
        finally
        {
            _validandoXml = false;
        }
    }

    private async Task VistaPreviaAsync()
    {
        if (Id is not { } id || _guardando) return;
        await GuardarAsync();
        if (_error is not null) return;
        var (archivo, error) = await Traslados.ObtenerVistaPreviaPdfAsync(id);
        _error = error;
        if (archivo is null) return;
        await Dialogos.ShowAsync<DialogoDeComprobanteDeCompra>("Vista previa de Carta Porte",
            new DialogParameters<DialogoDeComprobanteDeCompra>
            {
                { x => x.Archivo, archivo },
                { x => x.TituloVistaPrevia, "Vista previa de Carta Porte" },
                { x => x.AvisoFiscal, "Borrador sin validez fiscal. No contiene UUID, folio, timbre ni certificación del SAT." }
            }, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task DescargarXmlAsync()
    {
        if (Id is not { } id || _guardando) return;
        await GuardarAsync();
        if (_error is not null) return;
        var (archivo, error) = await Traslados.ObtenerXmlBorradorAsync(id);
        _error = error;
        if (archivo is not null) await Descargas.GuardarAsync(archivo);
    }

    private async Task TimbrarAsync()
    {
        if (Id is not { } id || !PuedeTimbrar || _timbrando) return;
        await GuardarAsync();
        if (_error is not null) return;

        var confirmado = await Confirmacion.ConfirmarAsync(
            "Timbrar Carta Porte",
            "Se consumirá un timbre para emitir el CFDI de traslado. Después ya no podrás editarlo.",
            "Timbrar Carta Porte");
        if (!confirmado) return;

        _timbrando = true;
        _error = null;
        try
        {
            var (resultado, error) = await Emision.TimbrarAsync(id, Guid.NewGuid().ToString("N"));
            _error = error;
            if (resultado is null) return;

            _estatus = resultado.Estatus;
            _mensajeXml = "La Carta Porte se timbró correctamente. Sus archivos fiscales están disponibles en Documentos.";
        }
        finally
        {
            _timbrando = false;
        }
    }

    private static DateTime Combinar(DateTime fecha, TimeSpan? hora) => fecha.Date.Add(hora ?? TimeSpan.Zero);
    private static void CambiarCantidad(RenglonMercancia renglon, decimal cantidad)
    {
        renglon.Cantidad = cantidad;
        RecalcularPeso(renglon);
    }
    private static void CambiarPesoUnitario(RenglonMercancia renglon, decimal? pesoUnitario)
    {
        renglon.PesoUnitarioKg = pesoUnitario;
        RecalcularPeso(renglon);
    }
    private static void CambiarPesoTotal(RenglonMercancia renglon, decimal pesoTotal)
    {
        renglon.PesoEnKg = pesoTotal;
        renglon.PesoUnitarioKg = null;
    }
    private static void RecalcularPeso(RenglonMercancia renglon)
    {
        if (renglon.PesoUnitarioKg is not { } unitario || renglon.Cantidad < 0 || unitario < 0 ||
            renglon.Cantidad > 999999999999.999999m || unitario > 999999999999.999999m)
            return;
        renglon.PesoEnKg = Math.Round(renglon.Cantidad * unitario, 3, MidpointRounding.ToEven);
    }
    private VehiculoDto? VehiculoElegido => _vehiculos.FirstOrDefault(x => x.Id == _vehiculoId);
    private FiguraTransporteDto? FiguraElegida => _figuras.FirstOrDefault(x => x.Id == _figuraId);

    private static string DomicilioDeFigura(FiguraTransporteDto figura)
        => string.Join(", ", new[]
        {
            string.Join(" ", new[] { figura.Calle, figura.NumeroExterior, figura.NumeroInterior }
                .Where(x => !string.IsNullOrWhiteSpace(x))),
            figura.Municipio, figura.Estado, $"C.P. {figura.CodigoPostal}"
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static UbicacionCartaPorteDto Vacio(string tipo, int orden) => new(tipo, orden, null, string.Empty, string.Empty, null, string.Empty, string.Empty, string.Empty);
    private static DetalleProblema ProblemaLocal(string detalle) => new("urn:facturacion:error:carta-porte", "Falta algo en la captura", 400, detalle, null, string.Empty, null);

    private sealed class RenglonMercancia
    {
        public ClaveSatDto? Producto { get; set; }
        public string Descripcion { get; set; } = string.Empty;
        public decimal Cantidad { get; set; } = 1m;
        public ClaveSatDto? Unidad { get; set; }
        public decimal PesoEnKg { get; set; }
        public decimal? PesoUnitarioKg { get; set; }
        public string UnidadPropia { get; set; } = string.Empty;

        public Guid? ProductoId { get; set; }
        public string? ProductoIdInterno { get; set; }
        public string? ProductoNombre { get; set; }

        public int? Largo { get; set; }
        public int? Alto { get; set; }
        public int? Ancho { get; set; }
        public string UnidadDeDimension { get; set; } = "cm";

        public bool DimensionesIncompletas
            => new[] { Largo, Alto, Ancho }.Count(x => x is not null) is 1 or 2;

        /// <summary>
        /// El texto que viaja al servidor. Incompletas se mandan tal cual para que el servidor las
        /// rechace con su mensaje, en lugar de perder en silencio lo capturado.
        /// </summary>
        public string Dimensiones
        {
            get => Largo is null && Alto is null && Ancho is null
                ? string.Empty
                : $"{Largo}/{Alto}/{Ancho}{UnidadDeDimension}";
            set
            {
                var partes = Regex.Match(value ?? string.Empty, @"^(\d{1,3})/(\d{1,3})/(\d{1,3})(cm|plg)$");
                Largo = partes.Success ? int.Parse(partes.Groups[1].Value) : null;
                Alto = partes.Success ? int.Parse(partes.Groups[2].Value) : null;
                Ancho = partes.Success ? int.Parse(partes.Groups[3].Value) : null;
                UnidadDeDimension = partes.Success ? partes.Groups[4].Value : "cm";
            }
        }
    }
}
