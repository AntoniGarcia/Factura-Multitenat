@page "/registro"
@layout LayoutDeAcceso
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Plataforma
@inject ServicioDeSesion Sesion

<PageTitle>Crear cuenta</PageTitle>

@*
    Alta en pasos. Los datos de la empresa emisora —RFC, régimen, código postal— no se piden
    aquí: se capturan después en «Datos fiscales», donde además hay que cargar el certificado.
    Pedirlos ahora obligaría a tenerlos a mano para poder siquiera entrar.
*@

<section class="tarjeta-acceso tarjeta-acceso-pasos">
    @if (_mensaje is null)
    {
        <IndicadorDePasos Etiquetas="_etapas" Actual="_paso" />

        <h1>@TituloDelPaso</h1>
        <p class="acceso-nota">@AyudaDelPaso</p>

        @if (_paso == 0)
        {
            <div class="acceso-rejilla">
                <div class="campo">
                    <label for="nombre">Tu nombre</label>
                    <input id="nombre" type="text" autocomplete="name" maxlength="128"
                           value="@_nombre" @oninput="AlEscribirNombre" />
                </div>

                <div class="campo">
                    <label for="correo">Correo</label>
                    <input id="correo" type="email" autocomplete="email" maxlength="254"
                           value="@_correo" @oninput="AlEscribirCorreo" />
                    <p class="campo-ayuda">Aquí llegará tu contraseña.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_correo) && !CorreoParece)
            {
                <p class="texto-error">Ese correo no parece válido.</p>
            }
        }
        else if (_paso == 1)
        {
            <div class="campo">
                <label for="cuenta">Nombre de la cuenta</label>
                <input id="cuenta" type="text" maxlength="200"
                       placeholder="@_nombre" value="@_nombreCuenta" @oninput="AlEscribirCuenta" />
                <p class="campo-ayuda">
                    El del despacho o el negocio. Si lo dejas vacío se usa el tuyo.
                </p>
            </div>
        }
        else
        {
            <dl class="resumen-alta">
                <dt>Nombre</dt>
                <dd>@_nombre</dd>

                <dt>Correo</dt>
                <dd>@_correo</dd>

                <dt>Cuenta</dt>
                <dd>@NombreDeCuenta</dd>
            </dl>

            <PanelErrores Problema="_problema" />
        }

        <div class="acciones-acceso @(_paso == 0 ? "acciones-acceso-separadas" : null)">
            @if (_paso == 0)
            {
                <a class="acceso-alterno-enlace" href="/iniciar-sesion">¿Ya tienes cuenta?</a>
            }
            else
            {
                <button type="button" class="boton-secundario" @onclick="Atras" disabled="@_enviando">
                    Atrás
                </button>
            }

            @if (_paso < _etapas.Count - 1)
            {
                <button type="button" @onclick="Siguiente" disabled="@(!PuedeAvanzar)">
                    Continuar
                </button>
            }
            else
            {
                <button type="button" @onclick="Registrar" disabled="@(_enviando || !PasoUnoListo)">
                    @(_enviando ? "Creando…" : "Crear cuenta")
                </button>
            }
        </div>
    }
    else
    {
        <h1>Revisa tu correo</h1>
        <p class="acceso-nota" role="status">@_mensaje</p>

        <div class="acciones-acceso">
            <a class="boton-enlace" href="/iniciar-sesion">Ir a iniciar sesión</a>
        </div>
    }
</section>

@code {
    private readonly List<string> _etapas = ["Tus datos", "Tu cuenta", "Confirmar"];

    private int _paso;

    private string _nombre = string.Empty;
    private string _correo = string.Empty;
    private string _nombreCuenta = string.Empty;

    private DetalleProblema? _problema;
    private string? _mensaje;
    private bool _enviando;

    private string TituloDelPaso => _paso switch
    {
        0 => "Crear cuenta",
        1 => "Nombra tu cuenta",
        _ => "Revisa y confirma"
    };

    private string AyudaDelPaso => _paso switch
    {
        0 => "Con estos datos entras al sistema.",
        1 => "Las empresas con las que vas a facturar se dan de alta después, en «Datos fiscales».",
        _ => "Al crear la cuenta te mandamos la contraseña por correo."
    };

    /// <summary>Comprobación de forma, no de existencia; la de verdad la hace el servidor.</summary>
    private bool CorreoParece =>
        _correo.Contains('@') && _correo.Contains('.') && _correo.Length >= 5;

    private bool PasoUnoListo => !string.IsNullOrWhiteSpace(_nombre) && CorreoParece;

    // El segundo paso se puede pasar sin escribir nada: si no dan nombre de cuenta se usa el
    // de la persona, que es lo que hacía el alta de un solo paso.
    private bool PuedeAvanzar => PasoUnoListo;

    private string NombreDeCuenta =>
        string.IsNullOrWhiteSpace(_nombreCuenta) ? _nombre : _nombreCuenta.Trim();

    private void AlEscribirNombre(ChangeEventArgs e) => _nombre = e.Value?.ToString() ?? string.Empty;

    private void AlEscribirCorreo(ChangeEventArgs e) => _correo = e.Value?.ToString() ?? string.Empty;

    private void AlEscribirCuenta(ChangeEventArgs e) => _nombreCuenta = e.Value?.ToString() ?? string.Empty;

    private void Siguiente()
    {
        if (PuedeAvanzar && _paso < _etapas.Count - 1) _paso++;
    }

    private void Atras()
    {
        if (_paso > 0) _paso--;
    }

    private async Task Registrar()
    {
        _enviando = true;
        _problema = null;

        var (exito, error) = await Sesion.RegistrarAsync(
            new PeticionRegistro(_correo.Trim(), _nombre.Trim(), NombreDeCuenta));

        _enviando = false;
        _problema = error;

        // El mensaje es el mismo exista o no el correo: la pantalla no puede convertirse en
        // un detector de qué correos ya tienen cuenta.
        if (exito is not null) _mensaje = exito.Mensaje;
    }
}
