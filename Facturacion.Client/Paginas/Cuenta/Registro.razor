@page "/registro"
@layout LayoutDeAcceso
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Plataforma
@inject ServicioDeSesion Sesion

<PageTitle>Crear cuenta</PageTitle>

@*
    Alta en pasos. Los datos de la empresa emisora —RFC, régimen, código postal— no se piden
    aquí: se capturan después en «Datos fiscales», donde además hay que cargar el certificado.
    Pedirlos ahora obligaría a tenerlos a mano para poder siquiera entrar.

    El último paso es el que hace el trabajo de verdad: hasta que el código no vuelve, en el
    servidor no existe ninguna cuenta. Por eso «Enviar código» no es el final del trámite,
    aunque lo parezca.
*@

<section class="tarjeta-acceso tarjeta-acceso-pasos">
    @if (_mensaje is null)
    {
        <IndicadorDePasos Etiquetas="_etapas" Actual="_paso" />

        <h1>@TituloDelPaso</h1>
        <p class="acceso-nota">@AyudaDelPaso</p>

        @if (_paso == 0)
        {
            <div class="acceso-rejilla">
                <div class="campo">
                    <label for="nombre">Tu nombre</label>
                    <input id="nombre" type="text" autocomplete="name" maxlength="128"
                           value="@_nombre" @oninput="AlEscribirNombre" />
                </div>

                <div class="campo">
                    <label for="correo">Correo</label>
                    <input id="correo" type="email" autocomplete="email" maxlength="254"
                           value="@_correo" @oninput="AlEscribirCorreo" />
                    <p class="campo-ayuda">Aquí llegará tu código de verificación.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_correo) && !CorreoParece)
            {
                <p class="texto-error">Ese correo no parece válido.</p>
            }
        }
        else if (_paso == 1)
        {
            <div class="campo">
                <label for="cuenta">Nombre de la cuenta</label>
                <input id="cuenta" type="text" maxlength="200"
                       placeholder="@_nombre" value="@_nombreCuenta" @oninput="AlEscribirCuenta" />
                <p class="campo-ayuda">
                    El del despacho o el negocio. Si lo dejas vacío se usa el tuyo.
                </p>
            </div>
        }
        else if (_paso == 2)
        {
            <dl class="resumen-alta">
                <dt>Nombre</dt>
                <dd>@_nombre</dd>

                <dt>Correo</dt>
                <dd>@_correo</dd>

                <dt>Cuenta</dt>
                <dd>@NombreDeCuenta</dd>
            </dl>

            <PanelErrores Problema="_problema" />
        }
        else
        {
            @* El correo se repite aquí y no solo en el paso anterior: es donde se nota si
               uno se equivocó al teclearlo, porque es la razón por la que no llega nada. *@
            <p class="acceso-nota" role="status">@_avisoDelEnvio</p>

            <div class="campo">
                <label for="codigo">Código de verificación</label>
                <input id="codigo" class="campo-codigo" type="text" inputmode="numeric"
                       autocomplete="one-time-code" maxlength="6" placeholder="000000"
                       value="@_codigo" @oninput="AlEscribirCodigo" />
                <p class="campo-ayuda">Seis dígitos. Caduca a los 20 minutos.</p>
            </div>

            <div class="acceso-rejilla">
                <div class="campo">
                    <label for="contrasena">Contraseña</label>
                    <input id="contrasena" type="password" autocomplete="new-password" maxlength="128"
                           value="@_contrasena" @oninput="AlEscribirContrasena" />
                    <p class="campo-ayuda">12 caracteres, con mayúscula, minúscula y número.</p>
                </div>

                <div class="campo">
                    <label for="confirmacion-contrasena">Repite la contraseña</label>
                    <input id="confirmacion-contrasena" type="password" autocomplete="new-password"
                           maxlength="128" value="@_confirmacionContrasena"
                           @oninput="AlEscribirConfirmacion" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_contrasena) && !ContrasenaCumpleForma)
            {
                <p class="texto-error">La contraseña todavía no cumple los requisitos.</p>
            }

            @if (!string.IsNullOrEmpty(_confirmacionContrasena) && _contrasena != _confirmacionContrasena)
            {
                <p class="texto-error">Las dos contraseñas no coinciden.</p>
            }

            <PanelErrores Problema="_problema" />
        }

        <div class="acciones-acceso @(_paso == 0 ? "acciones-acceso-separadas" : null)">
            @if (_paso == 0)
            {
                <a class="acceso-alterno-enlace" href="/iniciar-sesion">¿Ya tienes cuenta?</a>
            }
            else if (_paso < 3)
            {
                <button type="button" class="boton-secundario" @onclick="Atras" disabled="@_enviando">
                    Atrás
                </button>
            }
            else
            {
                @* En el último paso no se vuelve atrás: el código ya salió y los datos ya no
                   se pueden cambiar sin pedir otro. Lo que hace falta aquí es reenviarlo. *@
                <button type="button" class="boton-secundario" @onclick="Reenviar" disabled="@_enviando">
                    Volver a enviar
                </button>
            }

            @if (_paso < 2)
            {
                <button type="button" @onclick="Siguiente" disabled="@(!PuedeAvanzar)">
                    Continuar
                </button>
            }
            else if (_paso == 2)
            {
                <button type="button" @onclick="PedirCodigo" disabled="@(_enviando || !PasoUnoListo)">
                    @(_enviando ? "Enviando…" : "Enviar código")
                </button>
            }
            else
            {
                <button type="button" @onclick="Verificar" disabled="@(_enviando || !PuedeVerificar)">
                    @(_enviando ? "Creando…" : "Crear cuenta")
                </button>
            }
        </div>
    }
    else
    {
        <h1>Cuenta lista</h1>
        <p class="acceso-nota" role="status">@_mensaje</p>

        <div class="acciones-acceso">
            <a class="boton-enlace" href="/iniciar-sesion">Ir a iniciar sesión</a>
        </div>
    }
</section>

@code {
    private readonly List<string> _etapas = ["Tus datos", "Tu cuenta", "Confirmar", "Verificar"];

    private int _paso;

    private string _nombre = string.Empty;
    private string _correo = string.Empty;
    private string _nombreCuenta = string.Empty;
    private string _codigo = string.Empty;
    private string _contrasena = string.Empty;
    private string _confirmacionContrasena = string.Empty;

    private DetalleProblema? _problema;

    /// <summary>Lo que respondió el servidor al mandar el código. Se muestra en el paso cuatro.</summary>
    private string? _avisoDelEnvio;

    /// <summary>Mensaje final. Mientras sea nulo, el trámite sigue abierto.</summary>
    private string? _mensaje;

    private bool _enviando;

    private string TituloDelPaso => _paso switch
    {
        0 => "Crear cuenta",
        1 => "Nombra tu cuenta",
        2 => "Revisa y confirma",
        _ => "Verifica y protege tu cuenta"
    };

    private string AyudaDelPaso => _paso switch
    {
        0 => "Con estos datos entras al sistema.",
        1 => "Las empresas con las que vas a facturar se dan de alta después, en «Datos fiscales».",
        2 => "Te mandamos un código para comprobar que el correo es tuyo.",
        _ => $"Escribe el código que mandamos a {_correo} y elige tu contraseña."
    };

    /// <summary>Comprobación de forma, no de existencia; la de verdad la hace el servidor.</summary>
    private bool CorreoParece =>
        _correo.Contains('@') && _correo.Contains('.') && _correo.Length >= 5;

    private bool PasoUnoListo => !string.IsNullOrWhiteSpace(_nombre) && CorreoParece;

    // El segundo paso se puede pasar sin escribir nada: si no dan nombre de cuenta se usa el
    // de la persona, que es lo que hacía el alta de un solo paso.
    private bool PuedeAvanzar => PasoUnoListo;

    private bool CodigoCompleto => _codigo.Length == 6;

    private bool ContrasenaCumpleForma =>
        _contrasena.Length >= 12 &&
        _contrasena.Any(char.IsUpper) &&
        _contrasena.Any(char.IsLower) &&
        _contrasena.Any(char.IsDigit);

    private bool PuedeVerificar =>
        CodigoCompleto && ContrasenaCumpleForma && _contrasena == _confirmacionContrasena;

    private string NombreDeCuenta =>
        string.IsNullOrWhiteSpace(_nombreCuenta) ? _nombre : _nombreCuenta.Trim();

    private void AlEscribirNombre(ChangeEventArgs e) => _nombre = e.Value?.ToString() ?? string.Empty;

    private void AlEscribirCorreo(ChangeEventArgs e) => _correo = e.Value?.ToString() ?? string.Empty;

    private void AlEscribirCuenta(ChangeEventArgs e) => _nombreCuenta = e.Value?.ToString() ?? string.Empty;

    private void AlEscribirContrasena(ChangeEventArgs e)
        => _contrasena = e.Value?.ToString() ?? string.Empty;

    private void AlEscribirConfirmacion(ChangeEventArgs e)
        => _confirmacionContrasena = e.Value?.ToString() ?? string.Empty;

    /// <summary>
    /// Se queda solo con los dígitos: quien copia el código del correo se trae espacios o un
    /// guion sin querer, y rechazárselo por eso sería castigarlo por copiar bien.
    /// </summary>
    private void AlEscribirCodigo(ChangeEventArgs e)
        => _codigo = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).ToArray());

    private void Siguiente()
    {
        if (PuedeAvanzar && _paso < 2) _paso++;
    }

    private void Atras()
    {
        if (_paso > 0) _paso--;
    }

    private Task PedirCodigo() => EnviarCodigo(avanzar: true);

    private Task Reenviar() => EnviarCodigo(avanzar: false);

    /// <summary>
    /// Manda —o vuelve a mandar— el código. Reenviar es la misma petición: en el servidor,
    /// pedir un código nuevo tira el anterior, que es justo lo que espera quien lo pide
    /// porque el primero no le llegó.
    /// </summary>
    private async Task EnviarCodigo(bool avanzar)
    {
        _enviando = true;
        _problema = null;

        var (exito, error) = await Sesion.RegistrarAsync(
            new PeticionRegistro(_correo.Trim(), _nombre.Trim(), NombreDeCuenta));

        _enviando = false;
        _problema = error;

        if (exito is null) return;

        // El mensaje es el mismo exista o no el correo: la pantalla no puede convertirse en
        // un detector de qué correos ya tienen cuenta. Por eso se avanza al paso del código
        // en los dos casos, aunque cuando el correo ya tenía cuenta no haya código que valga.
        _avisoDelEnvio = exito.Mensaje;
        _codigo = string.Empty;

        if (avanzar) _paso = 3;
    }

    private async Task Verificar()
    {
        _enviando = true;
        _problema = null;

        var (exito, error) = await Sesion.VerificarAltaAsync(
            new PeticionVerificarAlta(
                _correo.Trim(), _codigo, _contrasena, _confirmacionContrasena));

        _enviando = false;
        _problema = error;

        if (exito is not null) _mensaje = exito.Mensaje;
    }
}
