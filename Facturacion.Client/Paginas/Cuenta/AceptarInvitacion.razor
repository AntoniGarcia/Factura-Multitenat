@page "/aceptar-invitacion"
@layout LayoutDeAcceso
@using Facturacion.Client.Componentes.Comunes
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Plataforma
@inject ServicioDeUsuarios Usuarios
@inject NavigationManager Navegacion

<PageTitle>Aceptar invitación</PageTitle>

<section class="tarjeta-acceso">
    @if (_cargando)
    {
        <p>Comprobando la invitación…</p>
    }
    else if (_invitacion is null)
    {
        <h1>Invitación no válida</h1>
        <p>
            Este enlace ya se usó, se revocó o venció. Las invitaciones son válidas por 72 horas;
            pide a quien te invitó que la reenvíe.
        </p>
        <a href="/iniciar-sesion">Ir a iniciar sesión</a>
    }
    else if (_lista)
    {
        <h1>Cuenta creada</h1>
        <p>Ya puedes iniciar sesión con @_invitacion.Correo.</p>
        <a href="/iniciar-sesion">Iniciar sesión</a>
    }
    else
    {
        <h1>Únete a @_invitacion.NombreEmpresa</h1>
        <p>Fija tu contraseña para @_invitacion.Correo.</p>

        <EditForm Model="_datos" OnValidSubmit="Aceptar" FormName="aceptar-invitacion">
            <div class="campo">
                <label for="contrasena">Contraseña</label>
                <InputText id="contrasena" @bind-Value="_datos.Contrasena" type="password" autocomplete="new-password" />
            </div>

            <div class="campo">
                <label for="confirmar">Confirmar contraseña</label>
                <InputText id="confirmar" @bind-Value="_datos.Confirmar" type="password" autocomplete="new-password" />
            </div>

            @if (_datos.Contrasena.Length > 0 && _datos.Confirmar.Length > 0 && _datos.Contrasena != _datos.Confirmar)
            {
                <p class="texto-error">Las contraseñas no coinciden.</p>
            }

            <PanelErrores Problema="_problema" />

            <button type="submit" disabled="@(_enviando || _datos.Contrasena != _datos.Confirmar || _datos.Contrasena.Length == 0)">
                @(_enviando ? "Creando cuenta…" : "Crear cuenta y entrar")
            </button>
        </EditForm>
    }
</section>

@code {
    private sealed class Datos
    {
        public string Contrasena { get; set; } = string.Empty;
        public string Confirmar { get; set; } = string.Empty;
    }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private readonly Datos _datos = new();
    private InvitacionPublicaDto? _invitacion;
    private DetalleProblema? _problema;
    private bool _cargando = true, _enviando, _lista;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Token))
            _invitacion = await Usuarios.ObtenerInvitacionAsync(Token);

        _cargando = false;
    }

    private async Task Aceptar()
    {
        if (Token is null) return;

        _enviando = true;
        _problema = await Usuarios.AceptarInvitacionAsync(new PeticionAceptarInvitacion(Token, _datos.Contrasena));
        _enviando = false;

        if (_problema is null) _lista = true;
    }
}
