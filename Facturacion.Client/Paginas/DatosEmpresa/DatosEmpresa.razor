@page "/empresa/datos"
@attribute [Authorize(Policy = Permisos.ConfigurarEmpresa)]
@using Facturacion.Shared.Contratos
@using Facturacion.Client.Componentes.Empresas
@inject ServicioDeEmpresa Empresas
@inject ServicioDeCatalogos Catalogos
@inject IDialogService Dialogos

<PageTitle>Datos Empresa</PageTitle>
<TituloDePagina Texto="Datos de la Empresa" />

@* Dos pestañas independientes, cada una con su propio EditForm, su propio Cargando y su
   propio botón Guardar — son dos páginas distintas (antes /empresa y /empresa/configuracion)
   que ahora comparten encabezado, no un formulario conjunto. Notaría deja de ser una página
   aparte (/empresa/notaria, que se deja intacta por si algo más la enlaza directo) y se abre
   como diálogo desde "Datos de la Empresa", igual que DialogoDeCliente en Catálogos. *@
<MudTabs>
    <MudTabPanel Text="Datos de la Empresa">
        <section class="pestana-empresa" aria-label="Datos fiscales y domicilio de la empresa">
            <PanelErrores Problema="_errorDatos" />

            @if (_empresa is null)
            {
                <p>Cargando…</p>
            }
            else
            {
                <EditForm Model="_empresa" OnValidSubmit="GuardarDatosAsync" class="formulario-empresa">
                    <h2 class="seccion-titulo">Datos fiscales</h2>
                    <p class="seccion-ayuda">
                        Estos son los que viajan al CFDI. Deben coincidir con tu Constancia de Situación Fiscal.
                    </p>

                    <div class="rejilla-campos">
                        <MudTextField Value="@_empresa.Rfc"
                                      Label="RFC"
                                      ReadOnly="true"
                                      Class="cifra-tabular"
                                      HelperText="No se puede cambiar: los certificados y los comprobantes ya emitidos están atados a este RFC." />

                        @* :after es lo que dispara la vista previa mientras se escribe; sin él, el valor
                           se enlaza pero nada recalcula la normalización. *@
                        <MudTextField @bind-Value="_nombre"
                                      @bind-Value:after="ActualizarVistaPrevia"
                                      Label="Nombre o razón social"
                                      Immediate="true"
                                      MaxLength="254"
                                      HelperText="Sin régimen de capital, como en la constancia." />
                    </div>

                    @if (_vistaPrevia.HuboCambios)
                    {
                        <div class="aviso-normalizacion" role="status">
                            <p>Se va a guardar como <strong class="cifra-tabular">@_vistaPrevia.Normalizado</strong></p>
                            <ul>
                                @foreach (var ajuste in _vistaPrevia.Ajustes)
                                {
                                    <li>@ajuste</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="rejilla-campos">
                        <MudSelect T="string" @bind-Value="_regimenFiscal" Label="Régimen fiscal">
                            @foreach (var regimen in Catalogos.Obtener("c_RegimenFiscal"))
                            {
                                <MudSelectItem T="string" Value="@regimen.Clave">@regimen.Clave — @regimen.Descripcion</MudSelectItem>
                            }
                        </MudSelect>

                        <MudTextField @bind-Value="_cpExpedicion"
                                      Label="Código postal del lugar de expedición"
                                      Class="cifra-tabular"
                                      MaxLength="5"
                                      HelperText="Va en el CFDI como lugar de expedición." />

                        <MudTextField @bind-Value="_zonaHoraria"
                                      Label="Huso horario del lugar de expedición"
                                      HelperText="Con esto se sella el comprobante con la hora local correcta." />
                    </div>

                    <h2 class="seccion-titulo">Domicilio</h2>
                    <p class="seccion-ayuda">Sale en el PDF, no en el XML. Puedes dejarlo en blanco.</p>

                    <div class="rejilla-campos">
                        <MudTextField @bind-Value="_calle" Label="Calle" MaxLength="128" />
                        <MudTextField @bind-Value="_numeroExterior" Label="Número exterior" MaxLength="32" />
                        <MudTextField @bind-Value="_numeroInterior" Label="Número interior" MaxLength="32" />
                        <MudTextField @bind-Value="_colonia" Label="Colonia" MaxLength="128" />
                        <MudTextField @bind-Value="_localidad" Label="Localidad" MaxLength="128" />
                        <MudTextField @bind-Value="_municipio" Label="Municipio" MaxLength="128" />
                        <MudTextField @bind-Value="_estado" Label="Estado" MaxLength="128" />
                        <MudTextField @bind-Value="_pais" Label="País" MaxLength="64" />
                        <MudTextField @bind-Value="_codigoPostal" Label="Código postal" Class="cifra-tabular" MaxLength="5" />
                        <MudTextField @bind-Value="_referencia" Label="Referencia" MaxLength="256" />
                    </div>

                    <h2 class="seccion-titulo">Origen predeterminado de Carta Porte</h2>
                    <p class="seccion-ayuda">Usa el lugar desde donde suelen salir las mercancías. Es independiente del domicilio general y puedes cambiarlo en cada traslado.</p>
                    <MudCheckBox T="bool" @bind-Value="_configurarOrigenCartaPorte" Label="Configurar origen para nuevos traslados" />
                    @if (_configurarOrigenCartaPorte)
                    {
                        <EditorDomicilioCartaPorte Valor="_origenCartaPorte" ValorCambiado="v => _origenCartaPorte = v" />
                    }

                    <h2 class="seccion-titulo">Contacto</h2>

                    <div class="rejilla-campos">
                        <MudTextField @bind-Value="_telefono" Label="Teléfono" MaxLength="32" />
                        <MudTextField @bind-Value="_correoContacto" Label="Correo electrónico" MaxLength="254" />
                    </div>

                    <h2 class="seccion-titulo">Licencias</h2>
                    <div class="aviso-reservado" role="note">
                        <p>
                            Las licencias las asigna el operador del sistema según el servicio contratado.
                            No se pueden cambiar desde la empresa.
                        </p>
                    </div>

                    <div class="rejilla-campos">
                        <MudCheckBox Value="_empresa.Licencias.Notarios" Label="Notarios" Disabled="true" />
                        <MudCheckBox Value="_empresa.Licencias.Obras" Label="Obras" Disabled="true" />
                        <MudCheckBox Value="_empresa.Licencias.Comercio" Label="Comercio exterior" Disabled="true" />
                        <MudCheckBox Value="_empresa.Licencias.Ine" Label="INE" Disabled="true" />
                    </div>

                    @if (_empresa.Licencias.Notarios)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AccountBalance"
                                   OnClick="AbrirNotariaAsync">
                            Configurar Notaría
                        </MudButton>
                    }

                    <div class="acciones-formulario">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Disabled="_guardandoDatos">
                            @(_guardandoDatos ? "Guardando…" : "Guardar")
                        </MudButton>

                        @if (_guardadoDatos)
                        {
                            <span class="mensaje-exito" role="status">Datos guardados.</span>
                        }
                    </div>
                </EditForm>
            }
        </section>
    </MudTabPanel>

    <MudTabPanel Text="Impuesto Predeterminado">
        <section class="pestana-empresa" aria-label="Tasas de impuestos por omisión y avisos">
            <PanelErrores Problema="_errorTasas" />

            <p class="seccion-ayuda">
                Estas tasas son una sugerencia al configurar productos. Los impuestos de la factura
                se calculan con los que tenga guardados cada producto.
            </p>

            @if (_configuracion is null)
            {
                <p>Cargando…</p>
            }
            else
            {
                <EditForm Model="_configuracion" OnValidSubmit="GuardarTasasAsync">
                    <h2 class="seccion-titulo">Impuestos por omisión</h2>

                    <div class="rejilla-campos">
                        <MudNumericField @bind-Value="_iva" Label="IVA trasladado" Format="P2" Step="0.01M" Min="0M" Max="1M"
                                         HelperText="0.16 es 16 %." Class="cifra-tabular" />

                        <MudNumericField @bind-Value="_retIva" Label="Retención de IVA" Format="P2" Step="0.01M" Min="0M" Max="1M"
                                         HelperText="Cero si la empresa no retiene." Class="cifra-tabular" />

                        <MudNumericField @bind-Value="_retIsr" Label="Retención de ISR" Format="P2" Step="0.01M" Min="0M" Max="1M"
                                         HelperText="Cero si la empresa no retiene." Class="cifra-tabular" />
                    </div>

                    <h2 class="seccion-titulo">Avisos</h2>

                    <div class="rejilla-campos">
                        <MudNumericField @bind-Value="_diasAviso" Label="Avisar caducidad del certificado" Min="1" Max="365"
                                         HelperText="Días de anticipación." Class="cifra-tabular" />
                    </div>

                    <div class="acciones-formulario">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Disabled="_guardandoTasas">
                            @(_guardandoTasas ? "Guardando…" : "Guardar")
                        </MudButton>

                        @if (_guardadoTasas)
                        {
                            <span class="mensaje-exito" role="status">Configuración guardada.</span>
                        }
                    </div>
                </EditForm>
            }
        </section>
    </MudTabPanel>
</MudTabs>

@code {
    // ── Datos de la Empresa ──────────────────────────────────────────────────────────────

    private EmpresaDto? _empresa;
    private DetalleProblema? _errorDatos;
    private bool _guardandoDatos;
    private bool _guardadoDatos;

    private string _nombre = string.Empty;
    private string _regimenFiscal = string.Empty;
    private string _cpExpedicion = string.Empty;
    private string _zonaHoraria = string.Empty;
    private string? _calle, _numeroExterior, _numeroInterior, _referencia, _colonia;
    private string? _localidad, _municipio, _estado, _pais, _codigoPostal, _telefono, _correoContacto;
    private bool _configurarOrigenCartaPorte;
    private DomicilioSatDto _origenCartaPorte = new(string.Empty, null, null, string.Empty, string.Empty, string.Empty);

    /// <summary>
    /// La misma normalización que aplica el servidor, corriendo mientras el usuario escribe.
    /// Es comodidad, no validación: la que cuenta es la del servidor (ARQUITECTURA.md §3).
    /// </summary>
    private NombreFiscalNormalizado _vistaPrevia = NombreFiscal.Normalizar(string.Empty);

    // ── Tasas ─────────────────────────────────────────────────────────────────────────

    private ConfiguracionEmpresaDto? _configuracion;
    private DetalleProblema? _errorTasas;
    private bool _guardandoTasas, _guardadoTasas;

    private decimal _iva, _retIva, _retIsr;
    private int _diasAviso;

    protected override async Task OnInitializedAsync()
    {
        // Las dos pestañas cargan de una vez: son dos llamadas independientes y ligeras, y
        // así cambiar de pestaña no dispara una carga a medias.
        await Task.WhenAll(CargarDatosAsync(), CargarTasasAsync());
    }

    private async Task CargarDatosAsync()
    {
        _empresa = await Empresas.ObtenerAsync();
        if (_empresa is null) return;

        _nombre = _empresa.NombreFiscal;
        _regimenFiscal = _empresa.RegimenFiscal;
        _cpExpedicion = _empresa.CodigoPostalExpedicion;
        _zonaHoraria = _empresa.ZonaHoraria;
        _calle = _empresa.Calle;
        _numeroExterior = _empresa.NumeroExterior;
        _numeroInterior = _empresa.NumeroInterior;
        _referencia = _empresa.Referencia;
        _colonia = _empresa.Colonia;
        _localidad = _empresa.Localidad;
        _municipio = _empresa.Municipio;
        _estado = _empresa.Estado;
        _pais = _empresa.Pais;
        _codigoPostal = _empresa.CodigoPostal;
        _telefono = _empresa.Telefono;
        _correoContacto = _empresa.CorreoContacto;
        _configurarOrigenCartaPorte = _empresa.OrigenCartaPorte is not null;
        if (_empresa.OrigenCartaPorte is { } origen) _origenCartaPorte = origen;
        ActualizarVistaPrevia();
    }

    private void ActualizarVistaPrevia() => _vistaPrevia = NombreFiscal.Normalizar(_nombre);

    private async Task GuardarDatosAsync()
    {
        if (_empresa is null) return;

        _guardandoDatos = true;
        _guardadoDatos = false;
        _errorDatos = null;

        var peticion = new PeticionGuardarEmpresa(
            _nombre, _regimenFiscal, _cpExpedicion, _zonaHoraria,
            _calle, _numeroExterior, _numeroInterior, _referencia, _colonia, _localidad,
            _municipio, _estado, _pais, _codigoPostal, _telefono, _correoContacto,
            _empresa.Licencias, _configurarOrigenCartaPorte ? _origenCartaPorte : null);

        var (exito, error) = await Empresas.GuardarAsync(peticion);

        _guardandoDatos = false;

        if (error is not null)
        {
            _errorDatos = error;
            return;
        }

        // Se relee lo que el servidor guardó de verdad: si normalizó el nombre, el campo
        // tiene que mostrar el resultado, no lo que el usuario tecleó.
        _empresa = exito!.Empresa;
        _nombre = exito.Empresa.NombreFiscal;
        _configurarOrigenCartaPorte = exito.Empresa.OrigenCartaPorte is not null;
        if (exito.Empresa.OrigenCartaPorte is { } origen) _origenCartaPorte = origen;
        _vistaPrevia = NombreFiscal.Normalizar(_nombre);
        _guardadoDatos = true;
    }

    private async Task AbrirNotariaAsync()
    {
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var referencia = await Dialogos.ShowAsync<DialogoDeNotaria>("Configuración de Notaría", opciones);
        await referencia.Result;
    }

    // ── Tasas ─────────────────────────────────────────────────────────────────────────

    private async Task CargarTasasAsync()
    {
        _configuracion = await Empresas.ObtenerConfiguracionAsync();
        if (_configuracion is null) return;

        _iva = _configuracion.TasaIvaPorDefecto;
        _retIva = _configuracion.TasaRetencionIvaPorDefecto;
        _retIsr = _configuracion.TasaRetencionIsrPorDefecto;
        _diasAviso = _configuracion.DiasAvisoCaducidadCertificado;
    }

    private async Task GuardarTasasAsync()
    {
        _guardandoTasas = true;
        _guardadoTasas = false;
        _errorTasas = null;

        var (exito, error) = await Empresas.GuardarConfiguracionAsync(
            new ConfiguracionEmpresaDto(_iva, _retIva, _retIsr, _diasAviso));

        _guardandoTasas = false;

        if (error is not null)
        {
            _errorTasas = error;
            return;
        }

        _configuracion = exito;
        _guardadoTasas = true;
    }
}
