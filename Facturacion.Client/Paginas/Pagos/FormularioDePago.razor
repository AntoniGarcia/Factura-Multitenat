@page "/pagos/nuevo"
@page "/pagos/{Id:guid}"
@attribute [Authorize(Policy = Permisos.EmitirPago)]
@using Facturacion.Client.Servicios.Documentos
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Documentos
@using Facturacion.Shared.Plataforma
@inject ServicioDePagos Pagos
@inject ServicioDeEmision Emision
@inject ServicioDeCatalogos Catalogos
@inject ServicioDeClientes Clientes
@inject IDialogService Dialogos
@inject NavigationManager Navegacion
@implements IDisposable

<PageTitle>@(EsNuevo ? "Nuevo pago" : "Pago")</PageTitle>
<TituloDePagina Texto="@(EsNuevo ? "Nuevo pago" : "Pago")" />

<TarjetaFormulario Ancha="true" RutaVolver="/documentos" Class="pago-formulario">
<PanelErrores Problema="_error" />

@if (_aviso is not null)
{
    <div class="aviso-documentos" role="status">@_aviso</div>
}

@if (_cargando)
{
    <p class="tabla-datos-estado">Cargando…</p>
}
else if (_pago is null)
{
    @if (_error is null)
    {
        <p class="tabla-datos-estado">No se encontró ese pago. Vuelve al listado de documentos.</p>
    }
}
else
{
    <MudTabs Elevation="0" ApplyEffectsToContainer="true" Class="pestanas-pago">
        <MudTabPanel Text="General">
            <section class="seccion-formulario">
                <h2 class="seccion-titulo">Datos del pago</h2>

                <div class="rejilla-formulario">
                    <MudTextField T="string" Label="Folio" Value="@FolioMostrado" ReadOnly="true"
                                  Class="cifra-tabular" />

                    <MudTextField T="string" Label="No. de operación" @bind-Value="_numOperacion"
                                  Disabled="@(!EsEditable)" Immediate="true"
                                  HelperText="Referencia de la transferencia, cheque o autorización." />

                    <MudTextField T="string" Label="Huso horario de la empresa"
                                  Value="@_pago.ZonaHoraria" ReadOnly="true" />
                    <MudDatePicker Label="Fecha del pago" @bind-Date="_fechaPagoLocal"
                                   Disabled="@(!EsEditable)" Required="true" />
                    <MudTimePicker Label="Hora del pago" @bind-Time="_horaPagoLocal"
                                   Disabled="@(!EsEditable)" Required="true" AmPm="false" />

                    <BuscadorCatalogo Catalogo="c_FormaPago" Label="Forma de pago" @bind-Clave="_formaDePago"
                                     Opciones="@Catalogos.Obtener("c_FormaPago").Where(x => x.Clave != "99").ToArray()"
                                     Deshabilitado="@(!EsEditable)" Requerido="true" PuedeLimpiar="false" />

                    <MudSelect T="string" Label="Moneda" @bind-Value="_moneda" Disabled="@(!EsEditable)">
                        @foreach (var moneda in Catalogos.ObtenerMonedasDeCaptura())
                        {
                            <MudSelectItem T="string" Value="@moneda.Clave">@moneda.Clave — @moneda.Descripcion</MudSelectItem>
                        }
                        @if (_moneda is not ("MXN" or "USD"))
                        {
                            <MudSelectItem T="string" Value="@_moneda" Disabled="true">@_moneda — Moneda guardada</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField T="decimal?" Label="Tipo de cambio" @bind-Value="_tipoCambio"
                                     Immediate="true"
                                     Disabled="@(!EsEditable || _moneda == "MXN")"
                                     HelperText="@(_moneda == "MXN" ? "No aplica en pesos." : "Obligatorio fuera de MXN.")"
                                     Format="F6" Class="cifra-tabular" />

                    <MudNumericField T="decimal" Label="Importe del pago" @bind-Value="_monto"
                                     Immediate="true"
                                     Disabled="@(!EsEditable)" Format="F2" Class="cifra-tabular"
                                     HelperText="Debe coincidir con la suma de los abonos." />
                </div>
            </section>

            <section class="seccion-formulario">
                <h2 class="seccion-titulo">Cliente</h2>

                <div class="rejilla-formulario">
                    @if (EsEditable)
                    {
                        <BuscadorDeCliente Valor="_cliente" ValorCambiado="AlElegirCliente" Requerido="true" />
                    }

                    <MudTextField T="string" Label="R.F.C." Value="@(_cliente?.Rfc ?? _pago.ReceptorRfc)" ReadOnly="true"
                                  Class="cifra-tabular" />
                    <MudTextField T="string" Label="Nombre" Value="@(_cliente?.Nombre ?? _pago.ReceptorNombre)" ReadOnly="true" />
                </div>
            </section>

            <section class="seccion-formulario">
                <h2 class="seccion-titulo">Facturas que se pagan</h2>
                <p class="seccion-ayuda">
                    Busca facturas timbradas PPD. El saldo y la parcialidad se calculan automáticamente.
                </p>

                @if (EsEditable)
                {
                    <div class="rejilla-consulta-pago">
                        <MudTextField T="string" Label="Serie" @bind-Value="_serieBusqueda" Class="cifra-tabular" Immediate="true" />
                        <MudNumericField T="int" Label="Folio" @bind-Value="_folioBusqueda" Class="cifra-tabular" Immediate="true" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Consultar">
                            Consultar
                        </MudButton>
                    </div>

                    @if (_encontrado is { } encontrado)
                    {
                        <div class="resultado-consulta-pago">
                            <span>
                                <strong class="cifra-tabular">@encontrado.Serie-@encontrado.Folio</strong>
                                — saldo <strong class="cifra-tabular">@encontrado.SaldoPendiente.ToString("N2")</strong>
                                @encontrado.Moneda, parcialidad @encontrado.NumParcialidad
                            </span>
                            <MudNumericField T="decimal" Label="Importe a pagar" @bind-Value="_importeAPagar"
                                             Format="F2" Class="cifra-tabular" Immediate="true" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Agregar">Agregar factura</MudButton>
                        </div>
                    }
                }

                @if (_renglones.Count == 0)
                {
                    <p class="tabla-datos-estado">Todavía no se agregó ninguna factura.</p>
                }
                else
                {
                    <MudTable T="Renglon" Items="_renglones" Dense="true" Striped="true" Elevation="0"
                              Breakpoint="Breakpoint.Sm" Class="pago-facturas">
                        <HeaderContent>
                                <MudTh>Folio fiscal</MudTh>
                                <MudTh>Serie-folio</MudTh>
                                <MudTh>Moneda</MudTh>
                                <MudTh>Parcialidad</MudTh>
                                <MudTh>Saldo anterior</MudTh>
                                <MudTh>Importe pagado</MudTh>
                                <MudTh>Saldo insoluto</MudTh>
                                <MudTh>Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="renglon">
                                    <MudTd DataLabel="Folio fiscal" Class="cifra-tabular pago-uuid">@renglon.IdDocumento</MudTd>
                                    <MudTd DataLabel="Serie-folio" Class="cifra-tabular">@renglon.Serie-@renglon.Folio</MudTd>
                                    <MudTd DataLabel="Moneda">@renglon.Moneda</MudTd>
                                    <MudTd DataLabel="Parcialidad" Class="cifra-tabular">@renglon.NumParcialidad</MudTd>
                                    <MudTd DataLabel="Saldo anterior" Class="cifra-tabular">@renglon.SaldoAnterior.ToString("N2")</MudTd>
                                    <MudTd DataLabel="Importe pagado" Class="cifra-tabular pago-abono">
                                        @if (EsEditable)
                                        {
                                            <MudNumericField T="decimal" Value="renglon.ImpPagado"
                                                ValueChanged="@(v => CambiarImporte(renglon, v))" Immediate="true"
                                                Label="@($"Abono {renglon.Serie}-{renglon.Folio}")" Format="F2"
                                                Min="0" Max="renglon.SaldoAnterior" Class="cifra-tabular" />
                                        }
                                        else
                                        {
                                            @renglon.ImpPagado.ToString("N2")
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Saldo insoluto" Class="cifra-tabular">@((renglon.SaldoAnterior - renglon.ImpPagado).ToString("N2"))</MudTd>
                                    <MudTd DataLabel="Acciones">
                                        @if (EsEditable)
                                        {
                                            <MudButton Size="Size.Small" Color="Color.Error"
                                                       OnClick="@(() => _renglones.Remove(renglon))">
                                                Quitar
                                            </MudButton>
                                        }
                                    </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </section>
        </MudTabPanel>

        <MudTabPanel Text="Bancos">
            <section class="seccion-formulario">
                <h2 class="seccion-titulo">Banco ordenante</h2>
                <p class="seccion-ayuda">Datos opcionales; no son necesarios para transferencias, incluido SPEI.</p>

                <div class="rejilla-formulario">
                    <MudTextField T="string" Label="R.F.C. del banco ordenante" @bind-Value="_rfcOrdenante"
                                  Disabled="@(!EsEditable)" Class="cifra-tabular" Immediate="true" />
                    <MudTextField T="string" Label="Banco extranjero" @bind-Value="_bancoOrdenanteExtranjero"
                                  Disabled="@(!EsEditable)" Immediate="true"
                                  HelperText="Solo si el ordenante no tiene R.F.C. mexicano." />
                    <MudTextField T="string" Label="Cuenta ordenante" @bind-Value="_ctaOrdenante"
                                  Disabled="@(!EsEditable)" Class="cifra-tabular" Immediate="true" />
                </div>

            </section>
            <section class="seccion-formulario">
                <h2 class="seccion-titulo">Banco beneficiario</h2>

                <div class="rejilla-formulario">
                    <MudTextField T="string" Label="R.F.C. del banco beneficiario" @bind-Value="_rfcBeneficiario"
                                  Disabled="@(!EsEditable)" Class="cifra-tabular" Immediate="true" />
                    <MudTextField T="string" Label="Cuenta beneficiaria" @bind-Value="_ctaBeneficiario"
                                  Disabled="@(!EsEditable)" Class="cifra-tabular" Immediate="true" />
                </div>
            </section>
        </MudTabPanel>
    </MudTabs>

    <section class="pago-resumen @(CuadraElPago ? "" : "pago-resumen-diferencia")" aria-labelledby="pago-resumen-titulo">
        <h2 id="pago-resumen-titulo" class="seccion-titulo">Resumen del pago</h2>
        <dl class="pago-resumen-importes">
            <div><dt>Importe recibido (@_moneda)</dt><dd class="cifra-tabular">@_monto.ToString("N2")</dd></div>
            <div><dt>Repartido entre facturas</dt><dd class="cifra-tabular">@Repartido.ToString("N2")</dd></div>
            <div><dt>Diferencia</dt><dd class="cifra-tabular">@((_monto - Repartido).ToString("N2"))</dd></div>
        </dl>
        <p class="seccion-ayuda" role="status">
            @if (!CuadraElPago)
            {
                <text>El importe recibido y la suma de los abonos deben coincidir.</text>
            }
            else if (_renglones.Count == 0)
            {
                <text>Agrega las facturas que cubre este pago.</text>
            }
            else
            {
                <text>El importe coincide con los abonos capturados.</text>
            }
        </p>
    </section>

    @if (EsEditable)
    {
        <div class="tarjeta-formulario-acciones">
            <MudButton OnClick="@(() => Navegacion.NavigateTo("/documentos"))">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar" Disabled="@_trabajando">Guardar borrador</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="VistaPrevia" Disabled="@_trabajando">Vista previa PDF</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Timbrar"
                       Disabled="@(_trabajando || !PuedeTimbrar)">
                Timbrar pago
            </MudButton>
        </div>
    }
}
</TarjetaFormulario>

<ActualizadorDeCatalogos AlCambiar="@(() => { })" />

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private PagoDto? _pago;
    private bool _cargando = true;
    private DetalleProblema? _error;
    private string? _aviso;
    private bool _trabajando;
    private EstadoDeIntegracionFiscalDto? _integracionFiscal;

    private ClienteEnListaDto? _cliente;
    private Guid? _clienteId;

    private DateTime _fechaPagoUtc = DateTime.UtcNow;
    private DateTime? _fechaPagoLocal;
    private TimeSpan? _horaPagoLocal;
    private string _formaDePago = "03";
    private string _moneda = "MXN";
    private decimal? _tipoCambio;
    private decimal _monto;
    private string? _numOperacion;

    private string? _rfcOrdenante;
    private string? _bancoOrdenanteExtranjero;
    private string? _ctaOrdenante;
    private string? _rfcBeneficiario;
    private string? _ctaBeneficiario;

    private string _serieBusqueda = string.Empty;
    private int _folioBusqueda;
    private DocumentoPorPagarDto? _encontrado;
    private decimal _importeAPagar;

    private readonly List<Renglon> _renglones = [];

    private sealed record Renglon(
        Guid IdDocumento, string? Serie, string? Folio, string Moneda,
        int NumParcialidad, decimal SaldoAnterior, decimal ImpPagado);

    private Guid? _borradorSinGuardar;
    private IDisposable? _registroDeSalida;

    private bool EsNuevo => Id is null;

    private bool EsEditable => _pago?.Estatus is "borrador" or "error";

    private bool PuedeTimbrar => _integracionFiscal?.TimbradoDisponible == true;

    private decimal Repartido => _renglones.Sum(r => r.ImpPagado);

    private bool CuadraElPago => Math.Round(Repartido, 2) == Math.Round(_monto, 2);

    private string FolioMostrado => _pago?.Folio is { } folio
        ? $"{_pago.Serie}-{folio}"
        : "Se asigna al timbrar";

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _pago = null;
        _error = null;
        _borradorSinGuardar = null;
        try { await CargarPagoAsync(); }
        catch (HttpRequestException)
        {
            _error = new DetalleProblema("about:blank", "No se pudo abrir el pago", 0,
                "Vuelve al listado e inténtalo de nuevo.", null, "", null);
        }
        finally { _cargando = false; }
    }

    private async Task CargarPagoAsync()
    {
        _integracionFiscal = await Emision.ObtenerEstadoDeIntegracionAsync();

        _pago = Id is { } id
            ? await Pagos.ObtenerAsync(id)
            : await Pagos.CrearBorradorAsync();

        if (_pago is null) return;

        if (EsNuevo && _pago is { } creado)
        {
            // Todavía no se marca _borradorSinGuardar aquí: el handler de salida se registra
            // en OnAfterRender, y si se marcara antes de este NavigateTo, la redirección
            // interna dispararía el borrado del borrador que se acaba de crear.
            Navegacion.NavigateTo($"/pagos/{creado.Id}", replace: true);
            return;
        }

        Rehidratar(_pago);
        _cliente = null;
        if (_clienteId is { } clienteId && await Clientes.ObtenerAsync(clienteId) is { } cliente)
            _cliente = new ClienteEnListaDto(cliente.Id, cliente.ClaveInterna, cliente.Rfc,
                cliente.Nombre, cliente.RegimenFiscal, cliente.DomicilioFiscalCp, cliente.CorreoPrincipal, cliente.Activo);

        _borradorSinGuardar = _pago is { Estatus: "borrador" } && _pago.ClienteId is null && _pago.Documentos.Count == 0
            ? _pago.Id
            : null;
    }

    private void Rehidratar(PagoDto pago)
    {
        _clienteId = pago.ClienteId;
        _fechaPagoUtc = pago.FechaPagoUtc;
        _fechaPagoLocal = pago.FechaPagoLocal?.Date;
        _horaPagoLocal = pago.FechaPagoLocal?.TimeOfDay;
        _formaDePago = pago.FormaDePagoP ?? "03";
        _moneda = pago.MonedaP;
        _tipoCambio = pago.TipoCambioP;
        _monto = pago.Monto;
        _numOperacion = pago.NumOperacion;
        _rfcOrdenante = pago.RfcEmisorCtaOrd;
        _bancoOrdenanteExtranjero = pago.NomBancoOrdExt;
        _ctaOrdenante = pago.CtaOrdenante;
        _rfcBeneficiario = pago.RfcEmisorCtaBen;
        _ctaBeneficiario = pago.CtaBeneficiario;

        _renglones.Clear();
        _renglones.AddRange(pago.Documentos.Select(d => new Renglon(
            d.IdDocumento, d.Serie, d.Folio, d.MonedaDR, d.NumParcialidad, d.ImpSaldoAnt, d.ImpPagado)));
    }

    private void AlElegirCliente(ClienteEnListaDto? cliente)
    {
        if (_clienteId != cliente?.Id)
        {
            _renglones.Clear();
            _encontrado = null;
            _monto = 0;
            _aviso = "Al cambiar de cliente se retiran las facturas del pago.";
        }
        _cliente = cliente;
        _clienteId = cliente?.Id;
    }

    private void CambiarImporte(Renglon renglon, decimal importe)
    {
        var indice = _renglones.IndexOf(renglon);
        if (indice >= 0) _renglones[indice] = renglon with { ImpPagado = importe };
    }

    private async Task Consultar()
    {
        _error = null;
        _aviso = null;
        _encontrado = null;

        if (string.IsNullOrWhiteSpace(_serieBusqueda) || _folioBusqueda <= 0)
        {
            _aviso = "Escribe la serie y el folio de la factura que se está pagando.";
            return;
        }

        var (encontrado, error) = await Pagos.ConsultarSaldoAsync(_serieBusqueda.Trim(), _folioBusqueda);

        _error = error;
        _encontrado = encontrado;

        // Se propone saldar la factura completa, que es lo más común; el usuario lo baja si
        // el abono es parcial.
        if (encontrado is not null) _importeAPagar = encontrado.SaldoPendiente;
    }

    private void Agregar()
    {
        if (_encontrado is not { } encontrado) return;

        if (_renglones.Any(r => r.IdDocumento == encontrado.IdDocumento))
        {
            _aviso = "Esa factura ya está en la lista.";
            return;
        }

        if (_importeAPagar <= 0 || _importeAPagar > encontrado.SaldoPendiente)
        {
            _aviso = $"El importe tiene que estar entre 0 y {encontrado.SaldoPendiente:N2}.";
            return;
        }

        _renglones.Add(new Renglon(
            encontrado.IdDocumento, encontrado.Serie, encontrado.Folio, encontrado.Moneda,
            encontrado.NumParcialidad, encontrado.SaldoPendiente, _importeAPagar));

        // Cuando es el primer renglón, el importe del pago casi siempre es ese: se propone
        // para ahorrar teclear, y queda editable.
        if (_renglones.Count == 1 && _monto == 0) _monto = _importeAPagar;

        _encontrado = null;
        _importeAPagar = 0;
        _aviso = null;
    }

    private async Task<bool> GuardarInternoAsync()
    {
        if (_pago is not { } pago) return false;

        if (_fechaPagoLocal is null || _horaPagoLocal is null)
        {
            _aviso = "Indica la fecha y hora del pago en el huso de la empresa.";
            return false;
        }

        if (_clienteId is not { } clienteId)
        {
            _aviso = "Elige el cliente al que corresponde el pago.";
            return false;
        }

        var peticion = new PeticionGuardarPago(
            clienteId,
            _fechaPagoUtc,
            _formaDePago,
            _moneda,
            _tipoCambio,
            _monto,
            _numOperacion,
            _rfcOrdenante,
            _bancoOrdenanteExtranjero,
            _ctaOrdenante,
            _rfcBeneficiario,
            _ctaBeneficiario,
            [.. _renglones.Select(r => new RenglonDePagoDto(r.IdDocumento, r.ImpPagado))])
        {
            FechaPagoLocal = DateTime.SpecifyKind(_fechaPagoLocal.Value.Date.Add(_horaPagoLocal.Value), DateTimeKind.Unspecified)
        };

        var (guardado, error) = await Pagos.GuardarAsync(pago.Id, peticion);

        _error = error;

        if (guardado is null) return false;

        _pago = guardado;
        Rehidratar(guardado);
        _borradorSinGuardar = null;

        return true;
    }

    private async Task VistaPrevia()
    {
        if (_trabajando || _pago is null) return;
        _trabajando = true;
        _error = null;
        _aviso = null;
        try
        {
            if (!await GuardarInternoAsync()) return;
            var (archivo, error) = await Emision.ObtenerVistaPreviaPdfAsync(_pago.Id);
            _error = error;
            if (archivo is null) return;
            await Dialogos.ShowAsync<DialogoDeComprobanteDeCompra>("Vista previa de pago",
                new DialogParameters<DialogoDeComprobanteDeCompra>
                {
                    { x => x.Archivo, archivo },
                    { x => x.TituloVistaPrevia, "Complemento de pagos - borrador" },
                    { x => x.AvisoFiscal, "Borrador sin validez fiscal. No contiene certificación del SAT ni consume timbres." }
                }, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
        }
        finally { _trabajando = false; }
    }

    private async Task Guardar()
    {
        if (_trabajando) return;
        _trabajando = true;
        _aviso = null;

        try
        {
            if (await GuardarInternoAsync()) _aviso = "Borrador guardado.";
        }
        finally
        {
            _trabajando = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _registroDeSalida = Navegacion.RegisterLocationChangingHandler(AlSalirAsync);
    }

    private async ValueTask AlSalirAsync(LocationChangingContext contexto)
    {
        if (_borradorSinGuardar is not { } id) return;
        _borradorSinGuardar = null;

        try { await Pagos.EliminarBorradorAsync(id); }
        catch { /* el barrido lo recoge después */ }
    }

    public void Dispose() => _registroDeSalida?.Dispose();

    private async Task Timbrar()
    {
        if (!PuedeTimbrar) return;

        _trabajando = true;
        _aviso = null;

        try
        {
            if (!await GuardarInternoAsync()) return;

            // Clave nueva por intento real del usuario, igual que en la emisión: es lo que
            // impide que un doble clic gaste dos timbres.
            var (timbrado, error) = await Emision.TimbrarAsync(_pago!.Id, Guid.NewGuid().ToString("N"));

            _error = error;

            if (timbrado is not null)
            {
                _aviso = $"Pago timbrado. Folio fiscal {timbrado.Uuid}.";
                _pago = await Pagos.ObtenerAsync(_pago.Id) ?? _pago;
            }
        }
        finally
        {
            _trabajando = false;
        }
    }
}
