@page "/pagos/nuevo"
@page "/pagos/{Id:guid}"
@attribute [Authorize(Policy = Permisos.Politicas.EditarPagos)]
@using Facturacion.Client.Servicios.Documentos
@using Facturacion.Client.Servicios.Plataforma
@using Facturacion.Shared.Comun
@using Facturacion.Shared.Contratos
@using Facturacion.Shared.Documentos
@using Facturacion.Shared.Plataforma
@inject ServicioDePagos Pagos
@inject ServicioDeEmision Emision
@inject ServicioDeCatalogos Catalogos
@inject ServicioDeEmpresa Empresa
@inject ServicioDeClientes Clientes
@inject IDialogService Dialogos
@inject IServicioDeConfirmacion Confirmacion
@inject NavigationManager Navegacion
@implements IDisposable

<PageTitle>@(EsNuevo ? "Nuevo pago" : "Pago")</PageTitle>
<TituloDePagina Texto="@(EsNuevo ? "Nuevo pago" : "Pago")" />
<NavigationLock ConfirmExternalNavigation="@TieneCambiosSinGuardar" />

<TarjetaFormulario Ancha="true" RutaVolver="/documentos" Class="pago-formulario">
<PanelErrores Problema="_error" />

@if (_aviso is not null)
{
    <div class="aviso-documentos" role="status">@_aviso</div>
}

@if (_cargando)
{
    <p class="tabla-datos-estado">Cargando…</p>
}
else if (_pago is null)
{
    @if (_error is null)
    {
        <p class="tabla-datos-estado">No se encontró ese pago. Vuelve al listado de documentos.</p>
    }
}
else
{
    <MudTabs Elevation="0" ApplyEffectsToContainer="true" Class="pestanas-pago">
        <MudTabPanel Text="General">
            <details class="seccion-formulario pago-sustitucion" open="@(!string.IsNullOrWhiteSpace(_uuidSustituido))">
                <summary>Sustitución de un pago <span class="seccion-ayuda">Opcional</span></summary>
                <div class="rejilla-formulario">
                    <MudTextField T="string" Label="Folio fiscal del pago anterior" @bind-Value="_uuidSustituido"
                                  Disabled="@(!EsEditable || _trabajando)" Immediate="true" Class="cifra-tabular"
                                  HelperText="Opcional. Relación 04: sustituye el último pago de las mismas facturas." />
                    @if (EsEditable)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CargarAnterior"
                                   Disabled="@(_trabajando || string.IsNullOrWhiteSpace(_uuidSustituido))">Cargar pago anterior</MudButton>
                    }
                </div>
            </details>
            <section class="seccion-formulario">
                <h2 class="seccion-titulo">Datos del pago</h2>

                <div class="rejilla-formulario">
                    <MudTextField T="string" Label="Folio" Value="@FolioMostrado" ReadOnly="true"
                                  Class="cifra-tabular" />

                    <MudTextField T="string" Label="No. de operación" @bind-Value="_numOperacion"
                                  Disabled="@(!EsEditable)" Immediate="true"
                                  HelperText="Referencia de la transferencia, cheque o autorización." />

                    <MudTextField T="string" Label="Huso horario de la empresa"
                                  Value="@_pago.ZonaHoraria" ReadOnly="true" />
                    <MudDatePicker Label="Fecha del pago" @bind-Date="_fechaPagoLocal"
                                   Disabled="@(!EsEditable)" Required="true" />
                    <MudTimePicker Label="Hora del pago" @bind-Time="_horaPagoLocal"
                                   Disabled="@(!EsEditable)" Required="true" AmPm="false" />

                    <BuscadorCatalogo Catalogo="c_FormaPago" Label="Forma de pago" Clave="@_formaDePago" ClaveChanged="CambiarFormaDePago"
                                     Opciones="@Catalogos.Obtener("c_FormaPago").Where(x => x.Clave != "99").ToArray()"
                                     Deshabilitado="@(!EsEditable)" Requerido="true" PuedeLimpiar="false" />

                    <MudSelect T="string" Label="Moneda" Value="@_moneda" ValueChanged="CambiarMoneda" Disabled="@(!EsEditable)">
                        @foreach (var moneda in _monedasDeCaptura)
                        {
                            <MudSelectItem T="string" Value="@moneda.Clave">@moneda.Clave — @moneda.Descripcion</MudSelectItem>
                        }
                        @if (_monedasDeCaptura.All(m => m.Clave != _moneda))
                        {
                            <MudSelectItem T="string" Value="@_moneda" Disabled="true">@_moneda — Moneda guardada</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField T="decimal?" Label="Tipo de cambio" @bind-Value="_tipoCambio"
                                     Immediate="true"
                                     Disabled="@(!EsEditable || _moneda == "MXN")"
                                     HelperText="@(_moneda == "MXN" ? "No aplica en pesos." : "Obligatorio fuera de MXN.")"
                                     Format="F6" Class="cifra-tabular" />

                    <MudNumericField T="decimal" Label="Importe del pago" Value="_monto" ValueChanged="CambiarMonto"
                                     Immediate="true"
                                     Disabled="@(!EsEditable)" Format="@($"F{DecimalesPago}")" Class="cifra-tabular"
                                     HelperText="Debe coincidir con los abonos convertidos a esta moneda." />
                </div>
            </section>

            <section class="seccion-formulario">
                <h2 class="seccion-titulo">Cliente</h2>

                <div class="rejilla-formulario">
                    @if (EsEditable)
                    {
                        <BuscadorDeCliente Valor="_cliente" ValorCambiado="AlElegirCliente" Requerido="true" />
                    }

                    <MudTextField T="string" Label="R.F.C." Value="@(_cliente?.Rfc ?? _pago.ReceptorRfc)" ReadOnly="true"
                                  Class="cifra-tabular" />
                    <MudTextField T="string" Label="Nombre" Value="@(_cliente?.Nombre ?? _pago.ReceptorNombre)" ReadOnly="true" />
                </div>
            </section>

            <section class="seccion-formulario">
                <h2 class="seccion-titulo">Facturas que se pagan</h2>
                <p class="seccion-ayuda">
                    Busca facturas timbradas PPD con saldo. El abono se propone con el saldo completo y se ajusta en la tabla.
                </p>

                @if (EsEditable)
                {
                    <div class="rejilla-consulta-pago">
                        <MudAutocomplete @key="_versionBuscador" T="FacturaPendienteDto" Label="Serie"
                                         ValueChanged="ElegirPendiente" TextChanged="@((string t) => _serieBusqueda = t ?? string.Empty)"
                                         SearchFunc="BuscarPendientes" ToStringFunc="@(p => p?.Serie ?? string.Empty)"
                                         MinCharacters="0" OpenOnFocus="true" DebounceInterval="300"
                                         CoerceText="false" CoerceValue="false" Strict="false" ResetValueOnEmptyText="true"
                                         Placeholder="Escribe la serie o elige una factura" Class="cifra-tabular">
                            <ItemTemplate Context="pendiente">
                                <span class="cifra-tabular">@pendiente.Serie-@pendiente.Folio</span>
                                <span class="buscador-catalogo-descripcion">
                                    saldo <span class="cifra-tabular">@pendiente.SaldoPendiente.ToString($"N{pendiente.DecimalesMoneda}")</span> @pendiente.Moneda
                                </span>
                            </ItemTemplate>
                            <NoItemsTemplate>
                                <span class="seccion-ayuda">@(_clienteId is null ? "No hay facturas PPD con saldo." : "Este cliente no tiene facturas PPD con saldo.")</span>
                            </NoItemsTemplate>
                        </MudAutocomplete>
                        <MudNumericField T="int" Label="Folio" @bind-Value="_folioBusqueda" Class="cifra-tabular" Immediate="true" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AgregarFactura" Disabled="@_trabajando">
                            Agregar factura
                        </MudButton>
                    </div>
                }

                @if (_renglones.Count == 0)
                {
                    <p class="tabla-datos-estado">Todavía no se agregó ninguna factura.</p>
                }
                else
                {
                    <MudTable T="Renglon" Items="_renglones" Dense="true" Striped="true" Elevation="0"
                              Breakpoint="Breakpoint.Sm" Class="pago-facturas">
                        <HeaderContent>
                                <MudTh>Folio fiscal</MudTh>
                                <MudTh>Serie-folio</MudTh>
                                <MudTh>Moneda</MudTh>
                                <MudTh>Equivalencia</MudTh>
                                <MudTh>Parcialidad</MudTh>
                                <MudTh>Saldo anterior</MudTh>
                                <MudTh>Importe pagado</MudTh>
                                <MudTh>Saldo insoluto</MudTh>
                                <MudTh>Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="renglon">
                                    <MudTd DataLabel="Folio fiscal" Class="cifra-tabular pago-uuid">@renglon.IdDocumento</MudTd>
                                    <MudTd DataLabel="Serie-folio" Class="cifra-tabular">@renglon.Serie-@renglon.Folio</MudTd>
                                    <MudTd DataLabel="Moneda">@renglon.Moneda</MudTd>
                                    <MudTd DataLabel="Equivalencia">
                                        @if (EsEditable && renglon.Moneda != _moneda)
                                        {
                                            <MudNumericField T="decimal?" Value="renglon.EquivalenciaDR" ValueChanged="@((decimal? v) => CambiarEquivalencia(renglon, v))"
                                                Label="@($"{renglon.Moneda} por 1 {_moneda}")" Immediate="true" Format="0.##########" Min="0.0000000001m" Required="true" />
                                        }
                                        else { <span class="cifra-tabular">@renglon.EquivalenciaDR</span> }
                                    </MudTd>
                                    <MudTd DataLabel="Parcialidad" Class="cifra-tabular">@renglon.NumParcialidad</MudTd>
                                    <MudTd DataLabel="Saldo anterior" Class="cifra-tabular">@renglon.SaldoAnterior.ToString($"N{renglon.DecimalesMoneda}")</MudTd>
                                    <MudTd DataLabel="Importe pagado" Class="cifra-tabular pago-abono">
                                        @if (EsEditable)
                                        {
                                            <MudNumericField T="decimal" Value="renglon.ImpPagado"
                                                ValueChanged="@((decimal v) => CambiarImporte(renglon, v))" Immediate="true"
                                                Label="@($"Abono {renglon.Serie}-{renglon.Folio}")" Format="@($"F{renglon.DecimalesMoneda}")"
                                                Min="0" Max="renglon.SaldoAnterior" Class="cifra-tabular" />
                                        }
                                        else
                                        {
                                            @renglon.ImpPagado.ToString($"N{renglon.DecimalesMoneda}")
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Saldo insoluto" Class="cifra-tabular">@((renglon.SaldoAnterior - renglon.ImpPagado).ToString($"N{renglon.DecimalesMoneda}"))</MudTd>
                                    <MudTd DataLabel="Acciones">
                                        @if (EsEditable)
                                        {
                                            <MudButton Size="Size.Small" Color="Color.Error"
                                                       OnClick="@(() => Quitar(renglon))">
                                                Quitar
                                            </MudButton>
                                        }
                                    </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </section>
        </MudTabPanel>

        <MudTabPanel Text="Bancos">
            <section class="seccion-formulario">
                <h2 class="seccion-titulo">Banco ordenante</h2>
                <p class="seccion-ayuda">Datos opcionales; no son necesarios para transferencias, incluido SPEI.</p>

                <div class="rejilla-formulario">
                    <MudTextField T="string" Label="R.F.C. del banco ordenante" @bind-Value="_rfcOrdenante"
                                  Disabled="@(!EsEditable)" Class="cifra-tabular" Immediate="true" />
                    <MudTextField T="string" Label="Banco extranjero" @bind-Value="_bancoOrdenanteExtranjero"
                                  Disabled="@(!EsEditable)" Immediate="true"
                                  HelperText="Solo si el ordenante no tiene R.F.C. mexicano." />
                    <MudTextField T="string" Label="Cuenta ordenante" @bind-Value="_ctaOrdenante"
                                  Disabled="@(!EsEditable)" Class="cifra-tabular" Immediate="true" />
                </div>

            </section>
            <section class="seccion-formulario">
                <h2 class="seccion-titulo">Banco beneficiario</h2>

                <div class="rejilla-formulario">
                    <MudTextField T="string" Label="R.F.C. del banco beneficiario" @bind-Value="_rfcBeneficiario"
                                  Disabled="@(!EsEditable)" Class="cifra-tabular" Immediate="true" />
                    <MudTextField T="string" Label="Cuenta beneficiaria" @bind-Value="_ctaBeneficiario"
                                  Disabled="@(!EsEditable)" Class="cifra-tabular" Immediate="true" />
                </div>
            </section>
            <section class="seccion-formulario">
                <h2 class="seccion-titulo">Comprobante bancario SPEI</h2>
                <MudCheckBox T="bool" Value="_incluirSpei" ValueChanged="CambiarIncluirSpei"
                             Label="Incluir datos SPEI" Color="Color.Primary" Disabled="@(!EsEditable || _formaDePago != "03")" />
                @if (_incluirSpei)
                {
                    <p class="seccion-ayuda">Copia los datos bancarios, no los del CSD de la empresa.</p>
                    <div class="rejilla-formulario">
                        <MudTextField T="string" Label="Tipo de cadena" Value="@("01 — SPEI")" ReadOnly="true" />
                        <MudTextField T="string" Label="Certificado del pago (Base64)" @bind-Value="_certPago"
                                      Lines="3" MaxLength="16384" Required="true" Immediate="true" Disabled="@(!EsEditable)" />
                        <MudTextField T="string" Label="Cadena original del pago" @bind-Value="_cadPago"
                                      Lines="3" MaxLength="8192" Required="true" Immediate="true" Disabled="@(!EsEditable)" />
                        <MudTextField T="string" Label="Sello del pago (Base64)" @bind-Value="_selloPago"
                                      Lines="3" MaxLength="4096" Required="true" Immediate="true" Disabled="@(!EsEditable)" />
                    </div>
                }
            </section>
        </MudTabPanel>
    </MudTabs>

    <section class="pago-resumen @(CuadraElPago ? "" : "pago-resumen-diferencia")" aria-labelledby="pago-resumen-titulo">
        <h2 id="pago-resumen-titulo" class="seccion-titulo">Resumen del pago</h2>
        <dl class="pago-resumen-importes">
            <div><dt>Importe recibido (@_moneda)</dt><dd class="cifra-tabular">@_monto.ToString($"N{DecimalesPago}")</dd></div>
            <div><dt>Repartido (@_moneda)</dt><dd class="cifra-tabular">@Repartido.ToString($"N{DecimalesPago}")</dd></div>
            <div><dt>Diferencia</dt><dd class="cifra-tabular">@((CuadraElPago ? 0m : _monto - Repartido).ToString($"N{DecimalesPago}"))</dd></div>
        </dl>
        <p class="seccion-ayuda" role="status">
            @if (!CuadraElPago)
            {
                <text>El importe recibido y la suma de los abonos deben coincidir.</text>
            }
            else if (_renglones.Count == 0)
            {
                <text>Agrega las facturas que cubre este pago.</text>
            }
            else
            {
                <text>El importe coincide con los abonos capturados.</text>
            }
        </p>
    </section>

    @if (EsEditable)
    {
        <div class="tarjeta-formulario-acciones">
            <MudButton Variant="Variant.Outlined" OnClick="Guardar" Disabled="@_trabajando">Guardar borrador</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="VistaPrevia" Disabled="@_trabajando">Vista previa PDF</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Timbrar"
                       Disabled="@(_trabajando || !PuedeTimbrar)">
                Timbrar pago
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="@(() => Navegacion.NavigateTo("/documentos"))">Volver a documentos</MudButton>
        </div>
    }
}
</TarjetaFormulario>

<ActualizadorDeCatalogos AlCambiar="@(() => { })" />

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private PagoDto? _pago;
    private bool _cargando = true;
    private DetalleProblema? _error;
    private string? _aviso;
    private bool _trabajando;
    private EstadoDeIntegracionFiscalDto? _integracionFiscal;

    private ClienteEnListaDto? _cliente;
    private Guid? _clienteId;

    private DateTime _fechaPagoUtc = DateTime.UtcNow;
    private DateTime? _fechaPagoLocal;
    private TimeSpan? _horaPagoLocal;
    private string _formaDePago = string.Empty;
    private string _moneda = "MXN";
    private IReadOnlyList<ClaveSatDto> _monedasDeCaptura = [];
    private decimal? _tipoCambio;
    private decimal _monto;
    private string? _numOperacion;

    private string? _rfcOrdenante;
    private string? _bancoOrdenanteExtranjero;
    private string? _ctaOrdenante;
    private string? _rfcBeneficiario;
    private string? _ctaBeneficiario;
    private string? _uuidSustituido;
    private bool _incluirSpei;
    private string? _certPago;
    private string? _cadPago;
    private string? _selloPago;

    private string _serieBusqueda = string.Empty;
    private int _folioBusqueda;
    private int _versionBuscador;

    private readonly List<Renglon> _renglones = [];

    // Clase y no record: reemplazar el renglón por una copia hacía perder el foco a media captura.
    private sealed class Renglon
    {
        public required Guid IdDocumento { get; init; }
        public string? Serie { get; init; }
        public string? Folio { get; init; }
        public required string Moneda { get; init; }
        public int NumParcialidad { get; init; }
        public decimal SaldoAnterior { get; init; }
        public decimal ImpPagado { get; set; }
        public decimal? EquivalenciaDR { get; set; } = 1m;
        public int DecimalesMoneda { get; init; } = 2;
    }

    private Guid? _borradorSinGuardar;
    private IDisposable? _registroDeSalida;
    private string? _capturaGuardada;

    private bool TieneCambiosSinGuardar => !_cargando && EsEditable && _capturaGuardada is not null
        && _capturaGuardada != CapturaActual();

    private string CapturaActual() => System.Text.Json.JsonSerializer.Serialize(new
    {
        _clienteId, _fechaPagoLocal, _horaPagoLocal, _formaDePago, _moneda, _tipoCambio, _monto,
        NumOperacion = _numOperacion ?? string.Empty, RfcOrdenante = _rfcOrdenante ?? string.Empty,
        BancoOrdenante = _bancoOrdenanteExtranjero ?? string.Empty, CuentaOrdenante = _ctaOrdenante ?? string.Empty,
        RfcBeneficiario = _rfcBeneficiario ?? string.Empty, CuentaBeneficiario = _ctaBeneficiario ?? string.Empty,
        UuidSustituido = _uuidSustituido ?? string.Empty, _incluirSpei,
        Certificado = _certPago ?? string.Empty, Cadena = _cadPago ?? string.Empty, Sello = _selloPago ?? string.Empty,
        Renglones = _renglones
    });

    private bool EsNuevo => Id is null;

    private bool EsEditable => _pago?.Estatus is "borrador" or "error";

    private bool PuedeTimbrar => _integracionFiscal?.TimbradoDisponible == true;

    private int DecimalesPago => _pago?.DecimalesPorMoneda.GetValueOrDefault(_moneda, 2) ?? 2;
    private decimal Repartido => _renglones.Sum(r => r.EquivalenciaDR is > 0 ? r.ImpPagado / r.EquivalenciaDR.Value : 0);

    private bool CuadraElPago => _renglones.All(r => ConversionDePago.EsEquivalenciaValida(r.Moneda, _moneda, r.EquivalenciaDR)) &&
        ConversionDePago.Cuadra(_monto, DecimalesPago, _renglones.Select(r => (r.ImpPagado, r.EquivalenciaDR ?? 1m, r.DecimalesMoneda, r.Moneda == _moneda)));

    private string FolioMostrado => _pago?.Folio is { } folio
        ? $"{_pago.Serie}-{folio}"
        : "Se asigna al timbrar";

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _pago = null;
        _error = null;
        _borradorSinGuardar = null;
        _capturaGuardada = null;
        try
        {
            _monedasDeCaptura = Catalogos.ObtenerMonedasDeCaptura((await Empresa.ObtenerMonedasAsync())?.Monedas ?? []);
            await CargarPagoAsync();
        }
        catch (HttpRequestException)
        {
            _error = new DetalleProblema("about:blank", "No se pudo abrir el pago", 0,
                "Vuelve al listado e inténtalo de nuevo.", null, "", null);
        }
        finally { _cargando = false; }
    }

    private async Task CargarPagoAsync()
    {
        _integracionFiscal = await Emision.ObtenerEstadoDeIntegracionAsync();

        _pago = Id is { } id
            ? await Pagos.ObtenerAsync(id)
            : await Pagos.CrearBorradorAsync();

        if (_pago is null) return;

        if (EsNuevo && _pago is { } creado)
        {
            /// No se marca _borradorSinGuardar todavía: el manejador de salida se registra en
            /// OnAfterRender, y esta redirección interna borraría el borrador recién creado.
            /// Se marca después de navegar.
            Navegacion.NavigateTo($"/pagos/{creado.Id}", replace: true);
            return;
        }

        Rehidratar(_pago);
        _cliente = null;
        if (_clienteId is { } clienteId && await Clientes.ObtenerAsync(clienteId) is { } cliente)
            _cliente = new ClienteEnListaDto(cliente.Id, cliente.ClaveInterna, cliente.Rfc,
                cliente.Nombre, cliente.RegimenFiscal, cliente.DomicilioFiscalCp, cliente.CorreoPrincipal, cliente.Activo);

        _borradorSinGuardar = _pago is { Estatus: "borrador" } && _pago.ClienteId is null && _pago.Documentos.Count == 0
            ? _pago.Id
            : null;
    }

    private void Rehidratar(PagoDto pago)
    {
        _clienteId = pago.ClienteId;
        _fechaPagoUtc = pago.FechaPagoUtc;
        _fechaPagoLocal = pago.FechaPagoLocal?.Date;
        _horaPagoLocal = pago.FechaPagoLocal?.TimeOfDay;
        _formaDePago = pago.FormaDePagoP ?? string.Empty;
        _moneda = pago.MonedaP;
        _tipoCambio = pago.TipoCambioP;
        _monto = pago.Monto;
        _numOperacion = pago.NumOperacion;
        _rfcOrdenante = pago.RfcEmisorCtaOrd;
        _bancoOrdenanteExtranjero = pago.NomBancoOrdExt;
        _ctaOrdenante = pago.CtaOrdenante;
        _rfcBeneficiario = pago.RfcEmisorCtaBen;
        _ctaBeneficiario = pago.CtaBeneficiario;
        _uuidSustituido = pago.UuidSustituido?.ToString("D");
        _incluirSpei = pago.TipoCadPago is not null;
        _certPago = pago.CertPago;
        _cadPago = pago.CadPago;
        _selloPago = pago.SelloPago;

        _renglones.Clear();
        _renglones.AddRange(pago.Documentos.Select(d => new Renglon
        {
            IdDocumento = d.IdDocumento, Serie = d.Serie, Folio = d.Folio, Moneda = d.MonedaDR,
            NumParcialidad = d.NumParcialidad, SaldoAnterior = d.ImpSaldoAnt, ImpPagado = d.ImpPagado,
            EquivalenciaDR = d.EquivalenciaDR, DecimalesMoneda = d.DecimalesMonedaDR
        }));
        _capturaGuardada = CapturaActual();
    }

    private void AlElegirCliente(ClienteEnListaDto? cliente)
    {
        if (_clienteId != cliente?.Id)
        {
            _renglones.Clear();
            _monto = 0;
            _aviso = "Al cambiar de cliente se retiran las facturas del pago.";
        }
        _cliente = cliente;
        _clienteId = cliente?.Id;
    }

    private async Task CargarAnterior()
    {
        if (_trabajando || !EsEditable) return;
        _aviso = null; _error = null;
        if (!Guid.TryParse(_uuidSustituido, out var uuid) || uuid == Guid.Empty)
        {
            _aviso = "Escribe el folio fiscal del pago anterior.";
            return;
        }
        _trabajando = true;
        try
        {
            var (anterior, error) = await Pagos.ObtenerParaSustituirAsync(uuid);
            _error = error;
            if (anterior is null) return;
            Rehidratar(anterior);
            _cliente = null;
            if (_clienteId is { } clienteId && await Clientes.ObtenerAsync(clienteId) is { } cliente)
                _cliente = new ClienteEnListaDto(cliente.Id, cliente.ClaveInterna, cliente.Rfc, cliente.Nombre,
                    cliente.RegimenFiscal, cliente.DomicilioFiscalCp, cliente.CorreoPrincipal, cliente.Activo);
            _aviso = "Revisa los datos. Después de emitir el sustituto, cancela el anterior con motivo 01.";
        }
        finally { _trabajando = false; }
    }

    private void CambiarMoneda(string moneda)
    {
        if (moneda == _moneda) return;
        _moneda = moneda; _tipoCambio = null;
        foreach (var renglon in _renglones)
            renglon.EquivalenciaDR = renglon.Moneda == moneda ? 1m : null;
        SincronizarMonto();
    }

    private void CambiarFormaDePago(string forma)
    {
        _formaDePago = forma;
        if (forma != "03") CambiarIncluirSpei(false);
    }

    private void CambiarIncluirSpei(bool incluir)
    {
        _incluirSpei = incluir;
        if (!incluir) { _certPago = null; _cadPago = null; _selloPago = null; }
    }

    private void CambiarEquivalencia(Renglon renglon, decimal? valor)
    {
        renglon.EquivalenciaDR = valor;
        SincronizarMonto();
    }

    private void CambiarImporte(Renglon renglon, decimal importe)
    {
        renglon.ImpPagado = importe;
        SincronizarMonto();
    }

    private void Quitar(Renglon renglon)
    {
        _renglones.Remove(renglon);
        SincronizarMonto();
    }

    // El importe del pago es la suma de los abonos.
    private void SincronizarMonto()
    {
        if (_renglones.Count == 0 || _renglones.Any(r => r.EquivalenciaDR is not > 0)) return;
        _monto = Math.Round(Repartido, DecimalesPago, MidpointRounding.AwayFromZero);
    }

    // El último renglón absorbe la diferencia, sin bajar de cero ni pasar de su saldo.
    private void CambiarMonto(decimal monto)
    {
        _monto = monto;
        if (_renglones.Count == 0 || _renglones[^1] is not { EquivalenciaDR: > 0 } ultimo) return;
        var otros = _renglones.Take(_renglones.Count - 1)
            .Sum(r => r.EquivalenciaDR is > 0 ? r.ImpPagado / r.EquivalenciaDR.Value : 0);
        var abono = Math.Round((monto - otros) * ultimo.EquivalenciaDR!.Value, ultimo.DecimalesMoneda, MidpointRounding.AwayFromZero);
        ultimo.ImpPagado = Math.Clamp(abono, 0, ultimo.SaldoAnterior);
    }

    private async Task<IEnumerable<FacturaPendienteDto>> BuscarPendientes(string texto, CancellationToken ct)
        => await Pagos.BuscarPendientesAsync(_clienteId, texto, ct);

    private void ElegirPendiente(FacturaPendienteDto? pendiente)
    {
        if (pendiente is null) return;
        _serieBusqueda = pendiente.Serie ?? string.Empty;
        _folioBusqueda = pendiente.Folio;
    }

    private async Task AgregarFactura()
    {
        _error = null;
        _aviso = null;

        var serie = _serieBusqueda.Trim();
        var folio = _folioBusqueda;
        // «A-125» en la serie con el folio vacío quiere decir las dos cosas.
        if (folio <= 0 && serie.LastIndexOf('-') is > 0 and var guion && int.TryParse(serie[(guion + 1)..], out var escrito))
        {
            folio = escrito;
            serie = serie[..guion];
        }

        if (serie.Length == 0 || folio <= 0)
        {
            _aviso = "Escribe o elige la serie y el folio de la factura que se está pagando.";
            return;
        }

        _trabajando = true;
        try
        {
            var (encontrado, error) = await Pagos.ConsultarSaldoAsync(serie, folio);
            _error = error;
            if (encontrado is null) return;

            if (_renglones.Any(r => r.IdDocumento == encontrado.IdDocumento))
            {
                _aviso = "Esa factura ya está en la lista.";
                return;
            }

            _renglones.Add(new Renglon
            {
                IdDocumento = encontrado.IdDocumento, Serie = encontrado.Serie, Folio = encontrado.Folio,
                Moneda = encontrado.Moneda, NumParcialidad = encontrado.NumParcialidad,
                SaldoAnterior = encontrado.SaldoPendiente, ImpPagado = encontrado.SaldoPendiente,
                EquivalenciaDR = encontrado.Moneda == _moneda ? 1m : null, DecimalesMoneda = encontrado.DecimalesMoneda
            });
            SincronizarMonto();

            _serieBusqueda = string.Empty;
            _folioBusqueda = 0;
            _versionBuscador++;
        }
        finally { _trabajando = false; }
    }

    // Lo que el servidor exige para timbrar: antes de timbrar bloquea; al guardar solo avisa.
    private List<string> Faltantes()
    {
        var faltan = new List<string>();
        if (_clienteId is null) faltan.Add("el cliente");
        if (string.IsNullOrEmpty(_formaDePago)) faltan.Add("la forma de pago");
        if (_fechaPagoLocal is null || _horaPagoLocal is null) faltan.Add("la fecha y hora del pago");
        if (_moneda != "MXN" && _tipoCambio is null) faltan.Add("el tipo de cambio");
        if (_renglones.Count == 0) faltan.Add("al menos una factura");
        else if (_renglones.Any(r => r.ImpPagado <= 0)) faltan.Add("el abono de cada factura");
        if (_renglones.Any(r => r.EquivalenciaDR is not > 0)) faltan.Add("la equivalencia de cada factura en otra moneda");
        if (_monto <= 0) faltan.Add("el importe del pago");
        else if (_renglones.Count > 0 && !CuadraElPago) faltan.Add("que el importe coincida con los abonos");
        return faltan;
    }

    private string? Advertencia()
        => string.IsNullOrWhiteSpace(_numOperacion)
            ? "No capturaste el número de operación; revisa si el banco lo dio."
            : null;

    private static string Lista(List<string> elementos)
        => elementos.Count == 1 ? elementos[0] : string.Join(", ", elementos[..^1]) + " y " + elementos[^1];

    private async Task<bool> GuardarInternoAsync()
    {
        if (_pago is not { } pago) return false;

        if (_fechaPagoLocal is null || _horaPagoLocal is null)
        {
            _aviso = "Indica la fecha y hora del pago en el huso de la empresa.";
            return false;
        }

        if (_clienteId is not { } clienteId)
        {
            _aviso = "Elige el cliente al que corresponde el pago.";
            return false;
        }

        Guid? sustituido = null;
        if (!string.IsNullOrWhiteSpace(_uuidSustituido))
        {
            if (!Guid.TryParse(_uuidSustituido, out var uuid) || uuid == Guid.Empty)
            {
                _aviso = "El folio fiscal del pago anterior no es válido.";
                return false;
            }
            sustituido = uuid;
        }

        var peticion = new PeticionGuardarPago(
            clienteId,
            _fechaPagoUtc,
            _formaDePago,
            _moneda,
            _tipoCambio,
            _monto,
            _numOperacion,
            _rfcOrdenante,
            _bancoOrdenanteExtranjero,
            _ctaOrdenante,
            _rfcBeneficiario,
            _ctaBeneficiario,
            [.. _renglones.Select(r => new RenglonDePagoDto(r.IdDocumento, r.ImpPagado, r.EquivalenciaDR))])
        {
            UuidSustituido = sustituido,
            TipoCadPago = _incluirSpei ? "01" : null,
            CertPago = _incluirSpei ? _certPago : null,
            CadPago = _incluirSpei ? _cadPago : null,
            SelloPago = _incluirSpei ? _selloPago : null,
            FechaPagoLocal = DateTime.SpecifyKind(_fechaPagoLocal.Value.Date.Add(_horaPagoLocal.Value), DateTimeKind.Unspecified)
        };

        var (guardado, error) = await Pagos.GuardarAsync(pago.Id, peticion);

        _error = error;

        if (guardado is null) return false;

        _pago = guardado;
        Rehidratar(guardado);
        _borradorSinGuardar = null;

        return true;
    }

    private async Task VistaPrevia()
    {
        if (_trabajando || _pago is null) return;
        _trabajando = true;
        _error = null;
        _aviso = null;
        try
        {
            if (!await GuardarInternoAsync()) return;
            var (archivo, error) = await Emision.ObtenerVistaPreviaPdfAsync(_pago.Id);
            _error = error;
            if (archivo is null) return;
            await Dialogos.ShowAsync<DialogoDeComprobanteDeCompra>("Vista previa de pago",
                new DialogParameters<DialogoDeComprobanteDeCompra>
                {
                    { x => x.Archivo, archivo },
                    { x => x.TituloVistaPrevia, "Complemento de pagos" },
                    { x => x.EsBorrador, true }
                }, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
        }
        finally { _trabajando = false; }
    }

    private async Task Guardar()
    {
        if (_trabajando) return;
        _trabajando = true;
        _aviso = null;

        try
        {
            var faltantes = Faltantes();
            var advertencia = Advertencia();
            if (!await GuardarInternoAsync()) return;
            _aviso = "Borrador guardado." +
                (faltantes.Count > 0 ? $" Para timbrar falta {Lista(faltantes)}." : "") +
                (advertencia is null ? "" : $" {advertencia}");
        }
        finally
        {
            _trabajando = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _registroDeSalida = Navegacion.RegisterLocationChangingHandler(AlSalirAsync);
    }

    private async ValueTask AlSalirAsync(LocationChangingContext contexto)
    {
        if (TieneCambiosSinGuardar && !await Confirmacion.ConfirmarAsync(
                "Cambios sin guardar", "Los cambios de este pago no se han guardado. ¿Quieres salir y descartarlos?", "Salir sin guardar"))
        {
            contexto.PreventNavigation();
            return;
        }
        if (contexto.CancellationToken.IsCancellationRequested) return;
        if (_borradorSinGuardar is not { } id) return;
        _borradorSinGuardar = null;

        try { await Pagos.EliminarBorradorAsync(id); }
        catch { /* el barrido lo recoge después */ }
    }

    public void Dispose() => _registroDeSalida?.Dispose();

    private async Task Timbrar()
    {
        if (!PuedeTimbrar) return;

        _aviso = null;
        if (Faltantes() is { Count: > 0 } faltantes)
        {
            _aviso = $"No se puede timbrar: falta {Lista(faltantes)}.";
            return;
        }

        _trabajando = true;

        try
        {
            if (!await GuardarInternoAsync()) return;

            // Clave nueva por intento real del usuario, igual que en la emisión: es lo que
            // impide que un doble clic gaste dos timbres.
            var (timbrado, error) = await Emision.TimbrarAsync(_pago!.Id, Guid.NewGuid().ToString("N"));

            _error = error;

            if (timbrado is not null)
            {
                _aviso = $"Pago timbrado. Folio fiscal {timbrado.Uuid}.";
                _pago = await Pagos.ObtenerAsync(_pago.Id) ?? _pago;
            }
        }
        finally
        {
            _trabajando = false;
        }
    }
}
