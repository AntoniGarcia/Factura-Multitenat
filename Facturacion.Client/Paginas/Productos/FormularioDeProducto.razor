@page "/productos/nuevo"
@page "/productos/{Id:guid}"
@attribute [Authorize(Policy = Permisos.Politicas.EditarProductos)]
@using Facturacion.Client.Componentes.Catalogos
@inject NavigationManager Navegacion

<PageTitle>@(EsNuevo ? "Nuevo producto" : "Editar producto")</PageTitle>
<TituloDePagina Texto="@(EsNuevo ? "Nuevo producto" : $"Producto {_codigoInterno}")" />

<TarjetaFormulario RutaVolver="/productos" Class="tarjeta-formulario-catalogo">
    <EditorDeProducto Id="Id"
                      IdDelFormulario="formulario-producto"
                      AlGuardar="@(() => Navegacion.NavigateTo("/productos"))"
                      OcupadoCambiado="o => _ocupado = o"
                      CodigoCargado="c => _codigoInterno = c" />

    <div class="tarjeta-formulario-acciones">
        <span class="catalogo-acciones-ayuda">Revisa las claves SAT y el desglose de impuestos.</span>
        <MudButton Variant="Variant.Text" OnClick="@(() => Navegacion.NavigateTo("/productos"))">Cancelar</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="formulario-producto"
                   Variant="Variant.Filled" Color="Color.Primary" Disabled="_ocupado">
            Guardar producto
        </MudButton>
    </div>
</TarjetaFormulario>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool EsNuevo => Id is null;
    private bool _ocupado = true;
    private int _codigoInterno;
}
