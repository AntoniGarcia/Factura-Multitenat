@page "/productos"
@attribute [Authorize]
@inject ServicioDeProductos Productos
@inject NavigationManager Navegacion
@inject IServicioDeConfirmacion Confirmacion
@inject ServicioDeSesion Sesion

<PageTitle>Productos y servicios</PageTitle>
<TituloDePagina Texto="Productos y servicios" />

<PanelErrores Problema="_error" />

<section class="catalogo-panel" aria-label="Catálogo de productos y servicios">
    <p class="catalogo-descripcion">
        Conceptos reutilizables con sus claves del SAT, precio e impuestos configurados.
    </p>

    <BarraHerramientasCatalogo Texto="@_texto"
                               TextoCambiado="AlBuscar"
                               Placeholder="Buscar por código, descripción o clave SAT…"
                               MuestraEstatus="true"
                               Activos="_activos"
                               ActivosCambiado="AlFiltrarActivos"
                               TextoNuevo="Nuevo producto"
                               OnNuevo="@(_puedeCrear ? EventCallback.Factory.Create(this, () => Navegacion.NavigateTo("/productos/nuevo")) : default)"
                               OnExportar="Exportar"
                               TextoSecundario="Importar CSV"
                               IconoSecundario="@Icons.Material.Filled.UploadFile"
                               OnSecundario="@(_puedeCrear || _puedeModificar ? EventCallback.Factory.Create(this, () => Navegacion.NavigateTo("/productos/importar")) : default)" />

    <div class="catalogo-tabla">
        <TablaDatos T="ProductoEnListaDto"
                    @ref="_tabla"
                    Columnas="_columnas"
                    CargarPagina="CargarAsync"
                    TextoEntidad="productos"
                    TextoSinDatos="No hay productos que coincidan." />
    </div>
</section>

@code {
    private TablaDatos<ProductoEnListaDto>? _tabla;
    private DetalleProblema? _error;
    private string _texto = string.Empty;
    private bool? _activos;

    // Comodidad visual: lo que el servidor rechazaría ni se ofrece. La protección real es la
    // política de cada endpoint. La importación crea y actualiza: se ofrece con cualquiera de
    // las dos y el servidor rechaza, renglón por renglón, lo que no se tenga.
    private bool _puedeCrear, _puedeModificar, _puedeDesactivar, _puedeEliminar;

    private IReadOnlyList<ColumnaDeTabla<ProductoEnListaDto>> _columnas = [];

    protected override void OnInitialized()
    {
        _puedeCrear = Sesion.TienePermiso(Permisos.ProductosCrear);
        _puedeModificar = Sesion.TienePermiso(Permisos.ProductosModificar);
        _puedeDesactivar = Sesion.TienePermiso(Permisos.ProductosDesactivar);
        _puedeEliminar = Sesion.TienePermiso(Permisos.ProductosEliminar);
        _columnas = _puedeModificar || _puedeDesactivar || _puedeEliminar ? [.. Columnas, Acciones] : Columnas;
    }

    private IReadOnlyList<ColumnaDeTabla<ProductoEnListaDto>> Columnas =>
    [
        new("Código", p => @<span class="cifra-tabular">@p.CodigoInterno</span>, ClaveOrden: "codigo", Tabular: true),
        new("Producto o servicio", p => @<div class="catalogo-celda-principal">
                                            <strong>@p.Descripcion</strong>
                                            <span>@p.UnidadTexto</span>
                                        </div>, ClaveOrden: "descripcion"),
        new("Clave SAT", p => @<span class="cifra-tabular">@p.ClaveProdServ</span>, Tabular: true),
        new("Precio", p => @<div class="catalogo-celda-precio">
                               <strong class="cifra-tabular">@p.ValorUnitario.ToString("N2")</strong>
                               <span>@(p.PesoKg is { } peso ? $"{peso:N3} kg" : "Sin peso")</span>
                           </div>, ClaveOrden: "precio", Tabular: true),
        new("Estado", p => @<span class="indicador-estado indicador-estado-@(p.Activo ? "timbrada" : "borrador")">
                                @(p.Activo ? "Activo" : "Inactivo")
                            </span>),
    ];

    private ColumnaDeTabla<ProductoEnListaDto> Acciones => new("", p => @<div class="acciones-renglon">
                          @if (_puedeModificar)
                          {
                              <MudButton Size="Size.Small" OnClick="@(() => Navegacion.NavigateTo($"/productos/{p.Id}"))">Editar</MudButton>
                          }
                          @if (_puedeDesactivar)
                          {
                              <MudButton Size="Size.Small" OnClick="@(() => CambiarActivo(p))">
                                  @(p.Activo ? "Desactivar" : "Reactivar")
                              </MudButton>
                          }
                          @if (_puedeEliminar)
                          {
                              <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => Eliminar(p))">Eliminar</MudButton>
                          }
                      </div>);

    private async Task<ResultadoDePagina<ProductoEnListaDto>> CargarAsync(PeticionDePagina peticion, CancellationToken ct)
    {
        var pagina = await Productos.ListarAsync(
            _texto, _activos, peticion.Pagina, peticion.TamanoPagina,
            peticion.ClaveOrden, peticion.Descendente, ct);

        return new ResultadoDePagina<ProductoEnListaDto>(pagina.Elementos, pagina.Total);
    }

    private async Task AlBuscar(string texto)
    {
        _texto = texto;
        await RecargarAsync();
    }

    private async Task AlFiltrarActivos(bool? activos)
    {
        _activos = activos;
        await RecargarAsync();
    }

    private Task RecargarAsync() => _tabla?.RecargarAsync() ?? Task.CompletedTask;

    private async Task CambiarActivo(ProductoEnListaDto producto)
    {
        if (producto.Activo)
        {
            var confirmado = await Confirmacion.ConfirmarAsync(
                "Desactivar producto",
                $"«{producto.Descripcion}» dejará de aparecer al facturar. Los comprobantes ya emitidos no se tocan.",
                "Desactivar");

            if (!confirmado) return;
        }

        var (_, error) = await Productos.CambiarActivoAsync(producto.Id, !producto.Activo);

        _error = error;

        if (error is null) await RecargarAsync();
    }

    /// <summary>Solo prospera si ningún concepto usó el producto; si no, el servidor pide desactivarlo.</summary>
    private async Task Eliminar(ProductoEnListaDto producto)
    {
        var confirmado = await Confirmacion.ConfirmarAsync(
            "Eliminar producto",
            $"«{producto.Descripcion}» se borrará de forma definitiva. Solo es posible si ningún comprobante lo usa.",
            "Eliminar");

        if (!confirmado) return;

        _error = await Productos.EliminarAsync(producto.Id);

        if (_error is null) await RecargarAsync();
    }

    private void Exportar()
        => Navegacion.NavigateTo(ServicioDeProductos.RutaDeExportacion(_activos), forceLoad: true);
}
