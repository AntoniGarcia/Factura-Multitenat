<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="cnf" />
            <add segment="appsettings.Instalacion.json" />
          </hiddenSegments>
        </requestFiltering>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Facturacion.Server.dll" hostingModel="outofprocess" stdoutLogEnabled="false" stdoutLogFile=".\cnf\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Staging" />
          <environmentVariable name="Instalacion__ArranqueAutomatico" value="true" />
          <environmentVariable name="Instalacion__ConexionSinCifrarRevision" value="true" />
          <environmentVariable name="Instalacion__JuntoAlServidorRevision" value="true" />
          <environmentVariable name="Pac__Modo" value="Deshabilitado" />
          <!-- Sustituye facturacion-prueba.local por el hostname del sitio, sin protocolo ni puerto. -->
          <environmentVariable name="AllowedHosts" value="localhost;127.0.0.1;[::1];facturacion-prueba.local" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
