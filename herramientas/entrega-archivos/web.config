<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Permite cargar catCFDI (~46.5 MB) desde el panel del operador sin rechazo 413.1 de IIS. -->
          <requestLimits maxAllowedContentLength="54525952" />
          <hiddenSegments>
            <add segment="cnf" />
            <add segment="appsettings.Instalacion.json" />
            <add segment="llavero-instalacion" />
          </hiddenSegments>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Facturacion.Server.dll" hostingModel="outofprocess" stdoutLogEnabled="false" stdoutLogFile=".\cnf\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Staging" />
          <environmentVariable name="Instalacion__ArranqueAutomatico" value="true" />
          <environmentVariable name="Instalacion__JuntoAlServidorRevision" value="true" />
          <environmentVariable name="Pac__Modo" value="Deshabilitado" />
          <environmentVariable name="RevisionDocumentos__Habilitada" value="true" />
          <!-- Sustituye facturacion-prueba.local por el hostname del sitio, sin protocolo ni puerto. -->
          <environmentVariable name="AllowedHosts" value="localhost;127.0.0.1;[::1];facturacion-prueba.local" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
