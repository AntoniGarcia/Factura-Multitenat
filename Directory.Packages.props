<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Las versiones de Microsoft.* se fijan al runtime instalado (10.0.10) para no cargar
       ensamblados más nuevos que el host. Un solo archivo evita que las dos mitades
       diverjan de versión en sus .csproj. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="MudBlazor" Version="9.8.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- NPOI 2.8.0 arrastra SourceLink 8.0.0 y, con él, Microsoft.Build.Tasks.Git 8.0.0.
         Esa versión expone datos sensibles del proceso de compilación (GHSA-23fw-v26w-5fgq).
         Es una herramienta de build, pero se fija igual para que CI no use la vulnerable. -->
    <PackageVersion Include="Microsoft.Build.Tasks.Git" Version="10.0.401" />
    <!-- Fijado por transitividad: Microsoft.AspNetCore.OpenApi 10.0.10 arrastra
         Microsoft.OpenApi 2.0.0, que tiene la vulnerabilidad GHSA-v5pm-xwqc-g5wc
         (corregida a partir de 2.7.5). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>

  <!-- Lee el .xls (formato binario legado) del catálogo del SAT sin depender de Excel
       instalado. Solo el Server la referencia: es una herramienta de carga, no algo que
       viaje al WebAssembly. -->
  <ItemGroup>
    <PackageVersion Include="NPOI" Version="2.8.0" />
    <!-- Fijado por transitividad: NPOI arrastra System.Security.Cryptography.Xml 8.0.2 para
         firmar/verificar OOXML, algo que este proyecto no usa —solo lee .xls—, pero la
         versión igual trae varias vulnerabilidades conocidas (NU1903) que hay que tapar. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <!-- Representación impresa del CFDI (fase B5).

       QuestPDF va bajo licencia Community, que es gratuita SOLO mientras la facturación
       anual del producto quede por debajo de un millón de dólares. Por encima de eso hay
       que comprar licencia comercial. Está anotado aquí y no en un correo porque el día que
       el SaaS crezca, esta línea es lo único que va a recordarlo.

       QRCoder es MIT, sin condiciones ni topes. -->
  <ItemGroup>
    <PackageVersion Include="QuestPDF" Version="2025.7.0" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
